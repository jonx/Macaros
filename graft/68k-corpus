#!/bin/sh
# 68k-corpus - run a folder of 68k executables on booted AROS, one boot, and
# write a result line per program. Used to harden the translation layer against
# real software: each run names what stopped a program, and the summary says
# which gap is worth fixing next.
#
# Input may be flat (program files) or category/program/program. The latter
# keeps fixtures beside each executable and produces category-aware reports.
#
#   graft/68k-corpus <host-folder-of-68k-programs> [outfile]
set -u
HERE="$(cd "$(dirname "$0")" && pwd)"; ROOT="$(cd "$HERE/.." && pwd)"
DIR="${1:?usage: 68k-corpus <folder> [out]}"
CORPUS_ARGS="${CORPUS_ARGS:-}"      # arguments appended to every program
CORPUS_BEFORE="${CORPUS_BEFORE:-}"  # optional native/setup command(s)
CORPUS_ORACLE="${CORPUS_ORACLE:-}"  # optional native command; capture its output
# CORPUS_MANIFEST: "program : arguments" per line. Running a CLI tool with no
# arguments proves nothing - it exits immediately and tells you nothing about
# whether it works. Give each one real work and the result means something.
MANIFEST="${CORPUS_MANIFEST:-}"
OUT="${2:-$ROOT/run/darwin-aarch64/corpus-$(date +%H%M%S).txt}"
SHARE="$HOME/AROS/Shared"; SUB="corpus"
RUN="$ROOT/run/darwin-aarch64/corpus-$$"; mkdir -p "$RUN"
ENTRIES="$RUN/entries"; : >"$ENTRIES"
# EACH PROGRAM GETS ITS OWN DIRECTORY. They used to share one, which is fine
# until a program does its job: ConvertTabsToSpaces with no arguments rewrote
# every file in the directory, so every program after it alphabetically was a
# corrupted binary and reported "file is not executable". The sweep looked like
# a mass regression and was actually one program working correctly.
mkdir -p "$SHARE/$SUB" && rm -rf "$SHARE/$SUB"/* 2>/dev/null
for f in "$DIR"/*; do
  [ -f "$f" ] || continue
  b=$(basename "$f")
  mkdir -p "$SHARE/$SUB/$b.d" && cp "$f" "$SHARE/$SUB/$b.d/$b"
  printf '%s|%s|%s\n' "$b" "$b" "$b" >>"$ENTRIES"
done
for category_dir in "$DIR"/*; do
  [ -d "$category_dir" ] || continue
  category=$(basename "$category_dir")
  for program_dir in "$category_dir"/*; do
    [ -d "$program_dir" ] || continue
    b=$(basename "$program_dir")
    [ -f "$program_dir/$b" ] || continue
    label=$(printf '%s__%s' "$category" "$b" | tr ' /' '__')
    mkdir -p "$SHARE/$SUB/$label.d"
    cp -R "$program_dir"/. "$SHARE/$SUB/$label.d/"
    printf '%s|[%s] %s|%s\n' "$label" "$category" "$b" "$b" >>"$ENTRIES"
  done
done
# deploy from the repo root before every sweep: a sweep against a stale library
# silently measures the previous build, which has already cost one wasted round
( cd "$ROOT" && ./graft/aros-ctl deploy >/dev/null 2>&1 ) || true
{
  echo 'FailAt 255'
  echo 'CD MacRW:corpus'
  echo 'Echo "=== CORPUS ===" >MacRW:corpus-out.txt'
  [ -n "$CORPUS_BEFORE" ] && printf '%s\n' "$CORPUS_BEFORE"
  [ -n "$CORPUS_ORACLE" ] && echo "$CORPUS_ORACLE <NIL: >>MacRW:corpus-out.txt"
  while IFS='|' read -r label display b; do
    [ -n "$label" ] || continue
    echo "CD MacRW:$SUB/$label.d"
    echo "Echo \"##### $display\" >>MacRW:corpus-out.txt"
    a="$CORPUS_ARGS"
    if [ -n "$MANIFEST" ] && [ -f "$MANIFEST" ]; then
      m=$(awk -v display="$display" -v base="$b" '
        function trim(s) { sub(/^[[:space:]]+/, "", s); sub(/[[:space:]]+$/, "", s); return s }
        /^[[:space:]]*(#|$)/ { next }
        index($0, "|") {
          split($0, f, "|"); key=trim(f[1]) "/" trim(f[2])
          shown=display; gsub(/^\[/, "", shown); gsub(/\] /, "/", shown)
          if (tolower(key)==tolower(shown) || tolower(trim(f[2]))==tolower(base)) {
            print trim(f[3]); exit
          }
          next
        }
        {
          p=index($0, ":"); if (!p) next
          key=trim(substr($0, 1, p-1))
          if (tolower(key)==tolower(base)) { print trim(substr($0, p+1)); exit }
        }' "$MANIFEST")
      [ -n "$m" ] && a="$m"
    fi
    # <NIL: matters: an interactive program (a text viewer, a prompt) otherwise
    # blocks forever inside a native Read, and a guest blocked in a native call
    # is past the point where the wall-clock guard can reach it.
    echo "$b $a <NIL: >>MacRW:corpus-out.txt"
  done <"$ENTRIES"
  echo 'Echo "=== DONE ===" >>MacRW:corpus-out.txt'
  echo 'Wait 999999'
} > "$RUN/startup"
pkill -f Macaros 2>/dev/null; sleep 1
rm -f "$SHARE/corpus-out.txt"; : > /tmp/aros-window.log
AROS_CTL_STARTUP_FILE="$RUN/startup" AROS_HOST_VOLUME="MacRW:$SHARE;WRITE" \
  EMU68K_MAX_SECONDS="${EMU68K_MAX_SECONDS:-8}" "$ROOT/graft/aros-ctl" run >/dev/null 2>&1
i=0; LIMIT="${CORPUS_TIMEOUT:-900}"
while [ $i -lt $LIMIT ]; do
  [ -f "$SHARE/corpus-out.txt" ] && grep -q '=== DONE ===' "$SHARE/corpus-out.txt" && break
  sleep 3; i=$((i+3))
done
cp "$SHARE/corpus-out.txt" "$OUT" 2>/dev/null
cp /tmp/aros-window.log "$OUT.log" 2>/dev/null
"$ROOT/graft/aros-ctl" stop >/dev/null 2>&1
echo "corpus results: $OUT"
