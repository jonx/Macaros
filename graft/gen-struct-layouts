#!/usr/bin/env python3
"""Emit the m68k-vs-native layout of every structure that crosses the 68k
boundary, from the AROS headers themselves.

A 68k program's structures are AmigaOS structures: big-endian, 32-bit pointers,
packed to two bytes. Native AROS on aarch64 is little-endian with 64-bit
pointers and different alignment, so a pointer handed across is not a pointer
that can be rebased - the object has to be rebuilt field by field. That needs
the two layouts, and hand-counting offsets is exactly the kind of work that is
wrong once and then wrong forever.

Both layouts come from one tool. clang dumps a record layout for any target it
can parse headers for, so the same probe compiled twice gives both:

    clang -target m68k-unknown-elf -fpack-struct=2 ...   the AmigaOS layout
    clang -target aarch64-unknown-aros ...               the native layout

-fpack-struct=2 is not optional. The m68k ELF psABI aligns 32-bit fields to 4
while the Amiga ABI packs to 2, and without it struct Node's ln_Name lands at
12 instead of 10 - every conversion built on that would be silently wrong. The
self-check below asserts layouts that are known from the AmigaOS ABI and
refuses to emit if they do not hold.
"""

import os
import json
import re
import subprocess
import sys

AROS_INC = os.environ.get(
    "AROS_INC",
    os.path.expanduser("~/aros-build/bin/darwin-aarch64/AROS/Developer/include"))
CLANG = os.environ.get("AROS_CLANG",
                       os.path.expanduser("~/aros-crosstools/bin/clang"))

# The structures that actually cross. Data structures the guest reads or writes
# need converting; OS-owned handles (Window, Screen, RastPort...) do not appear
# here because they cross as tokens and are never rebuilt.
HEADERS = [
    "dos/dos.h", "dos/dosextens.h", "dos/dosasl.h", "dos/exall.h",
    "utility/tagitem.h", "utility/hooks.h", "exec/lists.h", "exec/ports.h",
    "exec/tasks.h", "exec/execbase.h", "exec/libraries.h",
    "workbench/workbench.h", "intuition/classes.h", "intuition/intuition.h",
    "graphics/regions.h", "graphics/rastport.h", "graphics/gfx.h",
    "graphics/text.h", "graphics/displayinfo.h",
    "intuition/preferences.h", "intuition/screens.h",
    "libraries/gadtools.h",
]

TYPES = [
    "FileInfoBlock", "AnchorPath", "AChain", "DateStamp", "InfoData",
    "TagItem", "Node", "MinNode", "List", "MinList", "MsgPort", "Message",
    "DiskObject", "ExAllData", "Hook", "IClass",
    "Rectangle",
    "Window", "Screen", "RastPort", "Preferences", "BitMap",
    "TextAttr", "TextFont",
    "DimensionInfo", "DrawInfo",
    "NewMenu", "NewGadget", "Menu", "MenuItem", "Requester",
    "Gadget", "ExtGadget",
]

# Not marshalled, read by OFFSET: the structures the 68k execution service
# fills in on the guest's behalf. They are probed and self-checked like the
# rest, but they get no conversion table - nothing converts a Task.
OFFSET_TYPES = ["Task", "ExecBase", "Library", "CommandLineInterface",
                "MsgPort", "Message", "List", "Node", "Process"]

# `struct Screen` is intentionally only marshalled through byte 83. Its head is
# the AmigaOS ABI exactly (LeftEdge 8, Flags 20, Font 40, ViewPort 44, RastPort
# 84), but AROS's `struct Layer_Info` is larger than the classic one, so every
# field after it sits at an incompatible offset. The generated macros may name
# the full AROS layout, while FIELD_LIMITS prevents the generic copier from
# claiming that incompatible tail is a legacy facade.
FIELD_LIMITS = {"Screen": 84}

# Truths from the AmigaOS ABI. If the m68k side stops reproducing these, the
# probe is being compiled with the wrong alignment and nothing it emits can be
# trusted. This is the same guard the LVO numbering needed.
KNOWN_M68K = {
    "Node":          (14, {"ln_Succ": 0, "ln_Pred": 4, "ln_Type": 8,
                           "ln_Pri": 9, "ln_Name": 10}),
    "DateStamp":     (12, {"ds_Days": 0, "ds_Minute": 4, "ds_Tick": 8}),
    "TagItem":       (8,  {"ti_Tag": 0, "ti_Data": 4}),
    "FileInfoBlock": (260, {"fib_DiskKey": 0, "fib_DirEntryType": 4,
                            "fib_FileName": 8, "fib_Protection": 116,
                            "fib_Size": 124, "fib_NumBlocks": 128}),
    "Hook":          (20, {"h_Entry": 8, "h_SubEntry": 12, "h_Data": 16}),
    # A 68k program reads its own stack bounds straight out of its Task, so
    # these three have to be the AmigaOS offsets to the byte.
    "Task":          (92, {"tc_Flags": 14, "tc_State": 15, "tc_SigAlloc": 18,
                           "tc_SPReg": 54, "tc_SPLower": 58, "tc_SPUpper": 62,
                           "tc_UserData": 88}),
    "ExecBase":      (640, {"ThisTask": 276}),
    "Library":       (34, {"lib_Version": 20, "lib_Revision": 22}),
    "CommandLineInterface": (68, {"cli_CommandName": 16}),
    "Window":        (156, {"LeftEdge": 4, "TopEdge": 6, "Width": 8,
                              "Height": 10, "RPort": 50, "UserPort": 86}),
    "Screen":        (354, {"LeftEdge": 8, "Flags": 20, "Font": 40,
                              "ViewPort_ColorMap": 48,
                              "RastPort_Layer": 84}),
    # GetPrefs is a raw CopyMem on the native side, so the guest's idea of this
    # layout has to be right to the byte. The nested timeval and the pointer
    # sprite are named here because they are what the flattening and the array
    # support exist for.
    "Preferences":   (232, {"FontHeight": 0, "KeyRptSpeed_tv_secs": 4,
                            "DoubleClick_tv_micro": 24, "PointerMatrix": 28,
                            "XOffset": 100, "EnableCLI": 124,
                            "PrinterType": 126, "ext_size": 231}),
    "TextAttr":      (8,  {"ta_Name": 0, "ta_YSize": 4,
                            "ta_Style": 6, "ta_Flags": 7}),
    "TextFont":      (52, {"tf_YSize": 20, "tf_Style": 22,
                            "tf_Flags": 23, "tf_XSize": 24,
                            "tf_Baseline": 26, "tf_CharData": 34,
                            "tf_Modulo": 38, "tf_CharLoc": 40,
                            "tf_CharSpace": 44, "tf_CharKern": 48}),
    "DimensionInfo": (88, {"Header_StructID": 0, "Header_DisplayID": 4,
                            "MaxDepth": 16, "Nominal_MinX": 26,
                            "MaxOScan_MinX": 34, "VideoOScan_MinX": 42,
                            "TxtOScan_MinX": 50, "StdOScan_MinX": 58,
                            "pad": 66, "reserved": 80}),
    "DrawInfo":      (50, {"dri_Version": 0, "dri_NumPens": 2,
                            "dri_Pens": 4, "dri_Font": 8, "dri_Depth": 12,
                            "dri_Resolution_X": 14, "dri_Resolution_Y": 16,
                            "dri_Flags": 18, "dri_CheckMark": 22,
                            "dri_AmigaKey": 26, "dri_Screen": 30,
                            "dri_Prefs": 34, "dri_Reserved": 38}),
}

# clang indents by two spaces per nesting level, after a single space that even
# the outermost record carries, so the indent is what says whether a line is the
# record itself, one of its fields, or a field of a field.
LINE_RE = re.compile(r"^\s*(\d+) \|(\s+)(.*?)\s*$")
RECORD_RE = re.compile(r"^(struct|union) (\w+)$")
NAME_RE = re.compile(r"^(.*\S)\s+(\w+)$")
SIZE_RE = re.compile(r"^\s*\| \[sizeof=(\d+), align=(\d+)\]$")


def dump(target, extra):
    src = "/tmp/.structprobe-%d.c" % os.getpid()
    with open(src, "w") as fh:
        for h in HEADERS:
            fh.write("#include <%s>\n" % h)
        for i, t in enumerate(TYPES + OFFSET_TYPES):
            # sizeof FORCES clang to compute the layout; a tentative
            # definition alone does not, and the record is then never dumped
            fh.write("unsigned long probe_%d = sizeof(struct %s);\n" % (i, t))
    cmd = [CLANG, "-target", target] + extra + [
        "-Xclang", "-fdump-record-layouts", "-fsyntax-only", src,
        "-I" + AROS_INC, "-ffreestanding", "-w"]
    r = subprocess.run(cmd, capture_output=True, text=True)
    os.unlink(src)
    if r.returncode != 0:
        sys.stderr.write(r.stderr[:4000])
        sys.exit(1)
    return parse(r.stdout)


def resolve(records, name):
    """AROS declares several of these as <Name>32 / <Name>64 and lets the target
    pick, so `struct FileInfoBlock` is a DIFFERENT record on each side. Resolving
    by suffix is what lets the two layouts be compared at all."""
    for cand in (name, name + "32", name + "64"):
        if cand in records:
            return cand, records[cand]
    return None, None


def split_field(text):
    """A dumped field line is `<type> <name>`, with the array brackets on the
    TYPE (`UWORD[36] PointerMatrix`). An anonymous struct or union member has no
    name at all, which is exactly how `struct timeval`'s two unions appear."""
    m = NAME_RE.match(text)
    return (m.group(1), m.group(2)) if m else (text, None)


def tree(entries):
    """The flat (depth, offset, text) lines back into the nesting they describe."""
    root = []
    stack = [(0, root)]
    for depth, off, text in entries:
        while stack[-1][0] >= depth:
            stack.pop()
        ftype, fname = split_field(text)
        node = {"off": off, "type": ftype, "name": fname, "kids": []}
        stack[-1][1].append(node)
        stack.append((depth, node["kids"]))
    return root


def leaves(nodes, prefix, out, in_union):
    """Flatten to the scalars a marshaller can actually act on.

    A nested structure is not a field, it is a place where more fields live, so
    `KeyRptSpeed` yields `KeyRptSpeed_tv_secs` and `KeyRptSpeed_tv_micro`. Both
    targets flatten by the same rule, so the paths line up and the two layouts
    stay comparable.

    Only the FIRST member of a union is taken: the members are the same bytes,
    and emitting them all would convert those bytes once per member. struct
    timeval is two anonymous unions, so without this every timestamp field in
    the system would be converted twice."""
    for i, n in enumerate(nodes):
        if in_union and i > 0:
            break
        path = prefix + (n["name"],) if n["name"] else prefix
        # An ARRAY of structures is dumped as one element layout, so descending
        # would convert element 0 and silently drop the rest. It stays whole and
        # is reported as unconverted.
        if n["kids"] and not ARRAY_RE.match(n["type"]):
            leaves(n["kids"], path, out, n["type"].startswith("union"))
        elif path:
            out.append(("_".join(path), n["off"], n["type"]))


def parse(text):
    """-> {name: {'size': n, 'align': n, 'fields': [(path, offset, typetext)]}}"""
    out, cur, entries = {}, None, []

    def close(size=None, align=None):
        if cur is None:
            return
        flat = []
        leaves(tree(entries), (), flat, False)
        cur["fields"] = flat
        cur["size"], cur["align"] = size, align

    for line in text.splitlines():
        m = SIZE_RE.match(line)
        if m:
            close(int(m.group(1)), int(m.group(2)))
            cur, entries = None, []
            continue
        m = LINE_RE.match(line)
        if not m:
            continue
        depth = (len(m.group(2)) - 1) // 2
        if depth == 0:                       # the record this dump is about
            close()
            cur, entries = {"size": None, "align": None, "fields": []}, []
            r = RECORD_RE.match(m.group(3))
            if r:
                out[r.group(2)] = cur
        elif cur is not None:
            entries.append((depth, int(m.group(1)), m.group(3)))
    close()
    return out


def overlaps(records, native):
    """No field may be believed wider than the distance to the next one.

    A width comes from a table of type spellings, and a table can be wrong about
    a spelling (BOOL was), which does not fail loudly: it makes a conversion
    write over the following field. The record dump already says where the next
    field starts, so the claim is checkable against the compiler itself, for
    every type, without knowing which one is wrong."""
    bad = []
    for t in TYPES:
        rn, r = resolve(records, t)
        if not r:
            continue
        rows = sorted(r["fields"], key=lambda x: x[1])
        for i, (f, o, ty) in enumerate(rows):
            k = field_kind(t, f, ty, ty)
            if k is None:
                continue
            width = (k[2] if native else k[1]) * k[3]
            limit = rows[i + 1][1] if i + 1 < len(rows) else r["size"]
            if limit is not None and o + width > limit:
                bad.append("%s %s.%s (%s) is taken for %d bytes at %d, but the "
                           "next field starts at %d"
                           % ("native" if native else "m68k", t, f, ty,
                              width, o, limit))
    return bad


def selfcheck(m68k, native):
    bad = []
    for name, (size, fields) in KNOWN_M68K.items():
        _rn, r = resolve(m68k, name)
        if not r:
            bad.append("%s: not in the probe output" % name)
            continue
        if r["size"] != size:
            bad.append("%s: sizeof is %s, the AmigaOS ABI says %d"
                       % (name, r["size"], size))
        got = {f: o for f, o, _t in r["fields"]}
        for f, o in fields.items():
            if got.get(f) != o:
                bad.append("%s.%s: at %s, the AmigaOS ABI says %d"
                           % (name, f, got.get(f), o))
    return bad + overlaps(m68k, False) + overlaps(native, True)


# Scalar spelling -> width.  Guest and native types are inspected separately:
# AROS deliberately pairs LONG with UQUAD in FileInfoBlock32/64, for example,
# and deriving both widths from the guest spelling silently read only half the
# native value. BYTES is copied verbatim; SCALAR is byte-swapped and narrowed.
WIDTHS = {
    "UBYTE": 1, "BYTE": 1, "char": 1, "TEXT": 1,
    "unsigned char": 1, "signed char": 1,
    # BOOL is `short`, not `int`: AmigaOS sized it 16 bits and AROS keeps that.
    # Taking it for 4 wrote over whatever followed it - in struct Preferences,
    # EnableCLI at 124 would have flattened PrinterType at 126. The overlap
    # self-check below is the general form of this, and does not need the
    # spelling of every type to be known in advance.
    "UWORD": 2, "WORD": 2, "short": 2, "unsigned short": 2, "BOOL": 2,
    "LONG": 4, "ULONG": 4, "int": 4, "unsigned int": 4,
    "LONGBITS": 4, "ULONGBITS": 4,
    "QUAD": 8, "UQUAD": 8, "long long": 8, "unsigned long long": 8,
}

POINTER_SIZED = {"IPTR", "SIPTR", "APTR", "BPTR", "Tag", "STRPTR",
                 "CONST_STRPTR"}

# These typedefs are pointer-sized but the named fields are documented scalar
# cookies/flags, not addresses a caller dereferences. Every other pointer-like
# field stays out of the generic table until it has an explicit policy.
OPAQUE_SCALAR_FIELDS = {
    ("FileInfoBlock", "fib_DiskKey"),
    ("AnchorPath", "ap_Info_fib_DiskKey"),
    ("AChain", "an_Info_fib_DiskKey"),
    ("InfoData", "id_InUse"),
}

# Fields that ARE guest addresses of raw bytes, and may therefore be rebased
# into native pointers. This is a decision per field, not a property of the
# type, which is why it is written down rather than inferred: the same
# pointer-shaped field could equally be an address the guest must never see
# rebased. Bitplanes qualify because plane data is a bit array addressed
# MSB-first within each byte on both machines, so the bytes mean the same
# thing to native code without being touched.
GUEST_BYTE_POINTER_FIELDS = {
    ("BitMap", "Planes"),
    ("TextAttr", "ta_Name"),
}

ARRAY_RE = re.compile(r"^(.*?)\[(\d+)\]$")


def scalar_width(typetext, native):
    t = typetext.strip()
    if t in WIDTHS:
        return WIDTHS[t]
    if t in POINTER_SIZED or t.endswith("*"):
        return 8 if native else 4
    return None


# Pointer-shaped fields the OWNING LIBRARY never dereferences: they are the
# program's own value, handed back untouched. Carrying them as opaque scalars
# is what lets a structure the program allocated cross at all; refusing them
# would refuse the structure over a field nobody reads. This is a per-field
# statement about the library, so it is written down, not inferred.
def _opaque_value_fields():
    path = os.path.join(os.path.dirname(os.path.abspath(__file__)),
                        "emu68k-bridge-policy.json")
    try:
        with open(path) as fh:
            meta = json.load(fh).get("struct_metadata", {})
    except (OSError, ValueError):
        return set()
    return {(struct, field)
            for struct, fields in meta.get("opaque_value_fields", {}).items()
            for field in fields}


OPAQUE_VALUE_FIELDS = _opaque_value_fields()


def field_kind(struct_name, field_name, guest_type, native_type):
    """-> (kind, guest_width, native_width, count) or None when the field is
    something this cannot convert and must not pretend to. The widths are of
    ONE element; count says how many there are."""
    gt, nt = guest_type.strip(), native_type.strip()
    if (struct_name, field_name) in OPAQUE_VALUE_FIELDS:
        return ("SCALAR", 4, 8, 1)
    if (struct_name, field_name) in GUEST_BYTE_POINTER_FIELDS:
        m = ARRAY_RE.match(gt)
        return ("GPTR", 4, 8, int(m.group(2)) if m else 1)
    m = ARRAY_RE.match(gt)
    if m:
        base, n = m.group(1).strip(), int(m.group(2))
        if base in ("UBYTE", "char", "TEXT", "BYTE", "unsigned char"):
            return ("BYTES", 1, 1, n)       # a string or a blob: no byte order
        nm = ARRAY_RE.match(nt)
        nbase = nm.group(1).strip() if nm else ""
        # An array of pointer-sized elements is refused for the same reason a
        # pointer field is: the values may be guest addresses, and rebasing one
        # is a decision, not a width.
        if (base in POINTER_SIZED or nbase in POINTER_SIZED or
                base.endswith("*") or nbase.endswith("*")):
            return None
        gw = scalar_width(base, False)
        nw = scalar_width(nbase, True) if nm else None
        if not gw or not nw or int(nm.group(2)) != n:
            return None
        # An array of scalars is n scalars, each one byte-swapped. Skipping it
        # left the guest reading whatever was in its buffer before the call -
        # for GetPrefs that was the whole 72-byte pointer sprite.
        return ("ARRAY", gw, nw, n)
    pointer_like = (gt in POINTER_SIZED or nt in POINTER_SIZED or
                    gt.endswith("*") or nt.endswith("*"))
    if pointer_like and (struct_name, field_name) not in OPAQUE_SCALAR_FIELDS:
        return ("PTR", 4, 8, 1)             # a guest address: never a raw copy
    gw, nw = scalar_width(gt, False), scalar_width(nt, True)
    return ("SCALAR", gw, nw, 1) if gw and nw else None


HEAD = """/* GENERATED by graft/gen-struct-layouts - do not edit.
 *
 * The two layouts of every structure that crosses the 68k boundary: the
 * AmigaOS one the guest uses (big-endian, 32-bit pointers, packed to 2) and
 * the native aarch64 one. A field whose offsets differ cannot be copied, it
 * has to be converted, and these are the numbers that say where from and where
 * to. Both come from the AROS headers via clang, so they cannot drift from the
 * OS the way a hand-written table would.
 *
 * M68K_<Struct>_<field> is the guest offset; the native offset is offsetof()
 * on this side, which the compiler already knows - only the guest side needs
 * stating here.
 */

#ifndef EMU68K_LAYOUTS_H
#define EMU68K_LAYOUTS_H

/* One field of a structure, in both layouts at once. */
struct EmuField
{
    unsigned short g_off, n_off;   /* offset in the guest / native structure  */
    unsigned short count;          /* elements: 1 for a scalar, n for an array */
    unsigned char  g_w, n_w;       /* width of ONE element on each side (a
                                    * guest LONG is 4, a native IPTR is 8)    */
    unsigned char  kind;
};

"""


# Counting these offsets by hand is how tc_SPLower ended up two bytes out,
# which no test could see: the program just read a wrong pointer and went
# somewhere else.
def emit_offsets(m68k, out):
    L = ["/* GENERATED by graft/gen-struct-layouts - do not edit.",
         " *",
         " * m68k (AmigaOS ABI) offsets of the structures the 68k execution",
         " * service fills in on the guest's behalf. Derived from the AROS",
         " * headers with a 2-byte-packed m68k probe and locked by the",
         " * generator's KNOWN_M68K self-check. */",
         "#ifndef EMU68K_GUEST_OFFSETS_H",
         "#define EMU68K_GUEST_OFFSETS_H",
         ""]
    for t in OFFSET_TYPES:
        an, a = resolve(m68k, t)
        if not a:
            continue
        L.append("/* struct %s: %d bytes on m68k (%s) */" % (t, a["size"], an))
        L.append("#define M68K_%s_SIZEOF %d" % (t, a["size"]))
        for f, o, ty in a["fields"]:
            L.append("#define M68K_%s_%s %d" % (t, f, o))
        L.append("")
    L.append("#endif /* EMU68K_GUEST_OFFSETS_H */")
    text = "\n".join(L) + "\n"
    if "--check" in sys.argv:
        cur = open(out).read() if os.path.exists(out) else None
        if cur != text:
            print("STALE: %s - regenerate with `make struct-layouts`" % out)
            return 1
        print("guest offsets are in sync with the AROS headers")
        return 0
    open(out, "w").write(text)
    print("%s <- %d structures" % (out, len(OFFSET_TYPES)))
    return 0


def emit(m68k, native, out):
    L = [HEAD]
    for t in TYPES:
        an, a = resolve(m68k, t)
        bn, b = resolve(native, t)
        if not a:
            continue
        L.append("/* struct %s: %d bytes on m68k (%s), %s native (%s) */"
                 % (t, a["size"], an, b["size"] if b else "?", bn))
        L.append("#define M68K_%s_SIZEOF %d" % (t, a["size"]))
        nb = {f: o for f, o, _ in (b["fields"] if b else [])}
        for f, o, ty in a["fields"]:
            same = nb.get(f) == o
            L.append("#define M68K_%s_%s %s%s"
                     % (t, f, o, "" if same else
                        "   /* native @%s - CONVERT */" % nb.get(f)))
        L.append("")
    # ---- the field TABLES: what a generic marshaller walks ------------------
    L.append("/* The conversion tables. Each row is one field: where it lives on")
    L.append(" * each side, how wide it is on each side, and what may be done to it.")
    L.append(" * A generic walker (emu68k_marshal.c) is all that is needed to convert")
    L.append(" * a whole structure, so no per-structure C is written by hand. */")
    L.append("#define EMU_F_SCALAR 0   /* byte-swapped, narrowed to the guest width */")
    L.append("#define EMU_F_BYTES  1   /* copied verbatim: no byte order to change  */")
    L.append("#define EMU_F_ARRAY  2   /* count scalars, each one byte-swapped       */")
    L.append("#define EMU_F_GUESTPTR 3 /* guest addresses of raw bytes, rebased;")
    L.append("                          * guest -> native only, since a native")
    L.append("                          * address has no guest form to write back  */")
    L.append("")
    for t in TYPES:
        an, a = resolve(m68k, t)
        bn, b = resolve(native, t)
        if not a or not b:
            continue
        nb = {f: (o, ty) for f, o, ty in b["fields"]}
        rows, skipped = [], []
        for f, o, ty in a["fields"]:
            if f not in nb:
                skipped.append("%s (absent natively)" % f)
                continue
            no, nty = nb[f]
            k = field_kind(t, f, ty, nty)
            if k is None or k[0] == "PTR":
                skipped.append("%s (%s)" % (f, ty))
                continue
            if t in FIELD_LIMITS and o + k[1] * k[3] > FIELD_LIMITS[t]:
                skipped.append("%s (beyond %d-byte partial facade)"
                               % (f, FIELD_LIMITS[t]))
                continue
            kind = {"BYTES": "EMU_F_BYTES", "ARRAY": "EMU_F_ARRAY",
                    "GPTR": "EMU_F_GUESTPTR"}.get(k[0], "EMU_F_SCALAR")
            rows.append("    { %4d, %4d, %4d, %d, %d, %s },   /* %-24s %s */"
                        % (o, no, k[3], k[1], k[2], kind, f, ty))
        if not rows:
            continue
        L.append("static const struct EmuField emu_fields_%s[] = {" % t)
        L.extend(rows)
        L.append("};")
        if skipped:
            L.append("/* NOT converted, and deliberately not guessed at:")
            for x in skipped:
                L.append(" *   %s" % x)
            L.append(" */")
        L.append("")
    L.append("#endif /* EMU68K_LAYOUTS_H */")
    text = "\n".join(L) + "\n"
    if "--check" in sys.argv:
        cur = open(out).read() if os.path.exists(out) else None
        if cur != text:
            print("STALE: %s - regenerate with `make struct-layouts`" % out)
            return 1
        print("struct layouts are in sync with the AROS headers")
        return 0
    open(out, "w").write(text)
    print("%s <- %d structures" % (out, len([t for t in TYPES if t in m68k])))
    return 0


def main():
    probe_types = []
    if "--probe-json" in sys.argv:
        i = sys.argv.index("--probe-json")
        if i + 1 >= len(sys.argv):
            print("--probe-json requires a comma-separated type list", file=sys.stderr)
            return 2
        probe_types = [x for x in sys.argv[i + 1].split(",") if x]
        for t in probe_types:
            if t not in TYPES:
                TYPES.append(t)
    for i, arg in enumerate(sys.argv):
        if arg == "--header" and i + 1 < len(sys.argv) and sys.argv[i + 1] not in HEADERS:
            HEADERS.append(sys.argv[i + 1])

    m68k = dump("m68k-unknown-elf", ["-fpack-struct=2"])
    native = dump("aarch64-unknown-aros", [])

    bad = selfcheck(m68k, native)
    if bad:
        print("SELF-CHECK FAILED - the m68k probe is not producing AmigaOS "
              "layouts, so nothing here can be trusted:")
        for b in bad:
            print("  ! %s" % b)
        return 1

    if probe_types:
        result = {"schema": 1, "types": {}}
        for t in probe_types:
            guest_name, guest = resolve(m68k, t)
            native_name, host = resolve(native, t)
            def record(name, value):
                if not value:
                    return None
                return {"resolved_name": name, "size": value["size"],
                        "align": value["align"],
                        "fields": [{"name": f, "offset": o, "type": ty}
                                   for f, o, ty in value["fields"]]}
            result["types"][t] = {"m68k": record(guest_name, guest),
                                   "native": record(native_name, host)}
        import json
        print(json.dumps(result, indent=2, sort_keys=False))
        return 0

    if "--report" in sys.argv:
        for t in TYPES:
            an, a = resolve(m68k, t)
            bn, b = resolve(native, t)
            if not a:
                print("%-16s (not found)" % t)
                continue
            nb = {f: o for f, o, _ in (b["fields"] if b else [])}
            moved = sum(1 for f, o, _ in a["fields"] if nb.get(f) != o)
            print("%-16s m68k %4d b (%-16s) / native %-5s b (%-16s)  %2d of %2d fields move"
                  % (t, a["size"], an, b["size"] if b else "?", bn, moved,
                     len(a["fields"])))
        return 0

    rc = 0
    j = sys.argv.index("--emit-offsets") if "--emit-offsets" in sys.argv else -1
    if j >= 0:
        rc = emit_offsets(m68k, sys.argv[j + 1])

    i = sys.argv.index("--emit") if "--emit" in sys.argv else -1
    if i < 0:
        if j >= 0:
            return rc
        print("usage: gen-struct-layouts [--report] [--probe-json T1,T2 --header H] "
              "[--emit OUT.h] [--emit-offsets OUT.h] [--check]")
        return 2
    return emit(m68k, native, sys.argv[i + 1]) or rc


if __name__ == "__main__":
    sys.exit(main())
