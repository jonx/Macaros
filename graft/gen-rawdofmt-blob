#!/usr/bin/env python3
"""Assemble the in-guest OS routines and emit them as a C header.

These are 68k routines that run INSIDE the guest because they call back into
the program's own code (see hosted/emu68k/nativelib/rawdofmt.s). The assembled
bytes are checked in so the host builds without vasm; --check fails when the
header has drifted from the assembly it came from.

    gen-rawdofmt-blob <vasm> <src.s> <out.h> [--check]
"""

import os
import subprocess
import sys


def build(vasm, src):
    out = "/tmp/.rawdofmt-%d.bin" % os.getpid()
    r = subprocess.run([vasm, "-Fbin", "-m68020", "-nosym", "-o", out, src],
                       capture_output=True, text=True)
    if r.returncode != 0:
        sys.stderr.write(r.stdout + r.stderr)
        sys.exit(1)
    data = open(out, "rb").read()
    os.unlink(out)
    return data


def render(data, src):
    L = []
    L.append("/* GENERATED from %s - do not edit." % src)
    L.append(" * Regenerate with `make rawdofmt-blob`; `make hosted-emu68k-t3fmt`")
    L.append(" * fails if this drifts from the assembly it came from. */")
    L.append("")
    L.append("#ifndef EMU68K_RAWDOFMT_BLOB_H")
    L.append("#define EMU68K_RAWDOFMT_BLOB_H")
    L.append("")
    L.append("static const unsigned char emu68k_rawdofmt_bin[] = {")
    for i in range(0, len(data), 12):
        L.append("    " + " ".join("0x%02x," % c for c in data[i:i + 12]))
    L.append("};")
    L.append("")
    L.append("#endif")
    return "\n".join(L) + "\n"


def main():
    if len(sys.argv) < 4:
        sys.stderr.write(__doc__)
        return 2
    vasm, src, out = sys.argv[1:4]
    text = render(build(vasm, src), os.path.relpath(src))
    if "--check" in sys.argv:
        cur = open(out).read() if os.path.exists(out) else None
        if cur != text:
            print("STALE: %s does not match %s - run `make rawdofmt-blob`" % (out, src))
            return 1
        print("in-guest OS code is in sync with its assembly (%d bytes)"
              % text.count("0x"))
        return 0
    open(out, "w").write(text)
    print("%s <- %s" % (out, src))
    return 0


if __name__ == "__main__":
    sys.exit(main())
