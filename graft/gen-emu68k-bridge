#!/usr/bin/env python3
"""Generate the 68k -> native AROS library bridge from the OS tree's own .conf
files.

Every AROS library describes each of its vectors in a `##begin functionlist`
block: the full C prototype, and the m68k register each argument arrives in.
That is exactly the information a call needs to cross from a 68k guest into a
native library, so the crossing should be DERIVED from it rather than typed out
by hand.

What can be derived is limited by one fact: there is no pass-through. Guest
memory is big-endian with 32-bit pointers; native AROS on aarch64 is
little-endian with 64-bit pointers and different structure layouts. A pointer
argument is therefore only safe to forward when the thing behind it has no
layout at all - a NUL-terminated string, or raw bytes. Anything with fields has
to be rebuilt, which needs a description of the type, not of the function.

So functions land in tiers:

  1  every argument is a scalar or a char pointer, and the result is a scalar.
     Fully generated, no hand-written code, ever.
  2  a structure, a BPTR, or an untyped APTR crosses. Needs a per-TYPE
     description (written once, shared by every function using that type).
  3  the signature does not say enough: the callee retains the pointer, or
     calls back into the guest.

This script emits tier 1 and reports the rest as the work queue.
"""

import os
import re
import sys
import json
import hashlib
import subprocess

AROS = os.environ.get("AROS_SRC", os.path.expanduser("~/Source/aros-upstream"))
AROS_BUILD = os.environ.get("AROS_BUILD", os.path.expanduser("~/aros-build"))
AROS_CC = os.environ.get(
    "AROS_CC", os.path.expanduser("~/aros-crosstools/bin/clang"))
LAYOUT_TOOL = os.path.join(os.path.dirname(os.path.abspath(__file__)),
                           "gen-struct-layouts")
POLICY_PATH = os.environ.get(
    "EMU68K_BRIDGE_POLICY",
    os.path.join(os.path.dirname(os.path.abspath(__file__)),
                 "emu68k-bridge-policy.json"))

# Where the BUILD put the generated proto headers. They are the authority on how
# a library's base is named and typed (the .conf does not always say), and a
# library without one cannot be compiled against at all - which makes the
# presence of the header the natural test for "can we generate for this".
GENINC = os.environ.get(
    "AROS_GENINC",
    os.path.expanduser("~/aros-build/bin/darwin-aarch64/gen/include"))

# The libraries a 68k Amiga program plausibly calls: the AmigaOS application
# surface. Every .conf in the tree is CLASSIFIED (see --report-all, 175 of them),
# but only these have code emitted - compiling all 175 would link the bridge
# against HIDDs, datatypes and internal modules that no 68k program opens.
GEN_LIBS = [
    "exec", "dos", "utility", "intuition", "graphics", "layers", "gadtools",
    "asl", "icon", "iffparse", "commodities", "diskfont", "locale", "keymap",
    "datatypes", "expansion", "cybergraphics", "mathffp", "mathieeesingbas",
    "mathieeedoubbas", "mathieeesingtrans", "mathieeedoubtrans", "mathtrans",
    "workbench",
]


def load_policy():
    """Load the semantic facts C prototypes cannot carry. This file is small
    on purpose: it describes TYPES/domains once, while the .conf remains the
    authority for function names, LVOs, registers and C signatures."""
    try:
        with open(POLICY_PATH, encoding="utf-8") as fh:
            p = json.load(fh)
    except (OSError, ValueError) as e:
        raise SystemExit("cannot load bridge policy %s: %s" % (POLICY_PATH, e))
    if p.get("schema") != 1:
        raise SystemExit("bridge policy schema must be 1")
    return p


POLICY = load_policy()


def find_confs():
    """short name -> path, for every .conf in the tree carrying a functionlist.
    Prefers rom/ and workbench/libs/ when a name appears more than once."""
    out = {}
    for root, dirs, files in os.walk(AROS):
        dirs[:] = [d for d in dirs if d not in (".git", "bin")]
        for fn in files:
            if not fn.endswith(".conf"):
                continue
            p = os.path.join(root, fn)
            try:
                if "##begin functionlist" not in open(
                        p, encoding="utf-8", errors="replace").read():
                    continue
            except OSError:
                continue
            rel = os.path.relpath(p, AROS)
            short = fn[:-5]
            rank = 0 if rel.startswith(("rom/", "workbench/libs/")) else 1
            if short not in out or rank < out[short][1]:
                out[short] = (rel, rank)
    return {k: v[0] for k, v in out.items()}


BASE_RE = re.compile(r"extern\s+(struct\s+\w+|\w+)\s*\*\s*(\w+)\s*;")
GETBASE_RE = re.compile(r"__aros_getbase_(\w+)\s*\(\)")


def proto_base(short):
    """(base name, base type) for `short`, read from its generated proto header.
    Returns None when there is no header, i.e. nothing to generate against."""
    path = os.path.join(GENINC, "proto", short + ".h")
    try:
        src = open(path, encoding="utf-8", errors="replace").read()
    except OSError:
        return None
    m = GETBASE_RE.search(src)
    if not m:
        return None
    name = m.group(1)
    btype = "struct Library"
    for bt, bn in BASE_RE.findall(src):
        # the specific spelling wins over the generic `struct Library` one
        if bn == name and norm(bt) != "struct Library":
            btype = norm(bt)
    return (name, btype)


def gen_targets():
    """The libraries code is emitted for: on GEN_LIBS, has a .conf, and has a
    generated proto header to compile against."""
    confs = find_confs()
    out = []
    for short in GEN_LIBS:
        rel = confs.get(short)
        if not rel:
            continue
        pb = proto_base(short)
        if not pb:
            continue
        out.append((short + ".library", rel, pb[0], pb[1], "proto/%s.h" % short))
    return out


def all_targets():
    """Every library in the tree, for classification. No proto header needed:
    nothing is compiled, only counted."""
    return [(short + ".library", rel, None, None, None)
            for short, rel in sorted(find_confs().items())]


def analysis_targets(which):
    """Resolve requested libraries without the runtime emission allowlist.

    GEN_LIBS deliberately limits what the bridge links by default.  An importer
    must instead be able to inspect any source library, including one that has
    never been imported before.  A generated proto header is recorded when
    present but is not required merely to discover and report the source.
    """
    if not which:
        return gen_targets()
    confs, out, missing = find_confs(), [], []
    for requested in sorted(set(which)):
        short = requested[:-8] if requested.endswith(".library") else requested
        rel = confs.get(short)
        if not rel:
            missing.append(requested)
            continue
        pb = proto_base(short)
        out.append((short + ".library", rel,
                    pb[0] if pb else None, pb[1] if pb else None,
                    "proto/%s.h" % short if pb else None))
    if missing:
        raise ValueError("no AROS library .conf matches: %s" %
                         ", ".join(missing))
    return out


# ---------------------------------------------------------------------------
# type classification
# ---------------------------------------------------------------------------

# Fits in (or narrower than) a 32-bit 68k register, and carries no address.
SCALAR = {
    "LONG", "ULONG", "WORD", "UWORD", "BYTE", "UBYTE", "BOOL", "LONGBITS",
    "ULONGBITS", "int", "unsigned int", "long", "unsigned long", "short",
    "unsigned short", "char", "unsigned char", "signed char", "UBYTE",
    "STACKULONG", "STACKLONG", "Tag", "TEXT",
}

# Pointer-sized natively but used as an integer. Safe as an argument (we widen
# a 32-bit register); as a RESULT it is narrowed, which is only correct because
# the value is an integer and not an address. Flagged in the generated source.
WIDENING = {"IPTR", "SIPTR", "APTR_or_IPTR"}

# A pointer to bytes: no layout, so the guest's own buffer can be handed over
# directly. This is the only pointer class that is safe to forward as-is.
STRING = {"STRPTR", "CONST_STRPTR", "CONST_STRPTR_or_NULL"}

# How wide the guest's own value is when a scalar argument says how many bytes
# of a structure the caller wants touched. The register is 32 bits either way;
# this is the width the 68k program believes it passed.
SIZE_WIDTHS = {
    "BYTE": 1, "UBYTE": 1,
    "WORD": 2, "UWORD": 2,
    "LONG": 4, "ULONG": 4, "int": 4, "unsigned int": 4,
    "LONGBITS": 4, "ULONGBITS": 4, "IPTR": 4, "SIPTR": 4,
}
SIZE_CASTS = {1: "(ULONG)(UBYTE)", 2: "(ULONG)(UWORD)", 4: "(ULONG)"}

POINTER_SCALARS = {
    "u8":  ({"UBYTE"}, 1),
    "s8":  ({"BYTE"}, 1),
    "u16": ({"UWORD"}, 2),
    "s16": ({"WORD"}, 2),
    "u32": ({"ULONG", "ULONGBITS"}, 4),
    "s32": ({"LONG", "LONGBITS"}, 4),
}

VOID = {"void", "VOID"}

# Tier 1 by signature is not the same as safe to forward. A guest is not
# trusted to halt the machine it is a guest on, and a simple signature says
# nothing about that, so the decision is made by name.
#
# exec.library is inverted: it is a kernel API, not an application API, and
# nearly every one of its simple-signature vectors drives the real machine
# (ShutdownA, SetSR, ReadGayle, Exception, RawPutChar). The calls a 68k
# program legitimately makes into exec - memory, lists, semaphores,
# OpenLibrary - are hand-served already. So exec is allowlisted and everything
# else is denylisted.
ALLOWLIST_LIBS = {"exec.library"}

ALLOW = {
    ("exec.library", "AvailMem"): 1,
}

# Vectors that LOOK like tier 2a but must stay hand-written: they need
# something before or after the call that a derived crossing cannot know about.
DENY_2A = {
    ("dos.library", "Close"):     "must release the handle-table slot after",
    ("dos.library", "UnLock"):    "must release the handle-table slot after",
    ("dos.library", "UnLoadSeg"): "a guest seglist is not a native one",
    ("dos.library", "RunCommand"):"a guest seglist is not a native one",
    ("dos.library", "AddSegment"):"a guest seglist is not a native one",
}

DENY = {
    # the guest exits by returning; calling this would unwind the host task
    ("dos.library",  "Exit"):        "the guest exits by returning, not by this",
    # device-level operations: vanishingly rare in the programs being served,
    # and catastrophic if a mistranslated register ever reaches one
    ("dos.library",  "Format"):      "device-level, and destroys a volume",
    ("dos.library",  "Relabel"):     "device-level",
    ("dos.library",  "Inhibit"):     "device-level",
    ("dos.library",  "AddBuffers"):  "device-level",
    ("dos.library",  "SetOwner"):    "device-level",
    # meaningless or harmful without the paired call, which is not tier 1
    ("dos.library",  "UnLockDosList"): "pairs with LockDosList, which is not tier 1",
    ("dos.library",  "SetArgStr"):   "rebinds the host process argument string",
    ("dos.library",  "SetProgramName"): "renames the host process",
    ("dos.library",  "SetCurrentDirName"): "moves the host process, not the guest",
    ("dos.library",  "SetPrompt"):   "the host shell's prompt is not the guest's",
    ("dos.library",  "MaxCli"):      "reports on host CLIs, not guest ones",
    # the host task's signals are the JIT's, not the guest's: a guest that
    # allocates or waits on them stalls the task running it
    ("dos.library",  "CheckSignal"): "the host task's signals are not the guest's",
    # `dest` is a STRPTR when soft is set and a BPTR lock when it is not, so
    # one C type covers two conversions and the signature cannot say which
    ("dos.library",  "MakeLink"):   "dest is a string or a lock depending on soft",
    # returns a PAIR: quotient in D0, remainder in D1. The C prototype can only
    # describe D0, so generating from it would leave D1 stale and the
    # arithmetic silently wrong. Needs a hand-written crossing.
    ("utility.library", "UDivMod32"): "returns quotient in D0 AND remainder in D1",
    ("utility.library", "SDivMod32"): "returns quotient in D0 AND remainder in D1",
}


def norm(t):
    return re.sub(r"\s+", " ", t.strip())


def classify(t):
    """-> ('scalar'|'widen'|'string'|'void'|'bptr'|'double'|'struct'|'aptr'|'other')"""
    t = norm(t)
    if t in VOID:
        return "void"
    # A 68k double is a bit pattern in a register PAIR. Nothing about it needs
    # describing beyond that: no memory is touched and the value crosses
    # unchanged, so the .conf's own register spelling is the whole contract.
    if t == "double":
        return "double"
    if t == "BPTR":
        return "bptr"
    if t in SCALAR:
        return "scalar"
    if t in WIDENING:
        return "widen"
    if t in STRING:
        return "string"
    # `UBYTE *name` / `char *` / `CONST STRPTR` spellings of a byte buffer
    if re.fullmatch(r"(CONST\s+)?(unsigned\s+|signed\s+)?(char|UBYTE|TEXT)\s*\*", t):
        return "string"
    if t == "APTR" or t == "CONST_APTR":
        return "aptr"
    if "*" in t:
        return "struct"
    return "other"


# ---------------------------------------------------------------------------
# .conf parsing
# ---------------------------------------------------------------------------

# `<return type> <name>(<args>) (<regs>)`, where the return type may itself
# carry stars and `struct`.
FUNC_RE = re.compile(r"^(.*?\**)\s*(\w+)\s*\((.*)\)\s*\(([^()]*)\)\s*$")


def split_args(s):
    """Split an argument list on commas that are not inside parentheses (a
    function-pointer argument carries its own)."""
    out, depth, cur = [], 0, ""
    for ch in s:
        if ch in "([":
            depth += 1
        elif ch in ")]":
            depth -= 1
        if ch == "," and depth == 0:
            out.append(cur)
            cur = ""
        else:
            cur += ch
    if cur.strip():
        out.append(cur)
    return [a.strip() for a in out if a.strip()]


def arg_type_and_name(a):
    """`struct FileInfoBlock* fib` -> ('struct FileInfoBlock *', 'fib')"""
    a = a.strip()
    if a in VOID or a == "":
        return None
    # a function pointer argument: `void (*fn)(...)`
    if "(*" in a:
        return ("__fnptr", "fn")
    m = re.match(r"^(.*?)(\w+)$", a)
    if not m:
        return (norm(a), "a")
    t, n = m.group(1), m.group(2)
    if not t.strip() or t.strip() in ("struct", "const", "CONST", "unsigned", "signed"):
        # the whole thing was a bare type with no parameter name
        return (norm(a), "a")
    return (norm(t), n)


class Func:
    def __init__(self, lvo, ret, name, args, regs):
        self.lvo, self.ret, self.name, self.args, self.regs = lvo, ret, name, args, regs
        self.private = False
        self.novararg = False

    @property
    def offset(self):
        return -6 * self.lvo

    def tier(self, lib=None):
        """1, or the reason it is not 1."""
        if self.private:
            return (None, "private")
        if lib is not None:
            if (lib, self.name) in DENY:
                return (None, "refused: " + DENY[(lib, self.name)])
            if lib in ALLOWLIST_LIBS and (lib, self.name) not in ALLOW:
                return (None, "not on the %s allowlist" % lib.split(".")[0])
        if self.regs and self.regs[0] in ("base", "sysv"):
            return (None, "not register-based")
        # a zero-argument function has an empty register list, which is fine
        if not self.regs and self.args:
            return (None, "no register mapping")
        if len(self.regs) != len(self.args):
            return (None, "register/argument count mismatch")
        rc = classify(self.ret)
        if rc == "bptr":
            return (None, "returns BPTR")
        # A returned pointer is a 64-bit HOST address. There is no 32-bit
        # register to put it in, and truncating one is how a guest gets handed
        # a pointer that dereferences to nothing. This includes STRPTR: a
        # returned string is as unrepresentable as a returned struct.
        if rc in ("struct", "aptr", "other", "string"):
            return (None, "returns a pointer (%s)" % norm(self.ret))
        blockers = []
        for t, n in self.args:
            c = classify(t)
            if c == "bptr":
                blockers.append("BPTR %s" % n)
            elif c == "struct":
                blockers.append("%s" % norm(t))
            elif c == "aptr":
                blockers.append("APTR %s" % n)
            elif c == "other":
                blockers.append("%s %s" % (norm(t), n))
        if not blockers:
            return (1, None)

        # TIER 2a: the only thing standing in the way is a BPTR, and a BPTR
        # already has a mechanism - the handle table that maps a guest token to
        # the native pointer it stands for. So these are derivable too, and the
        # 25 dos vectors in this shape do not need writing out one at a time.
        if all(b.startswith("BPTR") for b in blockers) and \
           classify(self.ret) in ("scalar", "widen", "void", "bptr") and \
           lib is not None and (lib, self.name) not in DENY_2A:
            return (2, None)

        return (None, ", ".join(sorted(set(blockers))))


# The first vector the functionlist describes, exactly as genmodule derives it
# (tools/genmodule/config.c): by module type, except that a library declaring
# `noresident` spells out the four standard vectors itself and so starts at 1.
FIRSTLVO_BY_MODTYPE = {
    "handler": 1, "resource": 1,
    "library": 5, "usbclass": 5, "hidd": 5, "class": 5, "gadget": 5, "image": 5,
    "datatype": 6, "mcc": 6, "mui": 6, "mcp": 6,
    "device": 7,
}


def first_lvo(lines):
    modtype, options = "library", ""
    inconf = False
    for line in lines:
        if line.startswith("##begin config"):
            inconf = True
            continue
        if line.startswith("##end config"):
            break
        if not inconf:
            continue
        s = line.split("#")[0].strip()
        if s.startswith("modtype"):
            modtype = s.split(None, 1)[1].strip().lower() if len(s.split()) > 1 else modtype
        elif s.startswith("options"):
            options += " " + s
    lvo = FIRSTLVO_BY_MODTYPE.get(modtype, 5)
    if "noresident" in options:
        lvo = 1
    return lvo


def parse_conf(path):
    inlist = False
    try:
        lines = open(path, encoding="utf-8", errors="replace").read().splitlines()
    except OSError:
        return None
    funcs = []
    lvo = first_lvo(lines) - 1
    last = None
    for raw in lines:
        line = raw.rstrip()
        if line.startswith("##begin functionlist"):
            inlist = True
            continue
        if line.startswith("##end functionlist"):
            break
        if not inlist:
            continue
        # genmodule treats an empty line *inside* a functionlist as a reserved
        # vector slot (config.c:readsectionfunctionlist).  locale.library uses
        # exactly this after `.version 39` to leave LVO 5 to the OpenCatalog()
        # stack-call veneer, so discarding blank lines shifts every real entry.
        if not line.strip():
            lvo += 1
            last = None
            continue
        # strip trailing comment, but not a `#` inside the prototype
        s = line.split("#")[0].strip() if not line.lstrip().startswith("#") else ""
        if not s:
            continue
        if s.startswith("."):
            d = s[1:].split()
            if d[0] == "skip":
                lvo += int(d[1]) if len(d) > 1 else 1
                last = None
            elif d[0] == "private":
                if last is not None:
                    last.private = True
            elif d[0] == "novararg":
                if last is not None:
                    last.novararg = True
            # .version, .function, .alias and friends do not consume a vector
            continue
        m = FUNC_RE.match(s)
        if not m:
            last = None
            continue
        ret, name, argstr, regstr = m.groups()
        lvo += 1
        args = []
        ok = True
        for a in split_args(argstr):
            tn = arg_type_and_name(a)
            if tn is None:
                continue
            if tn[0] == "__fnptr":
                ok = False
            args.append(tn)
        regs = [r.strip() for r in regstr.split(",") if r.strip()]
        f = Func(lvo, ret if ret.strip() else "void", name, args, regs)
        if not ok:
            f.args.append(("__fnptr", "fn"))
        funcs.append(f)
        last = f
    return funcs


# ---------------------------------------------------------------------------
# implementation-source evidence
# ---------------------------------------------------------------------------

# The .conf prototype is the ABI authority, but intentionally says nothing
# about the meaning of an APTR or TagItem payload.  The implementation often
# does: GetTagData/FindTagItem name accepted tags, casts name pointer payloads,
# field accesses show which structures are read, and Alloc/Free pairs expose
# ownership.  Keep this pass evidence-producing rather than silently rewriting
# policy: only facts with an explicit source location should ever graduate into
# the fail-closed bridge policy.

SOURCE_FUNC_RE = (r"\bAROS_LH\d+[A-Z]*\s*\(\s*[^,]+,\s*%s\s*,")
TAG_CALL_RE = re.compile(r"\b(GetTagData|FindTagItem)\s*\(")
TAG_MACRO_RE = re.compile(r"^[A-Z][A-Za-z0-9_]*$")
ALLOC_CALL_RE = re.compile(r"\b(Alloc(?:Mem|Vec|Pooled|DosObject|AslRequest)|"
                           r"Create(?:Pool|MsgPort|IORequest)|NewObjectA?)\s*\(")
FREE_CALL_RE = re.compile(r"\b(Free(?:Mem|Vec|Pooled|DosObject|AslRequest)|"
                          r"Delete(?:Pool|MsgPort|IORequest)|DisposeObject|"
                          r"Close[A-Za-z0-9_]*)\s*\(")
CALLBACK_SOURCE_RE = re.compile(
    r"\b(CallHookPkt|CALLHOOKPKT|AROS_UFC\d*|HookEntry|h_Entry|cl_Dispatcher)\b")
TAG_DATA_CAST_RE = re.compile(
    r"\(\s*((?:const\s+)?(?:struct\s+)?[A-Za-z_]\w*"
    r"(?:\s+[A-Za-z_]\w*)?\s*\*?)\s*\)\s*\(?\s*"
    r"(?:[A-Za-z_]\w*\s*->\s*ti_Data|tidata)\b")
C_TYPE_TOKEN_RE = (r"(?:const\s+)?(?:struct\s+)?[A-Za-z_]\w*"
                   r"(?:\s+[A-Za-z_]\w*)?\s*\**")


def mask_c_comments(src):
    """Replace comments with spaces while preserving byte offsets/newlines.

    Evidence line numbers then still refer to the original source, and regexes
    cannot mistake an autodoc example or commented-out implementation for code.
    String and character literals are retained because a string default is
    useful evidence that a tag payload is a C string.
    """
    out = list(src)
    i, state = 0, "code"
    while i < len(src):
        ch = src[i]
        nxt = src[i + 1] if i + 1 < len(src) else ""
        if state == "code":
            if ch == "/" and nxt == "*":
                out[i] = out[i + 1] = " "
                i += 2
                state = "block"
                continue
            if ch == "/" and nxt == "/":
                out[i] = out[i + 1] = " "
                i += 2
                state = "line"
                continue
            if ch == '"':
                state = "string"
            elif ch == "'":
                state = "char"
        elif state == "block":
            if ch == "*" and nxt == "/":
                out[i] = out[i + 1] = " "
                i += 2
                state = "code"
                continue
            if ch != "\n":
                out[i] = " "
        elif state == "line":
            if ch == "\n":
                state = "code"
            else:
                out[i] = " "
        elif state in ("string", "char"):
            quote = '"' if state == "string" else "'"
            if ch == "\\":
                i += 2
                continue
            if ch == quote:
                state = "code"
        i += 1
    return "".join(out)


def call_arguments(src, opening):
    """Return the top-level arguments and closing offset for a C call."""
    if opening >= len(src) or src[opening] != "(":
        return ([], opening)
    args, start, depth = [], opening + 1, 1
    i, state = opening + 1, "code"
    while i < len(src):
        ch = src[i]
        if state == "code":
            if ch == '"':
                state = "string"
            elif ch == "'":
                state = "char"
            elif ch == "(":
                depth += 1
            elif ch == ")":
                depth -= 1
                if depth == 0:
                    args.append(src[start:i].strip())
                    return (args, i + 1)
            elif ch == "," and depth == 1:
                args.append(src[start:i].strip())
                start = i + 1
        elif state in ("string", "char"):
            quote = '"' if state == "string" else "'"
            if ch == "\\":
                i += 2
                continue
            if ch == quote:
                state = "code"
        i += 1
    return ([], opening)


def source_cast_before(src, offset):
    """The result cast immediately preceding a GetTagData call, if any."""
    prefix = src[max(0, offset - 96):offset]
    m = re.search(r"\(\s*((?:const\s+)?(?:struct\s+)?[A-Za-z_]\w*"
                  r"(?:\s+[A-Za-z_]\w*)?\s*\*?)\s*\)\s*$", prefix)
    return norm(m.group(1)) if m else None


def infer_source_tag_kind(access, cast, default):
    """Classify only what the implementation spells out; retain ambiguity."""
    if access == "FindTagItem":
        return ("unknown", "medium")
    c = object_canon(cast) if cast else ""
    if c:
        if c in ("STRPTR", "CONST_STRPTR", "char *", "const char *", "TEXT *"):
            return ("cstr", "high")
        if "*" in c or c in ("APTR",):
            return ("pointer:" + c, "high")
    if re.search(r'(^|\W)"(?:[^"\\]|\\.)*"', default or ""):
        return ("cstr", "high")
    if re.search(r"\bNULL\b", default or ""):
        return ("pointer:unknown", "medium")
    # An uncast GetTagData result is IPTR-sized and a literal default does not
    # distinguish an integer from a pointer encoded as zero.  Calling it u32
    # here would make pointer-valued tags unsafe.  A later AST use-site pass may
    # promote this evidence after proving arithmetic/boolean-only use.
    return ("unknown", "medium")


def extract_tag_evidence(raw, base_line):
    """Return source-located tag-domain evidence from one function body."""
    code = mask_c_comments(raw)
    tags = []
    for m in TAG_CALL_RE.finditer(code):
        opening = code.find("(", m.start())
        args, _end = call_arguments(code, opening)
        if not args:
            continue
        tag = args[0].strip()
        if not TAG_MACRO_RE.fullmatch(tag):
            continue
        default = args[1].strip() if len(args) > 1 else ""
        list_expression = ""
        if m.group(1) == "GetTagData" and len(args) > 2:
            list_expression = args[2].strip()
        elif m.group(1) == "FindTagItem" and len(args) > 1:
            list_expression = args[1].strip()
        cast = source_cast_before(code, m.start())
        kind, confidence = infer_source_tag_kind(m.group(1), cast, default)
        tags.append({
            "name": tag,
            "access": m.group(1),
            "kind": kind,
            "confidence": confidence,
            "line": base_line + code.count("\n", 0, m.start()),
            "cast": cast,
            "default": re.sub(r"\s+", " ", default)[:120],
            "list_expression": re.sub(r"\s+", " ", list_expression)[:120],
            "list_parameters": sorted(set(re.findall(
                r"\b[A-Za-z_]\w*\b", list_expression)))
        })

    # A NextTagItem loop generally dispatches on ti_Tag.  These cases are
    # valid domain evidence but payload typing needs data-flow, so keep them
    # distinct and low confidence rather than pretending every case is u32.
    if "NextTagItem" in code:
        for m in re.finditer(r"\bcase\s+([A-Z][A-Za-z0-9_]*)\s*:", code):
            tag = m.group(1)
            if tag.endswith("_KIND"):
                continue
            if not (tag.startswith(("GA_", "GTM", "GTC", "GTS", "GTLV_", "GT_",
                                    "PGA_", "STRINGA_", "MX_", "CYCLE_"))):
                continue
            tags.append({
                "name": tag, "access": "NextTagItem/case", "kind": "unknown",
                "confidence": "low",
                "line": base_line + code.count("\n", 0, m.start()),
                "cast": None, "default": "", "list_expression": "",
                "list_parameters": []
            })

    # Deduplicate repeated reads but preserve the strongest evidence and first
    # source location.  A cast beats a NULL-derived pointer: high > medium > low.
    strength = {"low": 0, "medium": 1, "high": 2}
    tag_by_key = {}
    for tag in tags:
        key = (tag["name"], tag["access"])
        old = tag_by_key.get(key)
        if not old or strength[tag["confidence"]] > strength[old["confidence"]]:
            tag_by_key[key] = tag
    return sorted(tag_by_key.values(), key=lambda x: (x["name"], x["line"]))


def explicit_cast_kind(cast):
    canonical = object_canon(re.sub(r"\b(?:extern|static|register|volatile)\b", "", cast))
    canonical = norm(canonical)
    if canonical in ("STRPTR", "CONST_STRPTR", "char *", "const char *", "TEXT *"):
        return "cstr"
    if classify(canonical) == "string":
        return "cstr"
    if "*" in canonical or canonical in ("APTR", "CONST_APTR"):
        return "pointer:" + canonical
    if classify(canonical) == "scalar":
        return "u32"
    return None


def declaration_type_index(code):
    found = {}
    pattern = re.compile(r"\b(%s)\s*([A-Za-z_]\w*)\s*(\[[^\]]*\])?\s*(?=[=;,])" %
                         C_TYPE_TOKEN_RE)
    for match in pattern.finditer(code):
        declared = norm(match.group(1)) + (" *" if match.group(3) else "")
        found.setdefault(match.group(2), set()).add(norm(declared))
    return found


def declared_type_before(code, name, offset):
    pattern = re.compile(r"\b(%s)\s*%s\s*(\[[^\]]*\])?\s*(?=[=;,])" %
                         (C_TYPE_TOKEN_RE, re.escape(name)))
    matches = list(pattern.finditer(code, 0, offset))
    if not matches:
        return None
    return norm(matches[-1].group(1) + (" *" if matches[-1].group(2) else ""))


def declared_array_before(code, name, offset):
    pattern = re.compile(r"\b(%s)\s*%s\s*(\[[^\]]*\])\s*(?=[=;,])" %
                         (C_TYPE_TOKEN_RE, re.escape(name)))
    return bool(list(pattern.finditer(code, 0, offset)))


def extract_library_tag_evidence(sources, evidence_scope="library"):
    """Find type-bearing uses of tags anywhere in a library implementation.

    A public wrapper often forwards an IPTR unchanged to a BOOPSI class, so the
    wrapper alone cannot reveal its representation.  The class switch that
    consumes the same named tag can: `(struct Hook *)tidata`, for example, is
    explicit high-confidence evidence even though the call is not a normal C
    edge reachable from the public vector.
    """
    found = []
    field_types = {}
    for _path, raw in sources:
        for name, types in declaration_type_index(mask_c_comments(raw)).items():
            field_types.setdefault(name, set()).update(types)

    def add_case(tag, kind, cast, path, code, offset, access):
        found.append({
            "name": tag, "access": access, "kind": kind,
            "confidence": "high", "line": 1 + code.count("\n", 0, offset),
            "cast": cast, "default": "", "list_expression": "",
            "list_parameters": [], "source": os.path.relpath(path, AROS),
            "evidence_scope": evidence_scope
        })

    for path, raw in sources:
        code = mask_c_comments(raw)
        # Include explicit casts on direct GetTagData uses throughout the
        # library, including class implementations reached through dispatch.
        for item in extract_tag_evidence(raw, 1):
            if item.get("confidence") == "high":
                found.append(dict(item, source=os.path.relpath(path, AROS),
                                  evidence_scope=evidence_scope))
        for call in TAG_CALL_RE.finditer(code):
            # FindTagItem returns the TagItem itself, so the receiving variable's
            # type says nothing about ti_Data.  Only GetTagData returns payload.
            if call.group(1) != "GetTagData":
                continue
            opening = code.find("(", call.start())
            args, _after = call_arguments(code, opening)
            if not args or not TAG_MACRO_RE.fullmatch(args[0].strip()):
                continue
            tag = args[0].strip()
            prefix = code[max(0, call.start() - 192):call.start()]
            member = re.search(
                r"\b[A-Za-z_]\w*\s*->\s*([A-Za-z_]\w*)\s*=\s*"
                r"(?:\([^;=]+\)\s*)?$", prefix)
            if member:
                types = field_types.get(member.group(1), set())
                kinds = {explicit_cast_kind(t) for t in types}
                kinds.discard(None)
                if len(kinds) == 1 and types and all(explicit_cast_kind(t) for t in types):
                    add_case(tag, next(iter(kinds)), " | ".join(sorted(types)),
                             path, code, call.start(), "gettag-field-type")
            local = re.search(r"\b([A-Za-z_]\w*)\s*=\s*(?:\([^;=]+\)\s*)?$", prefix)
            if local and not member:
                target_type = declared_type_before(code, local.group(1), call.start())
                kind = explicit_cast_kind(target_type) if target_type else None
                if kind:
                    add_case(tag, kind, target_type, path, code, call.start(),
                             "gettag-local-target-type")
        cases = list(re.finditer(r"\bcase\s+([A-Z][A-Za-z0-9_]*)\s*:", code))
        for i, match in enumerate(cases):
            tag = match.group(1)
            if not TAG_MACRO_RE.fullmatch(tag):
                continue
            stop = cases[i + 1].start() if i + 1 < len(cases) else min(
                len(code), match.end() + 4096)
            block = code[match.end():stop]
            for cast_match in TAG_DATA_CAST_RE.finditer(block):
                cast = norm(cast_match.group(1))
                kind = explicit_cast_kind(cast)
                if not kind:
                    continue
                add_case(tag, kind, cast, path, code,
                         match.end() + cast_match.start(), "case-payload-cast")

            # A narrow/scalar local receiving ti_Data before the switch proves
            # scalar use for all of that switch's cases.  IPTR is intentionally
            # excluded because it is also the native carrier for pointers.
            if re.search(r"\btidata\b", block):
                target_type = declared_type_before(code, "tidata", match.start())
                kind = explicit_cast_kind(target_type) if target_type else None
                if kind:
                    add_case(tag, kind, target_type, path, code, match.start(),
                             "case-local-type")

            # Resolve `data->field = tidata` through declarations of that field.
            # Accept only when every declaration with that name yields the same
            # representation; ambiguous names remain unresolved.
            member_assign = re.compile(
                r"\b[A-Za-z_]\w*\s*->\s*([A-Za-z_]\w*)\s*=\s*"
                r"(?:\([^;=]+\)\s*)?(?:[A-Za-z_]\w*\s*->\s*ti_Data|tidata)\b")
            for assignment in member_assign.finditer(block):
                types = field_types.get(assignment.group(1), set())
                kinds = {explicit_cast_kind(t) for t in types}
                kinds.discard(None)
                if len(kinds) == 1 and types and all(explicit_cast_kind(t) for t in types):
                    add_case(tag, next(iter(kinds)), " | ".join(sorted(types)),
                             path, code, match.end() + assignment.start(),
                             "case-field-type")

            # Likewise for a named local target whose closest preceding
            # declaration gives it a concrete scalar or pointer type.
            local_assign = re.compile(
                r"\b([A-Za-z_]\w*)\s*=\s*(?:\([^;=]+\)\s*)?"
                r"(?:[A-Za-z_]\w*\s*->\s*ti_Data|tidata)\b")
            for assignment in local_assign.finditer(block):
                name = assignment.group(1)
                target_type = declared_type_before(code, name, match.start())
                kind = explicit_cast_kind(target_type) if target_type else None
                if kind:
                    add_case(tag, kind, target_type, path, code,
                             match.end() + assignment.start(), "case-local-target-type")
    unique = {}
    for item in found:
        key = (item["name"], item["kind"], item["source"], item["line"],
               item["access"])
        unique[key] = item
    return sorted(unique.values(), key=lambda x: (x["name"], x["source"], x["line"]))


def source_tree_tag_evidence(tag_names, existing_paths):
    """Corroborate forwarded tags from their consumers elsewhere in AROS."""
    names = sorted(set(tag_names))
    if not names:
        return [], []
    pattern = r"\b(?:%s)\b" % "|".join(re.escape(name) for name in names)
    try:
        proc = subprocess.run(
            ["rg", "-l", "--glob", "*.c", "--glob", "*.h", "-e", pattern, AROS],
            stdout=subprocess.PIPE, stderr=subprocess.PIPE,
            encoding="utf-8", errors="replace", timeout=30)
    except (OSError, subprocess.TimeoutExpired):
        return [], []
    paths = sorted(set(line for line in proc.stdout.splitlines()
                       if line and line not in existing_paths))
    # A tag prefix accidentally matching a generated/vendor forest must not
    # turn one import into an unbounded whole-tree analysis.
    paths = paths[:512]
    sources = []
    for path in paths:
        try:
            sources.append((path, open(path, encoding="utf-8", errors="replace").read()))
        except OSError:
            pass
    wanted = set(names)
    evidence = extract_library_tag_evidence(sources, evidence_scope="source-tree")
    annotated = []
    annotation = re.compile(
        r"/\*(.*?)\*/\s*#\s*define\s+([A-Za-z_]\w*)\s+([^\r\n]+)", re.S)
    for path, raw in sources:
        for match in annotation.finditer(raw):
            lhs, replacement = match.group(2), match.group(3)
            aliases = wanted.intersection(re.findall(r"\b[A-Za-z_]\w*\b", replacement))
            tag = lhs if lhs in wanted else (next(iter(aliases)) if len(aliases) == 1 else None)
            if not tag:
                continue
            declared, kind = None, None
            for type_match in re.finditer(r"\(\s*([^()]{1,80}?)\s*\)", match.group(1)):
                candidate = norm(type_match.group(1))
                inferred = explicit_cast_kind(candidate)
                if inferred:
                    declared, kind = candidate, inferred
                    break
            if not kind:
                continue
            annotated.append({
                "name": tag, "access": "header-type-annotation", "kind": kind,
                "confidence": "high", "line": 1 + raw.count("\n", 0, match.start()),
                "cast": declared, "default": "", "list_expression": "",
                "list_parameters": [], "source": os.path.relpath(path, AROS),
                "evidence_scope": "source-tree"
            })
    evidence.extend(annotated)
    unique = {}
    for item in evidence:
        key = (item["name"], item["kind"], item["source"], item["line"], item["access"])
        unique[key] = item
    result = sorted((item for item in unique.values() if item["name"] in wanted),
                    key=lambda x: (x["name"], x["source"], x["line"]))
    return result, sources


def expression_kind(expr, code, offset):
    """Infer a tag value's representation from an explicit client expression."""
    expr = expr.strip()
    if re.search(r'(^|\W)"(?:[^"\\]|\\.)*"', expr):
        return "cstr", "string-literal"
    stripped = re.sub(r"^\s*\(\s*(?:IPTR|SIPTR|ULONG)\s*\)\s*", "", expr)
    if stripped in ("TRUE", "FALSE"):
        return "u32", "scalar-literal"
    if re.fullmatch(r"(?:[-+]?\d+[uUlL]*|0x[0-9A-Fa-f]+[uUlL]*)", stripped):
        numeric = re.sub(r"[uUlL]+$", "", stripped)
        try:
            if int(numeric, 0) != 0:
                return "u32", "nonzero-scalar-literal"
        except ValueError:
            pass
    cast = re.match(r"^\s*\(\s*(%s)\s*\)" % C_TYPE_TOKEN_RE, expr)
    if cast:
        kind = explicit_cast_kind(norm(cast.group(1)))
        if kind:
            return kind, "explicit-cast"
    address = re.fullmatch(
        r"\s*(?:\(\s*IPTR\s*\)\s*)?&\s*([A-Za-z_]\w*)\s*", expr)
    if address:
        declared = declared_type_before(code, address.group(1), offset)
        if declared:
            if declared_array_before(code, address.group(1), offset):
                kind = explicit_cast_kind(declared)
                if kind:
                    return kind, "address-of-array"
            return "pointer:" + object_canon(declared + " *"), "address-of-typed-value"
    value = re.fullmatch(
        r"\s*(?:\(\s*IPTR\s*\)\s*)?([A-Za-z_]\w*)\s*", expr)
    if value:
        declared = declared_type_before(code, value.group(1), offset)
        kind = explicit_cast_kind(declared) if declared else None
        if kind:
            return kind, "declared-value-type"
    return None, None


def function_callsite_tag_evidence(f, evidence, sources):
    """Type variadic tag/value pairs for this exact public API veneer."""
    if f.novararg or not f.name.endswith("A"):
        return []
    tag_args = tag_arguments_for(evidence)
    if len(tag_args) != 1:
        return []
    tag_arg = tag_args[0]
    arg_names = [name for _type, name in f.args]
    try:
        fixed = arg_names.index(tag_arg)
    except ValueError:
        return []
    veneer = f.name[:-1]
    found = []
    for path, raw in sources:
        code = mask_c_comments(raw)
        for call in re.finditer(r"\b%s\s*\(" % re.escape(veneer), code):
            opening = code.find("(", call.start())
            args, _after = call_arguments(code, opening)
            if len(args) <= fixed:
                continue
            pairs = args[fixed:]
            for index in range(0, len(pairs) - 1, 2):
                tag = pairs[index].strip()
                if tag in ("TAG_DONE", "TAG_END"):
                    break
                if not TAG_MACRO_RE.fullmatch(tag) or tag.startswith("TAG_"):
                    continue
                kind, reason = expression_kind(pairs[index + 1], code, call.start())
                if not kind:
                    continue
                found.append({
                    "name": tag, "access": "typed-vararg-callsite", "kind": kind,
                    "confidence": "high", "line": 1 + code.count("\n", 0, call.start()),
                    "cast": reason, "default": "", "list_expression": veneer,
                    "list_parameters": [], "source": os.path.relpath(path, AROS),
                    "evidence_scope": "api-callsite", "api": f.name
                })
    unique = {}
    for item in found:
        key = (item["name"], item["kind"], item["source"], item["line"])
        unique[key] = item
    return sorted(unique.values(), key=lambda x: (x["name"], x["source"], x["line"]))


def source_function_chunk(src, name):
    """Find an AROS public function and the source through its closing marker."""
    m = re.search(SOURCE_FUNC_RE % re.escape(name), src, re.S)
    if not m:
        return None
    end = re.search(r"\}\s*/\*\s*%s\s*\*/" % re.escape(name), src[m.end():])
    if end:
        stop = m.end() + end.end()
    else:
        # Most AROS functions carry the marker.  Falling back to the next
        # public macro is conservative: it cannot blend two functions.
        nxt = re.search(r"\bAROS_LH\d+[A-Z]*\s*\(", src[m.end():])
        stop = m.end() + (nxt.start() if nxt else len(src) - m.end())
    return (m.start(), src[m.start():stop])


def generic_function_chunk(src, name):
    """Find a normal C function definition, excluding calls and prototypes."""
    code = mask_c_comments(src)
    for m in re.finditer(r"\b%s\s*\(" % re.escape(name), code):
        opening = code.find("(", m.start())
        _args, after = call_arguments(code, opening)
        if after == opening:
            continue
        # Attributes and old-style declaration details may sit between the
        # closing parenthesis and body.  A semicolon/assignment/comma proves
        # this occurrence is not the definition we want.
        brace = code.find("{", after, min(len(code), after + 512))
        if brace < 0 or re.search(r"[;=,]", code[after:brace]):
            continue
        depth, i, state = 1, brace + 1, "code"
        while i < len(code) and depth:
            ch = code[i]
            if state == "code":
                if ch == '"':
                    state = "string"
                elif ch == "'":
                    state = "char"
                elif ch == "{":
                    depth += 1
                elif ch == "}":
                    depth -= 1
            elif state in ("string", "char"):
                quote = '"' if state == "string" else "'"
                if ch == "\\":
                    i += 2
                    continue
                if ch == quote:
                    state = "code"
            i += 1
        if depth == 0:
            return (m.start(), src[m.start():i])
    return None


def source_files_for_target(rel):
    root = os.path.dirname(os.path.join(AROS, rel))
    files = []
    for walk_root, dirs, names in os.walk(root):
        dirs[:] = [d for d in dirs if d not in (".git", "bin", "obj")]
        for name in names:
            if name.endswith((".c", ".h")):
                files.append(os.path.join(walk_root, name))
    return root, sorted(files)


def analyze_function_source(lib, rel, f, sources):
    found = None
    for path, src in sources:
        chunk = source_function_chunk(src, f.name)
        if chunk:
            found = (path, src, chunk[0], chunk[1])
            break
    if not found:
        return {
            "name": f.name, "lvo": f.lvo, "offset": f.offset,
            "source": None, "policy": policy_key(lib, f) in POLICY.get("functions", {}),
            "tags": [], "arguments": {}, "memory": {}, "callbacks": []
        }

    path, whole, start, raw = found
    code = mask_c_comments(raw)
    base_line = whole.count("\n", 0, start) + 1
    tags = extract_tag_evidence(raw, base_line)

    arguments = {}
    for atype, aname in f.args:
        ev = {}
        fields = sorted(set(re.findall(r"\b%s\s*->\s*([A-Za-z_]\w*)" %
                                       re.escape(aname), code)))
        if fields:
            ev["dereferenced_fields"] = fields
        casts = sorted(set(norm(x) for x in re.findall(
            r"\(\s*((?:const\s+)?(?:struct\s+)?[A-Za-z_]\w*"
            r"(?:\s+[A-Za-z_]\w*)?\s*\*)\s*\)\s*%s\b" % re.escape(aname), code)))
        if casts:
            ev["concrete_casts"] = casts
        retained = sorted(set(re.findall(
            r"(?:->|\.)\s*([A-Za-z_]\w*)\s*=\s*(?:\([^;=]+\)\s*)?%s\b" %
            re.escape(aname), code)))
        if retained:
            ev["stored_in_fields"] = retained
        if ev:
            ev["declared_type"] = norm(atype)
            arguments[aname] = ev

    allocs = sorted(set(m.group(1) for m in ALLOC_CALL_RE.finditer(code)))
    frees = sorted(set(m.group(1) for m in FREE_CALL_RE.finditer(code)))
    callbacks = sorted(set(m.group(1) for m in CALLBACK_SOURCE_RE.finditer(code)))
    return {
        "name": f.name,
        "lvo": f.lvo,
        "offset": f.offset,
        "signature": {
            "result": norm(f.ret),
            "arguments": [{"type": norm(t), "name": n, "register": r}
                          for (t, n), r in zip(f.args, f.regs)]
        },
        "source": os.path.relpath(path, AROS),
        "line": base_line,
        "policy": policy_key(lib, f) in POLICY.get("functions", {}),
        "tags": tags,
        "arguments": arguments,
        "memory": {"allocators": allocs, "releasers": frees},
        "callbacks": callbacks,
        "_raw": raw
    }


def ownership_candidates(functions, evidence):
    """Pair pointer-producing allocators with source-correlated releasers."""
    byname = {f.name: f for f in functions}
    evname = {e["name"]: e for e in evidence}
    out = []
    release_prefixes = ("Free", "Close", "Dispose", "Delete")

    def noun(name):
        name = re.sub(r"A$", "", name)
        return re.sub(r"^(?:Get|Create|Alloc|Open|New|Free|Close|Dispose|Delete)", "", name)

    for producer in functions:
        pe = evname.get(producer.name, {})
        memory = pe.get("memory", {})
        if not (memory.get("allocators") or memory.get("reachable_allocators")):
            continue
        if classify(producer.ret) not in ("struct", "aptr", "string"):
            continue
        for consumer in functions:
            if not consumer.name.startswith(release_prefixes) or len(consumer.args) != 1:
                continue
            same_type = object_canon(producer.ret) == object_canon(consumer.args[0][0])
            same_noun = noun(producer.name) == noun(consumer.name)
            ce = evname.get(consumer.name, {})
            cross_ref = (consumer.name in pe.get("_raw", "") or
                         producer.name in ce.get("_raw", ""))
            if not same_type and not same_noun and not cross_ref:
                continue
            confidence = "high" if cross_ref and (same_type or same_noun) else "medium"
            out.append({
                "producer": producer.name,
                "consumer": consumer.name,
                "type": norm(producer.ret),
                "confidence": confidence,
                "evidence": sorted(set(
                    (["matching-type"] if same_type else []) +
                    (["matching-api-noun"] if same_noun else []) +
                    (["source-cross-reference"] if cross_ref else [])))
            })
    return sorted(out, key=lambda x: (x["producer"], x["consumer"]))


def conf_basename(path):
    """The basename is the prefix genmodule puts on expanded AROS_LH symbols."""
    try:
        src = open(path, encoding="utf-8", errors="replace").read()
    except OSError:
        return None
    m = re.search(r"^basename\s+([A-Za-z_]\w*)\s*$", src, re.M)
    return m.group(1) if m else None


def ast_compile_config(rel, short):
    """Reproduce the target compiler inputs used by a generated library.

    AROS' cross clang already carries the aarch64-unknown-aros triple.  Its
    configured sysroot can outlive a scratch build, so always point it at the
    current build explicitly.  genmodule's per-library forced include is what
    gives AROS_LH macros their concrete base/symbol definitions.
    """
    source_root = os.path.dirname(os.path.join(AROS, rel))
    mirror = os.path.join(AROS_BUILD, os.path.dirname(rel))
    objdir = os.path.join(AROS_BUILD, "bin", "darwin-aarch64", "gen",
                          os.path.dirname(rel), short)
    sysroot = os.path.join(AROS_BUILD, "bin", "darwin-aarch64", "AROS",
                           "Developer")
    forced = os.path.join(objdir, "include", "%s_deflibdefs.h" % short)
    args = [
        AROS_CC,
        "--sysroot", sysroot,
        "-iquote", source_root,
        "-iquote", mirror,
        "-I", os.path.join(objdir, "include"),
    ]
    if os.path.exists(forced):
        args += ["-include", forced]
    args += [
        "-DAROS_BUILD_TYPE=AROS_BUILD_TYPE_PERSONAL",
        "-DUSE_EXEC_DEBUG", "-D__NOLIBBASE__", "-D__arm64__",
        "-Wno-everything", "-fsyntax-only"
    ]
    return {
        "compiler": AROS_CC,
        "sysroot": sysroot,
        "source_root": source_root,
        "object_dir": objdir,
        "forced_include": forced if os.path.exists(forced) else None,
        "arguments": args
    }


def signature_record_name(ctype):
    if "*" not in ctype:
        return None
    base = re.sub(r"\b(?:const|CONST|volatile)\b", "", norm(ctype))
    base = re.sub(r"\s*\*+\s*$", "", base).strip()
    if base.startswith("struct "):
        return base.split(None, 1)[1]
    return None


def discover_record_headers(type_names, config):
    include = os.path.join(config["sysroot"], "include")
    headers = []
    for name in sorted(set(type_names)):
        pattern = r"\bstruct\s+%s(?:32|64)?\b" % re.escape(name)
        try:
            proc = subprocess.run(
                ["rg", "-l", "-e", pattern, include], stdout=subprocess.PIPE,
                stderr=subprocess.PIPE, encoding="utf-8", errors="replace", timeout=10)
        except (OSError, subprocess.TimeoutExpired):
            continue
        candidates = []
        definition = re.compile(r"\bstruct\s+%s(?:32|64)?\s*\{" % re.escape(name), re.S)
        for path in proc.stdout.splitlines():
            if not path:
                continue
            try:
                raw = open(path, encoding="utf-8", errors="replace").read()
            except OSError:
                continue
            if definition.search(mask_c_comments(raw)):
                candidates.append(os.path.relpath(path, include))
        candidates.sort(key=lambda path: (path.count(os.sep), len(path), path))
        if candidates and candidates[0] not in headers:
            headers.append(candidates[0])
    return headers


def probe_record_layouts(funcs, config):
    types = set()
    for f in funcs:
        for ctype in [f.ret] + [t for t, _name in f.args]:
            name = signature_record_name(ctype)
            if name:
                types.add(name)
    if not types:
        return {"status": "ok", "headers": [], "types": {}}
    headers = discover_record_headers(types, config)
    cmd = [LAYOUT_TOOL, "--probe-json", ",".join(sorted(types))]
    for header in headers:
        cmd += ["--header", header]
    env = dict(os.environ)
    env["AROS_INC"] = os.path.join(config["sysroot"], "include")
    env["AROS_CLANG"] = config["compiler"]
    try:
        proc = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                              encoding="utf-8", errors="replace", timeout=60, env=env)
    except (OSError, subprocess.TimeoutExpired) as exc:
        return {"status": "error", "headers": headers, "types": {},
                "error": str(exc)}
    if proc.returncode != 0:
        return {"status": "error", "headers": headers, "types": {},
                "error": (proc.stderr + proc.stdout)[-4000:]}
    try:
        result = json.loads(proc.stdout)
    except ValueError as exc:
        return {"status": "error", "headers": headers, "types": {},
                "error": "invalid layout JSON: %s" % exc}
    return {"status": "ok", "headers": headers,
            "types": result.get("types", {})}


def ast_nodes(node):
    if not isinstance(node, dict):
        return
    yield node
    for child in node.get("inner", []):
        yield from ast_nodes(child)


def ast_referenced_parameters(node):
    out = set()
    for child in ast_nodes(node):
        if child.get("kind") != "DeclRefExpr":
            continue
        ref = child.get("referencedDecl", {})
        if ref.get("kind") == "ParmVarDecl" and ref.get("name"):
            out.add(ref["name"])
    return out


def ast_callee(call):
    """Return the direct function declaration used as a CallExpr callee."""
    inner = call.get("inner", [])
    if not inner:
        return None
    for node in ast_nodes(inner[0]):
        if node.get("kind") != "DeclRefExpr":
            continue
        ref = node.get("referencedDecl", {})
        if ref.get("kind") == "FunctionDecl":
            return ref.get("name")
    return None


def ast_line(node):
    """Best-effort spelling/expansion line from Clang JSON locations."""
    locs = [node.get("loc", {}), node.get("range", {}).get("begin", {})]
    for loc in locs:
        for key in (None, "expansionLoc", "spellingLoc"):
            part = loc if key is None else loc.get(key, {})
            if part.get("line"):
                return part["line"]
    return None


def summarize_ast(ast, symbol):
    calls, param_fields, param_casts, retained, indirect = [], {}, {}, {}, []
    for node in ast_nodes(ast):
        kind = node.get("kind")
        if kind == "CallExpr":
            callee = ast_callee(node)
            if callee:
                # Clang places the callee expression first and the actual C
                # arguments after it.  Recording which caller parameters feed
                # each position lets helper evidence flow back to a public ABI
                # parameter without guessing from variable names.
                arguments = node.get("inner", [])[1:]
                calls.append({
                    "name": callee,
                    "line": ast_line(node),
                    "argument_parameters": [
                        sorted(ast_referenced_parameters(arg)) for arg in arguments
                    ]
                })
            else:
                inner = node.get("inner", [])
                indirect.append({
                    "line": ast_line(node),
                    "callee_kind": inner[0].get("kind") if inner else None,
                    "type": inner[0].get("type", {}).get("qualType") if inner else None
                })
        elif kind == "MemberExpr" and node.get("name"):
            for param in ast_referenced_parameters(node):
                param_fields.setdefault(param, set()).add(node["name"])
        elif kind in ("CStyleCastExpr", "ImplicitCastExpr"):
            cast_type = node.get("type", {}).get("qualType")
            if cast_type:
                for param in ast_referenced_parameters(node):
                    param_casts.setdefault(param, set()).add(cast_type)
        elif kind in ("BinaryOperator", "CompoundAssignOperator") and node.get("opcode") == "=":
            children = node.get("inner", [])
            if len(children) >= 2:
                lhs_fields = [x.get("name") for x in ast_nodes(children[0])
                              if x.get("kind") == "MemberExpr" and x.get("name")]
                for param in ast_referenced_parameters(children[1]):
                    retained.setdefault(param, set()).update(lhs_fields)
    # Calls appear inside other calls' argument trees; each CallExpr itself is
    # still visited once, so de-duplicate identical source locations only.
    unique_calls = []
    seen = set()
    for call in calls:
        key = (call["name"], call["line"],
               tuple(tuple(x) for x in call["argument_parameters"]))
        if key not in seen:
            unique_calls.append(call)
            seen.add(key)
    parameters = []
    for child in ast.get("inner", []):
        if child.get("kind") == "ParmVarDecl":
            parameters.append({
                "name": child.get("name"),
                "type": child.get("type", {}).get("qualType")
            })
    return {
        "symbol": symbol,
        "parameters": parameters,
        "direct_calls": unique_calls,
        "parameter_fields": {k: sorted(v) for k, v in sorted(param_fields.items())},
        "parameter_casts": {k: sorted(v) for k, v in sorted(param_casts.items())},
        "retained_parameters": {k: sorted(v) for k, v in sorted(retained.items())},
        "indirect_calls": indirect
    }


def json_stream(text):
    """Decode Clang's one-or-more top-level AST JSON objects."""
    decoder, offset, values = json.JSONDecoder(), 0, []
    while offset < len(text):
        while offset < len(text) and text[offset].isspace():
            offset += 1
        if offset >= len(text):
            break
        value, offset = decoder.raw_decode(text, offset)
        values.append(value)
    return values


def ast_function_definition(values, symbol):
    """Select the requested definition, not a prototype matched by the filter."""
    candidates = []
    for value in values:
        for node in ast_nodes(value):
            if node.get("kind") != "FunctionDecl" or node.get("name") != symbol:
                continue
            if any(child.get("kind") == "CompoundStmt"
                   for child in node.get("inner", [])):
                candidates.append(node)
    return candidates[0] if candidates else None


def compile_named_ast(config, symbol, source):
    if not os.path.isfile(config["compiler"]):
        return {"status": "unavailable", "symbol": symbol,
                "error": "AROS cross compiler not found"}
    if not os.path.isdir(config["sysroot"]):
        return {"status": "unavailable", "symbol": symbol,
                "error": "AROS build sysroot not found"}
    cmd = config["arguments"] + [
        "-Xclang", "-ast-dump=json",
        "-Xclang", "-ast-dump-filter=%s" % symbol,
        source
    ]
    try:
        proc = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                              encoding="utf-8", errors="replace", timeout=30)
    except (OSError, subprocess.TimeoutExpired) as exc:
        return {"status": "error", "symbol": symbol, "error": str(exc)}
    if proc.returncode != 0:
        return {"status": "error", "symbol": symbol,
                "error": proc.stderr.strip()[-2000:]}
    try:
        values = json_stream(proc.stdout)
    except ValueError as exc:
        return {"status": "error", "symbol": symbol,
                "error": "invalid clang AST JSON: %s" % exc}
    ast = ast_function_definition(values, symbol)
    if not ast:
        return {"status": "error", "symbol": symbol,
                "error": "clang AST did not contain the function definition"}
    summary = summarize_ast(ast, symbol)
    summary["status"] = "ok"
    return summary


def compile_function_ast(config, basename, f, source):
    symbol = "%s_%d_%s" % (basename, f.lvo, f.name)
    return compile_named_ast(config, symbol, source)


def local_function_definition(sources, name, preferred=None):
    """Locate a helper definition, preferring the caller's translation unit."""
    ordered = sources
    if preferred:
        ordered = ([item for item in sources if item[0] == preferred] +
                   [item for item in sources if item[0] != preferred])
    for path, whole in ordered:
        chunk = generic_function_chunk(whole, name)
        if chunk:
            start, raw = chunk
            return {
                "name": name,
                "path": path,
                "source": os.path.relpath(path, AROS),
                "line": whole.count("\n", 0, start) + 1,
                "raw": raw
            }
    return None


def roots_for_call(call, caller_aliases):
    """Map each call argument position back to public-vector parameters."""
    roots = []
    for referenced in call.get("argument_parameters", []):
        origins = set()
        for name in referenced:
            origins.update(caller_aliases.get(name, set()))
        roots.append(origins)
    return roots


def helper_aliases(ast, argument_roots):
    params = ast.get("parameters", [])
    return {
        param.get("name"): set(argument_roots[i])
        for i, param in enumerate(params)
        if param.get("name") and i < len(argument_roots) and argument_roots[i]
    }


def analyze_reachable_helpers(evidence, config, sources, shared_cache=None,
                              definition_cache=None, max_helpers=128, max_depth=12):
    """Follow local direct calls and propagate their semantics to one vector.

    This is a bounded call-graph/data-flow pass, not name-based guesswork.  A
    helper parameter is associated with a public ABI argument only when Clang's
    AST shows that argument flowing into the corresponding call position.
    """
    public_ast = evidence.get("ast", {})
    if public_ast.get("status") != "ok" or not evidence.get("source"):
        return
    public_path = os.path.join(AROS, evidence["source"])
    public_aliases = {arg["name"]: {arg["name"]}
                      for arg in evidence.get("signature", {}).get("arguments", [])}
    cache = shared_cache if shared_cache is not None else {}
    definition_cache = definition_cache if definition_cache is not None else {}
    reports, queued_states = {}, set()
    queue = []
    for call in public_ast.get("direct_calls", []):
        queue.append((call, public_aliases,
                      [evidence["name"], call["name"]], public_path, 1))

    while queue and len(reports) < max_helpers:
        call, caller_aliases, path, caller_source, depth = queue.pop(0)
        if depth > max_depth:
            continue
        definition_key = (call["name"], caller_source)
        if definition_key not in definition_cache:
            definition_cache[definition_key] = local_function_definition(
                sources, call["name"], caller_source)
        definition = definition_cache[definition_key]
        if not definition:
            continue
        key = (definition["name"], definition["path"])
        if key not in cache:
            ast = compile_named_ast(config, definition["name"], definition["path"])
            item = dict(definition)
            item["ast"] = ast
            item["tags"] = extract_tag_evidence(item["raw"], item["line"])
            code = mask_c_comments(item["raw"])
            item["memory"] = {
                "allocators": sorted(set(m.group(1) for m in ALLOC_CALL_RE.finditer(code))),
                "releasers": sorted(set(m.group(1) for m in FREE_CALL_RE.finditer(code)))
            }
            item["callbacks"] = sorted(
                set(m.group(1) for m in CALLBACK_SOURCE_RE.finditer(code)))
            cache[key] = item
        item = cache[key]
        ast = item["ast"]
        if ast.get("status") != "ok":
            aliases = {}
        else:
            aliases = helper_aliases(ast, roots_for_call(call, caller_aliases))
        state = (key, tuple((name, tuple(sorted(values)))
                            for name, values in sorted(aliases.items())))
        if state in queued_states:
            continue
        queued_states.add(state)

        report = reports.get(key)
        if report is None:
            report = {
                "name": item["name"], "source": item["source"],
                "line": item["line"], "via": path,
                "root_argument_aliases": {}, "tags": item["tags"],
                "memory": item["memory"], "callbacks": item["callbacks"],
                "ast": ast
            }
            reports[key] = report
        elif len(path) < len(report["via"]):
            report["via"] = path
        for name, values in aliases.items():
            current = set(report["root_argument_aliases"].get(name, []))
            report["root_argument_aliases"][name] = sorted(current | values)

        if ast.get("status") == "ok":
            merged_aliases = {name: set(values) for name, values in
                              report["root_argument_aliases"].items()}
            for child in ast.get("direct_calls", []):
                queue.append((child, merged_aliases, path + [child["name"]],
                              item["path"], depth + 1))

    helpers = sorted(reports.values(), key=lambda x: (x["source"], x["line"], x["name"]))
    propagated_tags, propagated_callbacks = [], []
    propagated_arguments = {}
    reachable_allocators, reachable_releasers = set(), set()
    for helper in helpers:
        for tag in helper["tags"]:
            root_arguments = set()
            for local in tag.get("list_parameters", []):
                root_arguments.update(helper["root_argument_aliases"].get(local, []))
            propagated_tags.append(dict(
                tag, source=helper["source"], via=helper["via"],
                root_arguments=sorted(root_arguments)))
        reachable_allocators.update(helper["memory"]["allocators"])
        reachable_releasers.update(helper["memory"]["releasers"])
        for callback in helper["callbacks"]:
            propagated_callbacks.append({
                "name": callback, "helper": helper["name"],
                "source": helper["source"], "via": helper["via"]
            })
        ast = helper["ast"]
        if ast.get("status") != "ok":
            continue
        for indirect in ast.get("indirect_calls", []):
            propagated_callbacks.append({
                "name": "<indirect-call>", "helper": helper["name"],
                "source": helper["source"], "via": helper["via"],
                "line": indirect.get("line"), "type": indirect.get("type")
            })
        categories = (
            ("dereferenced_fields", ast.get("parameter_fields", {})),
            ("concrete_casts", ast.get("parameter_casts", {})),
            ("stored_in_fields", ast.get("retained_parameters", {})),
        )
        for local, roots in helper["root_argument_aliases"].items():
            for category, facts in categories:
                for fact in facts.get(local, []):
                    for root in roots:
                        propagated_arguments.setdefault(root, []).append({
                            "kind": category, "value": fact,
                            "helper": helper["name"], "source": helper["source"],
                            "via": helper["via"]
                        })
    for root, facts in propagated_arguments.items():
        unique = {}
        for fact in facts:
            key = (fact["kind"], fact["value"], fact["helper"], fact["source"])
            unique[key] = fact
        propagated_arguments[root] = sorted(
            unique.values(), key=lambda x: (x["kind"], x["value"], x["helper"]))
    tag_unique = {}
    for tag in propagated_tags:
        key = (tag["name"], tag["access"], tag["kind"], tag["source"], tag["line"])
        tag_unique[key] = tag
    evidence["reachable_helpers"] = helpers
    evidence["propagated_tags"] = sorted(
        tag_unique.values(), key=lambda x: (x["name"], x["source"], x["line"]))
    evidence["propagated_arguments"] = dict(sorted(propagated_arguments.items()))
    callback_unique = {}
    for callback in propagated_callbacks:
        key = (callback["name"], callback["helper"], callback.get("line"),
               callback.get("type"))
        callback_unique[key] = callback
    evidence["propagated_callbacks"] = sorted(
        callback_unique.values(),
        key=lambda x: (x["name"], x["source"], x.get("line") or 0))
    evidence["memory"]["reachable_allocators"] = sorted(reachable_allocators)
    evidence["memory"]["reachable_releasers"] = sorted(reachable_releasers)


def collect_source_reports(which):
    """Return evidence mined from AROS library implementations."""
    wanted = set(which)
    reports = []
    for lib, rel, _base, _btype, _hdr in analysis_targets(which):
        short = lib.split(".")[0]
        if wanted and short not in wanted and lib not in wanted:
            continue
        funcs = [f for f in (parse_conf(os.path.join(AROS, rel)) or []) if not f.private]
        basename = conf_basename(os.path.join(AROS, rel))
        ast_config = ast_compile_config(rel, short)
        record_layouts = probe_record_layouts(funcs, ast_config)
        root, paths = source_files_for_target(rel)
        sources = []
        for path in paths:
            try:
                sources.append((path, open(path, encoding="utf-8", errors="replace").read()))
            except OSError:
                pass
        evidence = [analyze_function_source(lib, rel, f, sources) for f in funcs]
        ast_ok = ast_errors = 0
        helper_cache, helper_definition_cache = {}, {}
        for f, e in zip(funcs, evidence):
            if not e.get("source") or not basename:
                continue
            source = os.path.join(AROS, e["source"])
            e["ast"] = compile_function_ast(ast_config, basename, f, source)
            if e["ast"].get("status") == "ok":
                ast_ok += 1
            else:
                ast_errors += 1
            analyze_reachable_helpers(e, ast_config, sources,
                                      helper_cache, helper_definition_cache)
        library_tags = extract_library_tag_evidence(sources)
        used_names = set()
        for e in evidence:
            used_names.update(tag["name"] for tag in e.get("tags", []))
            used_names.update(tag["name"] for tag in e.get("propagated_tags", []))
        source_tree_tags, source_tree_sources = source_tree_tag_evidence(
            used_names, {path for path, _raw in sources})
        corroborating_tags = library_tags + source_tree_tags
        callsite_tags = []
        for f, e in zip(funcs, evidence):
            function_names = {tag["name"] for tag in e.get("tags", [])}
            function_names.update(tag["name"] for tag in e.get("propagated_tags", []))
            function_callsites = function_callsite_tag_evidence(
                f, e, source_tree_sources)
            callsite_tags.extend(function_callsites)
            e["corroborating_tag_evidence"] = ([
                tag for tag in corroborating_tags if tag["name"] in function_names
            ] + function_callsites)
        pairs = ownership_candidates(funcs, evidence)
        for e in evidence:
            e.pop("_raw", None)
        reports.append({
            "library": lib,
            "conf": rel,
            "source_root": os.path.relpath(root, AROS),
            "analysis_backend": {
                "kind": "clang-ast+source-evidence",
                "compiler": ast_config["compiler"],
                "sysroot": ast_config["sysroot"],
                "forced_include": ast_config["forced_include"],
                "compiled_functions": ast_ok,
                "failed_functions": ast_errors
            },
            "record_layouts": record_layouts,
            "functions": evidence,
            "ownership_candidates": pairs,
            "library_tag_evidence": library_tags,
            "source_tree_tag_evidence": source_tree_tags,
            "callsite_tag_evidence": callsite_tags
        })
    if wanted and not reports:
        raise ValueError("no generated library matches: %s" %
                         ", ".join(sorted(wanted)))
    return reports


def analyze_sources(which):
    """Emit JSON evidence mined from AROS library implementations."""
    try:
        reports = collect_source_reports(which)
    except ValueError as exc:
        print(str(exc), file=sys.stderr)
        return 1
    print(json.dumps({"schema": 1, "libraries": reports}, indent=2, sort_keys=False))
    return 0


def sha256_file(path):
    digest = hashlib.sha256()
    try:
        with open(path, "rb") as fh:
            while True:
                block = fh.read(1024 * 1024)
                if not block:
                    break
                digest.update(block)
    except OSError:
        return None
    return digest.hexdigest()


def logical_path(path):
    """Stable, relocatable spelling for an importer input path."""
    path = os.path.abspath(path)
    roots = ((os.path.abspath(AROS), "AROS_SRC"),
             (os.path.abspath(AROS_BUILD), "AROS_BUILD"))
    for root, label in roots:
        try:
            if os.path.commonpath((root, path)) == root:
                return label + "/" + os.path.relpath(path, root)
        except ValueError:
            pass
    return path


def input_file(path, role):
    if not path or not os.path.isfile(path):
        return None
    return {"role": role, "path": logical_path(path), "sha256": sha256_file(path)}


def discover_public_headers(short, config):
    include = os.path.join(config["sysroot"], "include")
    candidates = [
        os.path.join(include, "libraries", short + ".h"),
        os.path.join(include, "proto", short + ".h"),
        os.path.join(include, "clib", short + "_protos.h"),
        os.path.join(include, "defines", short + ".h"),
        os.path.join(include, "inline", short + ".h"),
        os.path.join(include, "inline", short + "_protos.h"),
        os.path.join(include, "pragmas", short + "_pragmas.h"),
        os.path.join(GENINC, "proto", short + ".h"),
    ]
    records = [input_file(path, "public-header") for path in candidates]
    return sorted((x for x in records if x), key=lambda x: x["path"])


def compiler_identity(config):
    try:
        proc = subprocess.run([config["compiler"], "--version"],
                              stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                              encoding="utf-8", errors="replace", timeout=10)
        version = proc.stdout.splitlines()[0] if proc.stdout else ""
    except (OSError, subprocess.TimeoutExpired):
        version = "unavailable"
    return {"path": config["compiler"], "version": version,
            "arguments": config["arguments"]}


def tag_arguments_for(evidence):
    return [arg["name"] for arg in evidence.get("signature", {}).get("arguments", [])
            if "TagItem" in arg.get("type", "")]


def tag_observations(evidence):
    """Normalize direct and helper tag evidence onto public arguments."""
    public_args = {arg["name"] for arg in
                   evidence.get("signature", {}).get("arguments", [])}
    tag_args = tag_arguments_for(evidence)
    observations = []
    for tag in evidence.get("tags", []):
        roots = sorted(public_args.intersection(tag.get("list_parameters", [])))
        if not roots and len(tag_args) == 1:
            roots = tag_args
        observations.append(dict(tag, source=evidence.get("source"),
                                 via=[evidence["name"]], root_arguments=roots))
    for tag in evidence.get("propagated_tags", []):
        item = dict(tag)
        if not item.get("root_arguments") and len(tag_args) == 1:
            item["root_arguments"] = tag_args
        observations.append(item)
    for tag in evidence.get("corroborating_tag_evidence", []):
        item = dict(tag, via=[evidence["name"], "<library-tag-consumer>"],
                    root_arguments=tag_args if len(tag_args) == 1 else [])
        observations.append(item)
    return observations


def evidence_provenance(item):
    return {key: item.get(key) for key in
            ("source", "line", "via", "access", "kind", "confidence",
             "cast", "default", "list_expression") if item.get(key) not in (None, "")}


def synthesize_function_tags(evidence, add_review):
    grouped, orphaned = {}, []
    for item in tag_observations(evidence):
        roots = item.get("root_arguments", [])
        if not roots:
            orphaned.append(item)
            continue
        for root in roots:
            grouped.setdefault((root, item["name"]), []).append(item)
    for item in orphaned:
        add_review("taglist-origin-unresolved", evidence["name"], item["name"],
                   "tag access could not be mapped to a public TagItem argument",
                   [evidence_provenance(item)])

    domains = {}
    strength = {"low": 0, "medium": 1, "high": 2}
    for (argument, name), items in sorted(grouped.items()):
        high_kinds = sorted(set(x["kind"] for x in items
                                if x.get("confidence") == "high" and
                                x.get("kind") not in (None, "unknown")))
        provenance = [evidence_provenance(x) for x in sorted(
            items, key=lambda x: (x.get("source") or "", x.get("line") or 0,
                                  x.get("kind") or ""))]
        domain = domains.setdefault(argument, {"argument": argument,
                                                "accepted": [], "unresolved": []})
        if len(high_kinds) == 1:
            domain["accepted"].append({"name": name, "kind": high_kinds[0],
                                       "confidence": "high",
                                       "provenance": provenance})
        else:
            best = max((strength.get(x.get("confidence"), -1) for x in items),
                       default=-1)
            reason = "conflicting high-confidence payload kinds" if high_kinds else \
                     "payload representation is not proved"
            unresolved = {"name": name, "reason": reason,
                          "best_confidence": next(
                              (k for k, v in strength.items() if v == best), "none"),
                          "observed_kinds": sorted(set(x.get("kind", "unknown")
                                                       for x in items)),
                          "provenance": provenance}
            domain["unresolved"].append(unresolved)
            add_review("tag-payload-conflict" if high_kinds else
                       "tag-payload-unresolved", evidence["name"],
                       "%s:%s" % (argument, name), reason, provenance)
    return [domains[name] for name in sorted(domains)]


def function_record_contracts(evidence, layouts):
    contracts = []
    for argument in evidence.get("signature", {}).get("arguments", []):
        name, ctype = argument["name"], argument["type"]
        record_name = signature_record_name(ctype)
        if not record_name or record_name not in layouts:
            continue
        layout = layouts[record_name]
        guest = layout.get("m68k") or {}
        native = layout.get("native") or {}
        guest_fields = {field["name"]: field for field in guest.get("fields", [])}
        native_fields = {field["name"]: field for field in native.get("fields", [])}
        observed = set(evidence.get("arguments", {}).get(name, {}).get(
            "dereferenced_fields", []))
        observed.update(fact["value"] for fact in
                        evidence.get("propagated_arguments", {}).get(name, [])
                        if fact["kind"] == "dereferenced_fields")
        required = []
        for field_name in sorted(observed.intersection(guest_fields)):
            guest_field, native_field = guest_fields[field_name], native_fields.get(field_name)
            required.append({
                "name": field_name,
                "m68k_offset": guest_field["offset"],
                "m68k_type": guest_field["type"],
                "native_offset": native_field["offset"] if native_field else None,
                "native_type": native_field["type"] if native_field else None,
                "pointer_shaped": classify(guest_field["type"]) in
                                  ("string", "aptr", "struct", "bptr")
            })
        contracts.append({
            "argument": name, "declared_type": ctype, "record": record_name,
            "m68k_size": guest.get("size"), "native_size": native.get("size"),
            "required_fields": required,
            "unresolved_observed_fields": sorted(observed - set(guest_fields))
        })
    return contracts


def build_import_manifest(report):
    lib, rel = report["library"], report["conf"]
    short = lib.split(".")[0]
    config = ast_compile_config(rel, short)
    source_root, source_paths = source_files_for_target(rel)
    conf_path = os.path.join(AROS, rel)
    forced = input_file(config.get("forced_include"), "generated-deflibdefs")
    source_inputs = []
    for path in source_paths:
        role = "implementation-header" if path.endswith(".h") else "implementation-source"
        source_inputs.append(input_file(path, role))
    source_inputs = sorted((x for x in source_inputs if x), key=lambda x: x["path"])
    public_headers = discover_public_headers(short, config)
    layout_header_inputs = [input_file(
        os.path.join(config["sysroot"], "include", header), "record-layout-header")
        for header in report.get("record_layouts", {}).get("headers", [])]
    layout_header_inputs = sorted((x for x in layout_header_inputs if x),
                                  key=lambda x: x["path"])
    external_evidence = (report.get("source_tree_tag_evidence", []) +
                         report.get("callsite_tag_evidence", []))
    external_paths = sorted(set(os.path.join(AROS, item["source"])
                                for item in external_evidence))
    external_inputs = [input_file(path, "external-tag-consumer")
                       for path in external_paths]
    external_inputs = sorted((x for x in external_inputs if x), key=lambda x: x["path"])

    review = []
    def add_review(kind, function, subject, detail, evidence=None):
        review.append({"kind": kind, "function": function, "subject": subject,
                       "detail": detail, "evidence": evidence or []})

    if not public_headers:
        add_review("missing-public-header", None, short,
                   "no generated or installed public header was found")
    if not forced:
        add_review("missing-build-input", None, short,
                   "generated *_deflibdefs.h is absent; AST compilation is incomplete")
    if report.get("record_layouts", {}).get("status") != "ok":
        add_review("record-layout-probe", None, short,
                   report.get("record_layouts", {}).get("error",
                                                        "record layout probe failed"))

    parsed = parse_conf(conf_path) or []
    by_name = {f.name: f for f in parsed if not f.private}
    functions = []
    outcomes = {"generated-from-abi": 0, "covered-by-policy": 0,
                "explicitly-refused": 0, "review-required": 0}
    for evidence in report["functions"]:
        f = by_name[evidence["name"]]
        tier, blocker = f.tier(lib)
        policy = function_policy(lib, f)
        if policy:
            outcome = "covered-by-policy"
        elif tier in (1, 2):
            outcome = "generated-from-abi"
        elif blocker and (blocker.startswith("refused:") or "allowlist" in blocker):
            outcome = "explicitly-refused"
        else:
            outcome = "review-required"
            add_review("crossing-semantics-required", f.name, norm(f.ret),
                       blocker or "signature requires semantic translation")
        outcomes[outcome] += 1

        if not evidence.get("source"):
            add_review("missing-implementation", f.name, f.name,
                       "public vector implementation was not found in C sources")
        ast = evidence.get("ast", {})
        if evidence.get("source") and ast.get("status") != "ok":
            add_review("public-ast-failure", f.name, ast.get("symbol", f.name),
                       ast.get("error", "AST compilation failed"))
        for helper in evidence.get("reachable_helpers", []):
            if helper.get("ast", {}).get("status") != "ok":
                add_review("helper-ast-failure", f.name, helper["name"],
                           helper["ast"].get("error", "AST compilation failed"),
                           [{"source": helper["source"], "line": helper["line"],
                             "via": helper["via"]}])
        for callback in evidence.get("propagated_callbacks", []):
            add_review("callback-contract", f.name, callback["name"],
                       "native-to-68k callback behavior requires an explicit contract",
                       [callback])
        for argument, facts in evidence.get("propagated_arguments", {}).items():
            retained = [fact for fact in facts if fact["kind"] == "stored_in_fields"]
            if retained:
                add_review("retained-pointer-lifetime", f.name, argument,
                           "reachable helper stores this public argument in native state",
                           retained)

        functions.append({
            "name": f.name, "lvo": f.lvo, "offset": f.offset,
            "signature": evidence.get("signature"),
            "source": evidence.get("source"), "line": evidence.get("line"),
            "outcome": outcome, "blocker": blocker,
            "existing_policy": policy,
            "reachable_helpers": len(evidence.get("reachable_helpers", [])),
            "record_contracts": function_record_contracts(
                evidence, report.get("record_layouts", {}).get("types", {})),
            "tag_domains": synthesize_function_tags(evidence, add_review),
            "argument_evidence": evidence.get("arguments", {}),
            "propagated_arguments": evidence.get("propagated_arguments", {}),
            "memory": evidence.get("memory", {}),
            "callbacks": evidence.get("callbacks", []),
            "propagated_callbacks": evidence.get("propagated_callbacks", [])
        })

    accepted_ownership = []
    for pair in report.get("ownership_candidates", []):
        if pair.get("confidence") == "high":
            accepted_ownership.append(pair)
        else:
            add_review("ownership-pair", pair["producer"], pair["consumer"],
                       "producer/releaser relationship is not high confidence", [pair])

    # Collapse exact duplicate review findings before assigning stable IDs.
    unique = {}
    for item in review:
        key = (item["kind"], item.get("function") or "", item["subject"], item["detail"])
        unique[key] = item
    review = [unique[key] for key in sorted(unique)]
    for i, item in enumerate(review, 1):
        item["id"] = "R%04d" % i
    unresolved_vectors = sum(1 for f in functions if f["outcome"] == "review-required")
    status = "review-required" if review or unresolved_vectors else "ready-for-generation"
    inputs = {
        "generator": input_file(os.path.abspath(__file__), "importer"),
        "current_policy": input_file(POLICY_PATH, "bridge-policy"),
        "conf": input_file(conf_path, "library-conf"),
        "public_headers": public_headers,
        "implementation": source_inputs,
        "external_tag_consumers": external_inputs,
        "record_layout_headers": layout_header_inputs,
        "generated_build_header": forced,
        "compiler": compiler_identity(config),
        "sysroot": logical_path(config["sysroot"]),
        "source_root": logical_path(source_root)
    }
    return {
        "schema": 1,
        "generator": "graft/gen-emu68k-bridge",
        "library": lib,
        "status": status,
        "inputs": inputs,
        "analysis": {
            "backend": report["analysis_backend"],
            "public_vectors": len(functions),
            "outcomes": outcomes,
            "review_items": len(review)
        },
        "accepted": {"abi_vectors": len(functions),
                     "ownership": accepted_ownership},
        "functions": functions,
        "review": review,
        "certification": {"status": "not-run", "checks": []}
    }


def import_review_markdown(manifest):
    a = manifest["analysis"]
    lines = [
        "# 68k bridge import review: %s" % manifest["library"], "",
        "Status: **%s**" % manifest["status"], "",
        "- Public vectors: %d" % a["public_vectors"],
        "- Generated from ABI: %d" % a["outcomes"]["generated-from-abi"],
        "- Already covered by policy: %d" % a["outcomes"]["covered-by-policy"],
        "- Explicitly refused: %d" % a["outcomes"]["explicitly-refused"],
        "- Crossing semantics requiring review: %d" % a["outcomes"]["review-required"],
        "- Review items: %d" % a["review_items"], "",
        "## Vector outcomes", "",
        "| LVO | Function | Outcome |", "|---:|---|---|"
    ]
    for f in manifest["functions"]:
        lines.append("| %d | `%s` | %s |" % (f["lvo"], f["name"], f["outcome"]))
    lines += ["", "## Review queue", ""]
    if not manifest["review"]:
        lines.append("No unresolved findings.")
    for item in manifest["review"]:
        where = ("`%s`: " % item["function"]) if item.get("function") else ""
        lines += ["### %s · %s" % (item["id"], item["kind"]), "",
                  "%s%s — %s" % (where, item["subject"], item["detail"]), ""]
    lines += ["## Safety rule", "",
              "Only explicit high-confidence facts are candidates for generated policy. "
              "Every item above remains fail-closed until resolved.", ""]
    return "\n".join(lines)


def policy_subset_for_library(manifest):
    """Build a non-activating policy candidate from proved import facts."""
    lib, short = manifest["library"], manifest["library"].split(".")[0]
    functions = {key: value for key, value in POLICY.get("functions", {}).items()
                 if key.startswith(lib + ".")}
    domain_names, object_names = set(), set()
    for spec in functions.values():
        domain_names.update(spec.get("taglists", {}).values())
        object_names.update(x.get("type") for x in spec.get("objects", {}).values())
        result = spec.get("result", {})
        if result.get("kind") == "object":
            object_names.add(result.get("type"))
    domains = {name: POLICY["tag_domains"][name] for name in sorted(domain_names)}
    objects = {}
    pending = set(x for x in object_names if x)
    while pending:
        name = sorted(pending)[0]
        pending.remove(name)
        if name in objects or name not in POLICY.get("object_types", {}):
            continue
        spec = POLICY["object_types"][name]
        objects[name] = spec
        for nested in spec.get("nested_fields", []):
            if nested.get("type"):
                pending.add(nested["type"])

    candidates = {}
    proposed_functions = {}
    for function in manifest["functions"]:
        taglists = {}
        for domain in function["tag_domains"]:
            name = "import.%s.%s.%s" % (short, function["name"], domain["argument"])
            tags = []
            for tag in domain["accepted"]:
                bridge_kind = tag["kind"] if tag["kind"] in ("u32", "cstr") else "refuse"
                item = {"name": tag["name"], "kind": bridge_kind,
                        "inferred_kind": tag["kind"],
                        "confidence": tag["confidence"],
                        "provenance": tag["provenance"]}
                if bridge_kind == "refuse":
                    item["reason"] = "typed payload has no approved bridge conversion"
                tags.append(item)
            for tag in domain["unresolved"]:
                tags.append({"name": tag["name"], "kind": "refuse",
                             "reason": tag["reason"],
                             "provenance": tag["provenance"]})
            candidates[name] = {"max_items": max(8, min(128, len(tags) + 4)),
                                "tags": sorted(tags, key=lambda x: x["name"])}
            taglists[domain["argument"]] = name
        if taglists:
            proposed_functions[lib + "." + function["name"]] = {
                "taglists": taglists,
                "activation": "blocked-until-complete-function-contract"
            }
    return {
        "schema": 1,
        "library": lib,
        "status": "candidate-not-active",
        "object_types": objects,
        "tag_domains": domains,
        "functions": functions,
        "candidate_tag_domains": candidates,
        "proposed_functions": proposed_functions,
        "accepted_ownership": manifest["accepted"]["ownership"],
        "safety": "refuse entries and incomplete functions must not be activated"
    }


def generated_test_plan(manifest):
    """Produce deterministic contracts consumed by the executable-test stage."""
    tests = []
    def add(kind, function, status, contract):
        tests.append({"kind": kind, "function": function,
                      "status": status, "contract": contract})

    for function in manifest["functions"]:
        outcome = function["outcome"]
        add("lvo-dispatch", function["name"],
            "ready" if outcome in ("generated-from-abi", "covered-by-policy") else "blocked",
            {"lvo": function["lvo"], "expected": outcome})
        policy = function.get("existing_policy") or {}
        for argument, obj in sorted(policy.get("objects", {}).items()):
            add("invalid-object-token", function["name"], "ready",
                {"argument": argument, "object_type": obj["type"],
                 "expected": "fail-closed"})
        for domain in function["tag_domains"]:
            add("unknown-tag", function["name"], "ready",
                {"argument": domain["argument"], "expected": "fail-closed"})
            for tag in domain["accepted"]:
                ready = tag["kind"] in ("u32", "cstr") and outcome != "review-required"
                add("tag-payload", function["name"], "ready" if ready else "blocked",
                    {"argument": domain["argument"], "tag": tag["name"],
                     "kind": tag["kind"],
                     "expected": "translated" if ready else "fail-closed"})
            for tag in domain["unresolved"]:
                add("unresolved-tag", function["name"], "ready",
                    {"argument": domain["argument"], "tag": tag["name"],
                     "expected": "fail-closed"})
    for pair in manifest["accepted"]["ownership"]:
        producer = next((f for f in manifest["functions"]
                         if f["name"] == pair["producer"]), None)
        consumer = next((f for f in manifest["functions"]
                         if f["name"] == pair["consumer"]), None)
        ready = bool(producer and consumer and
                     producer["outcome"] != "review-required" and
                     consumer["outcome"] != "review-required")
        add("object-lifecycle", pair["producer"], "ready" if ready else "blocked",
            {"consumer": pair["consumer"], "type": pair["type"],
             "expected": "create-use-release-stale-token-rejected"})
    tests.sort(key=lambda x: (x["function"], x["kind"],
                              json.dumps(x["contract"], sort_keys=True)))
    for index, test in enumerate(tests, 1):
        test["id"] = "T%04d" % index
    return {"schema": 1, "library": manifest["library"],
            "summary": {"total": len(tests),
                        "ready": sum(x["status"] == "ready" for x in tests),
                        "blocked": sum(x["status"] == "blocked" for x in tests)},
            "tests": tests}


def approved_bridge_source(report):
    lib, rel = report["library"], report["conf"]
    target = analysis_targets([lib])[0]
    _lib, _rel, base, btype, hdr = target
    if not base or not btype or not hdr:
        short = lib.split(".")[0]
        return (("/* GENERATED fail-closed placeholder for %s.\n"
                 " * Native proto/base metadata is absent, so no crossing can be emitted. */\n"
                 "int emu68k_import_%s_unavailable(void) { return 1; }\n" %
                 (lib, c_ident(short))), 0)
    funcs = parse_conf(os.path.join(AROS, rel)) or []
    return emit_lib(lib, rel, base, btype, hdr, funcs)


def import_artifacts(name):
    reports = collect_source_reports([name])
    if len(reports) != 1:
        raise ValueError("library import must resolve exactly one library")
    analysis = {"schema": 1, "libraries": reports}
    manifest = build_import_manifest(reports[0])
    bridge_source, crossings = approved_bridge_source(reports[0])
    test_plan = generated_test_plan(manifest)
    policy_candidate = policy_subset_for_library(manifest)
    manifest["generated"] = {
        "approved_bridge_crossings": crossings,
        "test_contracts": test_plan["summary"],
        "policy_status": policy_candidate["status"]
    }
    return {
        "analysis.json": json.dumps(analysis, indent=2, sort_keys=False) + "\n",
        "manifest.json": json.dumps(manifest, indent=2, sort_keys=False) + "\n",
        "review.md": import_review_markdown(manifest),
        "policy.generated.json": json.dumps(
            policy_candidate, indent=2, sort_keys=False) + "\n",
        "tests.generated.json": json.dumps(test_plan, indent=2, sort_keys=False) + "\n",
        "bridge.generated.c": bridge_source
    }, manifest


def import_library(name, output_dir=None, check=False):
    short = name[:-8] if name.endswith(".library") else name
    output_dir = output_dir or os.path.join(
        os.path.dirname(os.path.dirname(os.path.abspath(__file__))),
        "build", "emu68k-import", short)
    try:
        artifacts, manifest = import_artifacts(name)
    except ValueError as exc:
        print(str(exc), file=sys.stderr)
        return 1
    stale = []
    if check:
        for filename, content in artifacts.items():
            path = os.path.join(output_dir, filename)
            try:
                current = open(path, encoding="utf-8").read()
            except OSError:
                current = None
            if current != content:
                stale.append(path)
        if stale:
            print("STALE - regenerate library import:")
            for path in stale:
                print("  %s" % path)
            return 1
        print("library import is in sync: %s" % output_dir)
        return 0
    os.makedirs(output_dir, exist_ok=True)
    for filename, content in artifacts.items():
        path = os.path.join(output_dir, filename)
        temporary = path + ".tmp"
        with open(temporary, "w", encoding="utf-8") as fh:
            fh.write(content)
        os.replace(temporary, path)
    print("imported %s: %d vectors, %d review items (%s)" %
          (manifest["library"], manifest["analysis"]["public_vectors"],
           manifest["analysis"]["review_items"], manifest["status"]))
    print("artifacts: %s" % output_dir)
    return 0


