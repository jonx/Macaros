# self-check: LVO assignment must reproduce offsets known from the 68k ABI
# ---------------------------------------------------------------------------

KNOWN = {
    "dos.library": {
        "Open": -30, "Close": -36, "Read": -42, "Write": -48, "Input": -54,
        "Output": -60, "Seek": -66, "IoErr": -132, "Delay": -198,
        "MatchFirst": -822, "MatchNext": -828, "MatchEnd": -834,
        "ParsePattern": -840, "MatchPattern": -846, "ReadArgs": -798,
        "PrintFault": -474, "SetIoErr": -462, "GetProgramName": -576,
    },
    "exec.library": {
        "Supervisor": -30, "Forbid": -132, "Permit": -138, "AllocMem": -198,
        "FreeMem": -210, "FindTask": -294, "OpenLibrary": -552,
        "AllocVec": -684, "FreeVec": -690,
    },
    # OpenIntuition/Intuition are `.skip`ped privates in AROS, so they are
    # deliberately absent by name.
    "intuition.library": {
        "DisplayAlert": -90, "OpenWindow": -204,
        "CloseWindow": -72, "EasyRequestArgs": -588,
    },
    "graphics.library": {
        "BltBitMap": -30, "Text": -60, "Move": -240, "Draw": -246,
        "SetAPen": -342, "RectFill": -306,
    },
    "utility.library": {
        "FindTagItem": -30, "GetTagData": -36, "Stricmp": -162,
    },
    # -96 for FindToolType is confirmed twice over: by this table and by the
    # hand-written bridge that has been serving it to real programs.
    "icon.library": {
        "FreeFreeList": -54, "FindToolType": -96, "MatchToolValue": -102,
        "BumpRevision": -108,
    },
    # The blank line following `.version 39` reserves LVO 5 for the public
    # OpenCatalog() stack-call veneer.  These checks specifically protect the
    # blank-vector semantics in parse_conf().
    "locale.library": {
        "CloseCatalog": -36, "CloseLocale": -42,
        "ConvToLower": -48, "ConvToUpper": -54,
        "OpenCatalogA": -150, "OpenLocale": -156,
    },
}


def selfcheck(lib, funcs):
    want = KNOWN.get(lib)
    if not want:
        return []
    by = {f.name: f for f in funcs}
    bad = []
    for name, off in want.items():
        f = by.get(name)
        if f is None:
            bad.append("%s: not found" % name)
        elif f.offset != off:
            bad.append("%s: got %d, 68k ABI says %d" % (name, f.offset, off))
    return bad


# ---------------------------------------------------------------------------
# emit
# ---------------------------------------------------------------------------

def reg_pair(reg):
    """`D0/D1` -> ('r->d[0]', 'r->d[1]'), the two halves of a 64-bit value.

    The IEEE double libraries are the only place this appears: a double is
    passed high half first, in the two registers the .conf names."""
    m = re.fullmatch(r"([DA][0-7])/([DA][0-7])", reg.strip().upper())
    if not m:
        return None
    return (reg_expr(m.group(1)), reg_expr(m.group(2)))


def reg_expr(reg):
    """`D1` -> `r->d[1]`"""
    reg = reg.strip().upper()
    if not re.fullmatch(r"[DA][0-7]", reg):
        return None
    return "r->%s[%s]" % (reg[0].lower(), reg[1])


def arg_expr(t, reg):
    """The C expression that turns one 68k register into one native argument."""
    if classify(t) == "bptr":
        return "EMU_HANDLE(guest0, %s)" % reg_expr(reg)
    return _arg_expr(t, reg)


def _arg_expr(t, reg):
    """The C expression that turns one 68k register into one native argument."""
    c = classify(t)
    src = reg_expr(reg)
    t = norm(t)
    if c == "string":
        return "(%s)EMU_GPTR(guest0, %s)" % (t, src)
    if c == "widen":
        # sign-extend through LONG: the value is an integer, and a negative one
        # (an error code, a -1 sentinel) must stay negative when it widens
        return "(%s)(LONG)%s" % (t, src)
    return "(%s)%s" % (t, src)


def emit_lib(lib, rel, base, btype, hdr, funcs):
    short = lib.split(".")[0]
    domains = POLICY.get("tag_domains", {})
    object_types = POLICY.get("object_types", {})
    used_domains = []
    used_objects = []
    used_headers = []
    for f in funcs:
        p = function_policy(lib, f)
        if not p:
            continue
        for d in p.get("taglists", {}).values():
            if d not in used_domains:
                used_domains.append(d)
        for sp in p.get("tagged_structs", {}).values():
            if sp.get("header") not in used_headers:
                used_headers.append(sp.get("header"))
        for op in p.get("objects", {}).values():
            if op.get("type") not in used_objects:
                used_objects.append(op.get("type"))
        result = p.get("result", {})
        if result.get("kind") == "object" and result.get("type") not in used_objects:
            used_objects.append(result.get("type"))
    uses_structs = (any(function_policy(lib, f) and
                        (function_policy(lib, f).get("structs") or
                         function_policy(lib, f).get("tagged_structs")) for f in funcs) or
                    any(object_types[o].get("kind") == "facade" for o in used_objects) or
                    any(t.get("kind") == "struct"
                        for d in used_domains for t in domains[d]["tags"]))
    uses_nested_fields = any(object_types[o].get("nested_fields") for o in used_objects)
    out = []
    w = out.append

    def emit_post(items, result_expr=None):
        for lines, when in items:
            if when == "nonzero":
                if result_expr is None:
                    raise RuntimeError("conditional structure copy without a result")
                w("        if (%s)" % result_expr)
                w("        {")
                for line in lines:
                    w("            " + line)
                w("        }")
            else:
                for line in lines:
                    w("        " + line)

    w("/* GENERATED by graft/gen-emu68k-bridge from %s - do not edit." % rel)
    w(" *")
    w(" * Derived crossings for %s. Tier-1 scalar/string calls come straight" % lib)
    w(" * from the .conf prototype and register map; type-sensitive calls additionally")
    w(" * consume the checked semantic policy in graft/emu68k-bridge-policy.json.")
    w(" * Anything still lacking policy remains unavailable rather than guessed.")
    w(" */")
    w("")
    w("#include <exec/types.h>")
    w("#include <%s>" % hdr)
    if uses_structs:
        w("#include <string.h>")
    if (used_headers or uses_nested_fields or
            any(function_policy(lib, f) and function_policy(lib, f).get("null_args")
                for f in funcs)):
        w("#include <stdio.h>")
    for h in used_headers:
        w("#include <%s>" % h)
    for d in used_domains:
        for h in domains[d].get("headers", []):
            w("#include <%s>" % h)
    w("")
    w('#include "emu68k_gen.h"')
    if uses_structs:
        w('#include "emu68k_layouts.h"')
    w("")
    for d in used_domains:
        ident = c_ident(d)
        w("static const struct EmuTagDesc emu_tagdesc_%s[] =" % ident)
        w("{")
        tags = domains[d]["tags"]
        for tag in tags:
            if tag["kind"] == "struct":
                st = tag["type"]
                w('    { %s, %s, "%s", emu_fields_%s, EMU_NFIELDS(emu_fields_%s),'
                  % (tag["name"], TAG_KINDS[tag["kind"]], tag["name"], st, st))
                w("      M68K_%s_SIZEOF, sizeof(struct %s), 0, 0 }," % (st, st))
            elif tag["kind"] == "u16_ffff":
                w('    { %s, %s, "%s", NULL, 0, %d, 0, 0, 0 },' %
                  (tag["name"], TAG_KINDS[tag["kind"]], tag["name"],
                   tag["max_count"]))
            elif tag["kind"] == "rgb32":
                w('    { %s, %s, "%s", NULL, 0, %d, 0, 0, 0 },' %
                  (tag["name"], TAG_KINDS[tag["kind"]], tag["name"],
                   tag["max_longs"]))
            elif tag["kind"] == "object":
                w('    { %s, %s, "%s", NULL, 0, 0, 0, EMU_OBJ_%s, %d },' %
                  (tag["name"], TAG_KINDS[tag["kind"]], tag["name"],
                   c_ident(tag["type"]), 1 if tag.get("nullable", True) else 0))
            else:
                w('    { %s, %s, "%s", NULL, 0, 0, 0, 0, 0 },' %
                  (tag["name"], TAG_KINDS[tag["kind"]], tag["name"]))
        if not tags:
            w("    { 0, EMU_TAG_REFUSE, NULL, NULL, 0, 0, 0, 0, 0 },")
        w("};")
        w("static const struct EmuTagDomain emu_tagdomain_%s =" % ident)
        w("{")
        w('    emu_tagdesc_%s, %d, "%s"' % (ident, len(tags), d))
        w("};")
        w("")
    for oname in used_objects:
        ospec = object_types[oname]
        destructor_spec = ospec.get("destructor")
        if not destructor_spec or not destructor_spec.startswith(lib + "."):
            continue
        destructor = destructor_spec.rsplit(".", 1)[1]
        w("static void emu_object_cleanup_%s(APTR emu_base, APTR emu_object)" %
          c_ident(oname))
        w("{")
        w("    %s *%s = emu_base;" % (btype, base))
        w("    %s((%s)emu_object);" % (destructor, ospec["c_type"]))
        w("}")
        w("")
    w("int emu68k_gen_%s(int lvo, struct Emu68kRegs *r, APTR guest0, APTR base," % short)
    w("                  char *err, ULONG errlen)")
    w("{")
    w("    %s *%s = base;" % (btype, base))
    w("    (void)r; (void)guest0; (void)%s; (void)err; (void)errlen;" % base)
    w("")
    w("    switch (lvo)")
    w("    {")
    n = 0
    for f in funcs:
        t = f.tier(lib)[0]
        policy = function_policy(lib, f)
        if t not in (1, 2) and not policy:
            continue
        regs = [reg_expr(x) or reg_pair(x) for x in f.regs]
        if any(x is None for x in regs):
            continue
        sig = ", ".join("%s %s" % (norm(t), nm) for t, nm in f.args) or "void"
        w("    case %d:  /* %s(%s) -> %s  [%d] */" % (f.lvo, f.name, sig,
                                                      norm(f.ret), f.offset))
        taglists = policy.get("taglists", {}) if policy else {}
        structs = policy.get("structs", {}) if policy else {}
        tagged_structs = policy.get("tagged_structs", {}) if policy else {}
        pointers = policy.get("pointers", {}) if policy else {}
        arrays = policy.get("arrays", {}) if policy else {}
        objects = policy.get("objects", {}) if policy else {}
        callbacks = policy.get("callbacks", {}) if policy else {}
        guest_values = policy.get("guest_values", []) if policy else []
        strings = policy.get("strings", []) if policy else []
        null_args = policy.get("null_args", []) if policy else []
        boopsi = policy.get("boopsi") if policy else None
        if policy:
            w("    {")
        call_args = []
        post = []
        array_pre = []
        precall = []
        heap_tag_scratch = []
        heap_array_scratch = []
        # A "how much of this structure do you want" argument is clamped before
        # anything else: it bounds the guest range check as well as the copy, so
        # it cannot be computed inside the block that already needs it. The
        # clamped value is what the native call is told too, so a short buffer
        # stays short on both sides of the crossing.
        size_limits, size_args = {}, {}
        for sname, sp in structs.items():
            if "size_arg" not in sp:
                continue
            si = [n for _t, n in f.args].index(sp["size_arg"])
            width = SIZE_WIDTHS[norm(f.args[si][0])]
            var = "emu_limit_%d" % si
            w("        ULONG %s = %s%s;"
              % (var, SIZE_CASTS[width], reg_expr(f.regs[si])))
            w("        if (%s > M68K_%s_SIZEOF) %s = M68K_%s_SIZEOF;"
              % (var, sp["type"], var, sp["type"]))
            size_limits[sname] = var
            size_args[sp["size_arg"]] = var
        tagged_size_args = {}
        for bname, sp in tagged_structs.items():
            bi = [n for _t, n in f.args].index(bname)
            ti = [n for _t, n in f.args].index(sp["tag_arg"])
            si = [n for _t, n in f.args].index(sp["size_arg"])
            bsrc = reg_expr(f.regs[bi])
            tsrc = reg_expr(f.regs[ti])
            ssrc = reg_expr(f.regs[si])
            for stype in sp["variants"].values():
                w("        struct %s emu_tagged_%d_%s;" % (stype, bi, stype))
            w("        APTR emu_tagged_native_%d = NULL;" % bi)
            w("        const struct EmuField *emu_tagged_fields_%d = NULL;" % bi)
            w("        ULONG emu_tagged_nfields_%d = 0;" % bi)
            w("        ULONG emu_tagged_native_size_%d = 0;" % bi)
            w("        ULONG emu_tagged_guest_size_%d = 0;" % bi)
            w("        switch ((ULONG)%s)" % tsrc)
            w("        {")
            for macro, stype in sp["variants"].items():
                w("        case %s:" % macro)
                w("            memset(&emu_tagged_%d_%s, 0, sizeof(emu_tagged_%d_%s));"
                  % (bi, stype, bi, stype))
                w("            emu_tagged_native_%d = &emu_tagged_%d_%s;"
                  % (bi, bi, stype))
                w("            emu_tagged_fields_%d = emu_fields_%s;" % (bi, stype))
                w("            emu_tagged_nfields_%d = EMU_NFIELDS(emu_fields_%s);"
                  % (bi, stype))
                w("            emu_tagged_native_size_%d = sizeof(struct %s);" % (bi, stype))
                w("            emu_tagged_guest_size_%d = M68K_%s_SIZEOF;" % (bi, stype))
                w("            break;")
            w("        default:")
            w("            if (err && errlen)")
            w('                snprintf(err, errlen, "%s.%s: unsupported tag %%08lx",'
              % (f.name, bname))
            w("                         (unsigned long)%s);" % tsrc)
            w("            return 1;")
            w("        }")
            w("        ULONG emu_tagged_limit_%d = (ULONG)%s;" % (bi, ssrc))
            w("        if (emu_tagged_limit_%d > emu_tagged_guest_size_%d)"
              % (bi, bi))
            w("            emu_tagged_limit_%d = emu_tagged_guest_size_%d;" % (bi, bi))
            w("        if (emu68k_require_guest_range(%s, emu_tagged_limit_%d," % (bsrc, bi))
            w('                                         "%s.%s", err, errlen) < 0)'
              % (f.name, bname))
            w("            return 1;")
            lines = []
            if sp.get("clear", True):
                lines.append("memset(EMU_GPTR(guest0, %s), 0, emu_tagged_limit_%d);"
                             % (bsrc, bi))
            lines += ["emu68k_to_guest_sized(guest0, %s, emu_tagged_native_%d," % (bsrc, bi),
                      "                   emu_tagged_fields_%d, emu_tagged_nfields_%d, emu_tagged_limit_%d);"
                      % (bi, bi, bi),
                      "r->d[0] = emu_tagged_limit_%d;" % bi]
            post.append((lines, sp.get("copy_on", "always")))
            tagged_size_args[sp["size_arg"]] = "emu_tagged_native_size_%d" % bi
        for ai, ((atype, aname), reg) in enumerate(zip(f.args, f.regs)):
            src = reg_expr(reg)
            if classify(atype) == "double":
                hi, lo = reg_pair(reg)
                call_args.append("emu68k_double_in(%s, %s)" % (hi, lo))
                continue
            if aname in objects:
                op = objects[aname]
                oname = op["type"]
                w("        APTR emu_object_%d;" % ai)
                w("        if (emu68k_object_from_guest(guest0, %s, EMU_OBJ_%s, %d,"
                  % (src, c_ident(oname), 1 if op.get("nullable", True) else 0))
                w('                                        "%s", &emu_object_%d, err, errlen) < 0)'
                  % (oname, ai))
                w("            return 1;")
                call_args.append("(%s)emu_object_%d" % (norm(atype), ai))
                if boopsi and boopsi.get("class_arg") == aname:
                    w("        struct Emu68kBoopsiBridge emu_boopsi_%d;" % ai)
                    precall.extend([
                        "        if (emu68k_boopsi_prepare(guest0, %s, emu_object_%d," % (src, ai),
                        "                                   &emu_boopsi_%d, err, errlen) < 0)" % ai,
                        "            return 1;",
                    ])
                    post.append((["if (emu68k_boopsi_finish(&emu_boopsi_%d, err, errlen) < 0)" % ai,
                                  "    return 1;"], "always"))
                if op.get("release", False) or op.get("consume", False):
                    ospec = object_types[oname]
                    stype = ospec.get("facade_struct")
                    for nested in ospec.get("nested_fields", []):
                        if nested["kind"] == "object":
                            post.append(([
                                "emu68k_object_release(guest0,",
                                "    (ULONG)emu68k_scalar_from_guest(guest0, %s + M68K_%s_%s, 4),"
                                % (src, stype, nested["field"]),
                                "    EMU_OBJ_%s);" % c_ident(nested["type"]),
                            ], "always"))
                        elif nested["kind"] == "embedded_object":
                            post.append(([
                                "emu68k_object_release(guest0,",
                                "    %s + M68K_%s_%s," % (src, stype, nested["field"]),
                                "    EMU_OBJ_%s);" % c_ident(nested["type"]),
                            ], "always"))
                if op.get("release", False):
                    post.append((["emu68k_object_release(guest0, %s, EMU_OBJ_%s);"
                                  % (src, c_ident(oname))], "always"))
                if op.get("consume", False):
                    post.append((["emu68k_object_consume(guest0, %s, EMU_OBJ_%s);"
                                  % (src, c_ident(oname))], "always"))
                continue
            if aname in callbacks:
                w("        struct Emu68kHookBridge emu_hook_%d;" % ai)
                w("        if (emu68k_hook_prepare(guest0, %s, &emu_hook_%d, err, errlen) < 0)"
                  % (src, ai))
                w("            return 1;")
                call_args.append("(%s)&emu_hook_%d.native" % (norm(atype), ai))
                post.append((["if (emu68k_hook_finish(&emu_hook_%d, err, errlen) < 0)" % ai,
                              "    return 1;"], "always"))
                continue
            if aname in structs:
                sp = structs[aname]
                stype, direction = sp["type"], sp["direction"]
                span = size_limits.get(aname, "M68K_%s_SIZEOF" % stype)
                w("        struct %s emu_struct_%d;" % (stype, ai))
                w("        if (emu68k_require_guest_range(%s, %s," % (src, span))
                w('                                         "%s.%s", err, errlen) < 0)'
                  % (f.name, aname))
                w("            return 1;")
                w("        memset(&emu_struct_%d, 0, sizeof(emu_struct_%d));" % (ai, ai))
                if direction in ("in", "inout"):
                    w("        emu68k_from_guest_sized(guest0, %s, &emu_struct_%d,"
                      % (src, ai))
                    w("                             emu_fields_%s, EMU_NFIELDS(emu_fields_%s), %s);"
                      % (stype, stype, span))
                if direction in ("out", "inout"):
                    # Blanking first is right when the call fills the whole
                    # structure: a field it chose not to set must not read as
                    # leftovers. It is WRONG when the call sets only some
                    # fields, or when the structure holds anything the tables
                    # cannot convert (guest pointers the program put there
                    # itself), because those are the program's, not the OS's.
                    lines = []
                    if sp.get("clear", True):
                        lines.append("memset(EMU_GPTR(guest0, %s), 0, %s);"
                                     % (src, span))
                    lines += ["emu68k_to_guest_sized(guest0, %s, &emu_struct_%d," % (src, ai),
                              "                   emu_fields_%s, EMU_NFIELDS(emu_fields_%s), %s);"
                              % (stype, stype, span)]
                    post.append((lines, sp.get("copy_on", "always")))
                call_args.append("(%s)&emu_struct_%d" % (norm(atype), ai))
                continue
            if aname in tagged_structs:
                call_args.append("(%s)emu_tagged_native_%d" % (norm(atype), ai))
                continue
            if aname in tagged_size_args:
                call_args.append("(%s)%s" % (norm(atype), tagged_size_args[aname]))
                continue
            if aname in size_args:
                call_args.append("(%s)%s" % (norm(atype), size_args[aname]))
                continue
            if aname in pointers:
                pp = pointers[aname]
                direction = pp["direction"]
                width = POINTER_SCALARS[pp["kind"]][1]
                base_type = norm(re.sub(r"\s*\*\s*$", "", atype))
                w("        %s emu_scalar_%d = 0;" % (base_type, ai))
                w("        if (emu68k_require_guest_range(%s, %d,"
                  % (src, width))
                w('                                         "%s.%s", err, errlen) < 0)'
                  % (f.name, aname))
                w("            return 1;")
                if direction in ("in", "inout"):
                    w("        emu_scalar_%d = (%s)emu68k_scalar_from_guest(guest0, %s, %d);"
                      % (ai, base_type, src, width))
                if direction in ("out", "inout"):
                    post.append((["emu68k_scalar_to_guest(guest0, %s, %d, (UQUAD)emu_scalar_%d);"
                                  % (src, width, ai)], pp.get("copy_on", "always")))
                call_args.append("(%s)&emu_scalar_%d" % (norm(atype), ai))
                continue
            if aname in arrays:
                ap = arrays[aname]
                cap = ap["max_count"]
                w("        ULONG emu_array_size_%d = sizeof(ULONG) * %d;" % (ai, cap))
                w("        APTR emu_array_scratch_%d = NULL;" % ai)
                prior_arrays = list(heap_array_scratch)
                array_pre.extend([
                    "        if (%s)" % src,
                    "        {",
                    "            emu_array_scratch_%d = emu68k_scratch_alloc(" % ai,
                    "                emu_array_size_%d, err, errlen);" % ai,
                    "            if (!emu_array_scratch_%d)" % ai,
                    "            {",
                ] + [
                    "                emu68k_scratch_free(emu_array_scratch_%d, emu_array_size_%d);"
                    % (old, old) for old in prior_arrays
                ] + [
                    "                return 1;",
                    "            }",
                    "            if (emu68k_rgb32_to_native(guest0, %s," % src,
                    "                    (ULONG *)emu_array_scratch_%d, %d," % (ai, cap),
                    "                    \"%s.%s\", err, errlen) < 0)" % (f.name, aname),
                    "            {",
                    "                emu68k_scratch_free(emu_array_scratch_%d, emu_array_size_%d);"
                    % (ai, ai),
                ] + [
                    "                emu68k_scratch_free(emu_array_scratch_%d, emu_array_size_%d);"
                    % (old, old) for old in prior_arrays
                ] + [
                    "                return 1;",
                    "            }",
                    "        }",
                ])
                heap_array_scratch.append(ai)
                if not ap.get("nullable", True):
                    array_pre[0:0] = [
                        "        if (!%s)" % src,
                        "        {",
                        "            if (err && errlen)",
                        "                snprintf(err, errlen, \"%s.%s requires a non-NULL array\");"
                        % (f.name, aname),
                        "            return 1;",
                        "        }",
                    ]
                call_args.append("(%s)emu_array_scratch_%d" % (norm(atype), ai))
                continue
            if aname in guest_values:
                call_args.append("(%s)(IPTR)%s" % (norm(atype), src))
                continue
            if aname in strings:
                call_args.append("(%s)EMU_GPTR(guest0, %s)" % (norm(atype), src))
                continue
            if aname in null_args:
                w("        if (%s)" % src)
                w("        {")
                w("            if (err && errlen)")
                w('                snprintf(err, errlen, "%s.%s currently requires NULL");'
                  % (f.name, aname))
                w("            return 1;")
                w("        }")
                call_args.append("(%s)NULL" % norm(atype))
                continue
            if aname not in taglists:
                call_args.append(arg_expr(atype, reg))
                continue
            dname = taglists[aname]
            cap = domains[dname]["max_items"]
            ident = c_ident(dname)
            w("        struct TagItem emu_tags_%d[%d];" % (ai, cap + 1))
            # Room for the structures the domain's tags point at, one chunk per
            # such tag, in UQUADs so it is aligned for any of them. The
            # compiler sizes it, so the scratch cannot drift from the types.
            # A domain with no structure tags emits no scratch at all.
            structs = [t["type"] for t in domains[dname]["tags"]
                       if t.get("kind") == "struct"]
            array_counts = [t["max_count"] for t in domains[dname]["tags"]
                            if t.get("kind") == "u16_ffff"]
            rgb32_sizes = [t["max_longs"] for t in domains[dname]["tags"]
                           if t.get("kind") == "rgb32"]
            scratch_parts = (["(sizeof(struct %s) + 7) / 8" % s for s in structs] +
                             ["(sizeof(UWORD) * %d + 7) / 8" % n for n in array_counts] +
                             ["(sizeof(ULONG) * %d + 7) / 8" % n for n in rgb32_sizes])
            heap_scratch = bool(array_counts or rgb32_sizes)
            scratch_quads = " + ".join(scratch_parts)
            if heap_scratch:
                w("        ULONG emu_tagscratch_size_%d = sizeof(UQUAD) * (%s);"
                  % (ai, scratch_quads))
                w("        APTR emu_tagscratch_%d = emu68k_scratch_alloc("
                  "emu_tagscratch_size_%d, err, errlen);" % (ai, ai))
                w("        if (!emu_tagscratch_%d)" % ai)
                w("            return 1;")
                heap_tag_scratch.append(ai)
            elif scratch_parts:
                w("        UQUAD emu_tagscratch_%d[%s];" % (ai, scratch_quads))
            w("        if (emu68k_tags_to_native(guest0, %s, &emu_tagdomain_%s,"
              % (src, ident))
            w("                                     emu_tags_%d, %d, %s, err, errlen) < 0)"
              % (ai, cap + 1,
                 "emu_tagscratch_%d, emu_tagscratch_size_%d" % (ai, ai)
                 if heap_scratch else
                 "emu_tagscratch_%d, sizeof emu_tagscratch_%d" % (ai, ai)
                 if scratch_parts else "NULL, 0"))
            if heap_scratch:
                w("        {")
                w("            emu68k_scratch_free(emu_tagscratch_%d, emu_tagscratch_size_%d);"
                  % (ai, ai))
                w("            return 1;")
                w("        }")
            else:
                w("            return 1;")
            call_args.append("(%s)(%s ? emu_tags_%d : NULL)"
                             % (norm(atype), src, ai))
        for line in array_pre:
            w(line)
        for line in precall:
            w(line)
        args = ",\n              ".join(call_args)
        call = "%s(%s)" % (f.name, args)
        result_policy = policy.get("result") if policy else None
        def emit_heap_tag_cleanup():
            for scratch_ai in heap_tag_scratch:
                w("        emu68k_scratch_free(emu_tagscratch_%d, emu_tagscratch_size_%d);"
                  % (scratch_ai, scratch_ai))
            for scratch_ai in heap_array_scratch:
                w("        if (emu_array_scratch_%d)" % scratch_ai)
                w("            emu68k_scratch_free(emu_array_scratch_%d, emu_array_size_%d);"
                  % (scratch_ai, scratch_ai))
        if result_policy and result_policy.get("kind") == "guest_arg":
            result_arg = result_policy["arg"]
            result_index = [n for _t, n in f.args].index(result_arg)
            result_src = reg_expr(f.regs[result_index])
            w("        APTR emu_result = (APTR)%s;" % call)
            emit_heap_tag_cleanup()
            emit_post(post, "emu_result")
            w("        r->d[0] = emu_result ? %s : 0;" % result_src)
        elif result_policy and result_policy.get("kind") == "object":
            oname = result_policy["type"]
            ospec = object_types[oname]
            cleanup = ("emu_object_cleanup_%s" % c_ident(oname)
                       if result_policy.get("owned", True) else "NULL")
            w("        APTR emu_result = (APTR)%s;" % call)
            fallback = result_policy.get("fallback_textattr")
            if fallback:
                farg = fallback["arg"]
                fi = [n for _t, n in f.args].index(farg)
                fallback_args = list(call_args)
                fallback_args[fi] = "(%s)&emu_fallback_attr" % norm(f.args[fi][0])
                fallback_call = "%s(%s)" % (
                    f.name, ",\n                  ".join(fallback_args))
                w("        if (!emu_result)")
                w("        {")
                w("            struct TextAttr emu_fallback_attr = emu_struct_%d;" % fi)
                w("            emu_fallback_attr.ta_Name = (STRPTR)%s;" %
                  json.dumps(fallback["name"]))
                w("            emu_result = (APTR)%s;" % fallback_call)
                w("        }")
            tag_fallbacks = []
            for tag_arg, dname in taglists.items():
                tag_ai = [n for _t, n in f.args].index(tag_arg)
                for tag in domains[dname]["tags"]:
                    if tag.get("fallback_cstr_field"):
                        tag_fallbacks.append((tag_ai, tag))
            if tag_fallbacks:
                w("        if (!emu_result)")
                w("        {")
                w("            BOOL emu_fallback_changed = FALSE;")
                for tag_ai, tag in tag_fallbacks:
                    stype = tag["type"]
                    field = tag["fallback_cstr_field"]["field"]
                    value = tag["fallback_cstr_field"]["value"]
                    w("            for (ULONG emu_fallback_i = 0;")
                    w("                 emu_tags_%d[emu_fallback_i].ti_Tag != TAG_DONE;"
                      % tag_ai)
                    w("                 emu_fallback_i++)")
                    w("                if (emu_tags_%d[emu_fallback_i].ti_Tag == %s)"
                      % (tag_ai, tag["name"]))
                    w("                {")
                    w("                    struct %s *emu_fallback_value =" % stype)
                    w("                        (struct %s *)emu_tags_%d[emu_fallback_i].ti_Data;"
                      % (stype, tag_ai))
                    w("                    if (emu_fallback_value)")
                    w("                    {")
                    w("                        emu_fallback_value->%s = (STRPTR)%s;"
                      % (field, json.dumps(value)))
                    w("                        emu_fallback_changed = TRUE;")
                    w("                    }")
                    w("                }")
                w("            if (emu_fallback_changed)")
                w("                emu_result = (APTR)%s;" % call)
                w("        }")
            omitted_fallbacks = []
            for tag_arg, dname in taglists.items():
                tag_ai = [n for _t, n in f.args].index(tag_arg)
                for tag in domains[dname]["tags"]:
                    if tag.get("fallback") == "omit":
                        omitted_fallbacks.append((tag_ai, tag))
            if omitted_fallbacks:
                w("        if (!emu_result)")
                w("        {")
                w("            BOOL emu_fallback_changed = FALSE;")
                for tag_ai, tag in omitted_fallbacks:
                    w("            for (ULONG emu_fallback_i = 0;")
                    w("                 emu_tags_%d[emu_fallback_i].ti_Tag != TAG_DONE;"
                      % tag_ai)
                    w("                 emu_fallback_i++)")
                    w("                if (emu_tags_%d[emu_fallback_i].ti_Tag == %s)"
                      % (tag_ai, tag["name"]))
                    w("                {")
                    w("                    emu_tags_%d[emu_fallback_i].ti_Tag = TAG_IGNORE;"
                      % tag_ai)
                    w("                    emu_fallback_changed = TRUE;")
                    w("                }")
                w("            if (emu_fallback_changed)")
                w("                emu_result = (APTR)%s;" % call)
                w("        }")
            emit_heap_tag_cleanup()
            emit_post(post, "emu_result")
            if ospec.get("kind") == "facade":
                stype = ospec["facade_struct"]
                nested_arrays = [n for n in ospec.get("nested_fields", [])
                                 if n["kind"] == "u16_array"]
                extra_parts = ["sizeof(UWORD) * %d" % n["max_count"]
                               for n in nested_arrays]
                facade_size = str(ospec.get("facade_size", "M68K_%s_SIZEOF" % stype))
                if extra_parts:
                    facade_size += " + " + " + ".join(extra_parts)
                w("        if (emu68k_object_to_guest_facade(guest0, emu_result, EMU_OBJ_%s,"
                  % c_ident(oname))
                w("                                             base, %s," % cleanup)
                w('                                             "%s", %s,'
                  % (oname, facade_size))
                w("                                             emu_fields_%s, EMU_NFIELDS(emu_fields_%s),"
                  % (stype, stype))
                w("                                             &r->d[0], err, errlen) < 0)")
            else:
                w("        if (emu68k_object_to_guest(guest0, emu_result, EMU_OBJ_%s,"
                  % c_ident(oname))
                w("                                      base, %s," % cleanup)
                w('                                      "%s", &r->d[0], err, errlen) < 0)'
                  % oname)
            w("            return 1;")
            if ospec.get("kind") == "facade" and ospec.get("nested_fields"):
                w("        if (emu_result && r->d[0])")
                w("        {")
                w("            struct %s *emu_facade_native = (struct %s *)emu_result;"
                  % (stype, stype))
                array_offset = facade_size
                for ni, nested in enumerate(ospec.get("nested_fields", [])):
                    field = nested["field"]
                    native_field = nested.get("native_field", field)
                    if nested["kind"] == "u16_array":
                        count_field = nested["count_field"]
                        max_count = nested["max_count"]
                        native_count_field = nested.get("native_count_field", count_field)
                        w("            ULONG emu_nested_count_%d = emu_facade_native->%s;"
                          % (ni, native_count_field))
                        w("            if (emu_nested_count_%d > %d ||"
                          % (ni, max_count))
                        w("                (emu_nested_count_%d && !emu_facade_native->%s))"
                          % (ni, native_field))
                        w("            {")
                        w("                if (err && errlen)")
                        w('                    snprintf(err, errlen, "%s.%s has invalid count/pointer");'
                          % (oname, field))
                        w("                return 1;")
                        w("            }")
                        w("            ULONG emu_nested_guest_%d = r->d[0] + %s;"
                          % (ni, array_offset))
                        w("            for (ULONG emu_nested_i_%d = 0;"
                          % ni)
                        w("                 emu_nested_i_%d < emu_nested_count_%d;"
                          % (ni, ni))
                        w("                 emu_nested_i_%d++)" % ni)
                        w("                emu68k_scalar_to_guest(guest0,")
                        w("                    emu_nested_guest_%d + emu_nested_i_%d * 2, 2,"
                          % (ni, ni))
                        w("                    emu_facade_native->%s[emu_nested_i_%d]);"
                          % (native_field, ni))
                        w("            emu68k_scalar_to_guest(guest0,")
                        w("                r->d[0] + M68K_%s_%s, 4," % (stype, field))
                        w("                emu_nested_count_%d ? emu_nested_guest_%d : 0);"
                          % (ni, ni))
                        array_offset += " + sizeof(UWORD) * %d" % max_count
                    elif nested["kind"] == "object":
                        nested_type = nested["type"]
                        nested_spec = object_types[nested_type]
                        w("            ULONG emu_nested_token_%d = 0;" % ni)
                        if nested_spec.get("kind") == "facade":
                            nested_struct = nested_spec["facade_struct"]
                            w("            if (emu68k_object_to_guest_facade(guest0,")
                            w("                    emu_facade_native->%s, EMU_OBJ_%s," %
                              (native_field, c_ident(nested_type)))
                            w("                    NULL, NULL, \"%s\", M68K_%s_SIZEOF," %
                              (nested_type, nested_struct))
                            w("                    emu_fields_%s, EMU_NFIELDS(emu_fields_%s),"
                              % (nested_struct, nested_struct))
                            w("                    &emu_nested_token_%d, err, errlen) < 0)" % ni)
                        else:
                            w("            if (emu68k_object_to_guest(guest0,")
                            w("                    emu_facade_native->%s, EMU_OBJ_%s," %
                              (native_field, c_ident(nested_type)))
                            w("                    NULL, NULL, \"%s\"," % nested_type)
                            w("                    &emu_nested_token_%d, err, errlen) < 0)" % ni)
                        w("                return 1;")
                        w("            emu68k_scalar_to_guest(guest0,")
                        w("                r->d[0] + M68K_%s_%s, 4, emu_nested_token_%d);"
                          % (stype, field, ni))
                    elif nested["kind"] == "embedded_object":
                        nested_type = nested["type"]
                        w("            ULONG emu_nested_token_%d =" % ni)
                        w("                r->d[0] + M68K_%s_%s;" % (stype, field))
                        w("            if (emu68k_object_alias_to_guest(guest0,")
                        w("                    emu_nested_token_%d, &emu_facade_native->%s," %
                          (ni, native_field))
                        w("                    EMU_OBJ_%s, \"%s\", err, errlen) < 0)" %
                          (c_ident(nested_type), nested_type))
                        w("                return 1;")
                w("        }")
        elif classify(f.ret) == "void":
            w("        %s%s;" % ("    " if policy else "", call))
            emit_heap_tag_cleanup()
            emit_post(post)
        elif classify(f.ret) == "bptr":
            w("        %sr->d[0] = EMU_TOKEN(guest0, %s);   /* a BPTR crosses as a token */"
              % ("    " if policy else "", call))
            emit_heap_tag_cleanup()
            emit_post(post, "r->d[0]")
        elif classify(f.ret) == "double":
            pad = "    " if policy else ""
            w("        %semu68k_double_out(%s, &r->d[0], &r->d[1]);" % (pad, call))
            emit_heap_tag_cleanup()
            emit_post(post)
        else:
            note = ""
            if classify(f.ret) == "widen":
                note = "   /* narrowed: an integer, never an address */"
            w("        %sr->d[0] = (ULONG)%s;%s" %
              ("    " if policy else "", call, note))
            emit_heap_tag_cleanup()
            emit_post(post, "r->d[0]")
        w("        %sreturn 0;" % ("    " if policy else ""))
        if policy:
            w("    }")
        n += 1
    w("    }")
    w("    return 1;   /* no safe generated crossing for this vector */")
    w("}")
    w("")
    return "\n".join(out), n


HEADER = '''/* GENERATED by graft/gen-emu68k-bridge - do not edit.
 *
 * The generated half of the 68k -> native library bridge. One entry point per
 * library; each returns 0 when it served the call and 1 when the vector is not
 * one it covers, so the hand-written bridge stays in charge of everything that
 * needs judgement.
 */

#ifndef EMU68K_GEN_H
#define EMU68K_GEN_H

#include <exec/types.h>
#include <dos/dos.h>          /* BPTR, for the handle table below */
#include <utility/hooks.h>
#include <intuition/classes.h>

struct TagItem;
struct EmuField;

struct Emu68kHookBridge
{
    struct Hook native;
    APTR state;
    ULONG guest_hook;
    ULONG entry;
    LONG failed;
    char error[160];
};

struct Emu68kBoopsiBridge
{
    struct Hook saved_dispatcher;
    APTR native_class;
    APTR state;
    ULONG guest_class;
    ULONG entry;
    LONG failed;
    char error[160];
};

/* The leading, stable part of the engine's 68k register file. The engine owns
 * the full struct; only these two arrays are contractual here. */
struct Emu68kRegs
{
    ULONG d[8];
    ULONG a[8];
};

/* A guest pointer becomes a host pointer by adding the guest base. Only memory
 * inside the guest arena may be handed to a native call this way. */
#define EMU_GPTR(g0, a)  ((APTR)((a) ? (UBYTE *)(g0) + (ULONG)(a) : NULL))

/* A BPTR cannot cross as itself: a native one is 64-bit and a 68k register is
 * not. These map between the guest's 32-bit token and the native BPTR it
 * stands for; both live in emu68k_oscall.c, which owns the table. */
BPTR  emu68k_handle_bptr(APTR guest0, ULONG token);
ULONG emu68k_handle_token(APTR guest0, BPTR b);
#define EMU_HANDLE(g0, t)  emu68k_handle_bptr((g0), (ULONG)(t))
#define EMU_TOKEN(g0, b)   emu68k_handle_token((g0), (b))

/* A 68k IEEE double is the raw bit pattern in a register pair, high half first.
 * Nothing is converted: the same 64 bits are handed to a native double, which is
 * the same format. The union is there so it is a reinterpretation and not a
 * numeric conversion. */
static inline double emu68k_double_in(ULONG hi, ULONG lo)
{
    union { double d; UQUAD q; } u;
    u.q = ((UQUAD)hi << 32) | (UQUAD)lo;
    return u.d;
}
static inline void emu68k_double_out(double v, ULONG *hi, ULONG *lo)
{
    union { double d; UQUAD q; } u;
    u.d = v;
    *hi = (ULONG)(u.q >> 32);
    *lo = (ULONG)u.q;
}

UQUAD emu68k_scalar_from_guest(APTR guest0, ULONG addr, UBYTE width);
void  emu68k_scalar_to_guest(APTR guest0, ULONG addr, UBYTE width, UQUAD value);
APTR  emu68k_scratch_alloc(ULONG size, char *err, ULONG errlen);
void  emu68k_scratch_free(APTR scratch, ULONG size);

/* Native OS objects cross as typed, per-run tokens. The table preserves
 * identity and reference counts, rejects stale/wrong-type tokens, and owns a
 * cleanup callback so objects still live at program exit are released. */
typedef void (*EmuObjectCleanup)(APTR base, APTR object);
LONG emu68k_object_from_guest(APTR guest0, ULONG token, UWORD type,
                              BOOL nullable, const char *type_name,
                              APTR *native, char *err, ULONG errlen);
LONG emu68k_object_to_guest(APTR guest0, APTR native, UWORD type,
                            APTR base, EmuObjectCleanup cleanup,
                            const char *type_name, ULONG *token,
                            char *err, ULONG errlen);
LONG emu68k_object_to_guest_facade(APTR guest0, APTR native, UWORD type,
                                   APTR base, EmuObjectCleanup cleanup,
                                   const char *type_name, ULONG facade_size,
                                   const struct EmuField *fields, int field_count,
                                   ULONG *token, char *err, ULONG errlen);
LONG emu68k_object_alias_to_guest(APTR guest0, ULONG token, APTR native,
                                  UWORD type, const char *type_name,
                                  char *err, ULONG errlen);
void emu68k_object_release(APTR guest0, ULONG token, UWORD type);
void emu68k_object_consume(APTR guest0, ULONG token, UWORD type);
LONG emu68k_hook_prepare(APTR guest0, ULONG guest_hook,
                         struct Emu68kHookBridge *bridge,
                         char *err, ULONG errlen);
LONG emu68k_hook_finish(const struct Emu68kHookBridge *bridge,
                        char *err, ULONG errlen);
LONG emu68k_boopsi_prepare(APTR guest0, ULONG guest_class, APTR native_class,
                           struct Emu68kBoopsiBridge *bridge,
                           char *err, ULONG errlen);
LONG emu68k_boopsi_finish(struct Emu68kBoopsiBridge *bridge,
                          char *err, ULONG errlen);

/* Policy-compiled TagItem values. A domain names every accepted tag and the
 * type of ti_Data. Unknown/refused tags fail the crossing; they are never
 * forwarded as if every IPTR were a scalar. */
#define EMU_TAG_U32     0
#define EMU_TAG_CSTR    1
#define EMU_TAG_REFUSE  2
#define EMU_TAG_STRUCT  3   /* ti_Data is a guest pointer to a value structure */
#define EMU_TAG_NULL    4   /* pointer-valued tag accepted only when NULL       */
#define EMU_TAG_U16_FFFF 5  /* guest UWORD array terminated by 0xffff           */
#define EMU_TAG_RGB32    6  /* LoadRGB32 block stream terminated by zero         */
#define EMU_TAG_OBJECT   7  /* typed native object represented by a guest token  */
struct EmuTagDesc
{
    ULONG tag;
    UBYTE kind;
    const char *name;
    /* EMU_TAG_STRUCT only: how to rebuild what ti_Data points at. The native
     * copy lives in the caller's scratch and is valid for the call, which is
     * why a structure tag is only described for calls that consume it rather
     * than retain it. */
    const struct EmuField *fields;
    UWORD nfields;
    UWORD guest_size;
    UWORD native_size;
    UWORD object_type;
    UBYTE object_nullable;
};
struct EmuTagDomain
{
    const struct EmuTagDesc *tags;
    UWORD count;
    const char *name;
};
LONG emu68k_tags_to_native(APTR guest0, ULONG guest_tags,
                           const struct EmuTagDomain *domain,
                           struct TagItem *native_tags, ULONG capacity,
                           APTR scratch, ULONG scratch_size,
                           char *err, ULONG errlen);
LONG emu68k_rgb32_to_native(APTR guest0, ULONG guest_table,
                            ULONG *native_table, ULONG capacity,
                            const char *what, char *err, ULONG errlen);

LONG emu68k_require_guest_range(ULONG guest_addr, ULONG length,
                                const char *what, char *err, ULONG errlen);
void emu68k_to_guest(APTR guest0, ULONG gbase, const void *native,
                     const struct EmuField *fields, int count);
void emu68k_from_guest(APTR guest0, ULONG gbase, void *native,
                       const struct EmuField *fields, int count);
/* The same conversions bounded by how much of the GUEST structure the caller
 * asked for; a field straddling the bound is left alone rather than clipped. */
#define EMU_NO_LIMIT 0xffffffffUL
void emu68k_to_guest_sized(APTR guest0, ULONG gbase, const void *native,
                           const struct EmuField *fields, int count, ULONG limit);
void emu68k_from_guest_sized(APTR guest0, ULONG gbase, void *native,
                             const struct EmuField *fields, int count, ULONG limit);
#define EMU_NFIELDS(a) ((int)(sizeof(a) / sizeof((a)[0])))

%s
#endif /* EMU68K_GEN_H */
'''


def emit(outdir, check=False):
    """Write the generated sources, or with check=True only verify that what is
    on disk is what this generator would produce. The sources are checked in so
    the OS tree builds without python, which makes drift possible: a hand edit
    to a generated file, or a .conf change upstream that nobody regenerated
    for. This is what catches both."""
    targets = gen_targets()
    errors = validate_policy(targets)
    if errors:
        print("BRIDGE POLICY INVALID:")
        for e in errors:
            print("  ! %s" % e)
        return 1
    object_types = POLICY.get("object_types", {})
    object_enum = ["enum"]
    object_enum.append("{")
    for name, spec in sorted(object_types.items(), key=lambda kv: kv[1]["id"]):
        object_enum.append("    EMU_OBJ_%s = %d," % (c_ident(name), spec["id"]))
    object_enum.append("};")
    protos, total = ["\n".join(object_enum)], 0
    stale, emitted = [], []
    for lib, rel, base, btype, hdr in targets:
        funcs = parse_conf(os.path.join(AROS, rel))
        if funcs is None:
            continue
        src, n = emit_lib(lib, rel, base, btype, hdr, funcs)
        short = lib.split(".")[0]
        path = os.path.join(outdir, "emu68k_gen_%s.c" % short)
        if check:
            cur = open(path).read() if os.path.exists(path) else None
            if cur != src:
                stale.append(path)
        else:
            with open(path, "w") as fh:
                fh.write(src)
        protos.append("int emu68k_gen_%s(int lvo, struct Emu68kRegs *r,\n"
                      "                  APTR guest0, APTR base,\n"
                      "                  char *err, ULONG errlen);" % short)
        emitted.append(short)
        print("  %-28s %3d crossings" % (os.path.basename(path), n))
        total += n
    # The two places that have to know the SAME set of library names: the
    # dispatch table that routes a call to its generated crossings, and the
    # host's list of names it hands the guest a native base for. Both were
    # written by hand and both drifted the first time a library was added, so
    # both are emitted from the set that was actually generated.
    protos.append("\n".join(
        ["/* name, generated entry point, and where its base comes from. */",
         "#define EMU68K_GEN_LIBS(X) \\"] +
        ['    X("%s.library", emu68k_gen_%s, GENBASE_%s) \\'
         % (s, s, {"dos": "DOS", "exec": "EXEC"}.get(s, "OPEN"))
         for s in emitted] +
        ["    /* end */"]))
    hpath = os.path.join(outdir, "emu68k_gen.h")
    hsrc = HEADER % "\n".join(protos)
    # The host service decides which library names it answers with a native
    # base rather than looking for a 68k one on disk. That set is exactly the
    # set generated here: offering a name with no crossings behind it means the
    # program's first call to it is a capability gap, and NOT offering a name
    # we generated for sends it looking for a disk library that is not there.
    host_path = os.path.join(os.path.dirname(os.path.abspath(__file__)),
                             "..", "hosted", "emu68k", "emu68k_genlibs.h")
    host_src = ("/* GENERATED by graft/gen-emu68k-bridge - do not edit.\n"
                " *\n"
                " * The libraries the bridge has generated crossings for, and\n"
                " * therefore the ones the guest is given a native base for.\n"
                " */\n\n"
                "#ifndef EMU68K_GENLIBS_H\n"
                "#define EMU68K_GENLIBS_H\n\n"
                "#define EMU68K_SERVABLE_LIBS(X) \\\n"
                + "".join('    X("%s.library") \\\n' % s for s in emitted)
                + "    /* end */\n\n"
                "#endif /* EMU68K_GENLIBS_H */\n")
    if check:
        cur = open(hpath).read() if os.path.exists(hpath) else None
        if cur != hsrc:
            stale.append(hpath)
        cur = (open(host_path).read()
               if os.path.exists(host_path) else None)
        if cur != host_src:
            stale.append(os.path.normpath(host_path))
        if stale:
            print("STALE - regenerate with --emit:")
            for x in stale:
                print("  %s" % x)
            return 1
        print("generated sources are in sync with the .conf files (%d crossings)"
              % total)
        return 0
    with open(hpath, "w") as fh:
        fh.write(hsrc)
    with open(host_path, "w") as fh:
        fh.write(host_src)
    print("  %-28s %3d total" % ("emu68k_gen.h", total))
    return 0


def report_all():
    """Classify EVERY library in the tree. Nothing is compiled, so this needs no
    proto headers - it is the complete work queue, and it is what says the
    remaining effort is a list of TYPES rather than a list of functions."""
    import collections
    tot = t1 = 0
    types = collections.Counter()
    libs = 0
    for lib, rel, _b, _t, _h in all_targets():
        funcs = parse_conf(os.path.join(AROS, rel))
        if not funcs:
            continue
        libs += 1
        for f in funcs:
            if f.private:
                continue
            tot += 1
            if f.tier(lib)[0] == 1:
                t1 += 1
                continue
            for t, n in f.args:
                if classify(t) == "struct":
                    types[norm(t)] += 1
            if classify(f.ret) == "struct":
                types[norm(f.ret)] += 1
            if classify(f.ret) == "bptr" or any(classify(t) == "bptr" for t, _ in f.args):
                types["BPTR (the handle table)"] += 1

    print("%d libraries, %d public vectors" % (libs, tot))
    print("  tier 1, generated free:  %5d  (%.0f%%)" % (t1, 100.0 * t1 / max(1, tot)))
    print("  needs a type described:  %5d" % (tot - t1))
    print("\nthe types that block the most vectors (describe one, unlock all):")
    cum = 0
    for i, (t, c) in enumerate(types.most_common(25), 1):
        cum += c
        print("  %2d. %-34s %4d   (cumulative %d of %d)"
              % (i, t[:34], c, cum, tot - t1))
    print("\n%d distinct blocking types in total" % len(types))
    return 0


def main():
    errors = validate_policy(gen_targets())
    if errors:
        print("BRIDGE POLICY INVALID:")
        for e in errors:
            print("  ! %s" % e)
        return 1
    if "--import-library" in sys.argv or "--check-import" in sys.argv:
        option = "--import-library" if "--import-library" in sys.argv else "--check-import"
        i = sys.argv.index(option)
        if i + 1 >= len(sys.argv) or sys.argv[i + 1].startswith("-"):
            print("%s requires one AROS library name" % option, file=sys.stderr)
            return 2
        output_dir = None
        if "--output-dir" in sys.argv:
            oi = sys.argv.index("--output-dir")
            if oi + 1 >= len(sys.argv):
                print("--output-dir requires a path", file=sys.stderr)
                return 2
            output_dir = sys.argv[oi + 1]
        return import_library(sys.argv[i + 1], output_dir,
                              check=(option == "--check-import"))
    if "--analyze-source" in sys.argv:
        i = sys.argv.index("--analyze-source")
        which = []
        for arg in sys.argv[i + 1:]:
            if arg.startswith("-"):
                break
            which.extend(x for x in arg.split(",") if x)
        return analyze_sources(which)
    if "--emit" in sys.argv:
        i = sys.argv.index("--emit")
        return emit(sys.argv[i + 1])
    if "--report-all" in sys.argv:
        return report_all()
    if "--check" in sys.argv:
        i = sys.argv.index("--check")
        return emit(sys.argv[i + 1], check=True)
    if "--list" in sys.argv:
        which = [a for a in sys.argv[1:] if not a.startswith("-")]
        for lib, rel, base, btype, hdr in gen_targets():
            if which and lib.split(".")[0] not in which:
                continue
            funcs = parse_conf(os.path.join(AROS, rel)) or []
            print("== %s" % lib)
            for f in funcs:
                if f.tier(lib)[0] != 1:
                    continue
                sig = ", ".join("%s %s %s" % (t, n, r)
                                for (t, n), r in zip(f.args, f.regs)) or "void"
                print("  %4d %-6d %-22s %-10s (%s)%s"
                      % (f.lvo, f.offset, f.name, norm(f.ret), sig,
                         "  [DENIED: %s]" % DENY[(lib, f.name)]
                         if (lib, f.name) in DENY else ""))
        return 0
    total1 = total = 0
    reasons = {}
    fail = False
    for lib, rel, base, btype, hdr in gen_targets():
        path = os.path.join(AROS, rel)
        funcs = parse_conf(path)
        if funcs is None:
            print("%-20s MISSING %s" % (lib, rel))
            continue
        bad = selfcheck(lib, funcs)
        t1 = [f for f in funcs if f.tier(lib)[0] == 1]
        pub = [f for f in funcs if not f.private]
        total1 += len(t1)
        total += len(pub)
        print("%-20s %4d vectors  %4d public  %4d tier-1 (%.0f%%)  %s"
              % (lib, len(funcs), len(pub), len(t1),
                 100.0 * len(t1) / max(1, len(pub)),
                 "OK" if not bad else "LVO SELF-CHECK FAILED"))
        for b in bad:
            fail = True
            print("      ! %s" % b)
        for f in pub:
            if f.tier(lib)[0] != 1:
                reason = f.tier(lib)[1] or "generated semantic policy"
                reasons.setdefault(reason, []).append("%s.%s" % (lib.split(".")[0], f.name))

    print("\ntotal: %d of %d public vectors are tier 1 (%.0f%%)"
          % (total1, total, 100.0 * total1 / max(1, total)))
    print("\nwhat keeps the rest out, most common first:")
    for r, fs in sorted(reasons.items(), key=lambda kv: -len(kv[1]))[:18]:
        print("  %4d  %-42s e.g. %s" % (len(fs), r[:42], ", ".join(fs[:3])))

    return 1 if fail else 0


if __name__ == "__main__":
    sys.exit(main())
