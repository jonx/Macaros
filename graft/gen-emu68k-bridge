KNOWN = {
    "dos.library": {
        "Open": -30, "Close": -36, "Read": -42, "Write": -48, "Input": -54,
        "Output": -60, "Seek": -66, "IoErr": -132, "Delay": -198,
        "MatchFirst": -822, "MatchNext": -828, "MatchEnd": -834,
        "ParsePattern": -840, "MatchPattern": -846, "ReadArgs": -798,
        "PrintFault": -474, "SetIoErr": -462, "GetProgramName": -576,
    },
    "exec.library": {
        "Supervisor": -30, "Forbid": -132, "Permit": -138, "AllocMem": -198,
        "FreeMem": -210, "FindTask": -294, "OpenLibrary": -552,
        "AllocVec": -684, "FreeVec": -690,
    },
    # OpenIntuition/Intuition are `.skip`ped privates in AROS, so they are
    # deliberately absent by name.
    "intuition.library": {
        "DisplayAlert": -90, "OpenWindow": -204,
        "CloseWindow": -72, "EasyRequestArgs": -588,
    },
    "graphics.library": {
        "BltBitMap": -30, "Text": -60, "Move": -240, "Draw": -246,
        "SetAPen": -342, "RectFill": -306,
    },
    "utility.library": {
        "FindTagItem": -30, "GetTagData": -36, "Stricmp": -162,
    },
    # -96 for FindToolType is confirmed twice over: by this table and by the
    # hand-written bridge that has been serving it to real programs.
    "icon.library": {
        "FreeFreeList": -54, "FindToolType": -96, "MatchToolValue": -102,
        "BumpRevision": -108,
    },
    # The blank line following `.version 39` reserves LVO 5 for the public
    # OpenCatalog() stack-call veneer.  These checks specifically protect the
    # blank-vector semantics in parse_conf().
    "locale.library": {
        "CloseCatalog": -36, "CloseLocale": -42,
        "ConvToLower": -48, "ConvToUpper": -54,
        "OpenCatalogA": -150, "OpenLocale": -156,
    },
}


def selfcheck(lib, funcs):
    want = KNOWN.get(lib)
    if not want:
        return []
    by = {f.name: f for f in funcs}
    bad = []
    for name, off in want.items():
        f = by.get(name)
        if f is None:
            bad.append("%s: not found" % name)
        elif f.offset != off:
            bad.append("%s: got %d, 68k ABI says %d" % (name, f.offset, off))
    return bad


