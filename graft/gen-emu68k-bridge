#!/usr/bin/env python3
"""Generate the 68k -> native AROS library bridge from the OS tree's own .conf
files.

Every AROS library describes each of its vectors in a `##begin functionlist`
block: the full C prototype, and the m68k register each argument arrives in.
That is exactly the information a call needs to cross from a 68k guest into a
native library, so the crossing should be DERIVED from it rather than typed out
by hand.

What can be derived is limited by one fact: there is no pass-through. Guest
memory is big-endian with 32-bit pointers; native AROS on aarch64 is
little-endian with 64-bit pointers and different structure layouts. A pointer
argument is therefore only safe to forward when the thing behind it has no
layout at all - a NUL-terminated string, or raw bytes. Anything with fields has
to be rebuilt, which needs a description of the type, not of the function.

So functions land in tiers:

  1  every argument is a scalar or a char pointer, and the result is a scalar.
     Fully generated, no hand-written code, ever.
  2  a structure, a BPTR, or an untyped APTR crosses. Needs a per-TYPE
     description (written once, shared by every function using that type).
  3  the signature does not say enough: the callee retains the pointer, or
     calls back into the guest.

This script emits tier 1 and reports the rest as the work queue.
"""

import os
import re
import sys
import json

AROS = os.environ.get("AROS_SRC", os.path.expanduser("~/Source/aros-upstream"))
POLICY_PATH = os.environ.get(
    "EMU68K_BRIDGE_POLICY",
    os.path.join(os.path.dirname(os.path.abspath(__file__)),
                 "emu68k-bridge-policy.json"))

# Where the BUILD put the generated proto headers. They are the authority on how
# a library's base is named and typed (the .conf does not always say), and a
# library without one cannot be compiled against at all - which makes the
# presence of the header the natural test for "can we generate for this".
GENINC = os.environ.get(
    "AROS_GENINC",
    os.path.expanduser("~/aros-build/bin/darwin-aarch64/gen/include"))

# The libraries a 68k Amiga program plausibly calls: the AmigaOS application
# surface. Every .conf in the tree is CLASSIFIED (see --report-all, 175 of them),
# but only these have code emitted - compiling all 175 would link the bridge
# against HIDDs, datatypes and internal modules that no 68k program opens.
GEN_LIBS = [
    "exec", "dos", "utility", "intuition", "graphics", "layers", "gadtools",
    "asl", "icon", "iffparse", "commodities", "diskfont", "locale", "keymap",
    "datatypes", "expansion", "cybergraphics", "mathffp", "mathieeesingbas",
    "mathieeedoubbas", "mathieeesingtrans", "mathieeedoubtrans", "mathtrans",
]


def load_policy():
    """Load the semantic facts C prototypes cannot carry. This file is small
    on purpose: it describes TYPES/domains once, while the .conf remains the
    authority for function names, LVOs, registers and C signatures."""
    try:
        with open(POLICY_PATH, encoding="utf-8") as fh:
            p = json.load(fh)
    except (OSError, ValueError) as e:
        raise SystemExit("cannot load bridge policy %s: %s" % (POLICY_PATH, e))
    if p.get("schema") != 1:
        raise SystemExit("bridge policy schema must be 1")
    return p


POLICY = load_policy()


def find_confs():
    """short name -> path, for every .conf in the tree carrying a functionlist.
    Prefers rom/ and workbench/libs/ when a name appears more than once."""
    out = {}
    for root, dirs, files in os.walk(AROS):
        dirs[:] = [d for d in dirs if d not in (".git", "bin")]
        for fn in files:
            if not fn.endswith(".conf"):
                continue
            p = os.path.join(root, fn)
            try:
                if "##begin functionlist" not in open(
                        p, encoding="utf-8", errors="replace").read():
                    continue
            except OSError:
                continue
            rel = os.path.relpath(p, AROS)
            short = fn[:-5]
            rank = 0 if rel.startswith(("rom/", "workbench/libs/")) else 1
            if short not in out or rank < out[short][1]:
                out[short] = (rel, rank)
    return {k: v[0] for k, v in out.items()}


BASE_RE = re.compile(r"extern\s+(struct\s+\w+|\w+)\s*\*\s*(\w+)\s*;")
GETBASE_RE = re.compile(r"__aros_getbase_(\w+)\s*\(\)")


def proto_base(short):
    """(base name, base type) for `short`, read from its generated proto header.
    Returns None when there is no header, i.e. nothing to generate against."""
    path = os.path.join(GENINC, "proto", short + ".h")
    try:
        src = open(path, encoding="utf-8", errors="replace").read()
    except OSError:
        return None
    m = GETBASE_RE.search(src)
    if not m:
        return None
    name = m.group(1)
    btype = "struct Library"
    for bt, bn in BASE_RE.findall(src):
        # the specific spelling wins over the generic `struct Library` one
        if bn == name and norm(bt) != "struct Library":
            btype = norm(bt)
    return (name, btype)


def gen_targets():
    """The libraries code is emitted for: on GEN_LIBS, has a .conf, and has a
    generated proto header to compile against."""
    confs = find_confs()
    out = []
    for short in GEN_LIBS:
        rel = confs.get(short)
        if not rel:
            continue
        pb = proto_base(short)
        if not pb:
            continue
        out.append((short + ".library", rel, pb[0], pb[1], "proto/%s.h" % short))
    return out


def all_targets():
    """Every library in the tree, for classification. No proto header needed:
    nothing is compiled, only counted."""
    return [(short + ".library", rel, None, None, None)
            for short, rel in sorted(find_confs().items())]


# ---------------------------------------------------------------------------
# type classification
# ---------------------------------------------------------------------------

# Fits in (or narrower than) a 32-bit 68k register, and carries no address.
SCALAR = {
    "LONG", "ULONG", "WORD", "UWORD", "BYTE", "UBYTE", "BOOL", "LONGBITS",
    "ULONGBITS", "int", "unsigned int", "long", "unsigned long", "short",
    "unsigned short", "char", "unsigned char", "signed char", "UBYTE",
    "STACKULONG", "STACKLONG", "Tag", "TEXT",
}

# Pointer-sized natively but used as an integer. Safe as an argument (we widen
# a 32-bit register); as a RESULT it is narrowed, which is only correct because
# the value is an integer and not an address. Flagged in the generated source.
WIDENING = {"IPTR", "SIPTR", "APTR_or_IPTR"}

# A pointer to bytes: no layout, so the guest's own buffer can be handed over
# directly. This is the only pointer class that is safe to forward as-is.
STRING = {"STRPTR", "CONST_STRPTR", "CONST_STRPTR_or_NULL"}

# How wide the guest's own value is when a scalar argument says how many bytes
# of a structure the caller wants touched. The register is 32 bits either way;
# this is the width the 68k program believes it passed.
SIZE_WIDTHS = {
    "BYTE": 1, "UBYTE": 1,
    "WORD": 2, "UWORD": 2,
    "LONG": 4, "ULONG": 4, "int": 4, "unsigned int": 4,
    "LONGBITS": 4, "ULONGBITS": 4, "IPTR": 4, "SIPTR": 4,
}
SIZE_CASTS = {1: "(ULONG)(UBYTE)", 2: "(ULONG)(UWORD)", 4: "(ULONG)"}

POINTER_SCALARS = {
    "u8":  ({"UBYTE"}, 1),
    "s8":  ({"BYTE"}, 1),
    "u16": ({"UWORD"}, 2),
    "s16": ({"WORD"}, 2),
    "u32": ({"ULONG", "ULONGBITS"}, 4),
    "s32": ({"LONG", "LONGBITS"}, 4),
}

VOID = {"void", "VOID"}

# Tier 1 by signature is not the same as safe to forward. A guest is not
# trusted to halt the machine it is a guest on, and a simple signature says
# nothing about that, so the decision is made by name.
#
# exec.library is inverted: it is a kernel API, not an application API, and
# nearly every one of its simple-signature vectors drives the real machine
# (ShutdownA, SetSR, ReadGayle, Exception, RawPutChar). The calls a 68k
# program legitimately makes into exec - memory, lists, semaphores,
# OpenLibrary - are hand-served already. So exec is allowlisted and everything
# else is denylisted.
ALLOWLIST_LIBS = {"exec.library"}

ALLOW = {
    ("exec.library", "AvailMem"): 1,
}

# Vectors that LOOK like tier 2a but must stay hand-written: they need
# something before or after the call that a derived crossing cannot know about.
DENY_2A = {
    ("dos.library", "Close"):     "must release the handle-table slot after",
    ("dos.library", "UnLock"):    "must release the handle-table slot after",
    ("dos.library", "UnLoadSeg"): "a guest seglist is not a native one",
    ("dos.library", "RunCommand"):"a guest seglist is not a native one",
    ("dos.library", "AddSegment"):"a guest seglist is not a native one",
}

DENY = {
    # the guest exits by returning; calling this would unwind the host task
    ("dos.library",  "Exit"):        "the guest exits by returning, not by this",
    # device-level operations: vanishingly rare in the programs being served,
    # and catastrophic if a mistranslated register ever reaches one
    ("dos.library",  "Format"):      "device-level, and destroys a volume",
    ("dos.library",  "Relabel"):     "device-level",
    ("dos.library",  "Inhibit"):     "device-level",
    ("dos.library",  "AddBuffers"):  "device-level",
    ("dos.library",  "SetOwner"):    "device-level",
    # meaningless or harmful without the paired call, which is not tier 1
    ("dos.library",  "UnLockDosList"): "pairs with LockDosList, which is not tier 1",
    ("dos.library",  "SetArgStr"):   "rebinds the host process argument string",
    ("dos.library",  "SetProgramName"): "renames the host process",
    ("dos.library",  "SetCurrentDirName"): "moves the host process, not the guest",
    ("dos.library",  "SetPrompt"):   "the host shell's prompt is not the guest's",
    ("dos.library",  "MaxCli"):      "reports on host CLIs, not guest ones",
    # the host task's signals are the JIT's, not the guest's: a guest that
    # allocates or waits on them stalls the task running it
    ("dos.library",  "CheckSignal"): "the host task's signals are not the guest's",
    # `dest` is a STRPTR when soft is set and a BPTR lock when it is not, so
    # one C type covers two conversions and the signature cannot say which
    ("dos.library",  "MakeLink"):   "dest is a string or a lock depending on soft",
    # returns a PAIR: quotient in D0, remainder in D1. The C prototype can only
    # describe D0, so generating from it would leave D1 stale and the
    # arithmetic silently wrong. Needs a hand-written crossing.
    ("utility.library", "UDivMod32"): "returns quotient in D0 AND remainder in D1",
    ("utility.library", "SDivMod32"): "returns quotient in D0 AND remainder in D1",
}


def norm(t):
    return re.sub(r"\s+", " ", t.strip())


def classify(t):
    """-> ('scalar'|'widen'|'string'|'void'|'bptr'|'double'|'struct'|'aptr'|'other')"""
    t = norm(t)
    if t in VOID:
        return "void"
    # A 68k double is a bit pattern in a register PAIR. Nothing about it needs
    # describing beyond that: no memory is touched and the value crosses
    # unchanged, so the .conf's own register spelling is the whole contract.
    if t == "double":
        return "double"
    if t == "BPTR":
        return "bptr"
    if t in SCALAR:
        return "scalar"
    if t in WIDENING:
        return "widen"
    if t in STRING:
        return "string"
    # `UBYTE *name` / `char *` / `CONST STRPTR` spellings of a byte buffer
    if re.fullmatch(r"(CONST\s+)?(unsigned\s+|signed\s+)?(char|UBYTE|TEXT)\s*\*", t):
        return "string"
    if t == "APTR" or t == "CONST_APTR":
        return "aptr"
    if "*" in t:
        return "struct"
    return "other"


# ---------------------------------------------------------------------------
# .conf parsing
# ---------------------------------------------------------------------------

# `<return type> <name>(<args>) (<regs>)`, where the return type may itself
# carry stars and `struct`.
FUNC_RE = re.compile(r"^(.*?\**)\s*(\w+)\s*\((.*)\)\s*\(([^()]*)\)\s*$")


def split_args(s):
    """Split an argument list on commas that are not inside parentheses (a
    function-pointer argument carries its own)."""
    out, depth, cur = [], 0, ""
    for ch in s:
        if ch in "([":
            depth += 1
        elif ch in ")]":
            depth -= 1
        if ch == "," and depth == 0:
            out.append(cur)
            cur = ""
        else:
            cur += ch
    if cur.strip():
        out.append(cur)
    return [a.strip() for a in out if a.strip()]


def arg_type_and_name(a):
    """`struct FileInfoBlock* fib` -> ('struct FileInfoBlock *', 'fib')"""
    a = a.strip()
    if a in VOID or a == "":
        return None
    # a function pointer argument: `void (*fn)(...)`
    if "(*" in a:
        return ("__fnptr", "fn")
    m = re.match(r"^(.*?)(\w+)$", a)
    if not m:
        return (norm(a), "a")
    t, n = m.group(1), m.group(2)
    if not t.strip() or t.strip() in ("struct", "const", "CONST", "unsigned", "signed"):
        # the whole thing was a bare type with no parameter name
        return (norm(a), "a")
    return (norm(t), n)


class Func:
    def __init__(self, lvo, ret, name, args, regs):
        self.lvo, self.ret, self.name, self.args, self.regs = lvo, ret, name, args, regs
        self.private = False
        self.novararg = False

    @property
    def offset(self):
        return -6 * self.lvo

    def tier(self, lib=None):
        """1, or the reason it is not 1."""
        if self.private:
            return (None, "private")
        if lib is not None:
            if (lib, self.name) in DENY:
                return (None, "refused: " + DENY[(lib, self.name)])
            if lib in ALLOWLIST_LIBS and (lib, self.name) not in ALLOW:
                return (None, "not on the %s allowlist" % lib.split(".")[0])
        if self.regs and self.regs[0] in ("base", "sysv"):
            return (None, "not register-based")
        # a zero-argument function has an empty register list, which is fine
        if not self.regs and self.args:
            return (None, "no register mapping")
        if len(self.regs) != len(self.args):
            return (None, "register/argument count mismatch")
        rc = classify(self.ret)
        if rc == "bptr":
            return (None, "returns BPTR")
        # A returned pointer is a 64-bit HOST address. There is no 32-bit
        # register to put it in, and truncating one is how a guest gets handed
        # a pointer that dereferences to nothing. This includes STRPTR: a
        # returned string is as unrepresentable as a returned struct.
        if rc in ("struct", "aptr", "other", "string"):
            return (None, "returns a pointer (%s)" % norm(self.ret))
        blockers = []
        for t, n in self.args:
            c = classify(t)
            if c == "bptr":
                blockers.append("BPTR %s" % n)
            elif c == "struct":
                blockers.append("%s" % norm(t))
            elif c == "aptr":
                blockers.append("APTR %s" % n)
            elif c == "other":
                blockers.append("%s %s" % (norm(t), n))
        if not blockers:
            return (1, None)

        # TIER 2a: the only thing standing in the way is a BPTR, and a BPTR
        # already has a mechanism - the handle table that maps a guest token to
        # the native pointer it stands for. So these are derivable too, and the
        # 25 dos vectors in this shape do not need writing out one at a time.
        if all(b.startswith("BPTR") for b in blockers) and \
           classify(self.ret) in ("scalar", "widen", "void", "bptr") and \
           lib is not None and (lib, self.name) not in DENY_2A:
            return (2, None)

        return (None, ", ".join(sorted(set(blockers))))


# The first vector the functionlist describes, exactly as genmodule derives it
# (tools/genmodule/config.c): by module type, except that a library declaring
# `noresident` spells out the four standard vectors itself and so starts at 1.
FIRSTLVO_BY_MODTYPE = {
    "handler": 1, "resource": 1,
    "library": 5, "usbclass": 5, "hidd": 5, "class": 5, "gadget": 5, "image": 5,
    "datatype": 6, "mcc": 6, "mui": 6, "mcp": 6,
    "device": 7,
}


def first_lvo(lines):
    modtype, options = "library", ""
    inconf = False
    for line in lines:
        if line.startswith("##begin config"):
            inconf = True
            continue
        if line.startswith("##end config"):
            break
        if not inconf:
            continue
        s = line.split("#")[0].strip()
        if s.startswith("modtype"):
            modtype = s.split(None, 1)[1].strip().lower() if len(s.split()) > 1 else modtype
        elif s.startswith("options"):
            options += " " + s
    lvo = FIRSTLVO_BY_MODTYPE.get(modtype, 5)
    if "noresident" in options:
        lvo = 1
    return lvo


def parse_conf(path):
    inlist = False
    try:
        lines = open(path, encoding="utf-8", errors="replace").read().splitlines()
    except OSError:
        return None
    funcs = []
    lvo = first_lvo(lines) - 1
    last = None
    for raw in lines:
        line = raw.rstrip()
        if line.startswith("##begin functionlist"):
            inlist = True
            continue
        if line.startswith("##end functionlist"):
            break
        if not inlist:
            continue
        # genmodule treats an empty line *inside* a functionlist as a reserved
        # vector slot (config.c:readsectionfunctionlist).  locale.library uses
        # exactly this after `.version 39` to leave LVO 5 to the OpenCatalog()
        # stack-call veneer, so discarding blank lines shifts every real entry.
        if not line.strip():
            lvo += 1
            last = None
            continue
        # strip trailing comment, but not a `#` inside the prototype
        s = line.split("#")[0].strip() if not line.lstrip().startswith("#") else ""
        if not s:
            continue
        if s.startswith("."):
            d = s[1:].split()
            if d[0] == "skip":
                lvo += int(d[1]) if len(d) > 1 else 1
                last = None
            elif d[0] == "private":
                if last is not None:
                    last.private = True
            elif d[0] == "novararg":
                if last is not None:
                    last.novararg = True
            # .version, .function, .alias and friends do not consume a vector
            continue
        m = FUNC_RE.match(s)
        if not m:
            last = None
            continue
        ret, name, argstr, regstr = m.groups()
        lvo += 1
        args = []
        ok = True
        for a in split_args(argstr):
            tn = arg_type_and_name(a)
            if tn is None:
                continue
            if tn[0] == "__fnptr":
                ok = False
            args.append(tn)
        regs = [r.strip() for r in regstr.split(",") if r.strip()]
        f = Func(lvo, ret if ret.strip() else "void", name, args, regs)
        if not ok:
            f.args.append(("__fnptr", "fn"))
        funcs.append(f)
        last = f
    return funcs


# ---------------------------------------------------------------------------
# semantic policy validation
# ---------------------------------------------------------------------------

TAG_KINDS = {"u32": "EMU_TAG_U32", "cstr": "EMU_TAG_CSTR",
             "refuse": "EMU_TAG_REFUSE"}


def policy_key(lib, f):
    return "%s.%s" % (lib, f.name)


def function_policy(lib, f):
    return POLICY.get("functions", {}).get(policy_key(lib, f))


def c_ident(s):
    return re.sub(r"[^A-Za-z0-9_]", "_", s)


def object_canon(t):
    """Compare an object's pointer type without const qualification. Policy
    names identity classes, so `struct Locale *` and `const struct Locale *`
    are the same class while unrelated pointer types must still be rejected."""
    t = re.sub(r"\b(const|CONST)\b", "", norm(t))
    t = re.sub(r"\s*\*\s*", " *", t)
    return norm(t)


def validate_policy(targets):
    """Refuse stale names and unsafe shapes before emitting any C. A policy
    typo must fail the build, not quietly leave the intended vector uncovered."""
    domains = POLICY.get("tag_domains", {})
    object_types = POLICY.get("object_types", {})
    errors = []
    bykey = {}
    for lib, rel, _base, _btype, _hdr in targets:
        for f in parse_conf(os.path.join(AROS, rel)) or []:
            bykey[policy_key(lib, f)] = f

    seen_object_ids = set()
    for name, o in object_types.items():
        oid = o.get("id")
        ctype = o.get("c_type")
        destructor = o.get("destructor")
        if not re.fullmatch(r"[A-Za-z_]\w*", name):
            errors.append("object type %r has an invalid name" % name)
        if not isinstance(oid, int) or oid < 1 or oid > 255:
            errors.append("object type %s id must be 1..255" % name)
        elif oid in seen_object_ids:
            errors.append("object type %s repeats id %d" % (name, oid))
        seen_object_ids.add(oid)
        if not isinstance(ctype, str) or classify(ctype) not in ("struct", "aptr"):
            errors.append("object type %s has invalid pointer c_type %r" % (name, ctype))
        if o.get("kind") not in ("opaque", "facade"):
            errors.append("object type %s kind must be opaque or facade" % name)
        if o.get("kind") == "facade" and not re.fullmatch(
                r"[A-Za-z_]\w*", o.get("facade_struct", "")):
            errors.append("object type %s facade_struct is invalid" % name)
        if destructor is not None:
            df = bykey.get(destructor)
            if not isinstance(destructor, str) or not df:
                errors.append("object type %s has invalid destructor %r" % (name, destructor))
            elif (classify(df.ret) not in ("void", "scalar") or len(df.args) != 1 or
                  object_canon(df.args[0][0]) != object_canon(ctype)):
                errors.append("object type %s destructor %s has incompatible signature"
                              % (name, destructor))

    for name, d in domains.items():
        if not re.fullmatch(r"[A-Za-z0-9_.-]+", name):
            errors.append("tag domain %r has an invalid name" % name)
        cap = d.get("max_items")
        if not isinstance(cap, int) or cap < 1 or cap > 256:
            errors.append("tag domain %s max_items must be 1..256" % name)
        tags = d.get("tags")
        if not isinstance(tags, list):
            errors.append("tag domain %s tags must be a list" % name)
            continue
        seen = set()
        for t in tags:
            macro, kind = t.get("name"), t.get("kind")
            if not isinstance(macro, str) or not re.fullmatch(r"[A-Za-z_]\w*", macro):
                errors.append("tag domain %s has invalid macro %r" % (name, macro))
            elif macro in seen:
                errors.append("tag domain %s repeats %s" % (name, macro))
            seen.add(macro)
            if kind not in TAG_KINDS:
                errors.append("tag domain %s tag %s has unknown kind %r"
                              % (name, macro, kind))

    for key, p in POLICY.get("functions", {}).items():
        f = bykey.get(key)
        if not f:
            errors.append("function policy %s does not name a public .conf vector" % key)
            continue
        if f.private:
            errors.append("function policy %s names a private vector" % key)
        taglists = p.get("taglists", {})
        structs = p.get("structs", {})
        objects = p.get("objects", {})
        callbacks = p.get("callbacks", {})
        pointers = p.get("pointers", {})
        guest_values = p.get("guest_values", [])
        strings = p.get("strings", [])
        boopsi = p.get("boopsi")
        args = {n: t for t, n in f.args}
        for arg, domain in taglists.items():
            if arg not in args:
                errors.append("function policy %s names missing argument %s" % (key, arg))
            elif "TagItem" not in args[arg] or "*" not in args[arg]:
                errors.append("function policy %s argument %s is not a TagItem pointer"
                              % (key, arg))
            if domain not in domains:
                errors.append("function policy %s uses missing tag domain %s"
                              % (key, domain))
        for arg, sp in structs.items():
            stype, direction = sp.get("type"), sp.get("direction")
            if arg not in args:
                errors.append("function policy %s names missing argument %s" % (key, arg))
            elif (not isinstance(stype, str) or
                  "struct %s" % stype not in norm(args[arg]) or
                  "*" not in args[arg]):
                errors.append("function policy %s argument %s is not struct %s *"
                              % (key, arg, stype))
            if direction not in ("in", "out", "inout"):
                errors.append("function policy %s struct %s has invalid direction %r"
                              % (key, arg, direction))
            copy_on = sp.get("copy_on", "always")
            if copy_on not in ("always", "nonzero"):
                errors.append("function policy %s struct %s has invalid copy_on %r"
                              % (key, arg, copy_on))
            elif copy_on == "nonzero" and classify(f.ret) not in ("scalar", "widen"):
                errors.append("function policy %s struct %s copy_on nonzero needs scalar result"
                              % (key, arg))
            size_arg = sp.get("size_arg")
            if size_arg is not None:
                if size_arg not in args:
                    errors.append("function policy %s struct %s names missing size argument %s"
                                  % (key, arg, size_arg))
                elif norm(args[size_arg]) not in SIZE_WIDTHS:
                    errors.append("function policy %s size argument %s is %s, not a scalar count"
                                  % (key, size_arg, norm(args[size_arg])))
                if size_arg == arg:
                    errors.append("function policy %s struct %s cannot be its own size"
                                  % (key, arg))
            if arg in taglists:
                errors.append("function policy %s argument %s has two policies" % (key, arg))
        for arg, pp in pointers.items():
            kind, direction = pp.get("kind"), pp.get("direction")
            expected = POINTER_SCALARS.get(kind)
            if arg not in args:
                errors.append("function policy %s names missing scalar pointer %s" % (key, arg))
            elif not expected or "*" not in args[arg]:
                errors.append("function policy %s scalar pointer %s has invalid kind %r"
                              % (key, arg, kind))
            else:
                base_type = norm(re.sub(r"\s*\*\s*$", "", args[arg]))
                if base_type not in expected[0]:
                    errors.append("function policy %s scalar pointer %s kind %s mismatches %s"
                                  % (key, arg, kind, base_type))
            if direction not in ("in", "out", "inout"):
                errors.append("function policy %s scalar pointer %s has invalid direction %r"
                              % (key, arg, direction))
            copy_on = pp.get("copy_on", "always")
            if copy_on not in ("always", "nonzero"):
                errors.append("function policy %s scalar pointer %s has invalid copy_on %r"
                              % (key, arg, copy_on))
            elif copy_on == "nonzero" and classify(f.ret) not in ("scalar", "widen"):
                errors.append("function policy %s scalar pointer %s copy_on nonzero needs scalar result"
                              % (key, arg))
            if arg in taglists or arg in structs:
                errors.append("function policy %s argument %s has two policies" % (key, arg))
        for arg, op in objects.items():
            otype = op.get("type")
            ospec = object_types.get(otype)
            if arg not in args:
                errors.append("function policy %s names missing argument %s" % (key, arg))
            elif not ospec:
                errors.append("function policy %s uses missing object type %s"
                              % (key, otype))
            elif object_canon(args[arg]) != object_canon(ospec.get("c_type", "")):
                errors.append("function policy %s argument %s is not object %s"
                              % (key, arg, otype))
            if op.get("nullable", True) not in (True, False):
                errors.append("function policy %s object %s nullable must be boolean"
                              % (key, arg))
            if op.get("release", False) not in (True, False):
                errors.append("function policy %s object %s release must be boolean"
                              % (key, arg))
            if op.get("consume", False) not in (True, False):
                errors.append("function policy %s object %s consume must be boolean"
                              % (key, arg))
            if op.get("release", False) and op.get("consume", False):
                errors.append("function policy %s object %s cannot release and consume"
                              % (key, arg))
            if arg in taglists or arg in structs or arg in pointers:
                errors.append("function policy %s argument %s has two policies" % (key, arg))
        for arg, cb in callbacks.items():
            if arg not in args:
                errors.append("function policy %s names missing callback %s" % (key, arg))
            elif "struct Hook" not in args[arg] or "*" not in args[arg]:
                errors.append("function policy %s callback %s is not struct Hook *"
                              % (key, arg))
            if cb.get("kind") != "hook":
                errors.append("function policy %s callback %s kind must be hook"
                              % (key, arg))
            for role in ("object_arg", "message_arg"):
                if cb.get(role) not in args:
                    errors.append("function policy %s callback %s has missing %s"
                                  % (key, arg, role))
            if arg in taglists or arg in structs or arg in objects or arg in pointers:
                errors.append("function policy %s argument %s has two policies" % (key, arg))
        if not isinstance(guest_values, list) or any(a not in args for a in guest_values):
            errors.append("function policy %s has invalid guest_values" % key)
        else:
            for arg in guest_values:
                if classify(args[arg]) != "aptr":
                    errors.append("function policy %s guest value %s is not APTR"
                                  % (key, arg))
        if not isinstance(strings, list) or any(a not in args for a in strings):
            errors.append("function policy %s has invalid strings" % key)
        if boopsi:
            class_arg = boopsi.get("class_arg")
            if class_arg not in objects or objects[class_arg].get("type") != "Class":
                errors.append("function policy %s BOOPSI class_arg is not a Class object"
                              % key)
        result = p.get("result")
        if result:
            if result.get("kind") == "guest_arg":
                if result.get("arg") not in args:
                    errors.append("function policy %s has invalid guest_arg result" % key)
                elif result.get("arg") not in structs:
                    errors.append("function policy %s result argument is not a struct shadow" % key)
            elif result.get("kind") == "object":
                otype = result.get("type")
                ospec = object_types.get(otype)
                owned = result.get("owned", True)
                if owned not in (True, False):
                    errors.append("function policy %s object result owned must be boolean" % key)
                if not ospec:
                    errors.append("function policy %s uses missing result object %s"
                                  % (key, otype))
                elif object_canon(f.ret) != object_canon(ospec.get("c_type", "")):
                    errors.append("function policy %s result is not object %s" % (key, otype))
                elif owned and not ospec.get("destructor"):
                    errors.append("function policy %s owned object needs a destructor" % key)
                elif owned and not ospec["destructor"].startswith(key.rsplit(".", 1)[0] + "."):
                    errors.append("function policy %s object destructor must be in the same library"
                                  % key)
            else:
                errors.append("function policy %s has invalid result policy" % key)
        blockers = []
        for t, n in f.args:
            if (n in taglists or n in structs or n in pointers or n in objects or n in callbacks or
                    n in guest_values or n in strings):
                continue
            if classify(t) not in ("scalar", "widen", "string", "bptr"):
                blockers.append("%s %s" % (t, n))
        if not result and classify(f.ret) not in ("scalar", "widen", "void"):
            blockers.append("result %s" % f.ret)
        if blockers:
            errors.append("function policy %s still needs policy for %s"
                          % (key, ", ".join(blockers)))

    return errors


