POLICY_PATH = os.environ.get(
    "EMU68K_BRIDGE_POLICY",
    os.path.join(os.path.dirname(os.path.abspath(__file__)),
                 "emu68k-bridge-policy.json"))

# Where the BUILD put the generated proto headers. They are the authority on how
# a library's base is named and typed (the .conf does not always say), and a
# library without one cannot be compiled against at all - which makes the
# presence of the header the natural test for "can we generate for this".
GENINC = os.environ.get(
    "AROS_GENINC",
    os.path.expanduser("~/aros-build/bin/darwin-aarch64/gen/include"))

# The libraries a 68k Amiga program plausibly calls: the AmigaOS application
# surface. Every .conf in the tree is CLASSIFIED (see --report-all, 175 of them),
# but only these have code emitted - compiling all 175 would link the bridge
# against HIDDs, datatypes and internal modules that no 68k program opens.
GEN_LIBS = [
    "exec", "dos", "utility", "intuition", "graphics", "layers", "gadtools",
    "asl", "icon", "iffparse", "commodities", "diskfont", "locale", "keymap",
    "datatypes", "expansion", "cybergraphics", "mathffp", "mathieeesingbas",
