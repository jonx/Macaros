                        w("                    emu_nested_token_%d, &emu_facade_native->%s," %
                          (ni, native_field))
                        w("                    EMU_OBJ_%s, \"%s\", err, errlen) < 0)" %
                          (c_ident(nested_type), nested_type))
                        w("                return 1;")
                w("        }")
            if result_store_arg:
                store_index = [n for _t, n in f.args].index(result_store_arg)
                store_src = reg_expr(f.regs[store_index])
                w("        emu68k_scalar_to_guest(guest0, %s, 4, r->d[0]);"
                  % store_src)
        elif classify(f.ret) == "void":
            w("        %s%s;" % ("    " if policy else "", call))
            emit_heap_cleanup()
            emit_post(post)
        elif classify(f.ret) == "bptr":
            w("        %sr->d[0] = EMU_TOKEN(guest0, %s);   /* a BPTR crosses as a token */"
              % ("    " if policy else "", call))
            emit_heap_cleanup()
            emit_post(post, "r->d[0]")
        elif classify(f.ret) == "double":
            pad = "    " if policy else ""
            w("        %semu68k_double_out(%s, &r->d[0], &r->d[1]);" % (pad, call))
            emit_heap_cleanup()
            emit_post(post)
        else:
            note = ""
            if classify(f.ret) == "widen":
                note = "   /* narrowed: an integer, never an address */"
            w("        %sr->d[0] = (ULONG)%s;%s" %
              ("    " if policy else "", call, note))
            emit_heap_cleanup()
            emit_post(post, "r->d[0]")
        w("        %sreturn 0;" % ("    " if policy else ""))
        if policy:
            w("    }")
        n += 1
    w("    }")
    w("    return 1;   /* no safe generated crossing for this vector */")
    w("}")
    w("")
    return "\n".join(out), n


HEADER = '''/* GENERATED by graft/gen-emu68k-bridge - do not edit.
 *
 * The generated half of the 68k -> native library bridge. One entry point per
 * library; each returns 0 when it served the call and 1 when the vector is not
 * one it covers, so the hand-written bridge stays in charge of everything that
 * needs judgement.
 */

#ifndef EMU68K_GEN_H
#define EMU68K_GEN_H

#include <exec/types.h>
#include <dos/dos.h>          /* BPTR, for the handle table below */
#include <utility/hooks.h>
#include <intuition/classes.h>

struct TagItem;
struct EmuField;

struct Emu68kHookBridge
{
    struct Hook native;
    APTR state;
    ULONG guest_hook;
    ULONG entry;
    LONG failed;
    char error[160];
};

struct Emu68kBoopsiBridge
{
    struct Hook saved_dispatcher;
    APTR native_class;
    APTR state;
    ULONG guest_class;
    ULONG entry;
    LONG failed;
    char error[160];
};

/* The leading, stable part of the engine's 68k register file. The engine owns
 * the full struct; only these two arrays are contractual here. */
struct Emu68kRegs
{
    ULONG d[8];
    ULONG a[8];
};

/* A guest pointer becomes a host pointer by adding the guest base. Only memory
 * inside the guest arena may be handed to a native call this way. */
#define EMU_GPTR(g0, a)  ((APTR)((a) ? (UBYTE *)(g0) + (ULONG)(a) : NULL))

/* A BPTR cannot cross as itself: a native one is 64-bit and a 68k register is
 * not. These map between the guest's 32-bit token and the native BPTR it
 * stands for; both live in emu68k_oscall.c, which owns the table. */
BPTR  emu68k_handle_bptr(APTR guest0, ULONG token);
ULONG emu68k_handle_token(APTR guest0, BPTR b);
#define EMU_HANDLE(g0, t)  emu68k_handle_bptr((g0), (ULONG)(t))
#define EMU_TOKEN(g0, b)   emu68k_handle_token((g0), (b))

/* A 68k IEEE double is the raw bit pattern in a register pair, high half first.
 * Nothing is converted: the same 64 bits are handed to a native double, which is
 * the same format. The union is there so it is a reinterpretation and not a
 * numeric conversion. */
static inline double emu68k_double_in(ULONG hi, ULONG lo)
{
    union { double d; UQUAD q; } u;
    u.q = ((UQUAD)hi << 32) | (UQUAD)lo;
    return u.d;
}
static inline void emu68k_double_out(double v, ULONG *hi, ULONG *lo)
{
    union { double d; UQUAD q; } u;
    u.d = v;
    *hi = (ULONG)(u.q >> 32);
    *lo = (ULONG)u.q;
}

UQUAD emu68k_scalar_from_guest(APTR guest0, ULONG addr, UBYTE width);
void  emu68k_scalar_to_guest(APTR guest0, ULONG addr, UBYTE width, UQUAD value);
APTR  emu68k_scratch_alloc(ULONG size, char *err, ULONG errlen);
void  emu68k_scratch_free(APTR scratch, ULONG size);

/* Native OS objects cross as typed, per-run tokens. The table preserves
 * identity and reference counts, rejects stale/wrong-type tokens, and owns a
 * cleanup callback so objects still live at program exit are released. */
typedef void (*EmuObjectCleanup)(APTR base, APTR object);
LONG emu68k_object_from_guest(APTR guest0, ULONG token, UWORD type,
                              BOOL nullable, const char *type_name,
                              APTR *native, char *err, ULONG errlen);
LONG emu68k_object_to_guest(APTR guest0, APTR native, UWORD type,
                            APTR base, EmuObjectCleanup cleanup,
                            const char *type_name, ULONG *token,
                            char *err, ULONG errlen);
LONG emu68k_object_to_guest_facade(APTR guest0, APTR native, UWORD type,
                                   APTR base, EmuObjectCleanup cleanup,
                                   const char *type_name, ULONG facade_size,
                                   const struct EmuField *fields, int field_count,
                                   ULONG *token, char *err, ULONG errlen);
LONG emu68k_object_alias_to_guest(APTR guest0, ULONG token, APTR native,
                                  UWORD type, const char *type_name,
                                  char *err, ULONG errlen);
void emu68k_object_release(APTR guest0, ULONG token, UWORD type);
void emu68k_object_consume(APTR guest0, ULONG token, UWORD type);
void emu68k_object_consume_native(APTR guest0, APTR native, UWORD type);
LONG emu68k_hook_prepare(APTR guest0, ULONG guest_hook,
                         struct Emu68kHookBridge *bridge,
                         char *err, ULONG errlen);
LONG emu68k_hook_finish(const struct Emu68kHookBridge *bridge,
                        char *err, ULONG errlen);
LONG emu68k_boopsi_prepare(APTR guest0, ULONG guest_class, APTR native_class,
                           struct Emu68kBoopsiBridge *bridge,
                           char *err, ULONG errlen);
LONG emu68k_boopsi_finish(struct Emu68kBoopsiBridge *bridge,
                          char *err, ULONG errlen);

/* Policy-compiled TagItem values. A domain names every accepted tag and the
 * type of ti_Data. Unknown/refused tags fail the crossing; they are never
 * forwarded as if every IPTR were a scalar. */
#define EMU_TAG_U32     0
#define EMU_TAG_CSTR    1
#define EMU_TAG_REFUSE  2
#define EMU_TAG_STRUCT  3   /* ti_Data is a guest pointer to a value structure */
#define EMU_TAG_NULL    4   /* pointer-valued tag accepted only when NULL       */
#define EMU_TAG_U16_FFFF 5  /* guest UWORD array terminated by 0xffff           */
#define EMU_TAG_RGB32    6  /* LoadRGB32 block stream terminated by zero         */
#define EMU_TAG_OBJECT   7  /* typed native object represented by a guest token  */
#define EMU_TAG_OUT_U32  8  /* ti_Data points at a guest ULONG copyback slot      */
struct EmuTagOutSlot
{
    IPTR value;             /* first: native ti_Data can point at the whole slot */
    ULONG guest_addr;
};
struct EmuTagDesc
{
    ULONG tag;
    UBYTE kind;
    const char *name;
    /* EMU_TAG_STRUCT only: how to rebuild what ti_Data points at. The native
     * copy lives in the caller's scratch and is valid for the call, which is
     * why a structure tag is only described for calls that consume it rather
     * than retain it. */
    const struct EmuField *fields;
    UWORD nfields;
    UWORD guest_size;
    UWORD native_size;
    UWORD object_type;
    UBYTE object_nullable;
};
struct EmuTagDomain
{
    const struct EmuTagDesc *tags;
    UWORD count;
    const char *name;
};
LONG emu68k_tags_to_native(APTR guest0, ULONG guest_tags,
                           const struct EmuTagDomain *domain,
                           struct TagItem *native_tags, ULONG capacity,
                           APTR scratch, ULONG scratch_size,
                           char *err, ULONG errlen);
LONG emu68k_tags_to_guest(APTR guest0, struct TagItem *native_tags,
                          ULONG count, const struct EmuTagDomain *domain,
                          char *err, ULONG errlen);
LONG emu68k_rgb32_to_native(APTR guest0, ULONG guest_table,
                            ULONG *native_table, ULONG capacity,
                            const char *what, char *err, ULONG errlen);

LONG emu68k_require_guest_range(ULONG guest_addr, ULONG length,
                                const char *what, char *err, ULONG errlen);
void emu68k_to_guest(APTR guest0, ULONG gbase, const void *native,
                     const struct EmuField *fields, int count);
void emu68k_from_guest(APTR guest0, ULONG gbase, void *native,
                       const struct EmuField *fields, int count);
/* The same conversions bounded by how much of the GUEST structure the caller
 * asked for; a field straddling the bound is left alone rather than clipped. */
#define EMU_NO_LIMIT 0xffffffffUL
void emu68k_to_guest_sized(APTR guest0, ULONG gbase, const void *native,
                           const struct EmuField *fields, int count, ULONG limit);
void emu68k_from_guest_sized(APTR guest0, ULONG gbase, void *native,
                             const struct EmuField *fields, int count, ULONG limit);
#define EMU_NFIELDS(a) ((int)(sizeof(a) / sizeof((a)[0])))

%s
#endif /* EMU68K_GEN_H */
'''


def emit(outdir, check=False):
    """Write the generated sources, or with check=True only verify that what is
    on disk is what this generator would produce. The sources are checked in so
    the OS tree builds without python, which makes drift possible: a hand edit
    to a generated file, or a .conf change upstream that nobody regenerated
    for. This is what catches both."""
    targets = gen_targets()
    errors = validate_policy(targets)
    if errors:
        print("BRIDGE POLICY INVALID:")
        for e in errors:
            print("  ! %s" % e)
        return 1
    object_types = POLICY.get("object_types", {})
    object_enum = ["enum"]
    object_enum.append("{")
    for name, spec in sorted(object_types.items(), key=lambda kv: kv[1]["id"]):
        object_enum.append("    EMU_OBJ_%s = %d," % (c_ident(name), spec["id"]))
    object_enum.append("};")
    protos, total = ["\n".join(object_enum)], 0
    stale, emitted = [], []
    for lib, rel, base, btype, hdr in targets:
        funcs = parse_conf(os.path.join(AROS, rel))
        if funcs is None:
            continue
        src, n = emit_lib(lib, rel, base, btype, hdr, funcs)
        short = lib.split(".")[0]
        path = os.path.join(outdir, "emu68k_gen_%s.c" % short)
        if check:
            cur = open(path).read() if os.path.exists(path) else None
            if cur != src:
                stale.append(path)
        else:
            with open(path, "w") as fh:
                fh.write(src)
        protos.append("int emu68k_gen_%s(int lvo, struct Emu68kRegs *r,\n"
                      "                  APTR guest0, APTR base,\n"
                      "                  char *err, ULONG errlen);" % short)
        emitted.append(short)
        print("  %-28s %3d crossings" % (os.path.basename(path), n))
        total += n
    # The two places that have to know the SAME set of library names: the
    # dispatch table that routes a call to its generated crossings, and the
    # host's list of names it hands the guest a native base for. Both were
    # written by hand and both drifted the first time a library was added, so
    # both are emitted from the set that was actually generated.
    protos.append("\n".join(
        ["/* name, generated entry point, and where its base comes from. */",
         "#define EMU68K_GEN_LIBS(X) \\"] +
        ['    X("%s.library", emu68k_gen_%s, GENBASE_%s) \\'
         % (s, s, {"dos": "DOS", "exec": "EXEC"}.get(s, "OPEN"))
         for s in emitted] +
        ["    /* end */"]))
    hpath = os.path.join(outdir, "emu68k_gen.h")
    hsrc = HEADER % "\n".join(protos)
    # The host service decides which library names it answers with a native
    # base rather than looking for a 68k one on disk. That set is exactly the
    # set generated here: offering a name with no crossings behind it means the
    # program's first call to it is a capability gap, and NOT offering a name
    # we generated for sends it looking for a disk library that is not there.
    host_path = os.path.join(os.path.dirname(os.path.abspath(__file__)),
                             "..", "hosted", "emu68k", "emu68k_genlibs.h")
    host_src = ("/* GENERATED by graft/gen-emu68k-bridge - do not edit.\n"
                " *\n"
                " * The libraries the bridge has generated crossings for, and\n"
                " * therefore the ones the guest is given a native base for.\n"
                " */\n\n"
                "#ifndef EMU68K_GENLIBS_H\n"
                "#define EMU68K_GENLIBS_H\n\n"
                "#define EMU68K_SERVABLE_LIBS(X) \\\n"
                + "".join('    X("%s.library") \\\n' % s for s in emitted)
                + "    /* end */\n\n"
                "#endif /* EMU68K_GENLIBS_H */\n")
    if check:
        cur = open(hpath).read() if os.path.exists(hpath) else None
        if cur != hsrc:
            stale.append(hpath)
        cur = (open(host_path).read()
               if os.path.exists(host_path) else None)
        if cur != host_src:
            stale.append(os.path.normpath(host_path))
        if stale:
            print("STALE - regenerate with --emit:")
            for x in stale:
                print("  %s" % x)
            return 1
        print("generated sources are in sync with the .conf files (%d crossings)"
              % total)
        return 0
    with open(hpath, "w") as fh:
        fh.write(hsrc)
    with open(host_path, "w") as fh:
        fh.write(host_src)
    print("  %-28s %3d total" % ("emu68k_gen.h", total))
    return 0


def report_all():
    """Classify EVERY library in the tree. Nothing is compiled, so this needs no
    proto headers - it is the complete work queue, and it is what says the
    remaining effort is a list of TYPES rather than a list of functions."""
    import collections
    tot = t1 = 0
    types = collections.Counter()
    libs = 0
    for lib, rel, _b, _t, _h in all_targets():
        funcs = parse_conf(os.path.join(AROS, rel))
        if not funcs:
            continue
        libs += 1
        for f in funcs:
            if f.private:
                continue
            tot += 1
            if f.tier(lib)[0] == 1:
                t1 += 1
                continue
            for t, n in f.args:
                if classify(t) == "struct":
                    types[norm(t)] += 1
            if classify(f.ret) == "struct":
                types[norm(f.ret)] += 1
            if classify(f.ret) == "bptr" or any(classify(t) == "bptr" for t, _ in f.args):
                types["BPTR (the handle table)"] += 1

    print("%d libraries, %d public vectors" % (libs, tot))
    print("  tier 1, generated free:  %5d  (%.0f%%)" % (t1, 100.0 * t1 / max(1, tot)))
    print("  needs a type described:  %5d" % (tot - t1))
    print("\nthe types that block the most vectors (describe one, unlock all):")
    cum = 0
    for i, (t, c) in enumerate(types.most_common(25), 1):
        cum += c
        print("  %2d. %-34s %4d   (cumulative %d of %d)"
              % (i, t[:34], c, cum, tot - t1))
    print("\n%d distinct blocking types in total" % len(types))
    return 0


POLICY_ORIGIN_KEY = "origin"


def promote_import(name, apply_changes=True):
    """Merge a library's source-inferred crossings into the ACTIVE policy.

    The active policy is where hand decisions live, and a regeneration must
    never cost one. So every entry carries its provenance:

      origin "import"  - written by this command, refreshed by this command
      origin "review"  - decided by a person; the importer will not touch it
      (absent)         - treated as "review", because everything written before
                         provenance existed was written by hand

    A proposal that disagrees with a review-owned entry is REPORTED, not
    applied. That is the whole point: the tool can be re-run at any time, and
    the only thing it can lose is its own previous opinion."""
    short = name[:-8] if name.endswith(".library") else name
    packet = os.path.join(
        os.path.dirname(os.path.dirname(os.path.abspath(__file__))),
        "build", "emu68k-import", short, "manifest.json")
    if not os.path.exists(packet):
        print("no import packet for %s; run --import-library %s first"
              % (name, name), file=sys.stderr)
        return 2
    with open(packet, encoding="utf-8") as fh:
        manifest = json.load(fh)
    inferred = manifest.get("inferred_functions", {})

    with open(POLICY_PATH, encoding="utf-8") as fh:
        active = json.load(fh)
    functions = active.setdefault("functions", {})

    added, refreshed, kept, unchanged = [], [], [], []
    for key, proposal in sorted(inferred.items()):
        existing = functions.get(key)
        if existing is None:
            entry = dict(proposal)
            entry[POLICY_ORIGIN_KEY] = "import"
            functions[key] = entry
            added.append(key)
            continue
        if existing.get(POLICY_ORIGIN_KEY) != "import":
            kept.append(key)                      # a person owns this one
            continue
        current = {k: v for k, v in existing.items() if k != POLICY_ORIGIN_KEY}
        if current == proposal:
            unchanged.append(key)
            continue
        entry = dict(proposal)
        entry[POLICY_ORIGIN_KEY] = "import"
        functions[key] = entry
        refreshed.append(key)

    print("%s: %d inferred crossings" % (name, len(inferred)))
    print("  added      %d" % len(added))
    print("  refreshed  %d" % len(refreshed))
    print("  unchanged  %d" % len(unchanged))
    print("  kept (a review decision owns the entry) %d" % len(kept))
    for key in kept:
        print("    ! %s" % key)

    if not apply_changes:
        drift = added or refreshed
        if drift:
            print("STALE: the active policy is missing %d inferred crossings"
                  % len(drift))
            return 1
        return 0
    if added or refreshed:
        with open(POLICY_PATH, "w", encoding="utf-8") as fh:
            json.dump(active, fh, indent=2)
            fh.write("\n")
        print("  wrote %s" % POLICY_PATH)
    return 0


def main():
    if "--promote-import" in sys.argv or "--check-promotion" in sys.argv:
        option = ("--promote-import" if "--promote-import" in sys.argv
                  else "--check-promotion")
        i = sys.argv.index(option)
        if i + 1 >= len(sys.argv) or sys.argv[i + 1].startswith("-"):
            print("%s requires one AROS library name" % option, file=sys.stderr)
            return 2
        return promote_import(sys.argv[i + 1],
                              apply_changes=(option == "--promote-import"))
    errors = validate_policy(gen_targets())
    if errors:
        print("BRIDGE POLICY INVALID:")
        for e in errors:
            print("  ! %s" % e)
        return 1
    if "--import-library" in sys.argv or "--check-import" in sys.argv:
        option = "--import-library" if "--import-library" in sys.argv else "--check-import"
        i = sys.argv.index(option)
        if i + 1 >= len(sys.argv) or sys.argv[i + 1].startswith("-"):
            print("%s requires one AROS library name" % option, file=sys.stderr)
            return 2
        output_dir = None
        if "--output-dir" in sys.argv:
            oi = sys.argv.index("--output-dir")
            if oi + 1 >= len(sys.argv):
                print("--output-dir requires a path", file=sys.stderr)
                return 2
            output_dir = sys.argv[oi + 1]
        return import_library(sys.argv[i + 1], output_dir,
                              check=(option == "--check-import"))
    if "--analyze-source" in sys.argv:
        i = sys.argv.index("--analyze-source")
        which = []
        for arg in sys.argv[i + 1:]:
            if arg.startswith("-"):
                break
            which.extend(x for x in arg.split(",") if x)
        return analyze_sources(which)
    if "--emit" in sys.argv:
        i = sys.argv.index("--emit")
        return emit(sys.argv[i + 1])
    if "--report-all" in sys.argv:
        return report_all()
    if "--check" in sys.argv:
        i = sys.argv.index("--check")
        return emit(sys.argv[i + 1], check=True)
    if "--list" in sys.argv:
        which = [a for a in sys.argv[1:] if not a.startswith("-")]
        for lib, rel, base, btype, hdr in gen_targets():
            if which and lib.split(".")[0] not in which:
                continue
            funcs = parse_conf(os.path.join(AROS, rel)) or []
            print("== %s" % lib)
            for f in funcs:
                if f.tier(lib)[0] != 1:
                    continue
                sig = ", ".join("%s %s %s" % (t, n, r)
                                for (t, n), r in zip(f.args, f.regs)) or "void"
                print("  %4d %-6d %-22s %-10s (%s)%s"
                      % (f.lvo, f.offset, f.name, norm(f.ret), sig,
                         "  [DENIED: %s]" % DENY[(lib, f.name)]
                         if (lib, f.name) in DENY else ""))
        return 0
    total1 = total = 0
    reasons = {}
    fail = False
    for lib, rel, base, btype, hdr in gen_targets():
        path = os.path.join(AROS, rel)
        funcs = parse_conf(path)
        if funcs is None:
            print("%-20s MISSING %s" % (lib, rel))
            continue
        bad = selfcheck(lib, funcs)
        t1 = [f for f in funcs if f.tier(lib)[0] == 1]
        pub = [f for f in funcs if not f.private]
        total1 += len(t1)
        total += len(pub)
        print("%-20s %4d vectors  %4d public  %4d tier-1 (%.0f%%)  %s"
              % (lib, len(funcs), len(pub), len(t1),
                 100.0 * len(t1) / max(1, len(pub)),
                 "OK" if not bad else "LVO SELF-CHECK FAILED"))
        for b in bad:
            fail = True
            print("      ! %s" % b)
        for f in pub:
            if f.tier(lib)[0] != 1:
                reason = f.tier(lib)[1] or "generated semantic policy"
                reasons.setdefault(reason, []).append("%s.%s" % (lib.split(".")[0], f.name))

    print("\ntotal: %d of %d public vectors are tier 1 (%.0f%%)"
          % (total1, total, 100.0 * total1 / max(1, total)))
    print("\nwhat keeps the rest out, most common first:")
    for r, fs in sorted(reasons.items(), key=lambda kv: -len(kv[1]))[:18]:
        print("  %4d  %-42s e.g. %s" % (len(fs), r[:42], ", ".join(fs[:3])))

    return 1 if fail else 0


if __name__ == "__main__":
    sys.exit(main())
