                    w("                             emu_fields_%s, EMU_NFIELDS(emu_fields_%s), %s);"
                      % (stype, stype, span))
                    for fi, (field, fp) in enumerate(sp.get("fields", {}).items()):
                        kind = fp["kind"]
                        w("        ULONG emu_struct_field_%d_%d = (ULONG)" % (ai, fi))
                        w("            emu68k_scalar_from_guest(guest0, %s + M68K_%s_%s, 4);"
                          % (src, stype, field))
                        if kind == "cstr":
                            w("        if (emu_struct_field_%d_%d &&" % (ai, fi))
                            w("            emu68k_require_guest_range(emu_struct_field_%d_%d, 1,"
                              % (ai, fi))
                            w('                "%s.%s.%s", err, errlen) < 0)'
                              % (f.name, aname, field))
                            w("            return 1;")
                            if not fp.get("nullable", True):
                                w("        if (!emu_struct_field_%d_%d)" % (ai, fi))
                                w("        {")
                                w("            if (err && errlen)")
                                w('                snprintf(err, errlen, "%s.%s.%s requires non-NULL");'
                                  % (f.name, aname, field))
                                w("            return 1;")
                                w("        }")
                            w("        emu_struct_%d.%s = (__typeof__(emu_struct_%d.%s))"
                              "EMU_GPTR(guest0, emu_struct_field_%d_%d);"
                              % (ai, field, ai, field, ai, fi))
                        elif kind == "guest_value":
                            w("        emu_struct_%d.%s = (__typeof__(emu_struct_%d.%s))"
                              "(IPTR)emu_struct_field_%d_%d;"
                              % (ai, field, ai, field, ai, fi))
                        elif kind == "object":
                            nested_type = fp["type"]
                            w("        APTR emu_struct_object_%d_%d;" % (ai, fi))
                            w("        if (emu68k_object_from_guest(guest0, emu_struct_field_%d_%d,"
                              % (ai, fi))
                            w("                EMU_OBJ_%s, %d, \"%s\", &emu_struct_object_%d_%d,"
                              % (c_ident(nested_type),
                                 1 if fp.get("nullable", True) else 0,
                                 nested_type, ai, fi))
                            w("                err, errlen) < 0)")
                            w("            return 1;")
                            w("        emu_struct_%d.%s = (__typeof__(emu_struct_%d.%s))"
                              "emu_struct_object_%d_%d;"
                              % (ai, field, ai, field, ai, fi))
                        elif kind == "struct":
                            nested_struct = fp["type"]
                            w("        struct %s emu_struct_nested_%d_%d;"
                              % (nested_struct, ai, fi))
                            w("        memset(&emu_struct_nested_%d_%d, 0,"
                              " sizeof(emu_struct_nested_%d_%d));" % (ai, fi, ai, fi))
                            w("        if (emu_struct_field_%d_%d)" % (ai, fi))
                            w("        {")
                            w("            if (emu68k_require_guest_range(emu_struct_field_%d_%d,"
                              % (ai, fi))
                            w("                    M68K_%s_SIZEOF, \"%s.%s.%s\", err, errlen) < 0)"
                              % (nested_struct, f.name, aname, field))
                            w("                return 1;")
                            w("            emu68k_from_guest_sized(guest0, emu_struct_field_%d_%d,"
                              % (ai, fi))
                            w("                &emu_struct_nested_%d_%d, emu_fields_%s,"
                              % (ai, fi, nested_struct))
                            w("                EMU_NFIELDS(emu_fields_%s), M68K_%s_SIZEOF);"
                              % (nested_struct, nested_struct))
                            for nfi, (nested_field, nested_fp) in enumerate(
                                    fp.get("fields", {}).items()):
                                nested_kind = nested_fp["kind"]
                                w("            ULONG emu_struct_nested_field_%d_%d_%d = (ULONG)"
                                  % (ai, fi, nfi))
                                w("                emu68k_scalar_from_guest(guest0, "
                                  "emu_struct_field_%d_%d + M68K_%s_%s, 4);"
                                  % (ai, fi, nested_struct, nested_field))
                                if nested_kind == "cstr":
                                    w("            if (emu_struct_nested_field_%d_%d_%d &&"
                                      % (ai, fi, nfi))
                                    w("                emu68k_require_guest_range("
                                      "emu_struct_nested_field_%d_%d_%d, 1,"
                                      % (ai, fi, nfi))
                                    w('                    "%s.%s.%s.%s", err, errlen) < 0)'
                                      % (f.name, aname, field, nested_field))
                                    w("                return 1;")
                                    if not nested_fp.get("nullable", True):
                                        w("            if (!emu_struct_nested_field_%d_%d_%d)"
                                          % (ai, fi, nfi))
                                        w("            {")
                                        w("                if (err && errlen)")
                                        w('                    snprintf(err, errlen, '
                                          '"%s.%s.%s.%s requires non-NULL");'
                                          % (f.name, aname, field, nested_field))
                                        w("                return 1;")
                                        w("            }")
                                    w("            emu_struct_nested_%d_%d.%s = "
                                      "(__typeof__(emu_struct_nested_%d_%d.%s))"
                                      "EMU_GPTR(guest0, emu_struct_nested_field_%d_%d_%d);"
                                      % (ai, fi, nested_field, ai, fi, nested_field,
                                         ai, fi, nfi))
                                elif nested_kind == "guest_value":
                                    w("            emu_struct_nested_%d_%d.%s = "
                                      "(__typeof__(emu_struct_nested_%d_%d.%s))"
                                      "(IPTR)emu_struct_nested_field_%d_%d_%d;"
                                      % (ai, fi, nested_field, ai, fi, nested_field,
                                         ai, fi, nfi))
                                elif nested_kind == "object":
                                    nested_object_type = nested_fp["type"]
                                    w("            APTR emu_struct_nested_object_%d_%d_%d;"
                                      % (ai, fi, nfi))
                                    w("            if (emu68k_object_from_guest(guest0, "
                                      "emu_struct_nested_field_%d_%d_%d,"
                                      % (ai, fi, nfi))
                                    w("                    EMU_OBJ_%s, %d, \"%s\","
                                      % (c_ident(nested_object_type),
                                         1 if nested_fp.get("nullable", True) else 0,
                                         nested_object_type))
                                    w("                    &emu_struct_nested_object_%d_%d_%d, "
                                      "err, errlen) < 0)" % (ai, fi, nfi))
                                    w("                return 1;")
                                    w("            emu_struct_nested_%d_%d.%s = "
                                      "(__typeof__(emu_struct_nested_%d_%d.%s))"
                                      "emu_struct_nested_object_%d_%d_%d;"
                                      % (ai, fi, nested_field, ai, fi, nested_field,
                                         ai, fi, nfi))
                            w("            emu_struct_%d.%s = &emu_struct_nested_%d_%d;"
                              % (ai, field, ai, fi))
                            w("        }")
                            if not fp.get("nullable", True):
                                w("        else")
                                w("        {")
                                w("            if (err && errlen)")
                                w('                snprintf(err, errlen, "%s.%s.%s requires non-NULL");'
                                  % (f.name, aname, field))
                                w("            return 1;")
                                w("        }")
                if direction in ("out", "inout"):
                    # Blanking first is right when the call fills the whole
                    # structure: a field it chose not to set must not read as
                    # leftovers. It is WRONG when the call sets only some
                    # fields, or when the structure holds anything the tables
                    # cannot convert (guest pointers the program put there
                    # itself), because those are the program's, not the OS's.
                    lines = []
                    if sp.get("clear", True):
                        lines.append("memset(EMU_GPTR(guest0, %s), 0, %s);"
                                     % (src, span))
                    lines += ["emu68k_to_guest_sized(guest0, %s, &emu_struct_%d," % (src, ai),
                              "                   emu_fields_%s, EMU_NFIELDS(emu_fields_%s), %s);"
                              % (stype, stype, span)]
                    post.append((lines, sp.get("copy_on", "always")))
                call_args.append("(%s)&emu_struct_%d" % (norm(atype), ai))
                continue
            if aname in tagged_structs:
                call_args.append("(%s)emu_tagged_native_%d" % (norm(atype), ai))
                continue
            if aname in tagged_size_args:
                call_args.append("(%s)%s" % (norm(atype), tagged_size_args[aname]))
                continue
            if aname in size_args:
                call_args.append("(%s)%s" % (norm(atype), size_args[aname]))
                continue
            if aname in pointers:
                pp = pointers[aname]
                direction = pp["direction"]
                width = POINTER_SCALARS[pp["kind"]][1]
                base_type = norm(re.sub(r"\s*\*\s*$", "", atype))
                w("        %s emu_scalar_%d = 0;" % (base_type, ai))
                w("        if (emu68k_require_guest_range(%s, %d,"
                  % (src, width))
                w('                                         "%s.%s", err, errlen) < 0)'
                  % (f.name, aname))
                w("            return 1;")
                if direction in ("in", "inout"):
                    w("        emu_scalar_%d = (%s)emu68k_scalar_from_guest(guest0, %s, %d);"
