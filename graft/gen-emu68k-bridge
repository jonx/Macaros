# semantic policy validation
# ---------------------------------------------------------------------------

TAG_KINDS = {"u32": "EMU_TAG_U32", "cstr": "EMU_TAG_CSTR",
             "refuse": "EMU_TAG_REFUSE", "struct": "EMU_TAG_STRUCT",
             "null": "EMU_TAG_NULL", "u16_ffff": "EMU_TAG_U16_FFFF",
             "rgb32": "EMU_TAG_RGB32", "object": "EMU_TAG_OBJECT"}


def policy_key(lib, f):
    return "%s.%s" % (lib, f.name)


def function_policy(lib, f):
    return POLICY.get("functions", {}).get(policy_key(lib, f))


def c_ident(s):
    return re.sub(r"[^A-Za-z0-9_]", "_", s)


def object_canon(t):
    """Compare an object's pointer type without const qualification. Policy
    names identity classes, so `struct Locale *` and `const struct Locale *`
    are the same class while unrelated pointer types must still be rejected."""
    t = re.sub(r"\b(const|CONST)\b", "", norm(t))
    t = re.sub(r"\s*\*\s*", " *", t)
    return norm(t)


def validate_policy(targets):
    """Refuse stale names and unsafe shapes before emitting any C. A policy
    typo must fail the build, not quietly leave the intended vector uncovered."""
    domains = POLICY.get("tag_domains", {})
    object_types = POLICY.get("object_types", {})
    errors = []
    bykey = {}
    for lib, rel, _base, _btype, _hdr in targets:
        for f in parse_conf(os.path.join(AROS, rel)) or []:
            bykey[policy_key(lib, f)] = f

    seen_object_ids = set()
    for name, o in object_types.items():
        oid = o.get("id")
        ctype = o.get("c_type")
        destructor = o.get("destructor")
        if not re.fullmatch(r"[A-Za-z_]\w*", name):
            errors.append("object type %r has an invalid name" % name)
        if not isinstance(oid, int) or oid < 1 or oid > 255:
            errors.append("object type %s id must be 1..255" % name)
        elif oid in seen_object_ids:
            errors.append("object type %s repeats id %d" % (name, oid))
        seen_object_ids.add(oid)
        pointer_typedef = o.get("pointer_typedef", False)
        if pointer_typedef not in (True, False):
            errors.append("object type %s pointer_typedef must be boolean" % name)
        typedef_pointer = (pointer_typedef and isinstance(ctype, str) and
                           re.fullmatch(r"[A-Za-z_]\w*", ctype))
        if (not isinstance(ctype, str) or
                (classify(ctype) not in ("struct", "aptr") and not typedef_pointer)):
            errors.append("object type %s has invalid pointer c_type %r" % (name, ctype))
        if o.get("kind") not in ("opaque", "facade"):
            errors.append("object type %s kind must be opaque or facade" % name)
        if o.get("kind") == "facade" and not re.fullmatch(
                r"[A-Za-z_]\w*", o.get("facade_struct", "")):
            errors.append("object type %s facade_struct is invalid" % name)
        if o.get("facade_size") is not None and (
                o.get("kind") != "facade" or
                not isinstance(o.get("facade_size"), int) or o["facade_size"] < 1):
            errors.append("object type %s facade_size needs a positive facade" % name)
        nested_fields = o.get("nested_fields", [])
        if not isinstance(nested_fields, list):
            errors.append("object type %s nested_fields must be a list" % name)
            nested_fields = []
        if nested_fields and o.get("kind") != "facade":
            errors.append("object type %s nested fields need a facade" % name)
        seen_nested = set()
        for nested in nested_fields:
            field = nested.get("field") if isinstance(nested, dict) else None
            kind = nested.get("kind") if isinstance(nested, dict) else None
            if not isinstance(field, str) or not re.fullmatch(r"[A-Za-z_]\w*", field):
                errors.append("object type %s has invalid nested field" % name)
                continue
            native_field = nested.get("native_field", field)
            if not isinstance(native_field, str) or not re.fullmatch(
                    r"[A-Za-z_]\w*(\.[A-Za-z_]\w*)*", native_field):
                errors.append("object type %s nested field %s has invalid native_field"
                              % (name, field))
            if field in seen_nested:
                errors.append("object type %s repeats nested field %s" % (name, field))
            seen_nested.add(field)
            if kind == "u16_array":
                if not re.fullmatch(r"[A-Za-z_]\w*", nested.get("count_field", "")):
                    errors.append("object type %s nested field %s needs count_field"
                                  % (name, field))
                count = nested.get("max_count")
                if not isinstance(count, int) or count < 1 or count > 1024:
                    errors.append("object type %s nested field %s needs max_count 1..1024"
                                  % (name, field))
            elif kind in ("object", "embedded_object"):
                nested_type = nested.get("type")
                if nested_type not in object_types:
                    errors.append("object type %s nested field %s uses missing object %s"
                                  % (name, field, nested_type))
            else:
                errors.append("object type %s nested field %s has invalid kind %r"
                              % (name, field, kind))
        if destructor is not None:
            df = bykey.get(destructor)
            if not isinstance(destructor, str) or not df:
                errors.append("object type %s has invalid destructor %r" % (name, destructor))
            elif (classify(df.ret) not in ("void", "scalar") or len(df.args) != 1 or
                  object_canon(df.args[0][0]) != object_canon(ctype)):
                errors.append("object type %s destructor %s has incompatible signature"
                              % (name, destructor))

    for name, d in domains.items():
        if not re.fullmatch(r"[A-Za-z0-9_.-]+", name):
            errors.append("tag domain %r has an invalid name" % name)
        cap = d.get("max_items")
        if not isinstance(cap, int) or cap < 1 or cap > 256:
            errors.append("tag domain %s max_items must be 1..256" % name)
        tags = d.get("tags")
        if not isinstance(tags, list):
            errors.append("tag domain %s tags must be a list" % name)
            continue
        seen = set()
        for t in tags:
            macro, kind = t.get("name"), t.get("kind")
            if not isinstance(macro, str) or not re.fullmatch(r"[A-Za-z_]\w*", macro):
                errors.append("tag domain %s has invalid macro %r" % (name, macro))
            elif macro in seen:
                errors.append("tag domain %s repeats %s" % (name, macro))
            seen.add(macro)
            if kind not in TAG_KINDS:
                errors.append("tag domain %s tag %s has unknown kind %r"
                              % (name, macro, kind))
            elif kind == "struct" and not re.fullmatch(
                    r"[A-Za-z_]\w*", t.get("type", "")):
                errors.append("tag domain %s tag %s needs a structure type"
                              % (name, macro))
            elif kind == "u16_ffff" and (not isinstance(t.get("max_count"), int) or
                                           t["max_count"] < 1 or t["max_count"] > 256):
                errors.append("tag domain %s tag %s needs max_count 1..256"
                              % (name, macro))
            elif kind == "rgb32" and (not isinstance(t.get("max_longs"), int) or
                                       t["max_longs"] < 1 or t["max_longs"] > 4096):
                errors.append("tag domain %s tag %s needs max_longs 1..4096"
                              % (name, macro))
            elif kind == "object":
                if t.get("type") not in object_types:
                    errors.append("tag domain %s tag %s uses missing object type %r"
                                  % (name, macro, t.get("type")))
                if t.get("nullable", True) not in (True, False):
                    errors.append("tag domain %s tag %s nullable must be boolean"
                                  % (name, macro))
            fallback = t.get("fallback_cstr_field")
            if fallback is not None:
                if kind != "struct" or not isinstance(fallback, dict):
                    errors.append("tag domain %s tag %s string fallback needs a structure"
                                  % (name, macro))
                elif (not re.fullmatch(r"[A-Za-z_]\w*", fallback.get("field", "")) or
                      not isinstance(fallback.get("value"), str) or
                      not fallback["value"] or "\0" in fallback["value"]):
                    errors.append("tag domain %s tag %s has invalid string fallback"
                                  % (name, macro))
            tag_fallback = t.get("fallback")
            if tag_fallback is not None and tag_fallback != "omit":
                errors.append("tag domain %s tag %s has invalid fallback"
                              % (name, macro))

    for key, p in POLICY.get("functions", {}).items():
        f = bykey.get(key)
        if not f:
            errors.append("function policy %s does not name a public .conf vector" % key)
            continue
        if f.private:
            errors.append("function policy %s names a private vector" % key)
        taglists = p.get("taglists", {})
        structs = p.get("structs", {})
        tagged_structs = p.get("tagged_structs", {})
        objects = p.get("objects", {})
        callbacks = p.get("callbacks", {})
        pointers = p.get("pointers", {})
        arrays = p.get("arrays", {})
        guest_values = p.get("guest_values", [])
        strings = p.get("strings", [])
        null_args = p.get("null_args", [])
        boopsi = p.get("boopsi")
        args = {n: t for t, n in f.args}
        for arg, domain in taglists.items():
            if arg not in args:
                errors.append("function policy %s names missing argument %s" % (key, arg))
            elif "TagItem" not in args[arg] or "*" not in args[arg]:
                errors.append("function policy %s argument %s is not a TagItem pointer"
                              % (key, arg))
            if domain not in domains:
                errors.append("function policy %s uses missing tag domain %s"
                              % (key, domain))
        for arg, sp in structs.items():
            stype, direction = sp.get("type"), sp.get("direction")
            if arg not in args:
                errors.append("function policy %s names missing argument %s" % (key, arg))
            elif (not isinstance(stype, str) or
                  "struct %s" % stype not in norm(args[arg]) or
                  "*" not in args[arg]):
                errors.append("function policy %s argument %s is not struct %s *"
                              % (key, arg, stype))
            if direction not in ("in", "out", "inout"):
                errors.append("function policy %s struct %s has invalid direction %r"
                              % (key, arg, direction))
            if sp.get("clear", True) not in (True, False):
                errors.append("function policy %s struct %s clear must be boolean"
                              % (key, arg))
            copy_on = sp.get("copy_on", "always")
            if copy_on not in ("always", "nonzero"):
                errors.append("function policy %s struct %s has invalid copy_on %r"
                              % (key, arg, copy_on))
            elif copy_on == "nonzero" and classify(f.ret) not in ("scalar", "widen"):
                errors.append("function policy %s struct %s copy_on nonzero needs scalar result"
                              % (key, arg))
            size_arg = sp.get("size_arg")
            if size_arg is not None:
                if size_arg not in args:
                    errors.append("function policy %s struct %s names missing size argument %s"
                                  % (key, arg, size_arg))
                elif norm(args[size_arg]) not in SIZE_WIDTHS:
                    errors.append("function policy %s size argument %s is %s, not a scalar count"
                                  % (key, size_arg, norm(args[size_arg])))
                if size_arg == arg:
                    errors.append("function policy %s struct %s cannot be its own size"
                                  % (key, arg))
            if arg in taglists:
                errors.append("function policy %s argument %s has two policies" % (key, arg))
        for arg, sp in tagged_structs.items():
            tag_arg, size_arg = sp.get("tag_arg"), sp.get("size_arg")
            variants = sp.get("variants")
            if arg not in args:
                errors.append("function policy %s names missing tagged buffer %s" % (key, arg))
            elif "*" not in args[arg]:
                errors.append("function policy %s tagged buffer %s is not a pointer" % (key, arg))
            if tag_arg not in args or (tag_arg in args and
                                       norm(args[tag_arg]) not in SIZE_WIDTHS):
                errors.append("function policy %s tagged buffer %s has invalid tag argument %r"
                              % (key, arg, tag_arg))
            if size_arg not in args or (size_arg in args and
                                        norm(args[size_arg]) not in SIZE_WIDTHS):
                errors.append("function policy %s tagged buffer %s has invalid size argument %r"
                              % (key, arg, size_arg))
            if sp.get("direction") != "out":
                errors.append("function policy %s tagged buffer %s currently requires direction out"
                              % (key, arg))
            if not isinstance(variants, dict) or not variants:
                errors.append("function policy %s tagged buffer %s needs variants"
                              % (key, arg))
            else:
                for macro, stype in variants.items():
                    if (not re.fullmatch(r"[A-Za-z_]\w*", macro) or
                            not isinstance(stype, str) or
                            not re.fullmatch(r"[A-Za-z_]\w*", stype)):
                        errors.append("function policy %s tagged buffer %s has invalid variant %r"
                                      % (key, arg, macro))
            header = sp.get("header")
            if not isinstance(header, str) or not re.fullmatch(r"[A-Za-z0-9_./-]+\.h", header):
                errors.append("function policy %s tagged buffer %s needs a valid header"
                              % (key, arg))
            if sp.get("clear", True) not in (True, False):
                errors.append("function policy %s tagged buffer %s clear must be boolean"
                              % (key, arg))
            copy_on = sp.get("copy_on", "always")
            if copy_on not in ("always", "nonzero"):
                errors.append("function policy %s tagged buffer %s has invalid copy_on %r"
                              % (key, arg, copy_on))
            elif copy_on == "nonzero" and classify(f.ret) not in ("scalar", "widen"):
                errors.append("function policy %s tagged buffer %s copy_on nonzero needs scalar result"
                              % (key, arg))
            if arg in taglists or arg in structs or arg in objects or arg in pointers:
                errors.append("function policy %s argument %s has two policies" % (key, arg))
        for arg, pp in pointers.items():
            kind, direction = pp.get("kind"), pp.get("direction")
            expected = POINTER_SCALARS.get(kind)
            if arg not in args:
                errors.append("function policy %s names missing scalar pointer %s" % (key, arg))
            elif not expected or "*" not in args[arg]:
                errors.append("function policy %s scalar pointer %s has invalid kind %r"
                              % (key, arg, kind))
            else:
                base_type = norm(re.sub(r"\s*\*\s*$", "", args[arg]))
                if base_type not in expected[0]:
                    errors.append("function policy %s scalar pointer %s kind %s mismatches %s"
                                  % (key, arg, kind, base_type))
            if direction not in ("in", "out", "inout"):
                errors.append("function policy %s scalar pointer %s has invalid direction %r"
                              % (key, arg, direction))
            copy_on = pp.get("copy_on", "always")
            if copy_on not in ("always", "nonzero"):
                errors.append("function policy %s scalar pointer %s has invalid copy_on %r"
                              % (key, arg, copy_on))
            elif copy_on == "nonzero" and classify(f.ret) not in ("scalar", "widen"):
                errors.append("function policy %s scalar pointer %s copy_on nonzero needs scalar result"
                              % (key, arg))
            if arg in taglists or arg in structs:
                errors.append("function policy %s argument %s has two policies" % (key, arg))
        for arg, ap in arrays.items():
            kind, direction = ap.get("kind"), ap.get("direction")
            if arg not in args:
                errors.append("function policy %s names missing array %s" % (key, arg))
            elif "*" not in args[arg]:
                errors.append("function policy %s array %s is not a pointer" % (key, arg))
            elif kind == "rgb32" and object_canon(args[arg]).replace("const ", "") not in (
                    "ULONG *", "const ULONG *"):
                errors.append("function policy %s RGB32 array %s is not ULONG *"
                              % (key, arg))
            if kind != "rgb32":
                errors.append("function policy %s array %s has invalid kind %r"
                              % (key, arg, kind))
            if direction != "in":
                errors.append("function policy %s array %s currently requires direction in"
                              % (key, arg))
            count = ap.get("max_count")
            if not isinstance(count, int) or count < 1 or count > 4096:
                errors.append("function policy %s array %s needs max_count 1..4096"
                              % (key, arg))
            if ap.get("nullable", True) not in (True, False):
                errors.append("function policy %s array %s nullable must be boolean"
                              % (key, arg))
            if (arg in taglists or arg in structs or arg in tagged_structs or
                    arg in objects or arg in callbacks or arg in pointers):
                errors.append("function policy %s argument %s has two policies" % (key, arg))
        for arg, op in objects.items():
            otype = op.get("type")
            ospec = object_types.get(otype)
            if arg not in args:
                errors.append("function policy %s names missing argument %s" % (key, arg))
            elif not ospec:
                errors.append("function policy %s uses missing object type %s"
                              % (key, otype))
            elif object_canon(args[arg]) != object_canon(ospec.get("c_type", "")):
                errors.append("function policy %s argument %s is not object %s"
                              % (key, arg, otype))
            if op.get("nullable", True) not in (True, False):
                errors.append("function policy %s object %s nullable must be boolean"
                              % (key, arg))
            if op.get("release", False) not in (True, False):
                errors.append("function policy %s object %s release must be boolean"
                              % (key, arg))
            if op.get("consume", False) not in (True, False):
                errors.append("function policy %s object %s consume must be boolean"
                              % (key, arg))
            if op.get("release", False) and op.get("consume", False):
                errors.append("function policy %s object %s cannot release and consume"
                              % (key, arg))
            if arg in taglists or arg in structs or arg in pointers:
                errors.append("function policy %s argument %s has two policies" % (key, arg))
        for arg, cb in callbacks.items():
            if arg not in args:
                errors.append("function policy %s names missing callback %s" % (key, arg))
            elif "struct Hook" not in args[arg] or "*" not in args[arg]:
                errors.append("function policy %s callback %s is not struct Hook *"
                              % (key, arg))
            if cb.get("kind") != "hook":
                errors.append("function policy %s callback %s kind must be hook"
                              % (key, arg))
            for role in ("object_arg", "message_arg"):
                if cb.get(role) not in args:
                    errors.append("function policy %s callback %s has missing %s"
                                  % (key, arg, role))
            if arg in taglists or arg in structs or arg in objects or arg in pointers:
                errors.append("function policy %s argument %s has two policies" % (key, arg))
        if not isinstance(guest_values, list) or any(a not in args for a in guest_values):
            errors.append("function policy %s has invalid guest_values" % key)
        else:
            for arg in guest_values:
                if classify(args[arg]) != "aptr":
                    errors.append("function policy %s guest value %s is not APTR"
                                  % (key, arg))
        if not isinstance(strings, list) or any(a not in args for a in strings):
            errors.append("function policy %s has invalid strings" % key)
        if not isinstance(null_args, list) or any(a not in args for a in null_args):
            errors.append("function policy %s has invalid null_args" % key)
        else:
            for arg in null_args:
                if "*" not in args[arg]:
                    errors.append("function policy %s NULL-only argument %s is not a pointer"
                                  % (key, arg))
                if (arg in taglists or arg in structs or arg in tagged_structs or
                        arg in objects or arg in callbacks or arg in pointers or
                        arg in arrays or arg in guest_values or arg in strings):
                    errors.append("function policy %s argument %s has two policies"
                                  % (key, arg))
        if boopsi:
            class_arg = boopsi.get("class_arg")
            if class_arg not in objects or objects[class_arg].get("type") != "Class":
                errors.append("function policy %s BOOPSI class_arg is not a Class object"
                              % key)
        result = p.get("result")
        if result:
            if result.get("kind") == "guest_arg":
                if result.get("arg") not in args:
                    errors.append("function policy %s has invalid guest_arg result" % key)
                elif result.get("arg") not in structs:
                    errors.append("function policy %s result argument is not a struct shadow" % key)
            elif result.get("kind") == "object":
                otype = result.get("type")
                ospec = object_types.get(otype)
                owned = result.get("owned", True)
                if owned not in (True, False):
                    errors.append("function policy %s object result owned must be boolean" % key)
                if not ospec:
                    errors.append("function policy %s uses missing result object %s"
                                  % (key, otype))
                elif object_canon(f.ret) != object_canon(ospec.get("c_type", "")):
                    errors.append("function policy %s result is not object %s" % (key, otype))
                elif owned and not ospec.get("destructor"):
                    errors.append("function policy %s owned object needs a destructor" % key)
                elif owned and not ospec["destructor"].startswith(key.rsplit(".", 1)[0] + "."):
                    errors.append("function policy %s object destructor must be in the same library"
                                  % key)
                fallback = result.get("fallback_textattr")
                if fallback is not None:
                    farg = fallback.get("arg") if isinstance(fallback, dict) else None
                    fname = fallback.get("name") if isinstance(fallback, dict) else None
                    if (farg not in structs or
                            structs.get(farg, {}).get("type") != "TextAttr" or
                            structs.get(farg, {}).get("direction") not in ("in", "inout")):
                        errors.append("function policy %s font fallback needs an input TextAttr"
                                      % key)
                    if not isinstance(fname, str) or not fname or "\0" in fname:
                        errors.append("function policy %s font fallback needs a valid name"
                                      % key)
            else:
                errors.append("function policy %s has invalid result policy" % key)
        blockers = []
        for t, n in f.args:
            if (n in taglists or n in structs or n in tagged_structs or
                    n in pointers or n in arrays or n in objects or n in callbacks or
                    n in guest_values or n in strings or n in null_args):
                continue
            if classify(t) not in ("scalar", "widen", "string", "bptr"):
                blockers.append("%s %s" % (t, n))
        if not result and classify(f.ret) not in ("scalar", "widen", "void"):
            blockers.append("result %s" % f.ret)
        if blockers:
            errors.append("function policy %s still needs policy for %s"
                          % (key, ", ".join(blockers)))

    return errors


