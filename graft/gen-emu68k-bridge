#!/usr/bin/env python3
"""Generate the 68k -> native AROS library bridge from the OS tree's own .conf
files.

Every AROS library describes each of its vectors in a `##begin functionlist`
block: the full C prototype, and the m68k register each argument arrives in.
That is exactly the information a call needs to cross from a 68k guest into a
native library, so the crossing should be DERIVED from it rather than typed out
by hand.

What can be derived is limited by one fact: there is no pass-through. Guest
memory is big-endian with 32-bit pointers; native AROS on aarch64 is
little-endian with 64-bit pointers and different structure layouts. A pointer
argument is therefore only safe to forward when the thing behind it has no
layout at all - a NUL-terminated string, or raw bytes. Anything with fields has
to be rebuilt, which needs a description of the type, not of the function.

So functions land in tiers:

  1  every argument is a scalar or a char pointer, and the result is a scalar.
     Fully generated, no hand-written code, ever.
  2  a structure, a BPTR, or an untyped APTR crosses. Needs a per-TYPE
     description (written once, shared by every function using that type).
  3  the signature does not say enough: the callee retains the pointer, or
     calls back into the guest.

This script emits tier 1 and reports the rest as the work queue.
"""

import os
import re
import sys
import json

AROS = os.environ.get("AROS_SRC", os.path.expanduser("~/Source/aros-upstream"))
POLICY_PATH = os.environ.get(
    "EMU68K_BRIDGE_POLICY",
    os.path.join(os.path.dirname(os.path.abspath(__file__)),
                 "emu68k-bridge-policy.json"))

# Where the BUILD put the generated proto headers. They are the authority on how
# a library's base is named and typed (the .conf does not always say), and a
# library without one cannot be compiled against at all - which makes the
# presence of the header the natural test for "can we generate for this".
GENINC = os.environ.get(
    "AROS_GENINC",
    os.path.expanduser("~/aros-build/bin/darwin-aarch64/gen/include"))

# The libraries a 68k Amiga program plausibly calls: the AmigaOS application
# surface. Every .conf in the tree is CLASSIFIED (see --report-all, 175 of them),
# but only these have code emitted - compiling all 175 would link the bridge
# against HIDDs, datatypes and internal modules that no 68k program opens.
GEN_LIBS = [
    "exec", "dos", "utility", "intuition", "graphics", "layers", "gadtools",
    "asl", "icon", "iffparse", "commodities", "diskfont", "locale", "keymap",
    "datatypes", "expansion", "cybergraphics", "mathffp", "mathieeesingbas",
    "mathieeedoubbas",
]


def load_policy():
    """Load the semantic facts C prototypes cannot carry. This file is small
    on purpose: it describes TYPES/domains once, while the .conf remains the
    authority for function names, LVOs, registers and C signatures."""
    try:
        with open(POLICY_PATH, encoding="utf-8") as fh:
            p = json.load(fh)
    except (OSError, ValueError) as e:
        raise SystemExit("cannot load bridge policy %s: %s" % (POLICY_PATH, e))
    if p.get("schema") != 1:
        raise SystemExit("bridge policy schema must be 1")
    return p


POLICY = load_policy()


def find_confs():
    """short name -> path, for every .conf in the tree carrying a functionlist.
    Prefers rom/ and workbench/libs/ when a name appears more than once."""
    out = {}
    for root, dirs, files in os.walk(AROS):
        dirs[:] = [d for d in dirs if d not in (".git", "bin")]
        for fn in files:
            if not fn.endswith(".conf"):
                continue
            p = os.path.join(root, fn)
            try:
                if "##begin functionlist" not in open(
                        p, encoding="utf-8", errors="replace").read():
                    continue
            except OSError:
                continue
            rel = os.path.relpath(p, AROS)
            short = fn[:-5]
            rank = 0 if rel.startswith(("rom/", "workbench/libs/")) else 1
            if short not in out or rank < out[short][1]:
                out[short] = (rel, rank)
    return {k: v[0] for k, v in out.items()}


BASE_RE = re.compile(r"extern\s+(struct\s+\w+|\w+)\s*\*\s*(\w+)\s*;")
GETBASE_RE = re.compile(r"__aros_getbase_(\w+)\s*\(\)")


def proto_base(short):
    """(base name, base type) for `short`, read from its generated proto header.
    Returns None when there is no header, i.e. nothing to generate against."""
    path = os.path.join(GENINC, "proto", short + ".h")
    try:
        src = open(path, encoding="utf-8", errors="replace").read()
    except OSError:
        return None
    m = GETBASE_RE.search(src)
    if not m:
        return None
    name = m.group(1)
    btype = "struct Library"
    for bt, bn in BASE_RE.findall(src):
        # the specific spelling wins over the generic `struct Library` one
        if bn == name and norm(bt) != "struct Library":
            btype = norm(bt)
    return (name, btype)


def gen_targets():
    """The libraries code is emitted for: on GEN_LIBS, has a .conf, and has a
    generated proto header to compile against."""
    confs = find_confs()
    out = []
    for short in GEN_LIBS:
        rel = confs.get(short)
        if not rel:
            continue
        pb = proto_base(short)
        if not pb:
            continue
        out.append((short + ".library", rel, pb[0], pb[1], "proto/%s.h" % short))
    return out


def all_targets():
    """Every library in the tree, for classification. No proto header needed:
    nothing is compiled, only counted."""
    return [(short + ".library", rel, None, None, None)
            for short, rel in sorted(find_confs().items())]


# ---------------------------------------------------------------------------
# type classification
# ---------------------------------------------------------------------------

# Fits in (or narrower than) a 32-bit 68k register, and carries no address.
SCALAR = {
    "LONG", "ULONG", "WORD", "UWORD", "BYTE", "UBYTE", "BOOL", "LONGBITS",
    "ULONGBITS", "int", "unsigned int", "long", "unsigned long", "short",
    "unsigned short", "char", "unsigned char", "signed char", "UBYTE",
    "STACKULONG", "STACKLONG", "Tag", "TEXT",
}

# Pointer-sized natively but used as an integer. Safe as an argument (we widen
# a 32-bit register); as a RESULT it is narrowed, which is only correct because
# the value is an integer and not an address. Flagged in the generated source.
WIDENING = {"IPTR", "SIPTR", "APTR_or_IPTR"}

# A pointer to bytes: no layout, so the guest's own buffer can be handed over
# directly. This is the only pointer class that is safe to forward as-is.
STRING = {"STRPTR", "CONST_STRPTR", "CONST_STRPTR_or_NULL"}

VOID = {"void", "VOID"}

# Tier 1 by signature is not the same as safe to forward. A guest is not
# trusted to halt the machine it is a guest on, and a simple signature says
# nothing about that, so the decision is made by name.
#
# exec.library is inverted: it is a kernel API, not an application API, and
# nearly every one of its simple-signature vectors drives the real machine
# (ShutdownA, SetSR, ReadGayle, Exception, RawPutChar). The calls a 68k
# program legitimately makes into exec - memory, lists, semaphores,
# OpenLibrary - are hand-served already. So exec is allowlisted and everything
# else is denylisted.
ALLOWLIST_LIBS = {"exec.library"}

ALLOW = {
    ("exec.library", "AvailMem"): 1,
}

# Vectors that LOOK like tier 2a but must stay hand-written: they need
# something before or after the call that a derived crossing cannot know about.
DENY_2A = {
    ("dos.library", "Close"):     "must release the handle-table slot after",
    ("dos.library", "UnLock"):    "must release the handle-table slot after",
    ("dos.library", "UnLoadSeg"): "a guest seglist is not a native one",
    ("dos.library", "RunCommand"):"a guest seglist is not a native one",
    ("dos.library", "AddSegment"):"a guest seglist is not a native one",
}

DENY = {
    # the guest exits by returning; calling this would unwind the host task
    ("dos.library",  "Exit"):        "the guest exits by returning, not by this",
    # device-level operations: vanishingly rare in the programs being served,
    # and catastrophic if a mistranslated register ever reaches one
    ("dos.library",  "Format"):      "device-level, and destroys a volume",
    ("dos.library",  "Relabel"):     "device-level",
    ("dos.library",  "Inhibit"):     "device-level",
    ("dos.library",  "AddBuffers"):  "device-level",
    ("dos.library",  "SetOwner"):    "device-level",
    # meaningless or harmful without the paired call, which is not tier 1
    ("dos.library",  "UnLockDosList"): "pairs with LockDosList, which is not tier 1",
    ("dos.library",  "SetArgStr"):   "rebinds the host process argument string",
    ("dos.library",  "SetProgramName"): "renames the host process",
    ("dos.library",  "SetCurrentDirName"): "moves the host process, not the guest",
    ("dos.library",  "SetPrompt"):   "the host shell's prompt is not the guest's",
    ("dos.library",  "MaxCli"):      "reports on host CLIs, not guest ones",
    # the host task's signals are the JIT's, not the guest's: a guest that
    # allocates or waits on them stalls the task running it
    ("dos.library",  "CheckSignal"): "the host task's signals are not the guest's",
    # `dest` is a STRPTR when soft is set and a BPTR lock when it is not, so
    # one C type covers two conversions and the signature cannot say which
    ("dos.library",  "MakeLink"):   "dest is a string or a lock depending on soft",
    # returns a PAIR: quotient in D0, remainder in D1. The C prototype can only
    # describe D0, so generating from it would leave D1 stale and the
    # arithmetic silently wrong. Needs a hand-written crossing.
    ("utility.library", "UDivMod32"): "returns quotient in D0 AND remainder in D1",
    ("utility.library", "SDivMod32"): "returns quotient in D0 AND remainder in D1",
}


def norm(t):
    return re.sub(r"\s+", " ", t.strip())


def classify(t):
    """-> ('scalar'|'widen'|'string'|'void'|'bptr'|'struct'|'aptr'|'other')"""
    t = norm(t)
    if t in VOID:
        return "void"
    if t == "BPTR":
        return "bptr"
    if t in SCALAR:
        return "scalar"
    if t in WIDENING:
        return "widen"
    if t in STRING:
        return "string"
    # `UBYTE *name` / `char *` / `CONST STRPTR` spellings of a byte buffer
    if re.fullmatch(r"(CONST\s+)?(unsigned\s+|signed\s+)?(char|UBYTE|TEXT)\s*\*", t):
        return "string"
    if t == "APTR" or t == "CONST_APTR":
        return "aptr"
    if "*" in t:
        return "struct"
    return "other"


# ---------------------------------------------------------------------------
# .conf parsing
# ---------------------------------------------------------------------------

# `<return type> <name>(<args>) (<regs>)`, where the return type may itself
# carry stars and `struct`.
FUNC_RE = re.compile(r"^(.*?\**)\s*(\w+)\s*\((.*)\)\s*\(([^()]*)\)\s*$")


def split_args(s):
    """Split an argument list on commas that are not inside parentheses (a
    function-pointer argument carries its own)."""
    out, depth, cur = [], 0, ""
    for ch in s:
        if ch in "([":
            depth += 1
        elif ch in ")]":
            depth -= 1
        if ch == "," and depth == 0:
            out.append(cur)
            cur = ""
        else:
            cur += ch
    if cur.strip():
        out.append(cur)
    return [a.strip() for a in out if a.strip()]


def arg_type_and_name(a):
    """`struct FileInfoBlock* fib` -> ('struct FileInfoBlock *', 'fib')"""
    a = a.strip()
    if a in VOID or a == "":
        return None
    # a function pointer argument: `void (*fn)(...)`
    if "(*" in a:
        return ("__fnptr", "fn")
    m = re.match(r"^(.*?)(\w+)$", a)
    if not m:
        return (norm(a), "a")
    t, n = m.group(1), m.group(2)
    if not t.strip() or t.strip() in ("struct", "const", "CONST", "unsigned", "signed"):
        # the whole thing was a bare type with no parameter name
        return (norm(a), "a")
    return (norm(t), n)


class Func:
    def __init__(self, lvo, ret, name, args, regs):
        self.lvo, self.ret, self.name, self.args, self.regs = lvo, ret, name, args, regs
        self.private = False
        self.novararg = False

    @property
    def offset(self):
        return -6 * self.lvo

    def tier(self, lib=None):
        """1, or the reason it is not 1."""
        if self.private:
            return (None, "private")
        if lib is not None:
            if (lib, self.name) in DENY:
                return (None, "refused: " + DENY[(lib, self.name)])
            if lib in ALLOWLIST_LIBS and (lib, self.name) not in ALLOW:
                return (None, "not on the %s allowlist" % lib.split(".")[0])
        if self.regs and self.regs[0] in ("base", "sysv"):
            return (None, "not register-based")
        # a zero-argument function has an empty register list, which is fine
        if not self.regs and self.args:
            return (None, "no register mapping")
        if len(self.regs) != len(self.args):
            return (None, "register/argument count mismatch")
        rc = classify(self.ret)
        if rc == "bptr":
            return (None, "returns BPTR")
        # A returned pointer is a 64-bit HOST address. There is no 32-bit
        # register to put it in, and truncating one is how a guest gets handed
        # a pointer that dereferences to nothing. This includes STRPTR: a
        # returned string is as unrepresentable as a returned struct.
        if rc in ("struct", "aptr", "other", "string"):
            return (None, "returns a pointer (%s)" % norm(self.ret))
        blockers = []
        for t, n in self.args:
            c = classify(t)
            if c == "bptr":
                blockers.append("BPTR %s" % n)
            elif c == "struct":
                blockers.append("%s" % norm(t))
            elif c == "aptr":
                blockers.append("APTR %s" % n)
            elif c == "other":
                blockers.append("%s %s" % (norm(t), n))
        if not blockers:
            return (1, None)

        # TIER 2a: the only thing standing in the way is a BPTR, and a BPTR
        # already has a mechanism - the handle table that maps a guest token to
        # the native pointer it stands for. So these are derivable too, and the
        # 25 dos vectors in this shape do not need writing out one at a time.
        if all(b.startswith("BPTR") for b in blockers) and \
           classify(self.ret) in ("scalar", "widen", "void", "bptr") and \
           lib is not None and (lib, self.name) not in DENY_2A:
            return (2, None)

        return (None, ", ".join(sorted(set(blockers))))


# The first vector the functionlist describes, exactly as genmodule derives it
# (tools/genmodule/config.c): by module type, except that a library declaring
# `noresident` spells out the four standard vectors itself and so starts at 1.
FIRSTLVO_BY_MODTYPE = {
    "handler": 1, "resource": 1,
    "library": 5, "usbclass": 5, "hidd": 5, "class": 5, "gadget": 5, "image": 5,
    "datatype": 6, "mcc": 6, "mui": 6, "mcp": 6,
    "device": 7,
}


def first_lvo(lines):
    modtype, options = "library", ""
    inconf = False
    for line in lines:
        if line.startswith("##begin config"):
            inconf = True
            continue
        if line.startswith("##end config"):
            break
        if not inconf:
            continue
        s = line.split("#")[0].strip()
        if s.startswith("modtype"):
            modtype = s.split(None, 1)[1].strip().lower() if len(s.split()) > 1 else modtype
        elif s.startswith("options"):
            options += " " + s
    lvo = FIRSTLVO_BY_MODTYPE.get(modtype, 5)
    if "noresident" in options:
        lvo = 1
    return lvo


def parse_conf(path):
    inlist = False
    try:
        lines = open(path, encoding="utf-8", errors="replace").read().splitlines()
    except OSError:
        return None
    funcs = []
    lvo = first_lvo(lines) - 1
    last = None
    for raw in lines:
        line = raw.rstrip()
        if line.startswith("##begin functionlist"):
            inlist = True
            continue
        if line.startswith("##end functionlist"):
            break
        if not inlist:
            continue
        # strip trailing comment, but not a `#` inside the prototype
        s = line.split("#")[0].strip() if not line.lstrip().startswith("#") else ""
        if not s:
            continue
        if s.startswith("."):
            d = s[1:].split()
            if d[0] == "skip":
                lvo += int(d[1]) if len(d) > 1 else 1
                last = None
            elif d[0] == "private":
                if last is not None:
                    last.private = True
            elif d[0] == "novararg":
                if last is not None:
                    last.novararg = True
            # .version, .function, .alias and friends do not consume a vector
            continue
        m = FUNC_RE.match(s)
        if not m:
            last = None
            continue
        ret, name, argstr, regstr = m.groups()
        lvo += 1
        args = []
        ok = True
        for a in split_args(argstr):
            tn = arg_type_and_name(a)
            if tn is None:
                continue
            if tn[0] == "__fnptr":
                ok = False
            args.append(tn)
        regs = [r.strip() for r in regstr.split(",") if r.strip()]
        f = Func(lvo, ret if ret.strip() else "void", name, args, regs)
        if not ok:
            f.args.append(("__fnptr", "fn"))
        funcs.append(f)
        last = f
    return funcs


# ---------------------------------------------------------------------------
# semantic policy validation
# ---------------------------------------------------------------------------

TAG_KINDS = {"u32": "EMU_TAG_U32", "cstr": "EMU_TAG_CSTR",
             "refuse": "EMU_TAG_REFUSE"}


def policy_key(lib, f):
    return "%s.%s" % (lib, f.name)


def function_policy(lib, f):
    return POLICY.get("functions", {}).get(policy_key(lib, f))


def c_ident(s):
    return re.sub(r"[^A-Za-z0-9_]", "_", s)


def validate_policy(targets):
    """Refuse stale names and unsafe shapes before emitting any C. A policy
    typo must fail the build, not quietly leave the intended vector uncovered."""
    domains = POLICY.get("tag_domains", {})
    errors = []
    bykey = {}
    for lib, rel, _base, _btype, _hdr in targets:
        for f in parse_conf(os.path.join(AROS, rel)) or []:
            bykey[policy_key(lib, f)] = f

    for name, d in domains.items():
        if not re.fullmatch(r"[A-Za-z0-9_.-]+", name):
            errors.append("tag domain %r has an invalid name" % name)
        cap = d.get("max_items")
        if not isinstance(cap, int) or cap < 1 or cap > 256:
            errors.append("tag domain %s max_items must be 1..256" % name)
        tags = d.get("tags")
        if not isinstance(tags, list) or not tags:
            errors.append("tag domain %s has no tags" % name)
            continue
        seen = set()
        for t in tags:
            macro, kind = t.get("name"), t.get("kind")
            if not isinstance(macro, str) or not re.fullmatch(r"[A-Za-z_]\w*", macro):
                errors.append("tag domain %s has invalid macro %r" % (name, macro))
            elif macro in seen:
                errors.append("tag domain %s repeats %s" % (name, macro))
            seen.add(macro)
            if kind not in TAG_KINDS:
                errors.append("tag domain %s tag %s has unknown kind %r"
                              % (name, macro, kind))

    for key, p in POLICY.get("functions", {}).items():
        f = bykey.get(key)
        if not f:
            errors.append("function policy %s does not name a public .conf vector" % key)
            continue
        if f.private:
            errors.append("function policy %s names a private vector" % key)
        taglists = p.get("taglists", {})
        structs = p.get("structs", {})
        args = {n: t for t, n in f.args}
        for arg, domain in taglists.items():
            if arg not in args:
                errors.append("function policy %s names missing argument %s" % (key, arg))
            elif "TagItem" not in args[arg] or "*" not in args[arg]:
                errors.append("function policy %s argument %s is not a TagItem pointer"
                              % (key, arg))
            if domain not in domains:
                errors.append("function policy %s uses missing tag domain %s"
                              % (key, domain))
        for arg, sp in structs.items():
            stype, direction = sp.get("type"), sp.get("direction")
            if arg not in args:
                errors.append("function policy %s names missing argument %s" % (key, arg))
            elif (not isinstance(stype, str) or
                  "struct %s" % stype not in norm(args[arg]) or
                  "*" not in args[arg]):
                errors.append("function policy %s argument %s is not struct %s *"
                              % (key, arg, stype))
            if direction not in ("in", "out", "inout"):
                errors.append("function policy %s struct %s has invalid direction %r"
                              % (key, arg, direction))
            if arg in taglists:
                errors.append("function policy %s argument %s has two policies" % (key, arg))
        result = p.get("result")
        if result:
            if result.get("kind") != "guest_arg" or result.get("arg") not in args:
                errors.append("function policy %s has invalid guest_arg result" % key)
            elif result.get("arg") not in structs:
                errors.append("function policy %s result argument is not a struct shadow" % key)
        blockers = []
        for t, n in f.args:
            if n in taglists or n in structs:
                continue
            if classify(t) not in ("scalar", "widen", "string"):
                blockers.append("%s %s" % (t, n))
        if not result and classify(f.ret) not in ("scalar", "widen", "void"):
            blockers.append("result %s" % f.ret)
        if blockers:
            errors.append("function policy %s still needs policy for %s"
                          % (key, ", ".join(blockers)))

    return errors


# ---------------------------------------------------------------------------
# self-check: LVO assignment must reproduce offsets known from the 68k ABI
# ---------------------------------------------------------------------------

KNOWN = {
    "dos.library": {
        "Open": -30, "Close": -36, "Read": -42, "Write": -48, "Input": -54,
        "Output": -60, "Seek": -66, "IoErr": -132, "Delay": -198,
        "MatchFirst": -822, "MatchNext": -828, "MatchEnd": -834,
        "ParsePattern": -840, "MatchPattern": -846, "ReadArgs": -798,
        "PrintFault": -474, "SetIoErr": -462, "GetProgramName": -576,
    },
    "exec.library": {
        "Supervisor": -30, "Forbid": -132, "Permit": -138, "AllocMem": -198,
        "FreeMem": -210, "FindTask": -294, "OpenLibrary": -552,
        "AllocVec": -684, "FreeVec": -690,
    },
    # OpenIntuition/Intuition are `.skip`ped privates in AROS, so they are
    # deliberately absent by name.
    "intuition.library": {
        "DisplayAlert": -90, "OpenWindow": -204,
        "CloseWindow": -72, "EasyRequestArgs": -588,
    },
    "graphics.library": {
        "BltBitMap": -30, "Text": -60, "Move": -240, "Draw": -246,
        "SetAPen": -342, "RectFill": -306,
    },
    "utility.library": {
        "FindTagItem": -30, "GetTagData": -36, "Stricmp": -162,
    },
    # -96 for FindToolType is confirmed twice over: by this table and by the
    # hand-written bridge that has been serving it to real programs.
    "icon.library": {
        "FreeFreeList": -54, "FindToolType": -96, "MatchToolValue": -102,
        "BumpRevision": -108,
    },
}


def selfcheck(lib, funcs):
    want = KNOWN.get(lib)
    if not want:
        return []
    by = {f.name: f for f in funcs}
    bad = []
    for name, off in want.items():
        f = by.get(name)
        if f is None:
            bad.append("%s: not found" % name)
        elif f.offset != off:
            bad.append("%s: got %d, 68k ABI says %d" % (name, f.offset, off))
    return bad


# ---------------------------------------------------------------------------
# emit
# ---------------------------------------------------------------------------

def reg_expr(reg):
    """`D1` -> `r->d[1]`"""
    reg = reg.strip().upper()
    if not re.fullmatch(r"[DA][0-7]", reg):
        return None
    return "r->%s[%s]" % (reg[0].lower(), reg[1])


def arg_expr(t, reg):
    """The C expression that turns one 68k register into one native argument."""
    if classify(t) == "bptr":
        return "EMU_HANDLE(guest0, %s)" % reg_expr(reg)
    return _arg_expr(t, reg)


def _arg_expr(t, reg):
    """The C expression that turns one 68k register into one native argument."""
    c = classify(t)
    src = reg_expr(reg)
    t = norm(t)
    if c == "string":
        return "(%s)EMU_GPTR(guest0, %s)" % (t, src)
    if c == "widen":
        # sign-extend through LONG: the value is an integer, and a negative one
        # (an error code, a -1 sentinel) must stay negative when it widens
        return "(%s)(LONG)%s" % (t, src)
    return "(%s)%s" % (t, src)


def emit_lib(lib, rel, base, btype, hdr, funcs):
    short = lib.split(".")[0]
    domains = POLICY.get("tag_domains", {})
    used_domains = []
    for f in funcs:
        p = function_policy(lib, f)
        if not p:
            continue
        for d in p.get("taglists", {}).values():
            if d not in used_domains:
                used_domains.append(d)
    uses_structs = any(function_policy(lib, f) and
                       function_policy(lib, f).get("structs") for f in funcs)
    out = []
    w = out.append
    w("/* GENERATED by graft/gen-emu68k-bridge from %s - do not edit." % rel)
    w(" *")
    w(" * Derived crossings for %s. Tier-1 scalar/string calls come straight" % lib)
    w(" * from the .conf prototype and register map; type-sensitive calls additionally")
    w(" * consume the checked semantic policy in graft/emu68k-bridge-policy.json.")
    w(" * Anything still lacking policy remains unavailable rather than guessed.")
    w(" */")
    w("")
    w("#include <exec/types.h>")
    w("#include <%s>" % hdr)
    if uses_structs:
        w("#include <string.h>")
    for d in used_domains:
        for h in domains[d].get("headers", []):
            w("#include <%s>" % h)
    w("")
    w('#include "emu68k_gen.h"')
    if uses_structs:
        w('#include "emu68k_layouts.h"')
    w("")
    for d in used_domains:
        ident = c_ident(d)
        w("static const struct EmuTagDesc emu_tagdesc_%s[] =" % ident)
        w("{")
        for tag in domains[d]["tags"]:
            w('    { %s, %s, "%s" },' %
              (tag["name"], TAG_KINDS[tag["kind"]], tag["name"]))
        w("};")
        w("static const struct EmuTagDomain emu_tagdomain_%s =" % ident)
        w("{")
        w('    emu_tagdesc_%s, (UWORD)(sizeof(emu_tagdesc_%s) / sizeof(emu_tagdesc_%s[0])), "%s"'
          % (ident, ident, ident, d))
        w("};")
        w("")
    w("int emu68k_gen_%s(int lvo, struct Emu68kRegs *r, APTR guest0, APTR base," % short)
    w("                  char *err, ULONG errlen)")
    w("{")
    w("    %s *%s = base;" % (btype, base))
    w("    (void)r; (void)guest0; (void)%s; (void)err; (void)errlen;" % base)
    w("")
    w("    switch (lvo)")
    w("    {")
    n = 0
    for f in funcs:
        t = f.tier(lib)[0]
        policy = function_policy(lib, f)
        if t not in (1, 2) and not policy:
            continue
        regs = [reg_expr(x) for x in f.regs]
        if any(x is None for x in regs):
            continue
        sig = ", ".join("%s %s" % (norm(t), nm) for t, nm in f.args) or "void"
        w("    case %d:  /* %s(%s) -> %s  [%d] */" % (f.lvo, f.name, sig,
                                                      norm(f.ret), f.offset))
        taglists = policy.get("taglists", {}) if policy else {}
        structs = policy.get("structs", {}) if policy else {}
        if policy:
            w("    {")
        call_args = []
        post = []
        for ai, ((atype, aname), reg) in enumerate(zip(f.args, f.regs)):
            src = reg_expr(reg)
            if aname in structs:
                sp = structs[aname]
                stype, direction = sp["type"], sp["direction"]
                w("        struct %s emu_struct_%d;" % (stype, ai))
                w("        if (emu68k_require_guest_range(%s, M68K_%s_SIZEOF,"
                  % (src, stype))
                w('                                         "%s.%s", err, errlen) < 0)'
                  % (f.name, aname))
                w("            return 1;")
                w("        memset(&emu_struct_%d, 0, sizeof(emu_struct_%d));" % (ai, ai))
                if direction in ("in", "inout"):
                    w("        emu68k_from_guest(guest0, %s, &emu_struct_%d,"
                      % (src, ai))
                    w("                             emu_fields_%s, EMU_NFIELDS(emu_fields_%s));"
                      % (stype, stype))
                if direction in ("out", "inout"):
                    post.append("        emu68k_to_guest(guest0, %s, &emu_struct_%d,\n"
                                "                           emu_fields_%s, EMU_NFIELDS(emu_fields_%s));"
                                % (src, ai, stype, stype))
                call_args.append("(%s)&emu_struct_%d" % (norm(atype), ai))
                continue
            if aname not in taglists:
                call_args.append(arg_expr(atype, reg))
                continue
            dname = taglists[aname]
            cap = domains[dname]["max_items"]
            ident = c_ident(dname)
            w("        struct TagItem emu_tags_%d[%d];" % (ai, cap + 1))
            w("        if (emu68k_tags_to_native(guest0, %s, &emu_tagdomain_%s,"
              % (src, ident))
            w("                                     emu_tags_%d, %d, err, errlen) < 0)"
              % (ai, cap + 1))
            w("            return 1;")
            call_args.append("(%s)(%s ? emu_tags_%d : NULL)"
                             % (norm(atype), src, ai))
        args = ",\n              ".join(call_args)
        call = "%s(%s)" % (f.name, args)
        result_policy = policy.get("result") if policy else None
        if result_policy:
            result_arg = result_policy["arg"]
            result_index = [n for _t, n in f.args].index(result_arg)
            result_src = reg_expr(f.regs[result_index])
            w("        APTR emu_result = (APTR)%s;" % call)
            for line in post:
                w(line)
            w("        r->d[0] = emu_result ? %s : 0;" % result_src)
        elif classify(f.ret) == "void":
            w("        %s%s;" % ("    " if policy else "", call))
            for line in post:
                w(line)
        elif classify(f.ret) == "bptr":
            w("        %sr->d[0] = EMU_TOKEN(guest0, %s);   /* a BPTR crosses as a token */"
              % ("    " if policy else "", call))
            for line in post:
                w(line)
        else:
            note = ""
            if classify(f.ret) == "widen":
                note = "   /* narrowed: an integer, never an address */"
            w("        %sr->d[0] = (ULONG)%s;%s" %
              ("    " if policy else "", call, note))
            for line in post:
                w(line)
        w("        %sreturn 0;" % ("    " if policy else ""))
        if policy:
            w("    }")
        n += 1
    w("    }")
    w("    return 1;   /* no safe generated crossing for this vector */")
    w("}")
    w("")
    return "\n".join(out), n


HEADER = '''/* GENERATED by graft/gen-emu68k-bridge - do not edit.
 *
 * The generated half of the 68k -> native library bridge. One entry point per
 * library; each returns 0 when it served the call and 1 when the vector is not
 * one it covers, so the hand-written bridge stays in charge of everything that
 * needs judgement.
 */

#ifndef EMU68K_GEN_H
#define EMU68K_GEN_H

#include <exec/types.h>
#include <dos/dos.h>          /* BPTR, for the handle table below */

struct TagItem;
struct EmuField;

/* The leading, stable part of the engine's 68k register file. The engine owns
 * the full struct; only these two arrays are contractual here. */
struct Emu68kRegs
{
    ULONG d[8];
    ULONG a[8];
};

/* A guest pointer becomes a host pointer by adding the guest base. Only memory
 * inside the guest arena may be handed to a native call this way. */
#define EMU_GPTR(g0, a)  ((APTR)((a) ? (UBYTE *)(g0) + (ULONG)(a) : NULL))

/* A BPTR cannot cross as itself: a native one is 64-bit and a 68k register is
 * not. These map between the guest's 32-bit token and the native BPTR it
 * stands for; both live in emu68k_oscall.c, which owns the table. */
BPTR  emu68k_handle_bptr(APTR guest0, ULONG token);
ULONG emu68k_handle_token(APTR guest0, BPTR b);
#define EMU_HANDLE(g0, t)  emu68k_handle_bptr((g0), (ULONG)(t))
#define EMU_TOKEN(g0, b)   emu68k_handle_token((g0), (b))

/* Policy-compiled TagItem values. A domain names every accepted tag and the
 * type of ti_Data. Unknown/refused tags fail the crossing; they are never
 * forwarded as if every IPTR were a scalar. */
#define EMU_TAG_U32     0
#define EMU_TAG_CSTR    1
#define EMU_TAG_REFUSE  2
struct EmuTagDesc
{
    ULONG tag;
    UBYTE kind;
    const char *name;
};
struct EmuTagDomain
{
    const struct EmuTagDesc *tags;
    UWORD count;
    const char *name;
};
LONG emu68k_tags_to_native(APTR guest0, ULONG guest_tags,
                           const struct EmuTagDomain *domain,
                           struct TagItem *native_tags, ULONG capacity,
                           char *err, ULONG errlen);

LONG emu68k_require_guest_range(ULONG guest_addr, ULONG length,
                                const char *what, char *err, ULONG errlen);
void emu68k_to_guest(APTR guest0, ULONG gbase, const void *native,
                     const struct EmuField *fields, int count);
void emu68k_from_guest(APTR guest0, ULONG gbase, void *native,
                       const struct EmuField *fields, int count);
#define EMU_NFIELDS(a) ((int)(sizeof(a) / sizeof((a)[0])))

%s
#endif /* EMU68K_GEN_H */
'''


def emit(outdir, check=False):
    """Write the generated sources, or with check=True only verify that what is
    on disk is what this generator would produce. The sources are checked in so
    the OS tree builds without python, which makes drift possible: a hand edit
    to a generated file, or a .conf change upstream that nobody regenerated
    for. This is what catches both."""
    targets = gen_targets()
    errors = validate_policy(targets)
    if errors:
        print("BRIDGE POLICY INVALID:")
        for e in errors:
            print("  ! %s" % e)
        return 1
    protos, total = [], 0
    stale = []
    for lib, rel, base, btype, hdr in targets:
        funcs = parse_conf(os.path.join(AROS, rel))
        if funcs is None:
            continue
        src, n = emit_lib(lib, rel, base, btype, hdr, funcs)
        short = lib.split(".")[0]
        path = os.path.join(outdir, "emu68k_gen_%s.c" % short)
        if check:
            cur = open(path).read() if os.path.exists(path) else None
            if cur != src:
                stale.append(path)
        else:
            with open(path, "w") as fh:
                fh.write(src)
        protos.append("int emu68k_gen_%s(int lvo, struct Emu68kRegs *r,\n"
                      "                  APTR guest0, APTR base,\n"
                      "                  char *err, ULONG errlen);" % short)
        print("  %-28s %3d crossings" % (os.path.basename(path), n))
        total += n
    hpath = os.path.join(outdir, "emu68k_gen.h")
    hsrc = HEADER % "\n".join(protos)
    if check:
        cur = open(hpath).read() if os.path.exists(hpath) else None
        if cur != hsrc:
            stale.append(hpath)
        if stale:
            print("STALE - regenerate with --emit:")
            for x in stale:
                print("  %s" % x)
            return 1
        print("generated sources are in sync with the .conf files (%d crossings)"
              % total)
        return 0
    with open(hpath, "w") as fh:
        fh.write(hsrc)
    print("  %-28s %3d total" % ("emu68k_gen.h", total))
    return 0


def report_all():
    """Classify EVERY library in the tree. Nothing is compiled, so this needs no
    proto headers - it is the complete work queue, and it is what says the
    remaining effort is a list of TYPES rather than a list of functions."""
    import collections
    tot = t1 = 0
    types = collections.Counter()
    libs = 0
    for lib, rel, _b, _t, _h in all_targets():
        funcs = parse_conf(os.path.join(AROS, rel))
        if not funcs:
            continue
        libs += 1
        for f in funcs:
            if f.private:
                continue
            tot += 1
            if f.tier(lib)[0] == 1:
                t1 += 1
                continue
            for t, n in f.args:
                if classify(t) == "struct":
                    types[norm(t)] += 1
            if classify(f.ret) == "struct":
                types[norm(f.ret)] += 1
            if classify(f.ret) == "bptr" or any(classify(t) == "bptr" for t, _ in f.args):
                types["BPTR (the handle table)"] += 1

    print("%d libraries, %d public vectors" % (libs, tot))
    print("  tier 1, generated free:  %5d  (%.0f%%)" % (t1, 100.0 * t1 / max(1, tot)))
    print("  needs a type described:  %5d" % (tot - t1))
    print("\nthe types that block the most vectors (describe one, unlock all):")
    cum = 0
    for i, (t, c) in enumerate(types.most_common(25), 1):
        cum += c
        print("  %2d. %-34s %4d   (cumulative %d of %d)"
              % (i, t[:34], c, cum, tot - t1))
    print("\n%d distinct blocking types in total" % len(types))
    return 0


def main():
    errors = validate_policy(gen_targets())
    if errors:
        print("BRIDGE POLICY INVALID:")
        for e in errors:
            print("  ! %s" % e)
        return 1
    if "--emit" in sys.argv:
        i = sys.argv.index("--emit")
        return emit(sys.argv[i + 1])
    if "--report-all" in sys.argv:
        return report_all()
    if "--check" in sys.argv:
        i = sys.argv.index("--check")
        return emit(sys.argv[i + 1], check=True)
    if "--list" in sys.argv:
        which = [a for a in sys.argv[1:] if not a.startswith("-")]
        for lib, rel, base, btype, hdr in gen_targets():
            if which and lib.split(".")[0] not in which:
                continue
            funcs = parse_conf(os.path.join(AROS, rel)) or []
            print("== %s" % lib)
            for f in funcs:
                if f.tier(lib)[0] != 1:
                    continue
                sig = ", ".join("%s %s %s" % (t, n, r)
                                for (t, n), r in zip(f.args, f.regs)) or "void"
                print("  %4d %-6d %-22s %-10s (%s)%s"
                      % (f.lvo, f.offset, f.name, norm(f.ret), sig,
                         "  [DENIED: %s]" % DENY[(lib, f.name)]
                         if (lib, f.name) in DENY else ""))
        return 0
    total1 = total = 0
    reasons = {}
    fail = False
    for lib, rel, base, btype, hdr in gen_targets():
        path = os.path.join(AROS, rel)
        funcs = parse_conf(path)
        if funcs is None:
            print("%-20s MISSING %s" % (lib, rel))
            continue
        bad = selfcheck(lib, funcs)
        t1 = [f for f in funcs if f.tier(lib)[0] == 1]
        pub = [f for f in funcs if not f.private]
        total1 += len(t1)
        total += len(pub)
        print("%-20s %4d vectors  %4d public  %4d tier-1 (%.0f%%)  %s"
              % (lib, len(funcs), len(pub), len(t1),
                 100.0 * len(t1) / max(1, len(pub)),
                 "OK" if not bad else "LVO SELF-CHECK FAILED"))
        for b in bad:
            fail = True
            print("      ! %s" % b)
        for f in pub:
            if f.tier(lib)[0] != 1:
                reasons.setdefault(f.tier(lib)[1], []).append("%s.%s" % (lib.split(".")[0], f.name))

    print("\ntotal: %d of %d public vectors are tier 1 (%.0f%%)"
          % (total1, total, 100.0 * total1 / max(1, total)))
    print("\nwhat keeps the rest out, most common first:")
    for r, fs in sorted(reasons.items(), key=lambda kv: -len(kv[1]))[:18]:
        print("  %4d  %-42s e.g. %s" % (len(fs), r[:42], ", ".join(fs[:3])))

    return 1 if fail else 0


if __name__ == "__main__":
    sys.exit(main())
