    "workbench",
]


def load_policy():
    """Load the semantic facts C prototypes cannot carry. This file is small
    on purpose: it describes TYPES/domains once, while the .conf remains the
    authority for function names, LVOs, registers and C signatures."""
    try:
        with open(POLICY_PATH, encoding="utf-8") as fh:
            p = json.load(fh)
    except (OSError, ValueError) as e:
        raise SystemExit("cannot load bridge policy %s: %s" % (POLICY_PATH, e))
    if p.get("schema") != 1:
        raise SystemExit("bridge policy schema must be 1")
    domains = p.get("tag_domains", {})
    unresolved = {name for name, spec in domains.items() if "derive" in spec}
    while unresolved:
        progressed = False
        for name in sorted(unresolved):
            spec = domains[name]
            derive = spec.get("derive", {})
            source_name = derive.get("from")
            source = domains.get(source_name)
            if not source or source_name in unresolved:
                continue
            mapping = derive.get("map", {})
            otherwise = derive.get("otherwise", "refuse")
            tags = []
            for original in source.get("tags", []):
                target_kind = mapping.get(original.get("kind"), otherwise)
                if target_kind == "same":
                    item = dict(original)
                else:
                    item = {"name": original["name"], "kind": target_kind}
                    if target_kind == "refuse":
                        item["reason"] = ("derived output domain has no approved %s copyback" %
                                          original.get("kind", "payload"))
                tags.append(item)
            expanded = {key: value for key, value in spec.items() if key != "derive"}
            expanded.setdefault("headers", list(source.get("headers", [])))
            expanded.setdefault("max_items", source.get("max_items", 32))
            expanded["tags"] = tags
            domains[name] = expanded
            unresolved.remove(name)
            progressed = True
            break
        if not progressed:
            raise SystemExit("bridge policy has unresolved/cyclic derived tag domains: %s" %
                             ", ".join(sorted(unresolved)))
    return p


POLICY = load_policy()


def find_confs():
    """short name -> path, for every .conf in the tree carrying a functionlist.
    Prefers rom/ and workbench/libs/ when a name appears more than once."""
    out = {}
    for root, dirs, files in os.walk(AROS):
        dirs[:] = [d for d in dirs if d not in (".git", "bin")]
        for fn in files:
            if not fn.endswith(".conf"):
                continue
            p = os.path.join(root, fn)
            try:
                if "##begin functionlist" not in open(
                        p, encoding="utf-8", errors="replace").read():
                    continue
            except OSError:
                continue
            rel = os.path.relpath(p, AROS)
            short = fn[:-5]
            rank = 0 if rel.startswith(("rom/", "workbench/libs/")) else 1
            if short not in out or rank < out[short][1]:
                out[short] = (rel, rank)
    return {k: v[0] for k, v in out.items()}


BASE_RE = re.compile(r"extern\s+(struct\s+\w+|\w+)\s*\*\s*(\w+)\s*;")
GETBASE_RE = re.compile(r"__aros_getbase_(\w+)\s*\(\)")


def proto_base(short):
    """(base name, base type) for `short`, read from its generated proto header.
    Returns None when there is no header, i.e. nothing to generate against."""
    path = os.path.join(GENINC, "proto", short + ".h")
    try:
        src = open(path, encoding="utf-8", errors="replace").read()
    except OSError:
        return None
    m = GETBASE_RE.search(src)
    if not m:
        return None
    name = m.group(1)
    btype = "struct Library"
    for bt, bn in BASE_RE.findall(src):
        # the specific spelling wins over the generic `struct Library` one
        if bn == name and norm(bt) != "struct Library":
            btype = norm(bt)
    return (name, btype)


def gen_targets():
    """The libraries code is emitted for: on GEN_LIBS, has a .conf, and has a
    generated proto header to compile against."""
    confs = find_confs()
    out = []
    for short in GEN_LIBS:
        rel = confs.get(short)
        if not rel:
            continue
        pb = proto_base(short)
        if not pb:
            continue
        out.append((short + ".library", rel, pb[0], pb[1], "proto/%s.h" % short))
    return out


def all_targets():
    """Every library in the tree, for classification. No proto header needed:
    nothing is compiled, only counted."""
    return [(short + ".library", rel, None, None, None)
            for short, rel in sorted(find_confs().items())]


def analysis_targets(which):
    """Resolve requested libraries without the runtime emission allowlist.

    GEN_LIBS deliberately limits what the bridge links by default.  An importer
    must instead be able to inspect any source library, including one that has
    never been imported before.  A generated proto header is recorded when
    present but is not required merely to discover and report the source.
    """
    if not which:
        return gen_targets()
    confs, out, missing = find_confs(), [], []
    for requested in sorted(set(which)):
        short = requested[:-8] if requested.endswith(".library") else requested
        rel = confs.get(short)
        if not rel:
            missing.append(requested)
            continue
        pb = proto_base(short)
        out.append((short + ".library", rel,
                    pb[0] if pb else None, pb[1] if pb else None,
                    "proto/%s.h" % short if pb else None))
    if missing:
        raise ValueError("no AROS library .conf matches: %s" %
                         ", ".join(missing))
    return out


# ---------------------------------------------------------------------------
# type classification
# ---------------------------------------------------------------------------

# Fits in (or narrower than) a 32-bit 68k register, and carries no address.
SCALAR = {
    "LONG", "ULONG", "WORD", "UWORD", "BYTE", "UBYTE", "BOOL", "LONGBITS",
    "ULONGBITS", "int", "unsigned int", "long", "unsigned long", "short",
    "unsigned short", "char", "unsigned char", "signed char", "UBYTE",
    "STACKULONG", "STACKLONG", "Tag", "TEXT",
}

# Pointer-sized natively but used as an integer. Safe as an argument (we widen
# a 32-bit register); as a RESULT it is narrowed, which is only correct because
# the value is an integer and not an address. Flagged in the generated source.
WIDENING = {"IPTR", "SIPTR", "APTR_or_IPTR"}

# A pointer to bytes: no layout, so the guest's own buffer can be handed over
# directly. This is the only pointer class that is safe to forward as-is.
STRING = {"STRPTR", "CONST_STRPTR", "CONST_STRPTR_or_NULL"}

# How wide the guest's own value is when a scalar argument says how many bytes
# of a structure the caller wants touched. The register is 32 bits either way;
# this is the width the 68k program believes it passed.
SIZE_WIDTHS = {
    "BYTE": 1, "UBYTE": 1,
    "WORD": 2, "UWORD": 2,
    "LONG": 4, "ULONG": 4, "int": 4, "unsigned int": 4,
    "LONGBITS": 4, "ULONGBITS": 4, "IPTR": 4, "SIPTR": 4,
}
SIZE_CASTS = {1: "(ULONG)(UBYTE)", 2: "(ULONG)(UWORD)", 4: "(ULONG)"}

POINTER_SCALARS = {
    "u8":  ({"UBYTE"}, 1),
    "s8":  ({"BYTE"}, 1),
    "u16": ({"UWORD"}, 2),
    "s16": ({"WORD"}, 2),
    "u32": ({"ULONG", "ULONGBITS"}, 4),
    "s32": ({"LONG", "LONGBITS"}, 4),
}

VOID = {"void", "VOID"}

# Tier 1 by signature is not the same as safe to forward. A guest is not
# trusted to halt the machine it is a guest on, and a simple signature says
# nothing about that, so the decision is made by name.
#
# exec.library is inverted: it is a kernel API, not an application API, and
# nearly every one of its simple-signature vectors drives the real machine
# (ShutdownA, SetSR, ReadGayle, Exception, RawPutChar). The calls a 68k
# program legitimately makes into exec - memory, lists, semaphores,
# OpenLibrary - are hand-served already. So exec is allowlisted and everything
# else is denylisted.
ALLOWLIST_LIBS = {"exec.library"}

ALLOW = {
    ("exec.library", "AvailMem"): 1,
}

# Vectors that LOOK like tier 2a but must stay hand-written: they need
# something before or after the call that a derived crossing cannot know about.
DENY_2A = {
    ("dos.library", "Close"):     "must release the handle-table slot after",
    ("dos.library", "UnLock"):    "must release the handle-table slot after",
    ("dos.library", "UnLoadSeg"): "a guest seglist is not a native one",
    ("dos.library", "RunCommand"):"a guest seglist is not a native one",
    ("dos.library", "AddSegment"):"a guest seglist is not a native one",
}

DENY = {
    # the guest exits by returning; calling this would unwind the host task
    ("dos.library",  "Exit"):        "the guest exits by returning, not by this",
    # device-level operations: vanishingly rare in the programs being served,
    # and catastrophic if a mistranslated register ever reaches one
    ("dos.library",  "Format"):      "device-level, and destroys a volume",
    ("dos.library",  "Relabel"):     "device-level",
    ("dos.library",  "Inhibit"):     "device-level",
    ("dos.library",  "AddBuffers"):  "device-level",
    ("dos.library",  "SetOwner"):    "device-level",
    # meaningless or harmful without the paired call, which is not tier 1
    ("dos.library",  "UnLockDosList"): "pairs with LockDosList, which is not tier 1",
    ("dos.library",  "SetArgStr"):   "rebinds the host process argument string",
    ("dos.library",  "SetProgramName"): "renames the host process",
    ("dos.library",  "SetCurrentDirName"): "moves the host process, not the guest",
    ("dos.library",  "SetPrompt"):   "the host shell's prompt is not the guest's",
    ("dos.library",  "MaxCli"):      "reports on host CLIs, not guest ones",
    # the host task's signals are the JIT's, not the guest's: a guest that
    # allocates or waits on them stalls the task running it
    ("dos.library",  "CheckSignal"): "the host task's signals are not the guest's",
    # `dest` is a STRPTR when soft is set and a BPTR lock when it is not, so
    # one C type covers two conversions and the signature cannot say which
    ("dos.library",  "MakeLink"):   "dest is a string or a lock depending on soft",
    # returns a PAIR: quotient in D0, remainder in D1. The C prototype can only
    # describe D0, so generating from it would leave D1 stale and the
    # arithmetic silently wrong. Needs a hand-written crossing.
    ("utility.library", "UDivMod32"): "returns quotient in D0 AND remainder in D1",
    ("utility.library", "SDivMod32"): "returns quotient in D0 AND remainder in D1",
}


def norm(t):
    return re.sub(r"\s+", " ", t.strip())


def classify(t):
    """-> ('scalar'|'widen'|'string'|'void'|'bptr'|'double'|'struct'|'aptr'|'other')"""
    t = norm(t)
    if t in VOID:
        return "void"
    # A 68k double is a bit pattern in a register PAIR. Nothing about it needs
    # describing beyond that: no memory is touched and the value crosses
    # unchanged, so the .conf's own register spelling is the whole contract.
    if t == "double":
        return "double"
    if t == "BPTR":
        return "bptr"
    if t in SCALAR:
        return "scalar"
    if t in WIDENING:
        return "widen"
    if t in STRING:
        return "string"
    # `UBYTE *name` / `char *` / `CONST STRPTR` spellings of a byte buffer
    if re.fullmatch(r"(CONST\s+)?(unsigned\s+|signed\s+)?(char|UBYTE|TEXT)\s*\*", t):
        return "string"
    if t == "APTR" or t == "CONST_APTR":
        return "aptr"
    if "*" in t:
        return "struct"
    return "other"


# ---------------------------------------------------------------------------
# .conf parsing
# ---------------------------------------------------------------------------

# `<return type> <name>(<args>) (<regs>)`, where the return type may itself
# carry stars and `struct`.
FUNC_RE = re.compile(r"^(.*?\**)\s*(\w+)\s*\((.*)\)\s*\(([^()]*)\)\s*$")


def split_args(s):
    """Split an argument list on commas that are not inside parentheses (a
    function-pointer argument carries its own)."""
    out, depth, cur = [], 0, ""
    for ch in s:
        if ch in "([":
            depth += 1
        elif ch in ")]":
            depth -= 1
        if ch == "," and depth == 0:
            out.append(cur)
            cur = ""
        else:
            cur += ch
    if cur.strip():
        out.append(cur)
    return [a.strip() for a in out if a.strip()]


def arg_type_and_name(a):
    """`struct FileInfoBlock* fib` -> ('struct FileInfoBlock *', 'fib')"""
    a = a.strip()
    if a in VOID or a == "":
        return None
    # a function pointer argument: `void (*fn)(...)`
    if "(*" in a:
        return ("__fnptr", "fn")
    m = re.match(r"^(.*?)(\w+)$", a)
    if not m:
        return (norm(a), "a")
    t, n = m.group(1), m.group(2)
    if not t.strip() or t.strip() in ("struct", "const", "CONST", "unsigned", "signed"):
        # the whole thing was a bare type with no parameter name
        return (norm(a), "a")
    return (norm(t), n)


class Func:
    def __init__(self, lvo, ret, name, args, regs):
        self.lvo, self.ret, self.name, self.args, self.regs = lvo, ret, name, args, regs
        self.private = False
        self.novararg = False

    @property
    def offset(self):
        return -6 * self.lvo

    def tier(self, lib=None):
        """1, or the reason it is not 1."""
        if self.private:
            return (None, "private")
        if lib is not None:
            if (lib, self.name) in DENY:
                return (None, "refused: " + DENY[(lib, self.name)])
            if lib in ALLOWLIST_LIBS and (lib, self.name) not in ALLOW:
                return (None, "not on the %s allowlist" % lib.split(".")[0])
        if self.regs and self.regs[0] in ("base", "sysv"):
            return (None, "not register-based")
        # a zero-argument function has an empty register list, which is fine
        if not self.regs and self.args:
            return (None, "no register mapping")
        if len(self.regs) != len(self.args):
            return (None, "register/argument count mismatch")
        rc = classify(self.ret)
        if rc == "bptr":
            return (None, "returns BPTR")
        # A returned pointer is a 64-bit HOST address. There is no 32-bit
        # register to put it in, and truncating one is how a guest gets handed
        # a pointer that dereferences to nothing. This includes STRPTR: a
        # returned string is as unrepresentable as a returned struct.
        if rc in ("struct", "aptr", "other", "string"):
            return (None, "returns a pointer (%s)" % norm(self.ret))
        blockers = []
        for t, n in self.args:
            c = classify(t)
            if c == "bptr":
                blockers.append("BPTR %s" % n)
            elif c == "struct":
                blockers.append("%s" % norm(t))
            elif c == "aptr":
                blockers.append("APTR %s" % n)
            elif c == "other":
                blockers.append("%s %s" % (norm(t), n))
        if not blockers:
            return (1, None)

        # TIER 2a: the only thing standing in the way is a BPTR, and a BPTR
        # already has a mechanism - the handle table that maps a guest token to
        # the native pointer it stands for. So these are derivable too, and the
        # 25 dos vectors in this shape do not need writing out one at a time.
        if all(b.startswith("BPTR") for b in blockers) and \
           classify(self.ret) in ("scalar", "widen", "void", "bptr") and \
           lib is not None and (lib, self.name) not in DENY_2A:
            return (2, None)

        return (None, ", ".join(sorted(set(blockers))))


# The first vector the functionlist describes, exactly as genmodule derives it
# (tools/genmodule/config.c): by module type, except that a library declaring
# `noresident` spells out the four standard vectors itself and so starts at 1.
FIRSTLVO_BY_MODTYPE = {
    "handler": 1, "resource": 1,
    "library": 5, "usbclass": 5, "hidd": 5, "class": 5, "gadget": 5, "image": 5,
    "datatype": 6, "mcc": 6, "mui": 6, "mcp": 6,
    "device": 7,
}


def first_lvo(lines):
    modtype, options = "library", ""
    inconf = False
    for line in lines:
        if line.startswith("##begin config"):
            inconf = True
            continue
        if line.startswith("##end config"):
            break
        if not inconf:
            continue
        s = line.split("#")[0].strip()
        if s.startswith("modtype"):
            modtype = s.split(None, 1)[1].strip().lower() if len(s.split()) > 1 else modtype
        elif s.startswith("options"):
            options += " " + s
    lvo = FIRSTLVO_BY_MODTYPE.get(modtype, 5)
    if "noresident" in options:
        lvo = 1
    return lvo


def parse_conf(path):
    inlist = False
    try:
        lines = open(path, encoding="utf-8", errors="replace").read().splitlines()
    except OSError:
        return None
    funcs = []
    lvo = first_lvo(lines) - 1
    last = None
    for raw in lines:
        line = raw.rstrip()
        if line.startswith("##begin functionlist"):
            inlist = True
            continue
        if line.startswith("##end functionlist"):
            break
        if not inlist:
            continue
        # genmodule treats an empty line *inside* a functionlist as a reserved
        # vector slot (config.c:readsectionfunctionlist).  locale.library uses
        # exactly this after `.version 39` to leave LVO 5 to the OpenCatalog()
        # stack-call veneer, so discarding blank lines shifts every real entry.
        if not line.strip():
            lvo += 1
            last = None
            continue
        # strip trailing comment, but not a `#` inside the prototype
        s = line.split("#")[0].strip() if not line.lstrip().startswith("#") else ""
        if not s:
            continue
        if s.startswith("."):
            d = s[1:].split()
            if d[0] == "skip":
                lvo += int(d[1]) if len(d) > 1 else 1
                last = None
            elif d[0] == "private":
                if last is not None:
                    last.private = True
            elif d[0] == "novararg":
                if last is not None:
                    last.novararg = True
            # .version, .function, .alias and friends do not consume a vector
            continue
        m = FUNC_RE.match(s)
        if not m:
            last = None
            continue
        ret, name, argstr, regstr = m.groups()
        lvo += 1
        args = []
        ok = True
        for a in split_args(argstr):
            tn = arg_type_and_name(a)
            if tn is None:
                continue
            if tn[0] == "__fnptr":
                ok = False
            args.append(tn)
        regs = [r.strip() for r in regstr.split(",") if r.strip()]
        f = Func(lvo, ret if ret.strip() else "void", name, args, regs)
        if not ok:
            f.args.append(("__fnptr", "fn"))
        funcs.append(f)
        last = f
    return funcs


# ---------------------------------------------------------------------------
# implementation-source evidence
# ---------------------------------------------------------------------------

# The .conf prototype is the ABI authority, but intentionally says nothing
# about the meaning of an APTR or TagItem payload.  The implementation often
# does: GetTagData/FindTagItem name accepted tags, casts name pointer payloads,
# field accesses show which structures are read, and Alloc/Free pairs expose
# ownership.  Keep this pass evidence-producing rather than silently rewriting
# policy: only facts with an explicit source location should ever graduate into
# the fail-closed bridge policy.

SOURCE_FUNC_RE = (r"\bAROS_LH\d+[A-Z]*\s*\(\s*[^,]+,\s*%s\s*,")
TAG_CALL_RE = re.compile(r"\b(GetTagData|FindTagItem)\s*\(")
TAG_MACRO_RE = re.compile(r"^[A-Z][A-Za-z0-9_]*$")
ALLOC_CALL_RE = re.compile(r"\b(Alloc(?:Mem|Vec|Pooled|DosObject|AslRequest)|"
                           r"Create(?:Pool|MsgPort|IORequest)|NewObjectA?)\s*\(")
FREE_CALL_RE = re.compile(r"\b(Free(?:Mem|Vec|Pooled|DosObject|AslRequest)|"
                          r"Delete(?:Pool|MsgPort|IORequest)|DisposeObject|"
                          r"Close[A-Za-z0-9_]*)\s*\(")
CALLBACK_SOURCE_RE = re.compile(
    r"\b(CallHookPkt|CALLHOOKPKT|AROS_UFC\d*|HookEntry|h_Entry|cl_Dispatcher)\b")
TAG_DATA_CAST_RE = re.compile(
    r"\(\s*((?:const\s+)?(?:struct\s+)?[A-Za-z_]\w*"
    r"(?:\s+[A-Za-z_]\w*)?\s*\*?)\s*\)\s*\(?\s*"
    r"(?:[A-Za-z_]\w*\s*->\s*ti_Data|tidata)\b")
C_TYPE_TOKEN_RE = (r"(?:const\s+)?(?:struct\s+)?[A-Za-z_]\w*"
                   r"(?:\s+[A-Za-z_]\w*)?\s*\**")


def mask_c_comments(src):
    """Replace comments with spaces while preserving byte offsets/newlines.

    Evidence line numbers then still refer to the original source, and regexes
    cannot mistake an autodoc example or commented-out implementation for code.
    String and character literals are retained because a string default is
    useful evidence that a tag payload is a C string.
    """
    out = list(src)
    i, state = 0, "code"
    while i < len(src):
        ch = src[i]
        nxt = src[i + 1] if i + 1 < len(src) else ""
        if state == "code":
            if ch == "/" and nxt == "*":
                out[i] = out[i + 1] = " "
                i += 2
                state = "block"
                continue
            if ch == "/" and nxt == "/":
                out[i] = out[i + 1] = " "
                i += 2
                state = "line"
                continue
            if ch == '"':
                state = "string"
            elif ch == "'":
                state = "char"
        elif state == "block":
            if ch == "*" and nxt == "/":
                out[i] = out[i + 1] = " "
                i += 2
                state = "code"
                continue
            if ch != "\n":
                out[i] = " "
        elif state == "line":
            if ch == "\n":
                state = "code"
            else:
                out[i] = " "
        elif state in ("string", "char"):
            quote = '"' if state == "string" else "'"
            if ch == "\\":
                i += 2
                continue
            if ch == quote:
                state = "code"
        i += 1
    return "".join(out)


def call_arguments(src, opening):
    """Return the top-level arguments and closing offset for a C call."""
    if opening >= len(src) or src[opening] != "(":
        return ([], opening)
    args, start, depth = [], opening + 1, 1
    i, state = opening + 1, "code"
    while i < len(src):
        ch = src[i]
        if state == "code":
            if ch == '"':
                state = "string"
            elif ch == "'":
                state = "char"
            elif ch == "(":
                depth += 1
            elif ch == ")":
                depth -= 1
                if depth == 0:
                    args.append(src[start:i].strip())
                    return (args, i + 1)
            elif ch == "," and depth == 1:
                args.append(src[start:i].strip())
                start = i + 1
        elif state in ("string", "char"):
            quote = '"' if state == "string" else "'"
            if ch == "\\":
                i += 2
                continue
            if ch == quote:
                state = "code"
        i += 1
    return ([], opening)


def source_cast_before(src, offset):
    """The result cast immediately preceding a GetTagData call, if any."""
    prefix = src[max(0, offset - 96):offset]
    m = re.search(r"\(\s*((?:const\s+)?(?:struct\s+)?[A-Za-z_]\w*"
                  r"(?:\s+[A-Za-z_]\w*)?\s*\*?)\s*\)\s*$", prefix)
    return norm(m.group(1)) if m else None


def infer_source_tag_kind(access, cast, default):
    """Classify only what the implementation spells out; retain ambiguity."""
    if access == "FindTagItem":
        return ("unknown", "medium")
    c = object_canon(cast) if cast else ""
    if c:
        if c in ("STRPTR", "CONST_STRPTR", "char *", "const char *", "TEXT *"):
            return ("cstr", "high")
        if "*" in c or c in ("APTR",):
            return ("pointer:" + c, "high")
    if re.search(r'(^|\W)"(?:[^"\\]|\\.)*"', default or ""):
        return ("cstr", "high")
    if re.search(r"\bNULL\b", default or ""):
        return ("pointer:unknown", "medium")
    # An uncast GetTagData result is IPTR-sized and a literal default does not
    # distinguish an integer from a pointer encoded as zero.  Calling it u32
    # here would make pointer-valued tags unsafe.  A later AST use-site pass may
    # promote this evidence after proving arithmetic/boolean-only use.
    return ("unknown", "medium")


def extract_tag_evidence(raw, base_line):
    """Return source-located tag-domain evidence from one function body."""
    code = mask_c_comments(raw)
    tags = []
    for m in TAG_CALL_RE.finditer(code):
        opening = code.find("(", m.start())
        args, _end = call_arguments(code, opening)
        if not args:
            continue
        tag = args[0].strip()
        if not TAG_MACRO_RE.fullmatch(tag):
            continue
        default = args[1].strip() if len(args) > 1 else ""
        list_expression = ""
        if m.group(1) == "GetTagData" and len(args) > 2:
            list_expression = args[2].strip()
        elif m.group(1) == "FindTagItem" and len(args) > 1:
            list_expression = args[1].strip()
        cast = source_cast_before(code, m.start())
        kind, confidence = infer_source_tag_kind(m.group(1), cast, default)
        tags.append({
            "name": tag,
            "access": m.group(1),
            "kind": kind,
            "confidence": confidence,
            "line": base_line + code.count("\n", 0, m.start()),
            "cast": cast,
            "default": re.sub(r"\s+", " ", default)[:120],
            "list_expression": re.sub(r"\s+", " ", list_expression)[:120],
            "list_parameters": sorted(set(re.findall(
                r"\b[A-Za-z_]\w*\b", list_expression)))
        })

    # A NextTagItem loop generally dispatches on ti_Tag.  These cases are
    # valid domain evidence but payload typing needs data-flow, so keep them
    # distinct and low confidence rather than pretending every case is u32.
    if "NextTagItem" in code:
        next_tag_expressions, next_tag_parameters = [], set()
        for call in re.finditer(r"\bNextTagItem\s*\(", code):
            opening = code.find("(", call.start())
            args, _end = call_arguments(code, opening)
            if not args:
                continue
            expression = re.sub(r"\s+", " ", args[0].strip())[:120]
            next_tag_expressions.append(expression)
            next_tag_parameters.update(re.findall(r"\b[A-Za-z_]\w*\b",
                                                   expression))
        list_expression = " | ".join(sorted(set(next_tag_expressions)))
        for m in re.finditer(r"\bcase\s+([A-Z][A-Za-z0-9_]*)\s*:", code):
            tag = m.group(1)
            if tag.endswith("_KIND"):
                continue
            if not (tag.startswith(("GA_", "GTM", "GTC", "GTS", "GTLV_", "GT_",
                                    "WA_", "SA_", "PGA_", "STRINGA_", "MX_",
                                    "CYCLE_"))):
                continue
            tags.append({
                "name": tag, "access": "NextTagItem/case", "kind": "unknown",
                "confidence": "low",
                "line": base_line + code.count("\n", 0, m.start()),
                "cast": None, "default": "", "list_expression": list_expression,
                "list_parameters": sorted(next_tag_parameters)
            })

    # Deduplicate repeated reads but preserve the strongest evidence and first
    # source location.  A cast beats a NULL-derived pointer: high > medium > low.
    strength = {"low": 0, "medium": 1, "high": 2}
    tag_by_key = {}
    for tag in tags:
        key = (tag["name"], tag["access"])
        old = tag_by_key.get(key)
        if not old or strength[tag["confidence"]] > strength[old["confidence"]]:
            tag_by_key[key] = tag
    return sorted(tag_by_key.values(), key=lambda x: (x["name"], x["line"]))


def explicit_cast_kind(cast):
    canonical = object_canon(re.sub(r"\b(?:extern|static|register|volatile)\b", "", cast))
    canonical = norm(canonical)
    if canonical in ("STRPTR", "CONST_STRPTR", "char *", "const char *", "TEXT *"):
        return "cstr"
    if classify(canonical) == "string":
        return "cstr"
    if "*" in canonical or canonical in ("APTR", "CONST_APTR"):
        return "pointer:" + canonical
    if classify(canonical) == "scalar":
        return "u32"
    return None


def declaration_type_index(code):
    found = {}
    # Anchor at a declaration line. Without that boundary the optional second
    # type word can greedily consume most of a one-word declaration's field
    # name (`UBYTE FrontPen` became type `UBYTE FrontPe`, name `n`).
    pattern = re.compile(
        r"(?m)^[ \t]*(%s)[ \t]+([A-Za-z_]\w*)\s*(\[[^\]]*\])?\s*(?=[=;,])" %
        C_TYPE_TOKEN_RE)
    for match in pattern.finditer(code):
        declared = norm(match.group(1)) + (" *" if match.group(3) else "")
        found.setdefault(match.group(2), set()).add(norm(declared))
    return found


def declared_type_before(code, name, offset):
    pattern = re.compile(r"\b(%s)\s*%s\s*(\[[^\]]*\])?\s*(?=[=;,])" %
                         (C_TYPE_TOKEN_RE, re.escape(name)))
    matches = list(pattern.finditer(code, 0, offset))
    if not matches:
        return None
    return norm(matches[-1].group(1) + (" *" if matches[-1].group(2) else ""))


def declared_array_before(code, name, offset):
    pattern = re.compile(r"\b(%s)\s*%s\s*(\[[^\]]*\])\s*(?=[=;,])" %
                         (C_TYPE_TOKEN_RE, re.escape(name)))
    return bool(list(pattern.finditer(code, 0, offset)))


TAG_PAYLOAD_RE = re.compile(r"(?:[A-Za-z_]\w*\s*->\s*ti_Data|tidata)")
TAG_PAYLOAD_MARKER = "__EMU68K_TAG_PAYLOAD__"
TAG_TRUTH_CONDITION_RE = re.compile(
    r"\bif\s*\(\s*(?:!\s*)?" + re.escape(TAG_PAYLOAD_MARKER) +
    r"\s*(?:(?:==|!=)\s*(?:0|NULL|FALSE|TRUE))?\s*\)")


def truth_only_payload_use(code):
    """Whether every visible tag payload use only tests zero/nonzero."""
    marked, count = TAG_PAYLOAD_RE.subn(TAG_PAYLOAD_MARKER, code)
    if not count:
        return False
    reduced = TAG_TRUTH_CONDITION_RE.sub("if (0)", marked)
    return TAG_PAYLOAD_MARKER not in reduced


def scalar_payload_macros(code):
    """Return function-like macros that consume ``ti_Data`` only as truth.

    Some AROS tag switches hide the payload use behind a local macro.  Clang's
    expansion location points at the invocation and the spelling location at
    the macro body, while the lightweight source pass used for deterministic
    import packets previously saw neither as a typed assignment.  A truth-only
    use is nevertheless representation-safe: the native side observes zero or
    nonzero and never dereferences, stores, or calls through the value.

    Be deliberately narrow.  Every payload occurrence in the logical macro
    body must be the complete condition of an ``if`` (optionally negated or
    compared with a Boolean/null constant).  Any additional occurrence leaves
    the macro unclassified and therefore fail-closed.
    """
    logical = re.sub(r"\\\r?\n", " ", code)
    definitions = re.compile(
        r"(?m)^[ \t]*#[ \t]*define[ \t]+([A-Za-z_]\w*)"
        r"[ \t]*\([^\n)]*\)[ \t]+([^\n]*)$")
    result = set()
    for match in definitions.finditer(logical):
        body = match.group(2)
        if truth_only_payload_use(body):
            result.add(match.group(1))
    return result


def extract_library_tag_evidence(sources, evidence_scope="library", type_sources=None):
    """Find type-bearing uses of tags anywhere in a library implementation.

    A public wrapper often forwards an IPTR unchanged to a BOOPSI class, so the
    wrapper alone cannot reveal its representation.  The class switch that
    consumes the same named tag can: `(struct Hook *)tidata`, for example, is
    explicit high-confidence evidence even though the call is not a normal C
    edge reachable from the public vector.
    """
    found = []
    field_types = {}
    for _path, raw in list(sources) + list(type_sources or []):
        for name, types in declaration_type_index(mask_c_comments(raw)).items():
            field_types.setdefault(name, set()).update(types)

    def add_case(tag, kind, cast, path, code, offset, access):
        found.append({
            "name": tag, "access": access, "kind": kind,
            "confidence": "high", "line": 1 + code.count("\n", 0, offset),
            "cast": cast, "default": "", "list_expression": "",
            "list_parameters": [], "source": os.path.relpath(path, AROS),
            "evidence_scope": evidence_scope
        })

    for path, raw in sources:
        code = mask_c_comments(raw)
        truth_macros = scalar_payload_macros(code)
        # Include explicit casts on direct GetTagData uses throughout the
        # library, including class implementations reached through dispatch.
        for item in extract_tag_evidence(raw, 1):
            if item.get("confidence") == "high":
                found.append(dict(item, source=os.path.relpath(path, AROS),
                                  evidence_scope=evidence_scope))
        for call in TAG_CALL_RE.finditer(code):
            # FindTagItem returns the TagItem itself, so the receiving variable's
            # type says nothing about ti_Data.  Only GetTagData returns payload.
            if call.group(1) != "GetTagData":
                continue
            opening = code.find("(", call.start())
            args, _after = call_arguments(code, opening)
            if not args or not TAG_MACRO_RE.fullmatch(args[0].strip()):
                continue
            tag = args[0].strip()
            prefix = code[max(0, call.start() - 192):call.start()]
            member = re.search(
                r"\b[A-Za-z_]\w*\s*->\s*([A-Za-z_]\w*)\s*=\s*"
                r"(?:\([^;=]+\)\s*)?$", prefix)
            if member:
                types = field_types.get(member.group(1), set())
                kinds = {explicit_cast_kind(t) for t in types}
                kinds.discard(None)
                if len(kinds) == 1 and types and all(explicit_cast_kind(t) for t in types):
                    add_case(tag, next(iter(kinds)), " | ".join(sorted(types)),
                             path, code, call.start(), "gettag-field-type")
            local = re.search(r"\b([A-Za-z_]\w*)\s*=\s*(?:\([^;=]+\)\s*)?$", prefix)
            if local and not member:
                target_type = declared_type_before(code, local.group(1), call.start())
                kind = explicit_cast_kind(target_type) if target_type else None
                if kind:
                    add_case(tag, kind, target_type, path, code, call.start(),
                             "gettag-local-target-type")
        cases = list(re.finditer(r"\bcase\s+([A-Z][A-Za-z0-9_]*)\s*:", code))
        for i, match in enumerate(cases):
            tag = match.group(1)
            if not TAG_MACRO_RE.fullmatch(tag):
                continue
            stop = cases[i + 1].start() if i + 1 < len(cases) else min(
                len(code), match.end() + 4096)
            block = code[match.end():stop]
            for cast_match in TAG_DATA_CAST_RE.finditer(block):
                cast = norm(cast_match.group(1))
                kind = explicit_cast_kind(cast)
                if not kind:
                    continue
                add_case(tag, kind, cast, path, code,
                         match.end() + cast_match.start(), "case-payload-cast")

            # A narrow/scalar local receiving ti_Data before the switch proves
            # scalar use for all of that switch's cases.  IPTR is intentionally
            # excluded because it is also the native carrier for pointers.
            if re.search(r"\btidata\b", block):
                target_type = declared_type_before(code, "tidata", match.start())
                kind = explicit_cast_kind(target_type) if target_type else None
                if kind:
                    add_case(tag, kind, target_type, path, code, match.start(),
                             "case-local-type")

            # Resolve `data->field = tidata` through declarations of that field.
            # Accept only when every declaration with that name yields the same
            # representation; ambiguous names remain unresolved.
            member_assign = re.compile(
                r"\b[A-Za-z_]\w*\s*->\s*([A-Za-z_]\w*)\s*=\s*"
                r"(?:\([^;=]+\)\s*)?(?:[A-Za-z_]\w*\s*->\s*ti_Data|tidata)\b")
            for assignment in member_assign.finditer(block):
                types = field_types.get(assignment.group(1), set())
                kinds = {explicit_cast_kind(t) for t in types}
                kinds.discard(None)
                if len(kinds) == 1 and types and all(explicit_cast_kind(t) for t in types):
                    add_case(tag, next(iter(kinds)), " | ".join(sorted(types)),
                             path, code, match.end() + assignment.start(),
                             "case-field-type")

            # Likewise for a named local target whose closest preceding
            # declaration gives it a concrete scalar or pointer type.
            local_assign = re.compile(
                r"\b([A-Za-z_]\w*)\s*=\s*(?:\([^;=]+\)\s*)?"
                r"(?:[A-Za-z_]\w*\s*->\s*ti_Data|tidata)\b")
            for assignment in local_assign.finditer(block):
                name = assignment.group(1)
                target_type = declared_type_before(code, name, match.start())
                kind = explicit_cast_kind(target_type) if target_type else None
                if kind:
                    add_case(tag, kind, target_type, path, code,
                             match.end() + assignment.start(), "case-local-target-type")

            # A local function-like macro can hide an otherwise explicit
            # Boolean use of ti_Data.  Classify every case invoking the same
            # proved truth-only macro in one pass.  Preprocessor definition
            # lines are excluded so the case immediately preceding a local
            # #define is not accidentally attributed to the macro.
            for macro in sorted(truth_macros):
                invocation = re.search(
                    r"(?m)^[ \t]*(?!#)[^\n]*\b%s\s*\(" % re.escape(macro),
                    block)
                if invocation:
                    add_case(tag, "u32", macro, path, code,
                             match.end() + invocation.start(),
                             "case-payload-truth-macro")

            # The non-macro form is common in class and extension switches.
            # Again, every payload occurrence in the case must be consumed as
            # truth; a cast, assignment, dereference, or retention keeps the
            # case unresolved.
            if truth_only_payload_use(block):
                add_case(tag, "u32", "zero/nonzero", path, code,
                         match.end(), "case-payload-truth")
    unique = {}
    for item in found:
        key = (item["name"], item["kind"], item["source"], item["line"],
               item["access"])
        unique[key] = item
    return sorted(unique.values(), key=lambda x: (x["name"], x["source"], x["line"]))


def source_tree_tag_evidence(tag_names, existing_paths):
    """Corroborate forwarded tags from their consumers elsewhere in AROS."""
    names = sorted(set(tag_names))
    if not names:
        return [], []
    pattern = r"\b(?:%s)\b" % "|".join(re.escape(name) for name in names)
    try:
        proc = subprocess.run(
            ["rg", "-l", "--glob", "*.c", "--glob", "*.h", "-e", pattern, AROS],
            stdout=subprocess.PIPE, stderr=subprocess.PIPE,
            encoding="utf-8", errors="replace", timeout=30)
    except (OSError, subprocess.TimeoutExpired):
        return [], []
    paths = sorted(set(line for line in proc.stdout.splitlines()
                       if line and line not in existing_paths))
    # A tag prefix accidentally matching a generated/vendor forest must not
    # turn one import into an unbounded whole-tree analysis.
    paths = paths[:512]
    sources = []
    for path in paths:
        try:
            sources.append((path, open(path, encoding="utf-8", errors="replace").read()))
        except OSError:
            pass
    wanted = set(names)
    evidence = extract_library_tag_evidence(sources, evidence_scope="source-tree")
    annotated = []
    annotation = re.compile(
        r"/\*(.*?)\*/\s*#\s*define\s+([A-Za-z_]\w*)\s+([^\r\n]+)", re.S)
    for path, raw in sources:
        for match in annotation.finditer(raw):
            lhs, replacement = match.group(2), match.group(3)
            aliases = wanted.intersection(re.findall(r"\b[A-Za-z_]\w*\b", replacement))
            tag = lhs if lhs in wanted else (next(iter(aliases)) if len(aliases) == 1 else None)
            if not tag:
                continue
            declared, kind = None, None
            for type_match in re.finditer(r"\(\s*([^()]{1,80}?)\s*\)", match.group(1)):
                candidate = norm(type_match.group(1))
                inferred = explicit_cast_kind(candidate)
                if inferred:
                    declared, kind = candidate, inferred
                    break
            if not kind:
                continue
            annotated.append({
                "name": tag, "access": "header-type-annotation", "kind": kind,
                "confidence": "high", "line": 1 + raw.count("\n", 0, match.start()),
                "cast": declared, "default": "", "list_expression": "",
                "list_parameters": [], "source": os.path.relpath(path, AROS),
                "evidence_scope": "source-tree"
            })
    evidence.extend(annotated)
    unique = {}
    for item in evidence:
        key = (item["name"], item["kind"], item["source"], item["line"], item["access"])
        unique[key] = item
    result = sorted((item for item in unique.values() if item["name"] in wanted),
                    key=lambda x: (x["name"], x["source"], x["line"]))
    return result, sources


def expression_kind(expr, code, offset):
    """Infer a tag value's representation from an explicit client expression."""
    expr = expr.strip()
    if re.search(r'(^|\W)"(?:[^"\\]|\\.)*"', expr):
        return "cstr", "string-literal"
    stripped = re.sub(r"^\s*\(\s*(?:IPTR|SIPTR|ULONG)\s*\)\s*", "", expr)
    if stripped in ("TRUE", "FALSE"):
        return "u32", "scalar-literal"
    if re.fullmatch(r"(?:[-+]?\d+[uUlL]*|0x[0-9A-Fa-f]+[uUlL]*)", stripped):
        numeric = re.sub(r"[uUlL]+$", "", stripped)
        try:
            if int(numeric, 0) != 0:
                return "u32", "nonzero-scalar-literal"
        except ValueError:
            pass
    cast = re.match(r"^\s*\(\s*(%s)\s*\)" % C_TYPE_TOKEN_RE, expr)
    if cast:
        kind = explicit_cast_kind(norm(cast.group(1)))
        if kind:
            return kind, "explicit-cast"
    address = re.fullmatch(
        r"\s*(?:\(\s*IPTR\s*\)\s*)?&\s*([A-Za-z_]\w*)\s*", expr)
    if address:
        declared = declared_type_before(code, address.group(1), offset)
        if declared:
            if declared_array_before(code, address.group(1), offset):
                kind = explicit_cast_kind(declared)
                if kind:
                    return kind, "address-of-array"
            return "pointer:" + object_canon(declared + " *"), "address-of-typed-value"
    value = re.fullmatch(
        r"\s*(?:\(\s*IPTR\s*\)\s*)?([A-Za-z_]\w*)\s*", expr)
    if value:
        declared = declared_type_before(code, value.group(1), offset)
        kind = explicit_cast_kind(declared) if declared else None
        if kind:
            return kind, "declared-value-type"
    return None, None


def function_callsite_tag_evidence(f, evidence, sources):
    """Type variadic tag/value pairs for this exact public API veneer."""
    if f.novararg or not f.name.endswith("A"):
        return []
    tag_args = tag_arguments_for(evidence)
    if len(tag_args) != 1:
        return []
    tag_arg = tag_args[0]
    arg_names = [name for _type, name in f.args]
    try:
        fixed = arg_names.index(tag_arg)
    except ValueError:
        return []
    veneer = f.name[:-1]
    found = []
    for path, raw in sources:
        code = mask_c_comments(raw)
        for call in re.finditer(r"\b%s\s*\(" % re.escape(veneer), code):
            opening = code.find("(", call.start())
            args, _after = call_arguments(code, opening)
            if len(args) <= fixed:
                continue
            pairs = args[fixed:]
            for index in range(0, len(pairs) - 1, 2):
                tag = pairs[index].strip()
                if tag in ("TAG_DONE", "TAG_END"):
                    break
                if not TAG_MACRO_RE.fullmatch(tag) or tag.startswith("TAG_"):
                    continue
                kind, reason = expression_kind(pairs[index + 1], code, call.start())
                if not kind:
                    continue
                found.append({
                    "name": tag, "access": "typed-vararg-callsite", "kind": kind,
                    "confidence": "high", "line": 1 + code.count("\n", 0, call.start()),
                    "cast": reason, "default": "", "list_expression": veneer,
                    "list_parameters": [], "source": os.path.relpath(path, AROS),
                    "evidence_scope": "api-callsite", "api": f.name
                })
    unique = {}
    for item in found:
        key = (item["name"], item["kind"], item["source"], item["line"])
        unique[key] = item
    return sorted(unique.values(), key=lambda x: (x["name"], x["source"], x["line"]))


def source_function_chunk(src, name):
    """Find an AROS public function and the source through its closing marker."""
    m = re.search(SOURCE_FUNC_RE % re.escape(name), src, re.S)
    if not m:
        return None
    end = re.search(r"\}\s*/\*\s*%s\s*\*/" % re.escape(name), src[m.end():])
    if end:
        stop = m.end() + end.end()
    else:
        # Most AROS functions carry the marker.  Falling back to the next
        # public macro is conservative: it cannot blend two functions.
        nxt = re.search(r"\bAROS_LH\d+[A-Z]*\s*\(", src[m.end():])
        stop = m.end() + (nxt.start() if nxt else len(src) - m.end())
    return (m.start(), src[m.start():stop])


def generic_function_chunk(src, name):
    """Find a normal C function definition, excluding calls and prototypes."""
    code = mask_c_comments(src)
    for m in re.finditer(r"\b%s\s*\(" % re.escape(name), code):
        opening = code.find("(", m.start())
        _args, after = call_arguments(code, opening)
        if after == opening:
            continue
        # Attributes and old-style declaration details may sit between the
        # closing parenthesis and body.  A semicolon/assignment/comma proves
        # this occurrence is not the definition we want.
        brace = code.find("{", after, min(len(code), after + 512))
        if brace < 0 or re.search(r"[;=,]", code[after:brace]):
            continue
        depth, i, state = 1, brace + 1, "code"
        while i < len(code) and depth:
            ch = code[i]
            if state == "code":
                if ch == '"':
                    state = "string"
                elif ch == "'":
                    state = "char"
                elif ch == "{":
                    depth += 1
                elif ch == "}":
                    depth -= 1
            elif state in ("string", "char"):
                quote = '"' if state == "string" else "'"
                if ch == "\\":
                    i += 2
                    continue
                if ch == quote:
                    state = "code"
            i += 1
        if depth == 0:
            return (m.start(), src[m.start():i])
    return None


def source_files_for_target(rel):
    root = os.path.dirname(os.path.join(AROS, rel))
    files = []
    for walk_root, dirs, names in os.walk(root):
        dirs[:] = [d for d in dirs if d not in (".git", "bin", "obj")]
        for name in names:
            if name.endswith((".c", ".h")):
                files.append(os.path.join(walk_root, name))
    return root, sorted(files)


def terminated_record_arrays(f, raw, base_line):
    """Recognize a struct-pointer walk terminated by a named *_END case."""
    code = mask_c_comments(raw)
    found = []
    for ctype, argument in f.args:
        record = signature_record_name(ctype)
        if not record or ctype.count("*") != 1:
            continue
        aliases = {argument}
        aliases.update(re.findall(r"\b([A-Za-z_]\w*)\s*=\s*%s\b" %
                                  re.escape(argument), code))
        for alias in sorted(aliases):
            for switch in re.finditer(
                    r"\bswitch\s*\(\s*%s\s*->\s*([A-Za-z_]\w*)\s*\)" %
                    re.escape(alias), code):
                tail = code[switch.end():min(len(code), switch.end() + 8192)]
                sentinels = re.findall(r"\bcase\s+([A-Z][A-Za-z0-9_]*_END)\s*:", tail)
                advances = (re.search(r"\b%s\s*\+\+" % re.escape(alias), code) or
                            re.search(r"\b%s\s*\+=\s*1\b" % re.escape(alias), code))
                if not sentinels or not advances:
                    continue
                found.append({
                    "argument": argument, "record": record,
                    "sentinel_field": switch.group(1),
                    "sentinel_value": sentinels[0], "max_count": 1024,
                    "confidence": "high",
                    "line": base_line + code.count("\n", 0, switch.start()),
                    "via_alias": alias
                })
    unique = {}
    for item in found:
        key = (item["argument"], item["record"], item["sentinel_field"],
               item["sentinel_value"])
        unique[key] = item
    return sorted(unique.values(), key=lambda x: x["argument"])


def analyze_function_source(lib, rel, f, sources):
    found = None
    for path, src in sources:
        chunk = source_function_chunk(src, f.name)
        if chunk:
            found = (path, src, chunk[0], chunk[1])
            break
    if not found:
        return {
            "name": f.name, "lvo": f.lvo, "offset": f.offset,
            "source": None, "policy": policy_key(lib, f) in POLICY.get("functions", {}),
            "tags": [], "arguments": {}, "memory": {}, "callbacks": [],
            "record_arrays": []
        }

    path, whole, start, raw = found
    code = mask_c_comments(raw)
    base_line = whole.count("\n", 0, start) + 1
    tags = extract_tag_evidence(raw, base_line)
    record_arrays = terminated_record_arrays(f, raw, base_line)

    arguments = {}
    for atype, aname in f.args:
        ev = {}
        fields = sorted(set(re.findall(r"\b%s\s*->\s*([A-Za-z_]\w*)" %
                                       re.escape(aname), code)))
        if fields:
            ev["dereferenced_fields"] = fields
        casts = sorted(set(norm(x) for x in re.findall(
            r"\(\s*((?:const\s+)?(?:struct\s+)?[A-Za-z_]\w*"
            r"(?:\s+[A-Za-z_]\w*)?\s*\*)\s*\)\s*%s\b" % re.escape(aname), code)))
        if casts:
            ev["concrete_casts"] = casts
        retained = sorted(set(re.findall(
            r"(?:->|\.)\s*([A-Za-z_]\w*)\s*=\s*(?:\([^;=]+\)\s*)?%s\b" %
            re.escape(aname), code)))
        if retained:
            ev["stored_in_fields"] = retained
        if ev:
            ev["declared_type"] = norm(atype)
            arguments[aname] = ev

    allocs = sorted(set(m.group(1) for m in ALLOC_CALL_RE.finditer(code)))
    frees = sorted(set(m.group(1) for m in FREE_CALL_RE.finditer(code)))
    callbacks = sorted(set(m.group(1) for m in CALLBACK_SOURCE_RE.finditer(code)))
    return {
        "name": f.name,
        "lvo": f.lvo,
        "offset": f.offset,
        "signature": {
            "result": norm(f.ret),
            "arguments": [{"type": norm(t), "name": n, "register": r}
                          for (t, n), r in zip(f.args, f.regs)]
        },
        "source": os.path.relpath(path, AROS),
        "line": base_line,
        "policy": policy_key(lib, f) in POLICY.get("functions", {}),
        "tags": tags,
        "arguments": arguments,
        "memory": {"allocators": allocs, "releasers": frees},
        "callbacks": callbacks,
        "record_arrays": record_arrays,
        "_raw": raw
    }


def ownership_candidates(functions, evidence):
    """Pair pointer-producing allocators with source-correlated releasers."""
    byname = {f.name: f for f in functions}
    evname = {e["name"]: e for e in evidence}
    out = []
    release_prefixes = ("Free", "Close", "Dispose", "Delete")

    def noun(name):
        name = re.sub(r"A$", "", name)
        return re.sub(r"^(?:Get|Create|Alloc|Open|New|Free|Close|Dispose|Delete)", "", name)

    for producer in functions:
        pe = evname.get(producer.name, {})
        memory = pe.get("memory", {})
        if not (memory.get("allocators") or memory.get("reachable_allocators")):
            continue
        if classify(producer.ret) not in ("struct", "aptr", "string"):
            continue
        for consumer in functions:
            if not consumer.name.startswith(release_prefixes) or len(consumer.args) != 1:
                continue
            same_type = object_canon(producer.ret) == object_canon(consumer.args[0][0])
            same_noun = noun(producer.name) == noun(consumer.name)
            ce = evname.get(consumer.name, {})
            cross_ref = (consumer.name in pe.get("_raw", "") or
                         producer.name in ce.get("_raw", ""))
            if not same_type and not same_noun and not cross_ref:
                continue
            confidence = "high" if cross_ref and (same_type or same_noun) else "medium"
            out.append({
                "producer": producer.name,
                "consumer": consumer.name,
                "type": norm(producer.ret),
                "confidence": confidence,
                "evidence": sorted(set(
                    (["matching-type"] if same_type else []) +
                    (["matching-api-noun"] if same_noun else []) +
                    (["source-cross-reference"] if cross_ref else [])))
            })
    return sorted(out, key=lambda x: (x["producer"], x["consumer"]))


def conf_basename(path, config=None):
    """The basename is the prefix genmodule puts on expanded AROS_LH symbols.

    Only the library's first config block is relevant. A single .conf can also
    define many BOOPSI classes, each with its own later ``basename``; scanning
    the whole file would silently select the first class instead of the public
    library. When the library block uses genmodule's default, the generated
    libdefs header is the exact authority on GM_UNIQUENAME.
    """
    try:
        src = open(path, encoding="utf-8", errors="replace").read()
    except OSError:
        return None
    block = re.search(r"##begin\s+config\b(.*?)##end\s+config", src,
                      re.S | re.I)
    m = re.search(r"^basename\s+([A-Za-z_]\w*)\s*$",
                  block.group(1) if block else "", re.M)
    if m:
        return m.group(1)
    for generated in (config or {}).get("generated_inputs", []):
        try:
            raw = open(generated, encoding="utf-8", errors="replace").read()
        except OSError:
            continue
        m = re.search(r"^#define\s+GM_UNIQUENAME\(n\)\s+"
                      r"([A-Za-z_]\w*)\s*_?\s*##\s*n\s*$", raw, re.M)
        if m:
            return m.group(1).rstrip("_")
    return None


def ast_compile_config(rel, short):
    """Reproduce the target compiler inputs used by a generated library.

    AROS' cross clang already carries the aarch64-unknown-aros triple.  Its
    configured sysroot can outlive a scratch build, so always point it at the
    current build explicitly.  genmodule's per-library forced include is what
    gives AROS_LH macros their concrete base/symbol definitions.
    """
    source_root = os.path.dirname(os.path.join(AROS, rel))
    mirror = os.path.join(AROS_BUILD, os.path.dirname(rel))
    objdir = os.path.join(AROS_BUILD, "bin", "darwin-aarch64", "gen",
                          os.path.dirname(rel), short)
    sysroot = os.path.join(AROS_BUILD, "bin", "darwin-aarch64", "AROS",
                           "Developer")
    forced = os.path.join(objdir, "include", "%s_deflibdefs.h" % short)
    generated_inputs = []
    if os.path.exists(forced):
        generated_inputs.append(forced)
        try:
            forced_raw = open(forced, encoding="utf-8", errors="replace").read()
        except OSError:
            forced_raw = ""
        match = re.search(r'^#define\s+LC_LIBDEFS_FILE\s+"([^"]+)"',
                          forced_raw, re.M)
        if match and os.path.isfile(match.group(1)):
            generated_inputs.append(match.group(1))
    args = [
        AROS_CC,
        "--sysroot", sysroot,
        "-iquote", source_root,
        # The library's own directory. Its private headers live beside its
        # implementation, and the GENERATED libdefs header includes them by
        # quoted name from the object directory, where they are not. Without
        # this the analyzer cannot compile any module with a private header,
        # which is most of graphics, and a vector with no AST is a vector the
        # importer must refuse for lack of evidence.
        "-iquote", os.path.join(source_root, os.path.dirname(rel)),
        "-iquote", mirror,
        "-I", os.path.join(objdir, "include"),
    ]
    if os.path.exists(forced):
        args += ["-include", forced]
    args += [
        "-DAROS_BUILD_TYPE=AROS_BUILD_TYPE_PERSONAL",
        "-DUSE_EXEC_DEBUG", "-D__arm64__",
        "-Wno-everything", "-fsyntax-only"
    ]
    return {
        "compiler": AROS_CC,
        "sysroot": sysroot,
        "source_root": source_root,
        "object_dir": objdir,
        "forced_include": forced if os.path.exists(forced) else None,
        "generated_inputs": generated_inputs,
        "arguments": args
    }


def signature_record_name(ctype):
    if "*" not in ctype:
        return None
    base = re.sub(r"\b(?:const|CONST|volatile)\b", "", norm(ctype))
    base = re.sub(r"\s*\*+\s*$", "", base).strip()
    if base.startswith("struct "):
        return base.split(None, 1)[1]
    return None


def discover_record_headers(type_names, config):
    include = os.path.join(config["sysroot"], "include")
    headers = []
    for name in sorted(set(type_names)):
        pattern = r"\bstruct\s+%s(?:32|64)?\b" % re.escape(name)
        try:
            proc = subprocess.run(
                ["rg", "-l", "-e", pattern, include], stdout=subprocess.PIPE,
                stderr=subprocess.PIPE, encoding="utf-8", errors="replace", timeout=10)
        except (OSError, subprocess.TimeoutExpired):
            continue
        candidates = []
        definition = re.compile(r"\bstruct\s+%s(?:32|64)?\s*\{" % re.escape(name), re.S)
        for path in proc.stdout.splitlines():
            if not path:
                continue
            try:
                raw = open(path, encoding="utf-8", errors="replace").read()
            except OSError:
                continue
            if definition.search(mask_c_comments(raw)):
                candidates.append(os.path.relpath(path, include))
        candidates.sort(key=lambda path: (path.count(os.sep), len(path), path))
        if candidates and candidates[0] not in headers:
            headers.append(candidates[0])
    return headers


def probe_record_layouts(funcs, config):
    types = set()
    for f in funcs:
        for ctype in [f.ret] + [t for t, _name in f.args]:
            name = signature_record_name(ctype)
            if name:
                types.add(name)
    if not types:
        return {"status": "ok", "headers": [], "types": {}}
    headers = discover_record_headers(types, config)
    cmd = [LAYOUT_TOOL, "--probe-json", ",".join(sorted(types))]
    for header in headers:
        cmd += ["--header", header]
    env = dict(os.environ)
    env["AROS_INC"] = os.path.join(config["sysroot"], "include")
    env["AROS_CLANG"] = config["compiler"]
    try:
        proc = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                              encoding="utf-8", errors="replace", timeout=60, env=env)
    except (OSError, subprocess.TimeoutExpired) as exc:
        return {"status": "error", "headers": headers, "types": {},
                "error": str(exc)}
    if proc.returncode != 0:
        # gen-struct-layouts names its temporary translation unit with the
        # current process id.  Compiler diagnostics must not leak that random
        # filename into checked-in/import artifacts, otherwise an identical
        # analysis is reported stale on every replay.
        error = re.sub(r"(?:/[^\s:]+)?/\.structprobe-\d+\.c",
                       "<record-layout-probe>", proc.stderr + proc.stdout)
        return {"status": "error", "headers": headers, "types": {},
                "error": error[-4000:]}
    try:
        result = json.loads(proc.stdout)
    except ValueError as exc:
        return {"status": "error", "headers": headers, "types": {},
                "error": "invalid layout JSON: %s" % exc}
    return {"status": "ok", "headers": headers,
            "types": result.get("types", {})}


def ast_nodes(node):
    if not isinstance(node, dict):
        return
    yield node
    for child in node.get("inner", []):
        yield from ast_nodes(child)


def ast_referenced_parameters(node):
    out = set()
    for child in ast_nodes(node):
        if child.get("kind") != "DeclRefExpr":
            continue
        ref = child.get("referencedDecl", {})
        if ref.get("kind") == "ParmVarDecl" and ref.get("name"):
            out.add(ref["name"])
    return out


def ast_referenced_declarations(node):
    """Return parameter/local names referenced by an AST subtree."""
    out = set()
    for child in ast_nodes(node):
        if child.get("kind") != "DeclRefExpr":
            continue
        ref = child.get("referencedDecl", {})
        if ref.get("kind") in ("ParmVarDecl", "VarDecl") and ref.get("name"):
            out.add(ref["name"])
    return out


def ast_direct_parameter_values(node):
    """Parameters whose pointer value, rather than a derived field, is stored."""
    disallowed = {"MemberExpr", "BinaryOperator", "CompoundAssignOperator",
                  "CallExpr", "ConditionalOperator", "ArraySubscriptExpr"}
    if any(child.get("kind") in disallowed for child in ast_nodes(node)):
        return set()
    return ast_referenced_parameters(node)


def ast_callee(call):
    """Return the direct function declaration used as a CallExpr callee."""
    inner = call.get("inner", [])
    if not inner:
        return None
    for node in ast_nodes(inner[0]):
        if node.get("kind") != "DeclRefExpr":
            continue
        ref = node.get("referencedDecl", {})
        if ref.get("kind") == "FunctionDecl":
            return ref.get("name")
    return None


def ast_line(node):
    """Best-effort spelling/expansion line from Clang JSON locations."""
    locs = [node.get("loc", {}), node.get("range", {}).get("begin", {})]
    for loc in locs:
        for key in (None, "expansionLoc", "spellingLoc"):
            part = loc if key is None else loc.get(key, {})
            if part.get("line"):
                return part["line"]
    return None


def summarize_ast(ast, symbol):
    calls, param_fields, param_casts, retained, indirect = [], {}, {}, {}, []
    parameters = []
    for child in ast.get("inner", []):
        if child.get("kind") == "ParmVarDecl":
            parameters.append({
                "name": child.get("name"),
                "type": child.get("type", {}).get("qualType")
            })
    parameter_names = {x["name"] for x in parameters if x.get("name")}

    # Build a small intraprocedural origin graph. This is what connects a
    # public TagItem pointer stored in a local ExtNewWindow to the later
    # OpenWindow(&local) call; direct DeclRefExpr inspection alone loses that
    # relationship at the local variable.
    dependencies = {}
    local_names = set()
    for node in ast_nodes(ast):
        if node.get("kind") == "VarDecl" and node.get("name"):
            name = node["name"]
            local_names.add(name)
            refs = set()
            for child in node.get("inner", []):
                refs.update(ast_referenced_declarations(child))
            dependencies.setdefault(name, set()).update(refs - {name})
        elif (node.get("kind") in ("BinaryOperator", "CompoundAssignOperator") and
              node.get("opcode") == "="):
            children = node.get("inner", [])
            if len(children) < 2:
                continue
            lhs = ast_referenced_declarations(children[0])
            rhs = ast_referenced_declarations(children[1])
            for name in lhs:
                if name not in parameter_names:
                    local_names.add(name)
                    dependencies.setdefault(name, set()).update(rhs - {name})
    local_origins = {name: set(dependencies.get(name, set())) & parameter_names
                     for name in local_names}
    changed = True
    while changed:
        changed = False
        for name in sorted(local_names):
            origins = set(local_origins[name])
            for dependency in dependencies.get(name, set()):
                origins.update(local_origins.get(dependency, set()))
            if origins != local_origins[name]:
                local_origins[name] = origins
                changed = True

    def parameter_origins(node):
        refs = ast_referenced_declarations(node)
        origins = refs & parameter_names
        for name in refs - parameter_names:
            origins.update(local_origins.get(name, set()))
        return origins

    for node in ast_nodes(ast):
        kind = node.get("kind")
        if kind == "CallExpr":
            callee = ast_callee(node)
            if callee:
                # Clang places the callee expression first and the actual C
                # arguments after it.  Recording which caller parameters feed
                # each position lets helper evidence flow back to a public ABI
                # parameter without guessing from variable names.
                arguments = node.get("inner", [])[1:]
                calls.append({
                    "name": callee,
                    "line": ast_line(node),
                    "argument_parameters": [
                        sorted(parameter_origins(arg)) for arg in arguments
                    ],
                    "argument_direct_parameters": [
                        sorted(ast_direct_parameter_values(arg)) for arg in arguments
                    ]
                })
            else:
                inner = node.get("inner", [])
                indirect.append({
                    "line": ast_line(node),
                    "callee_kind": inner[0].get("kind") if inner else None,
                    "type": inner[0].get("type", {}).get("qualType") if inner else None,
                    "callee_parameters": sorted(parameter_origins(inner[0]))
                    if inner else []
                })
        elif kind == "MemberExpr" and node.get("name"):
            for param in parameter_origins(node):
                param_fields.setdefault(param, set()).add(node["name"])
        elif kind in ("CStyleCastExpr", "ImplicitCastExpr"):
            cast_type = node.get("type", {}).get("qualType")
            if cast_type:
                for param in parameter_origins(node):
                    param_casts.setdefault(param, set()).add(cast_type)
        elif kind in ("BinaryOperator", "CompoundAssignOperator") and node.get("opcode") == "=":
            children = node.get("inner", [])
            if len(children) >= 2:
                lhs_fields = [x.get("name") for x in ast_nodes(children[0])
                              if x.get("kind") == "MemberExpr" and x.get("name")]
                # A field copied *from* a public record is not retention of the
                # record pointer. Only record identity stores such as
                # gadget->NextGadget = previous create a lifetime obligation.
                for param in ast_direct_parameter_values(children[1]):
                    retained.setdefault(param, set()).update(lhs_fields)
    # Calls appear inside other calls' argument trees; each CallExpr itself is
    # still visited once, so de-duplicate identical source locations only.
    unique_calls = []
    seen = set()
    for call in calls:
        key = (call["name"], call["line"],
               tuple(tuple(x) for x in call["argument_parameters"]),
               tuple(tuple(x) for x in call["argument_direct_parameters"]))
        if key not in seen:
            unique_calls.append(call)
            seen.add(key)
    return {
        "symbol": symbol,
        "parameters": parameters,
        "direct_calls": unique_calls,
        "parameter_fields": {k: sorted(v) for k, v in sorted(param_fields.items())},
        "parameter_casts": {k: sorted(v) for k, v in sorted(param_casts.items())},
        "retained_parameters": {k: sorted(v) for k, v in sorted(retained.items())},
        "local_parameter_dependencies": {
            name: sorted(origins) for name, origins in sorted(local_origins.items())
            if origins
        },
        "indirect_calls": indirect
    }


def json_stream(text):
    """Decode Clang's one-or-more top-level AST JSON objects."""
    decoder, offset, values = json.JSONDecoder(), 0, []
    while offset < len(text):
        while offset < len(text) and text[offset].isspace():
            offset += 1
        if offset >= len(text):
            break
        value, offset = decoder.raw_decode(text, offset)
        values.append(value)
    return values


def ast_function_definition(values, symbol):
    """Select the requested definition, not a prototype matched by the filter."""
    exact, generated = [], []
    for value in values:
        for node in ast_nodes(value):
            if node.get("kind") != "FunctionDecl":
                continue
            if not any(child.get("kind") == "CompoundStmt"
                       for child in node.get("inner", [])):
                continue
            name = node.get("name", "")
            if name == symbol:
                exact.append(node)
            elif name.endswith("_" + symbol):
                generated.append(node)
    if exact:
        return exact[0]
    # A public AROS vector expands from OpenWindow to (for example)
    # Intuition_34_OpenWindow. The suffix is unambiguous because it includes
    # the complete requested vector name, not a substring match.
    return generated[0] if len(generated) == 1 else None


def compile_named_ast(config, symbol, source):
    if not os.path.isfile(config["compiler"]):
        return {"status": "unavailable", "symbol": symbol,
                "error": "AROS cross compiler not found"}
    if not os.path.isdir(config["sysroot"]):
        return {"status": "unavailable", "symbol": symbol,
                "error": "AROS build sysroot not found"}
    cmd = config["arguments"] + [
        "-Xclang", "-ast-dump=json",
        "-Xclang", "-ast-dump-filter=%s" % symbol,
        source
    ]
    try:
        proc = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                              encoding="utf-8", errors="replace", timeout=30)
    except (OSError, subprocess.TimeoutExpired) as exc:
        return {"status": "error", "symbol": symbol, "error": str(exc)}
    if proc.returncode != 0:
        return {"status": "error", "symbol": symbol,
                "error": proc.stderr.strip()[-2000:]}
    try:
        values = json_stream(proc.stdout)
    except ValueError as exc:
        return {"status": "error", "symbol": symbol,
                "error": "invalid clang AST JSON: %s" % exc}
    ast = ast_function_definition(values, symbol)
    if not ast:
        return {"status": "error", "symbol": symbol,
                "error": "clang AST did not contain the function definition"}
    summary = summarize_ast(ast, ast.get("name", symbol))
    summary["status"] = "ok"
    return summary


def compile_function_ast(config, basename, f, source):
    symbol = "%s_%d_%s" % (basename, f.lvo, f.name)
    return compile_named_ast(config, symbol, source)


def local_function_definition(sources, name, preferred=None):
    """Locate a helper definition, preferring the caller's translation unit."""
    ordered = sources
    if preferred:
        ordered = ([item for item in sources if item[0] == preferred] +
                   [item for item in sources if item[0] != preferred])
    for path, whole in ordered:
        # Public vectors use AROS_LH* macros and therefore are not ordinary C
        # definitions until preprocessing. Follow them as well as local helper
        # functions so delegation between vectors remains inside the source
        # graph.
        chunk = source_function_chunk(whole, name)
        public_vector = bool(chunk)
        chunk = chunk or generic_function_chunk(whole, name)
        if chunk:
            start, raw = chunk
            return {
                "name": name,
                "path": path,
                "source": os.path.relpath(path, AROS),
                "line": whole.count("\n", 0, start) + 1,
                "raw": raw,
                "public_vector": public_vector
            }
    return None


def source_call_name(name, public_symbols=None):
    """Map a generated inline library call back to its source vector name.

    AROS public calls made from inside a library compile as names such as
    ``__inline_Intuition_OpenWindow``.  The implementation in the source tree
    is still the public ``OpenWindow`` vector.  Treating the generated wrapper
    as an opaque external call cuts source analysis at exactly the boundary we
    most need to follow when one public vector delegates to another.
    """
    match = re.match(r"^__inline_[A-Za-z0-9]+_(.+)$", name or "")
    candidate = match.group(1) if match else name
    # Only collapse wrappers for public vectors in the library currently being
    # analyzed. Exec_CopyMem from intuition source, for example, is an external
    # dependency rather than a local CopyMem helper.
    if public_symbols is not None and candidate not in public_symbols:
        return name
    return candidate


def roots_for_call(call, caller_aliases, field="argument_parameters"):
    """Map each call argument position back to public-vector parameters."""
    roots = []
    for referenced in call.get(field, []):
        origins = set()
        for name in referenced:
            origins.update(caller_aliases.get(name, set()))
        roots.append(origins)
    return roots


def helper_aliases(ast, argument_roots, include_locals=True):
    params = ast.get("parameters", [])
    aliases = {
        param.get("name"): set(argument_roots[i])
        for i, param in enumerate(params)
        if param.get("name") and i < len(argument_roots) and argument_roots[i]
    }
    if include_locals:
        for local, dependencies in ast.get("local_parameter_dependencies", {}).items():
            roots = set()
            for dependency in dependencies:
                roots.update(aliases.get(dependency, set()))
            if roots:
                aliases[local] = roots
    return aliases


def analyze_reachable_helpers(evidence, config, sources, shared_cache=None,
                              definition_cache=None, public_symbols=None,
                              max_helpers=128, max_depth=12):
    """Follow local direct calls and propagate their semantics to one vector.

    This is a bounded call-graph/data-flow pass, not name-based guesswork.  A
    helper parameter is associated with a public ABI argument only when Clang's
    AST shows that argument flowing into the corresponding call position.
    """
    public_ast = evidence.get("ast", {})
    if public_ast.get("status") != "ok" or not evidence.get("source"):
        return
    public_path = os.path.join(AROS, evidence["source"])
    public_aliases = {arg["name"]: {arg["name"]}
                      for arg in evidence.get("signature", {}).get("arguments", [])}
    cache = shared_cache if shared_cache is not None else {}
    definition_cache = definition_cache if definition_cache is not None else {}
    reports, queued_states = {}, set()
    queue = []
    for call in public_ast.get("direct_calls", []):
        source_name = source_call_name(call["name"], public_symbols)
        source_call = dict(call, name=source_name)
        queue.append((source_call, public_aliases, public_aliases,
                      [evidence["name"], source_name], public_path, 1))

    while queue and len(reports) < max_helpers:
        call, caller_aliases, caller_identity_aliases, path, caller_source, depth = \
            queue.pop(0)
        if depth > max_depth:
            continue
        definition_key = (call["name"], caller_source)
        if definition_key not in definition_cache:
            definition_cache[definition_key] = local_function_definition(
                sources, call["name"], caller_source)
        definition = definition_cache[definition_key]
        if not definition:
            continue
        key = (definition["name"], definition["path"])
        if key not in cache:
            symbol = (public_symbols or {}).get(definition["name"],
                                                 definition["name"])
            ast = compile_named_ast(config, symbol, definition["path"])
            item = dict(definition)
            item["ast"] = ast
            item["tags"] = extract_tag_evidence(item["raw"], item["line"])
            code = mask_c_comments(item["raw"])
            item["memory"] = {
                "allocators": sorted(set(m.group(1) for m in ALLOC_CALL_RE.finditer(code))),
                "releasers": sorted(set(m.group(1) for m in FREE_CALL_RE.finditer(code)))
            }
            item["callbacks"] = sorted(
                set(m.group(1) for m in CALLBACK_SOURCE_RE.finditer(code)))
            cache[key] = item
        item = cache[key]
        ast = item["ast"]
        if ast.get("status") != "ok":
            aliases, identity_aliases = {}, {}
        else:
            aliases = helper_aliases(ast, roots_for_call(call, caller_aliases))
            identity_aliases = helper_aliases(
                ast, roots_for_call(call, caller_identity_aliases,
                                    "argument_direct_parameters"),
                include_locals=False)
        state = (key,
                 tuple((name, tuple(sorted(values)))
                       for name, values in sorted(aliases.items())),
                 tuple((name, tuple(sorted(values)))
                       for name, values in sorted(identity_aliases.items())))
        if state in queued_states:
            continue
        queued_states.add(state)

        report = reports.get(key)
        if report is None:
            report = {
                "name": item["name"], "source": item["source"],
                "line": item["line"], "via": path,
                "public_vector": item.get("public_vector", False),
                "root_argument_aliases": {},
                "identity_root_argument_aliases": {}, "tags": item["tags"],
                "memory": item["memory"], "callbacks": item["callbacks"],
                "ast": ast
            }
            reports[key] = report
        elif len(path) < len(report["via"]):
            report["via"] = path
        for name, values in aliases.items():
            current = set(report["root_argument_aliases"].get(name, []))
            report["root_argument_aliases"][name] = sorted(current | values)
        for name, values in identity_aliases.items():
            current = set(report["identity_root_argument_aliases"].get(name, []))
            report["identity_root_argument_aliases"][name] = \
                sorted(current | values)

        # Delegation into another public vector inherits that vector's direct
        # contract. Do not recursively inherit every operation the callee
        # performs on its newly-created native objects; those are internal
        # implementation details and would turn one call into a whole-library
        # semantic explosion.
        if ast.get("status") == "ok" and not item.get("public_vector"):
            merged_aliases = {name: set(values) for name, values in
                              report["root_argument_aliases"].items()}
            merged_identity_aliases = {
                name: set(values) for name, values in
                report["identity_root_argument_aliases"].items()
            }
            for child in ast.get("direct_calls", []):
                # Once inside the first callee, continue only along edges that
                # still carry a public ABI argument. This prevents an ordinary
                # internal call such as LockPubScreen from pulling the entire
                # Intuition library into OpenWindowTagList's semantic review.
                if not any(roots_for_call(child, merged_aliases)):
                    continue
                source_name = source_call_name(child["name"], public_symbols)
                source_child = dict(child, name=source_name)
                queue.append((source_child, merged_aliases,
                              merged_identity_aliases, path + [source_name],
                              item["path"], depth + 1))

    helpers = sorted(reports.values(), key=lambda x: (x["source"], x["line"], x["name"]))
    propagated_tags, propagated_callbacks = [], []
    propagated_arguments = {}
    reachable_allocators, reachable_releasers = set(), set()
    public_tag_arguments = {
        arg["name"] for arg in evidence.get("signature", {}).get("arguments", [])
        if "TagItem" in arg.get("type", "")
    }
    callback_arguments = {
        arg["name"] for arg in evidence.get("signature", {}).get("arguments", [])
        if ("Hook" in arg.get("type", "") or
            re.search(r"\(\s*\*", arg.get("type", "")))
    }
    for helper in helpers:
        for tag in helper["tags"]:
            root_arguments = set()
            for local in tag.get("list_parameters", []):
                root_arguments.update(helper["root_argument_aliases"].get(local, []))
            root_arguments.intersection_update(public_tag_arguments)
            if root_arguments:
                propagated_tags.append(dict(
                    tag, source=helper["source"], via=helper["via"],
                    root_arguments=sorted(root_arguments)))
        reachable_allocators.update(helper["memory"]["allocators"])
        reachable_releasers.update(helper["memory"]["releasers"])
        ast = helper["ast"]
        if ast.get("status") != "ok":
            continue
        for indirect in ast.get("indirect_calls", []):
            callback_roots = set()
            for local in indirect.get("callee_parameters", []):
                callback_roots.update(
                    helper["root_argument_aliases"].get(local, []))
            callback_roots.intersection_update(callback_arguments)
            if not callback_roots:
                continue
            propagated_callbacks.append({
                "name": "<indirect-call>", "helper": helper["name"],
                "source": helper["source"], "via": helper["via"],
                "line": indirect.get("line"), "type": indirect.get("type"),
                "root_arguments": sorted(callback_roots)
            })
        categories = (
            ("dereferenced_fields", ast.get("parameter_fields", {}),
             helper["root_argument_aliases"]),
            ("concrete_casts", ast.get("parameter_casts", {}),
             helper["root_argument_aliases"]),
            # Pointer retention is an identity property. A local object whose
            # scalar contents depend on a public record/taglist is not an alias
            # of that public pointer and must not inherit its lifetime.
            ("stored_in_fields", ast.get("retained_parameters", {}),
             helper["identity_root_argument_aliases"]),
        )
        for category, facts, category_aliases in categories:
            for local, roots in category_aliases.items():
                for fact in facts.get(local, []):
                    for root in roots:
                        propagated_arguments.setdefault(root, []).append({
                            "kind": category, "value": fact,
                            "helper": helper["name"], "source": helper["source"],
                            "via": helper["via"]
                        })
    for root, facts in propagated_arguments.items():
        unique = {}
        for fact in facts:
            key = (fact["kind"], fact["value"], fact["helper"], fact["source"])
            unique[key] = fact
        propagated_arguments[root] = sorted(
            unique.values(), key=lambda x: (x["kind"], x["value"], x["helper"]))
    tag_unique = {}
    for tag in propagated_tags:
        key = (tag["name"], tag["access"], tag["kind"], tag["source"], tag["line"])
        tag_unique[key] = tag
    evidence["reachable_helpers"] = helpers
    evidence["propagated_tags"] = sorted(
        tag_unique.values(), key=lambda x: (x["name"], x["source"], x["line"]))
    evidence["propagated_arguments"] = dict(sorted(propagated_arguments.items()))
    callback_unique = {}
    for callback in propagated_callbacks:
        key = (callback["name"], callback["helper"], callback.get("line"),
               callback.get("type"))
        callback_unique[key] = callback
    evidence["propagated_callbacks"] = sorted(
        callback_unique.values(),
        key=lambda x: (x["name"], x["source"], x.get("line") or 0))
    evidence["memory"]["reachable_allocators"] = sorted(reachable_allocators)
    evidence["memory"]["reachable_releasers"] = sorted(reachable_releasers)


def collect_source_reports(which):
    """Return evidence mined from AROS library implementations."""
    wanted = set(which)
    reports = []
    for lib, rel, _base, _btype, _hdr in analysis_targets(which):
        short = lib.split(".")[0]
        if wanted and short not in wanted and lib not in wanted:
            continue
        funcs = [f for f in (parse_conf(os.path.join(AROS, rel)) or []) if not f.private]
        ast_config = ast_compile_config(rel, short)
        basename = conf_basename(os.path.join(AROS, rel), ast_config)
        record_layouts = probe_record_layouts(funcs, ast_config)
        root, paths = source_files_for_target(rel)
        sources = []
        for path in paths:
            try:
                sources.append((path, open(path, encoding="utf-8", errors="replace").read()))
            except OSError:
                pass
        evidence = [analyze_function_source(lib, rel, f, sources) for f in funcs]
        ast_ok = ast_errors = 0
        helper_cache, helper_definition_cache = {}, {}
        public_symbols = {
            f.name: "%s_%d_%s" % (basename, f.lvo, f.name)
            for f in funcs
        } if basename else {}
        for f, e in zip(funcs, evidence):
            if not e.get("source") or not basename:
                continue
            source = os.path.join(AROS, e["source"])
            e["ast"] = compile_function_ast(ast_config, basename, f, source)
            if e["ast"].get("status") == "ok":
                ast_ok += 1
            else:
                ast_errors += 1
            analyze_reachable_helpers(e, ast_config, sources,
                                      helper_cache, helper_definition_cache,
                                      public_symbols)
        type_sources = []
        include_root = os.path.join(ast_config["sysroot"], "include")
        for header in record_layouts.get("headers", []):
            path = os.path.join(include_root, header)
            try:
                type_sources.append((path, open(
                    path, encoding="utf-8", errors="replace").read()))
            except OSError:
                pass
        library_tags = extract_library_tag_evidence(
            sources, type_sources=type_sources)
        used_names = set()
        for e in evidence:
            used_names.update(tag["name"] for tag in e.get("tags", []))
            used_names.update(tag["name"] for tag in e.get("propagated_tags", []))
        source_tree_tags, source_tree_sources = source_tree_tag_evidence(
            used_names, {path for path, _raw in sources})
        corroborating_tags = library_tags + source_tree_tags
        callsite_tags = []
        for f, e in zip(funcs, evidence):
            function_names = {tag["name"] for tag in e.get("tags", [])}
            function_names.update(tag["name"] for tag in e.get("propagated_tags", []))
            function_callsites = function_callsite_tag_evidence(
                f, e, source_tree_sources)
            callsite_tags.extend(function_callsites)
            e["corroborating_tag_evidence"] = ([
                tag for tag in corroborating_tags if tag["name"] in function_names
            ] + function_callsites)
        pairs = ownership_candidates(funcs, evidence)
        for e in evidence:
            e.pop("_raw", None)
        reports.append({
            "library": lib,
            "conf": rel,
            "source_root": os.path.relpath(root, AROS),
            "analysis_backend": {
                "kind": "clang-ast+source-evidence",
                "compiler": ast_config["compiler"],
                "sysroot": ast_config["sysroot"],
                "forced_include": ast_config["forced_include"],
                "compiled_functions": ast_ok,
                "failed_functions": ast_errors
            },
            "record_layouts": record_layouts,
            "functions": evidence,
            "ownership_candidates": pairs,
            "library_tag_evidence": library_tags,
            "source_tree_tag_evidence": source_tree_tags,
            "callsite_tag_evidence": callsite_tags
        })
    if wanted and not reports:
        raise ValueError("no generated library matches: %s" %
                         ", ".join(sorted(wanted)))
    return reports


def analyze_sources(which):
    """Emit JSON evidence mined from AROS library implementations."""
    try:
        reports = collect_source_reports(which)
    except ValueError as exc:
        print(str(exc), file=sys.stderr)
        return 1
    print(json.dumps({"schema": 1, "libraries": reports}, indent=2, sort_keys=False))
    return 0


def sha256_file(path):
    digest = hashlib.sha256()
    try:
        with open(path, "rb") as fh:
            while True:
                block = fh.read(1024 * 1024)
                if not block:
                    break
                digest.update(block)
    except OSError:
        return None
    return digest.hexdigest()


def logical_path(path):
    """Stable, relocatable spelling for an importer input path."""
    path = os.path.abspath(path)
    roots = ((os.path.abspath(AROS), "AROS_SRC"),
             (os.path.abspath(AROS_BUILD), "AROS_BUILD"))
    for root, label in roots:
        try:
            if os.path.commonpath((root, path)) == root:
                return label + "/" + os.path.relpath(path, root)
        except ValueError:
            pass
    return path


def input_file(path, role):
    if not path or not os.path.isfile(path):
        return None
    return {"role": role, "path": logical_path(path), "sha256": sha256_file(path)}


def discover_public_headers(short, config):
    include = os.path.join(config["sysroot"], "include")
    candidates = [
        os.path.join(include, "libraries", short + ".h"),
        os.path.join(include, "proto", short + ".h"),
        os.path.join(include, "clib", short + "_protos.h"),
        os.path.join(include, "defines", short + ".h"),
        os.path.join(include, "inline", short + ".h"),
        os.path.join(include, "inline", short + "_protos.h"),
        os.path.join(include, "pragmas", short + "_pragmas.h"),
        os.path.join(GENINC, "proto", short + ".h"),
    ]
    records = [input_file(path, "public-header") for path in candidates]
    return sorted((x for x in records if x), key=lambda x: x["path"])


def compiler_identity(config):
    try:
        proc = subprocess.run([config["compiler"], "--version"],
                              stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                              encoding="utf-8", errors="replace", timeout=10)
        version = proc.stdout.splitlines()[0] if proc.stdout else ""
    except (OSError, subprocess.TimeoutExpired):
        version = "unavailable"
    return {"path": config["compiler"], "version": version,
            "arguments": config["arguments"]}


def tag_arguments_for(evidence):
    return [arg["name"] for arg in evidence.get("signature", {}).get("arguments", [])
            if "TagItem" in arg.get("type", "")]


def tag_observations(evidence):
    """Normalize direct and helper tag evidence onto public arguments."""
    public_args = {arg["name"] for arg in
                   evidence.get("signature", {}).get("arguments", [])}
    tag_args = tag_arguments_for(evidence)
    observations = []
    for tag in evidence.get("tags", []):
        roots = sorted(public_args.intersection(tag.get("list_parameters", [])))
        if not roots and len(tag_args) == 1:
            roots = tag_args
        observations.append(dict(tag, source=evidence.get("source"),
                                 via=[evidence["name"]], root_arguments=roots))
    for tag in evidence.get("propagated_tags", []):
        item = dict(tag)
        if not item.get("root_arguments") and len(tag_args) == 1:
            item["root_arguments"] = tag_args
        observations.append(item)
    for tag in evidence.get("corroborating_tag_evidence", []):
        item = dict(tag, via=[evidence["name"], "<library-tag-consumer>"],
                    root_arguments=tag_args if len(tag_args) == 1 else [])
        observations.append(item)
    return observations


def evidence_provenance(item):
    return {key: item.get(key) for key in
            ("source", "line", "via", "access", "kind", "confidence",
             "cast", "default", "list_expression") if item.get(key) not in (None, "")}


def active_tag_resolution(policy, argument, tag_name):
    """Return the explicit bridge decision for one function/tag pair.

    Source inference and active policy are deliberately separate authorities:
    inference explains what was observed, while policy records the reviewed
    conversion (including a deliberate refusal).  Once a policy decision
    exists it must close the corresponding review item instead of making an
    already-generated crossing look unresolved forever.
    """
    domain_name = (policy or {}).get("taglists", {}).get(argument)
    domain = POLICY.get("tag_domains", {}).get(domain_name, {})
    for tag in domain.get("tags", []):
        if tag.get("name") == tag_name:
            resolution = {key: value for key, value in tag.items()
                          if key != "name"}
            resolution["domain"] = domain_name
            return resolution
    return None


def synthesize_function_tags(evidence, add_review, policy=None):
    grouped, orphaned = {}, []
    for item in tag_observations(evidence):
        roots = item.get("root_arguments", [])
        if not roots:
            orphaned.append(item)
            continue
        for root in roots:
            grouped.setdefault((root, item["name"]), []).append(item)
    public_tag_arguments = tag_arguments_for(evidence)
    if orphaned and not public_tag_arguments:
        # Some classic APIs hide a taglist inside a public record (notably
        # OpenWindow's ExtNewWindow.Extension). Reporting every case as an
        # independent lost origin obscures the actual single crossing decision:
        # translate the containing record field. Keep every tag as evidence in
        # one finite review item instead.
        orphaned_names = {item["name"] for item in orphaned}
        add_review(
            "embedded-tag-domain", evidence["name"],
            "%d source-observed tags" % len(orphaned_names),
            "tag iteration is rooted in a local or record field rather than a "
            "public TagItem argument; model the containing record pointer",
            [evidence_provenance(item) for item in orphaned])
    else:
        for item in orphaned:
            add_review("taglist-origin-unresolved", evidence["name"], item["name"],
                       "tag access could not be mapped to a public TagItem argument",
                       [evidence_provenance(item)])

    domains = {}
    strength = {"low": 0, "medium": 1, "high": 2}
    for (argument, name), items in sorted(grouped.items()):
        resolution = active_tag_resolution(policy, argument, name)
        high_kinds = sorted(set(x["kind"] for x in items
                                if x.get("confidence") == "high" and
                                x.get("kind") not in (None, "unknown")))
        provenance = [evidence_provenance(x) for x in sorted(
            items, key=lambda x: (x.get("source") or "", x.get("line") or 0,
                                  x.get("kind") or ""))]
        domain = domains.setdefault(argument, {"argument": argument,
                                                "accepted": [], "unresolved": []})
        if len(high_kinds) == 1:
            accepted = {"name": name, "kind": high_kinds[0],
                        "confidence": "high", "provenance": provenance}
            if resolution:
                accepted["policy_resolution"] = resolution
            domain["accepted"].append(accepted)
        else:
            best = max((strength.get(x.get("confidence"), -1) for x in items),
                       default=-1)
            reason = "conflicting high-confidence payload kinds" if high_kinds else \
                     "payload representation is not proved"
            unresolved = {"name": name, "reason": reason,
                          "best_confidence": next(
                              (k for k, v in strength.items() if v == best), "none"),
                          "observed_kinds": sorted(set(x.get("kind", "unknown")
                                                       for x in items)),
                          "provenance": provenance}
            if resolution:
                unresolved["policy_resolution"] = resolution
            domain["unresolved"].append(unresolved)
            if not resolution:
                add_review("tag-payload-conflict" if high_kinds else
                           "tag-payload-unresolved", evidence["name"],
                           "%s:%s" % (argument, name), reason, provenance)
    return [domains[name] for name in sorted(domains)]


def function_record_contracts(evidence, layouts):
    contracts = []
    for argument in evidence.get("signature", {}).get("arguments", []):
        name, ctype = argument["name"], argument["type"]
        record_name = signature_record_name(ctype)
        if not record_name or record_name not in layouts:
            continue
        layout = layouts[record_name]
        guest = layout.get("m68k") or {}
        native = layout.get("native") or {}
        guest_fields = {field["name"]: field for field in guest.get("fields", [])}
        native_fields = {field["name"]: field for field in native.get("fields", [])}
        observed = set(evidence.get("arguments", {}).get(name, {}).get(
            "dereferenced_fields", []))
        observed.update(fact["value"] for fact in
                        evidence.get("propagated_arguments", {}).get(name, [])
                        if fact["kind"] == "dereferenced_fields")
        required = []
        for field_name in sorted(observed.intersection(guest_fields)):
            guest_field, native_field = guest_fields[field_name], native_fields.get(field_name)
            required.append({
                "name": field_name,
                "m68k_offset": guest_field["offset"],
                "m68k_type": guest_field["type"],
                "native_offset": native_field["offset"] if native_field else None,
                "native_type": native_field["type"] if native_field else None,
                "pointer_shaped": classify(guest_field["type"]) in
                                  ("string", "aptr", "struct", "bptr")
            })
        contracts.append({
            "argument": name, "declared_type": ctype, "record": record_name,
            "m68k_size": guest.get("size"), "native_size": native.get("size"),
            "required_fields": required,
            "unresolved_observed_fields": sorted(observed - set(guest_fields))
        })
    return contracts


def function_record_arrays(evidence, layouts):
    arrays = []
    for candidate in evidence.get("record_arrays", []):
        layout = layouts.get(candidate["record"], {})
        guest_fields = {field["name"]: field for field in
                        (layout.get("m68k") or {}).get("fields", [])}
        native_fields = {field["name"]: field for field in
                         (layout.get("native") or {}).get("fields", [])}
        field = guest_fields.get(candidate["sentinel_field"])
        native = native_fields.get(candidate["sentinel_field"])
        item = dict(candidate)
        item["m68k_stride"] = (layout.get("m68k") or {}).get("size")
        item["native_stride"] = (layout.get("native") or {}).get("size")
        item["m68k_sentinel_offset"] = field.get("offset") if field else None
        item["native_sentinel_offset"] = native.get("offset") if native else None
        item["sentinel_width"] = (SIZE_WIDTHS.get(norm(field.get("type", "")))
                                  if field else None)
        item["layout_status"] = "complete" if all(
            x is not None for x in (item["m68k_stride"], item["native_stride"],
                                    item["m68k_sentinel_offset"],
                                    item["native_sentinel_offset"],
                                    item["sentinel_width"])) else "missing"
        arrays.append(item)
    return arrays


def api_noun(name):
    name = re.sub(r"A$", "", name)
    return re.sub(r"^(?:GT_)?(?:Get|Create|Alloc|Open|New|Free|Close|Dispose|"
                  r"Delete|Reply|Release|Post|Filter)", "", name)


def object_name_for_type(ctype, fallback=None):
    canonical = object_canon(ctype)
    matches = [name for name, spec in POLICY.get("object_types", {}).items()
               if object_canon(spec["c_type"]) == canonical]
    if len(matches) == 1:
        return matches[0]
    record = signature_record_name(ctype)
    return record or fallback


def infer_object_candidates(report):
    by_name = {f["name"]: f for f in report["functions"]}
    layouts = report.get("record_layouts", {}).get("types", {})
    candidates = {}
    for pair in report.get("ownership_candidates", []):
        if pair.get("confidence") != "high":
            continue
        producer = by_name.get(pair["producer"], {})
        ctype = producer.get("signature", {}).get("result", pair["type"])
        name = object_name_for_type(ctype, api_noun(pair["producer"]))
        if not name:
            continue
        existing = POLICY.get("object_types", {}).get(name)
        consumer = by_name.get(pair["consumer"], {})
        consumer_fields = set()
        for facts in consumer.get("arguments", {}).values():
            consumer_fields.update(facts.get("dereferenced_fields", []))
        linked = sorted(field for field in consumer_fields
                        if field.startswith(("Next", "First")) or field.endswith("Next"))
        candidates[name] = {
            "c_type": norm(ctype),
            "kind": existing.get("kind") if existing else "opaque",
            "status": "active" if existing else "candidate",
            "producer": pair["producer"], "consumer": pair["consumer"],
            "destructor": report["library"] + "." + pair["consumer"],
            "confidence": "high", "evidence": pair["evidence"],
            "record_layout": name if name in layouts else None,
            "linked_fields": linked,
            "promotion_requires": ([] if existing else
                ["facade-or-opaque-decision"] +
                (["linked-family-token-invalidation"] if linked else []))
        }
    return dict(sorted(candidates.items()))


def function_object_contracts(evidence, candidates):
    contracts = {"arguments": {}, "result": None}
    signature = evidence.get("signature", {})
    result_type = signature.get("result", "void")
    for name, candidate in candidates.items():
        if object_canon(candidate["c_type"]) == object_canon(result_type):
            contracts["result"] = {"type": name, "kind": "object",
                                   "source": candidate["producer"]}
            break
    for argument in signature.get("arguments", []):
        for name, candidate in candidates.items():
            if object_canon(candidate["c_type"]) == object_canon(argument["type"]):
                contracts["arguments"][argument["name"]] = {
                    "type": name, "nullable": "unresolved",
                    "consume": evidence["name"] == candidate["consumer"]
                }
                break
        else:
            known = object_name_for_type(argument["type"])
            if known and known in POLICY.get("object_types", {}):
                contracts["arguments"][argument["name"]] = {
                    "type": known, "nullable": "unresolved", "consume": False
                }
    return contracts


STRUCT_PTR_RE = re.compile(r"^(?:const\s+)?struct\s+(\w+)\s*\*$")


def described_object_types():
    """struct name -> policy object type, for every type the bridge can already
    carry. This is the vocabulary the importer is allowed to apply on its own."""
    out = {}
    for name, spec in POLICY.get("object_types", {}).items():
        m = STRUCT_PTR_RE.match(norm(spec.get("c_type", "")))
        if m:
            out[m.group(1)] = name
        if spec.get("facade_struct"):
            out[spec["facade_struct"]] = name
    return out


def published_detachers(report):
    """(owner struct, field) -> the vectors that let a program take it back.

    A pointer the callee keeps is only a hazard if nothing can undo it. When the
    same library publishes a vector that touches the very field the pointer was
    stored in and keeps nothing itself, the lifetime is managed by the library's
    own API, and the program is responsible for the ordering exactly as it is on
    a real Amiga: SetMenuStrip stores window->MenuStrip, ClearMenuStrip takes it
    back, and the bridge adds no hazard the machine did not already have.

    Derived, not listed. Nothing here names a library or a function."""
    index = collections.defaultdict(set)
    for evidence in report["functions"]:
        ast = evidence.get("ast", {}) or {}
        if ast.get("status") != "ok":
            continue
        if ast.get("retained_parameters"):
            continue                       # it keeps something: not a detach
        for argument, facts in (evidence.get("arguments", {}) or {}).items():
            m = STRUCT_PTR_RE.match(norm(facts.get("declared_type", "")))
            if not m:
                continue
            for field in facts.get("dereferenced_fields", []) or []:
                index[(m.group(1), field)].add(evidence["name"])
    return index


def infer_object_crossing(f, evidence, detachers=None):
    """A crossing the importer may write without asking, or None.

    The rule is deliberately narrow, and it is about EVIDENCE rather than
    coverage. Every pointer argument must be a type the bridge already carries,
    the result must not be a pointer (whose owner and destructor the signature
    cannot state), and the analyzer must not have seen the callee keep any of
    those pointers: `retained_parameters` is what separates ActivateWindow,
    which only looks at the window, from SetMenuStrip, which stores the menu in
    it and therefore needs a lifetime decision a human makes.

    Nullability is NOT inferred as "must not be NULL". The signature does not
    say, and refusing NULL would turn a legal call into a failure; passing it
    leaves the native function to answer, which it already does.

    This applies to any library. Nothing here names one."""
    known = described_object_types()
    ast = evidence.get("ast", {}) or {}
    if ast.get("status") != "ok":
        return None                      # no evidence, no inference
    retained = ast.get("retained_parameters", {}) or {}
    locals_from = ast.get("local_parameter_dependencies", {}) or {}
    arg_evidence = evidence.get("arguments", {}) or {}

    def kept_past_the_call(argument):
        """Does the callee still hold this pointer when it returns?

        `retained_parameters` says the pointer was written into some field, but
        it does not say whose. An implementation that packs its arguments into a
        message on its own stack and posts it synchronously writes fields too,
        and that is not retention: ActivateWindow, MoveWindow and a dozen others
        look identical to SetMenuStrip at that level of detail.

        The separation the analyzer already provides: a local that depends on
        this argument explains the write, UNLESS one of the other arguments
        exposes the same field, which is what SetMenuStrip's window->MenuStrip
        does. Then the owner outlives the call and a person decides."""
        fields = set(retained.get(argument, []))
        if not fields:
            return False
        explained_by_local = any(argument in sources
                                 for sources in locals_from.values())
        owner_struct = None
        for other, facts in arg_evidence.items():
            if other == argument:
                continue
            if fields & set(facts.get("dereferenced_fields", []) or []):
                m = STRUCT_PTR_RE.match(norm(facts.get("declared_type", "")))
                owner_struct = m.group(1) if m else ""
                break
        if owner_struct is not None:
            # The owner outlives the call. That is only a hazard if the library
            # publishes no way to take the pointer back.
            return not all((owner_struct, field) in (detachers or {})
                           for field in fields)
        return not explained_by_local

    if classify(f.ret) not in ("scalar", "widen", "void"):
        return None
    objects = {}
    for atype, aname in f.args:
        c = classify(atype)
        if c in ("scalar", "widen", "string"):
            continue
        m = STRUCT_PTR_RE.match(norm(atype))
        if not m or m.group(1) not in known:
            return None                  # a type nobody has described yet
        if kept_past_the_call(aname):
            return None                  # the callee keeps it: a lifetime call
        objects[aname] = {"type": known[m.group(1)], "nullable": True}
    if not objects:
        return None                      # nothing to infer; tier 1 covers it
    for argument, propagated in evidence.get("propagated_arguments", {}).items():
        # Only a POINTER can be kept. RectFill's helper stores its four WORD
        # coordinates into a rectangle, which the evidence reports the same way
        # as storing a pointer, and a number copied into a struct has no
        # identity and nothing to outlive. Treating the two alike refused every
        # drawing call in the library.
        if argument not in objects:
            continue
        if any(fact["kind"] == "stored_in_fields" for fact in propagated):
            return None                  # a helper keeps it: same decision
    return {"objects": objects}


def build_import_manifest(report):
    lib, rel = report["library"], report["conf"]
    short = lib.split(".")[0]
    config = ast_compile_config(rel, short)
    source_root, source_paths = source_files_for_target(rel)
    conf_path = os.path.join(AROS, rel)
    forced = input_file(config.get("forced_include"), "generated-deflibdefs")
    generated_build_inputs = [input_file(path, "generated-build-header")
                              for path in config.get("generated_inputs", [])]
    generated_build_inputs = [item for item in generated_build_inputs if item]
    source_inputs = []
    for path in source_paths:
        role = "implementation-header" if path.endswith(".h") else "implementation-source"
        source_inputs.append(input_file(path, role))
    source_inputs = sorted((x for x in source_inputs if x), key=lambda x: x["path"])
    public_headers = discover_public_headers(short, config)
    layout_header_inputs = [input_file(
        os.path.join(config["sysroot"], "include", header), "record-layout-header")
        for header in report.get("record_layouts", {}).get("headers", [])]
    layout_header_inputs = sorted((x for x in layout_header_inputs if x),
                                  key=lambda x: x["path"])
    external_evidence = (report.get("source_tree_tag_evidence", []) +
                         report.get("callsite_tag_evidence", []))
    external_paths = sorted(set(os.path.join(AROS, item["source"])
                                for item in external_evidence))
    external_inputs = [input_file(path, "external-tag-consumer")
                       for path in external_paths]
    external_inputs = sorted((x for x in external_inputs if x), key=lambda x: x["path"])

    review = []
    def add_review(kind, function, subject, detail, evidence=None):
        review.append({"kind": kind, "function": function, "subject": subject,
                       "detail": detail, "evidence": evidence or []})

    if not public_headers:
        add_review("missing-public-header", None, short,
                   "no generated or installed public header was found")
    if not forced:
        add_review("missing-build-input", None, short,
                   "generated *_deflibdefs.h is absent; AST compilation is incomplete")
    if report.get("record_layouts", {}).get("status") != "ok":
        add_review("record-layout-probe", None, short,
                   report.get("record_layouts", {}).get("error",
                                                        "record layout probe failed"))

    object_candidates = infer_object_candidates(report)
    for name, candidate in object_candidates.items():
        if candidate["status"] == "active":
            continue
        add_review("object-representation", candidate["producer"], name,
                   "choose opaque handle or guest-readable facade before promotion",
                   [candidate])
        if candidate["linked_fields"]:
            add_review("linked-object-lifecycle", candidate["consumer"], name,
                       "consumer traverses a linked family; invalidate every related token",
                       [{"fields": candidate["linked_fields"]}])

    detach_index = published_detachers(report)
    parsed = parse_conf(conf_path) or []
    by_name = {f.name: f for f in parsed if not f.private}
    functions = []
    inferred_functions = {}
    outcomes = {"generated-from-abi": 0, "covered-by-policy": 0,
                "explicitly-refused": 0, "inferred-from-source": 0,
                "review-required": 0}
    for evidence in report["functions"]:
        f = by_name[evidence["name"]]
        tier, blocker = f.tier(lib)
        policy = function_policy(lib, f)
        refusal = refusal_policy(lib, f)
        if refusal:
            outcome = "explicitly-refused"
        elif policy:
            outcome = "covered-by-policy"
        elif tier in (1, 2):
            outcome = "generated-from-abi"
        elif blocker and (blocker.startswith("refused:") or "allowlist" in blocker):
            outcome = "explicitly-refused"
        else:
            inferred = infer_object_crossing(f, evidence, detach_index)
            if inferred:
                outcome = "inferred-from-source"
                inferred_functions["%s.%s" % (lib, f.name)] = inferred
            else:
                outcome = "review-required"
                add_review("crossing-semantics-required", f.name, norm(f.ret),
                           blocker or "signature requires semantic translation")
        outcomes[outcome] += 1

        if not evidence.get("source"):
            add_review("missing-implementation", f.name, f.name,
                       "public vector implementation was not found in C sources")
        ast = evidence.get("ast", {})
        if evidence.get("source") and ast.get("status") != "ok":
            add_review("public-ast-failure", f.name, ast.get("symbol", f.name),
                       ast.get("error", "AST compilation failed"))
        for helper in evidence.get("reachable_helpers", []):
            if not refusal and helper.get("ast", {}).get("status") != "ok":
                add_review("helper-ast-failure", f.name, helper["name"],
                           helper["ast"].get("error", "AST compilation failed"),
                           [{"source": helper["source"], "line": helper["line"],
                             "via": helper["via"]}])
        if not refusal:
            for callback in evidence.get("propagated_callbacks", []):
                add_review("callback-contract", f.name, callback["name"],
                           "native-to-68k callback behavior requires an explicit contract",
                           [callback])
            for argument, facts in evidence.get("propagated_arguments", {}).items():
                retained = [fact for fact in facts if fact["kind"] == "stored_in_fields"]
                if retained:
                    add_review("retained-pointer-lifetime", f.name, argument,
                               "reachable helper stores this public argument in native state",
                               retained)

        def add_tag_review(*args):
            if not refusal:
                add_review(*args)

        functions.append({
            "name": f.name, "lvo": f.lvo, "offset": f.offset,
            "signature": evidence.get("signature"),
            "source": evidence.get("source"), "line": evidence.get("line"),
            "outcome": outcome, "blocker": blocker,
            "existing_policy": policy,
            "existing_refusal": refusal,
            "reachable_helpers": len(evidence.get("reachable_helpers", [])),
            "record_contracts": function_record_contracts(
                evidence, report.get("record_layouts", {}).get("types", {})),
            "record_arrays": function_record_arrays(
                evidence, report.get("record_layouts", {}).get("types", {})),
            "object_contracts": function_object_contracts(evidence, object_candidates),
            "tag_domains": synthesize_function_tags(evidence, add_tag_review, policy),
            "argument_evidence": evidence.get("arguments", {}),
            "propagated_arguments": evidence.get("propagated_arguments", {}),
            "memory": evidence.get("memory", {}),
            "callbacks": evidence.get("callbacks", []),
            "propagated_callbacks": evidence.get("propagated_callbacks", [])
        })

    accepted_ownership = []
    for pair in report.get("ownership_candidates", []):
        producer_policy = POLICY.get("functions", {}).get(
            "%s.%s" % (lib, pair["producer"]), {})
        result = producer_policy.get("result", {})
        result_object = (POLICY.get("object_types", {}).get(result.get("type"), {})
                         if result.get("kind") == "object" else {})
        reviewed_destructor = result_object.get("destructor") == "%s.%s" % (
            lib, pair["consumer"])
        if pair.get("confidence") == "high" or reviewed_destructor:
            accepted = dict(pair)
            if reviewed_destructor and pair.get("confidence") != "high":
                accepted["confidence"] = "high"
                accepted["evidence"] = sorted(set(
                    pair.get("evidence", []) + ["active-object-destructor-policy"]))
            accepted_ownership.append(accepted)
        else:
            add_review("ownership-pair", pair["producer"], pair["consumer"],
                       "producer/releaser relationship is not high confidence", [pair])

    # Collapse exact duplicate review findings before assigning stable IDs.
    unique = {}
    for item in review:
        key = (item["kind"], item.get("function") or "", item["subject"], item["detail"])
        unique[key] = item
    review = [unique[key] for key in sorted(unique)]
    for i, item in enumerate(review, 1):
        item["id"] = "R%04d" % i
    unresolved_vectors = sum(1 for f in functions if f["outcome"] == "review-required")
    status = "review-required" if review or unresolved_vectors else "ready-for-generation"
    inputs = {
        "generator": input_file(os.path.abspath(__file__), "importer"),
        "current_policy": input_file(POLICY_PATH, "bridge-policy"),
        "conf": input_file(conf_path, "library-conf"),
        "public_headers": public_headers,
        "implementation": source_inputs,
        "external_tag_consumers": external_inputs,
        "record_layout_headers": layout_header_inputs,
        "generated_build_header": forced,
        "generated_build_inputs": generated_build_inputs,
        "compiler": compiler_identity(config),
        "sysroot": logical_path(config["sysroot"]),
        "source_root": logical_path(source_root)
    }
    return {
        "schema": 1,
        "generator": "graft/gen-emu68k-bridge",
        "library": lib,
        "status": status,
        "inputs": inputs,
        "analysis": {
            "backend": report["analysis_backend"],
            "public_vectors": len(functions),
            "outcomes": outcomes,
            "review_items": len(review)
        },
        "accepted": {"abi_vectors": len(functions),
                     "ownership": accepted_ownership},
        "inferred_functions": inferred_functions,
        "object_candidates": object_candidates,
        "functions": functions,
        "review": review,
        "certification": {"status": "not-run", "checks": []}
    }


def import_review_markdown(manifest):
    a = manifest["analysis"]
    lines = [
        "# 68k bridge import review: %s" % manifest["library"], "",
        "Status: **%s**" % manifest["status"], "",
        "- Public vectors: %d" % a["public_vectors"],
        "- Generated from ABI: %d" % a["outcomes"]["generated-from-abi"],
        "- Already covered by policy: %d" % a["outcomes"]["covered-by-policy"],
        "- Explicitly refused: %d" % a["outcomes"]["explicitly-refused"],
        "- Inferred from source: %d" % a["outcomes"].get("inferred-from-source", 0),
        "- Crossing semantics requiring review: %d" % a["outcomes"]["review-required"],
        "- Review items: %d" % a["review_items"], "",
        "## Vector outcomes", "",
        "| LVO | Function | Outcome |", "|---:|---|---|"
    ]
    for f in manifest["functions"]:
        lines.append("| %d | `%s` | %s |" % (f["lvo"], f["name"], f["outcome"]))
    lines += ["", "## Review queue", ""]
    if not manifest["review"]:
        lines.append("No unresolved findings.")
    for item in manifest["review"]:
        where = ("`%s`: " % item["function"]) if item.get("function") else ""
        lines += ["### %s · %s" % (item["id"], item["kind"]), "",
                  "%s%s — %s" % (where, item["subject"], item["detail"]), ""]
    lines += ["## Safety rule", "",
              "Only explicit high-confidence facts are candidates for generated policy. "
              "Every item above remains fail-closed until resolved.", ""]
    return "\n".join(lines)


def policy_subset_for_library(manifest):
    """Build a non-activating policy candidate from proved import facts."""
    lib, short = manifest["library"], manifest["library"].split(".")[0]
    functions = {key: value for key, value in POLICY.get("functions", {}).items()
                 if key.startswith(lib + ".")}
    refusals = {key: value for key, value in
                POLICY.get("refused_functions", {}).items()
                if key.startswith(lib + ".")}
    domain_names, object_names = set(), set()
    for spec in functions.values():
        domain_names.update(spec.get("taglists", {}).values())
        object_names.update(x.get("type") for x in spec.get("objects", {}).values())
        result = spec.get("result", {})
        if result.get("kind") == "object":
            object_names.add(result.get("type"))
    domains = {name: POLICY["tag_domains"][name] for name in sorted(domain_names)}
    objects = {}
    def include_objects(names):
        pending = set(x for x in names if x)
        while pending:
            object_name = sorted(pending)[0]
            pending.remove(object_name)
            if (object_name in objects or
                    object_name not in POLICY.get("object_types", {})):
                continue
            spec = POLICY["object_types"][object_name]
            objects[object_name] = spec
            for nested in spec.get("nested_fields", []):
                if nested.get("type"):
                    pending.add(nested["type"])
    include_objects(object_names)

    object_by_pointer = {}
    for object_name, spec in POLICY.get("object_types", {}).items():
        canonical = object_canon(spec.get("c_type", ""))
        if canonical:
            object_by_pointer.setdefault(canonical, []).append(object_name)

    def inferred_bridge_tag(tag):
        kind = tag["kind"]
        if kind in ("u32", "cstr"):
            return {"kind": kind}
        if kind.startswith("pointer:"):
            matches = object_by_pointer.get(object_canon(kind.split(":", 1)[1]), [])
            if len(matches) == 1:
                include_objects(matches)
                return {"kind": "object", "type": matches[0], "nullable": True}
        return {"kind": "refuse",
                "reason": "typed payload has no approved bridge conversion"}

    candidates = {}
    proposed_functions = {}
    for function in manifest["functions"]:
        taglists = {}
        for domain in function["tag_domains"]:
            name = "import.%s.%s.%s" % (short, function["name"], domain["argument"])
            tags = []
            for tag in domain["accepted"]:
                bridge = inferred_bridge_tag(tag)
                item = {"name": tag["name"], **bridge,
                        "inferred_kind": tag["kind"],
                        "confidence": tag["confidence"],
                        "provenance": tag["provenance"]}
                tags.append(item)
            for tag in domain["unresolved"]:
                tags.append({"name": tag["name"], "kind": "refuse",
                             "reason": tag["reason"],
                             "provenance": tag["provenance"]})
            candidates[name] = {"max_items": max(8, min(128, len(tags) + 4)),
                                "tags": sorted(tags, key=lambda x: x["name"])}
            taglists[domain["argument"]] = name
        proposal = {}
        if taglists:
            proposal["taglists"] = taglists
        if function.get("record_arrays"):
            proposal["record_arrays"] = {
                item["argument"]: {
                    "type": item["record"], "sentinel_field": item["sentinel_field"],
                    "sentinel_value": item["sentinel_value"],
                    "sentinel_width": item["sentinel_width"],
                    "max_count": item["max_count"],
                    "layout_status": item["layout_status"]
                } for item in function["record_arrays"]
            }
        objects_for_function = function.get("object_contracts", {})
        if objects_for_function.get("arguments"):
            proposal["objects"] = objects_for_function["arguments"]
        if objects_for_function.get("result"):
            proposal["result"] = objects_for_function["result"]
        if proposal:
            proposal["activation"] = "blocked-until-complete-function-contract"
            proposed_functions[lib + "." + function["name"]] = proposal
    return {
        "schema": 1,
        "library": lib,
        "status": "candidate-not-active",
        "object_types": objects,
        "candidate_object_types": {
            name: candidate for name, candidate in manifest["object_candidates"].items()
            if candidate["status"] != "active"
        },
        "tag_domains": domains,
        "functions": functions,
        "refused_functions": refusals,
        "candidate_tag_domains": candidates,
        "proposed_functions": proposed_functions,
        "accepted_ownership": manifest["accepted"]["ownership"],
        "safety": "refuse entries and incomplete functions must not be activated"
    }


def generated_test_plan(manifest):
    """Produce deterministic contracts consumed by the executable-test stage."""
    tests = []
    def add(kind, function, status, contract):
        tests.append({"kind": kind, "function": function,
                      "status": status, "contract": contract})

    for function in manifest["functions"]:
        outcome = function["outcome"]
        crossing_ready = outcome in ("generated-from-abi", "covered-by-policy")
        dispatch_ready = crossing_ready or outcome == "explicitly-refused"
        add("lvo-dispatch", function["name"],
            "ready" if dispatch_ready else "blocked",
            {"lvo": function["lvo"], "expected": outcome})
        if outcome == "explicitly-refused":
            add("explicit-refusal", function["name"], "ready",
                {"reason": function["existing_refusal"]["reason"],
                 "expected": "named-fail-closed"})
            continue
        policy = function.get("existing_policy") or {}
        if policy.get("noop"):
            add("source-noop", function["name"], "ready",
                {"expected": "return-without-reading-arguments-or-calling-native",
                 "evidence": policy["evidence"]})
        for argument, obj in sorted(policy.get("objects", {}).items()):
            add("invalid-object-token", function["name"], "ready",
                {"argument": argument, "object_type": obj["type"],
                 "expected": "fail-closed"})
        for domain in function["tag_domains"]:
            add("unknown-tag", function["name"],
                "ready" if crossing_ready else "blocked",
                {"argument": domain["argument"], "expected": "fail-closed"})
            for tag in domain["accepted"]:
                resolution = tag.get("policy_resolution")
                effective_kind = resolution.get("kind") if resolution else tag["kind"]
                ready = crossing_ready and bool(resolution)
                add("tag-payload", function["name"], "ready" if ready else "blocked",
                    {"argument": domain["argument"], "tag": tag["name"],
                     "kind": effective_kind,
                     "expected": ("fail-closed" if ready and effective_kind in
                                  ("refuse", "null") else
                                  "translated" if ready else "not-generated")})
            for tag in domain["unresolved"]:
                resolution = tag.get("policy_resolution")
                effective_kind = resolution.get("kind") if resolution else None
                ready = crossing_ready and bool(resolution)
                add("resolved-tag" if resolution else "unresolved-tag",
                    function["name"], "ready" if ready else "blocked",
                    {"argument": domain["argument"], "tag": tag["name"],
                     "kind": effective_kind,
                     "expected": ("fail-closed" if ready and effective_kind in
                                  ("refuse", "null") else
                                  "translated" if ready else "not-generated")})
    for pair in manifest["accepted"]["ownership"]:
        producer = next((f for f in manifest["functions"]
                         if f["name"] == pair["producer"]), None)
        consumer = next((f for f in manifest["functions"]
                         if f["name"] == pair["consumer"]), None)
        ready = bool(producer and consumer and
                     producer["outcome"] != "review-required" and
                     consumer["outcome"] != "review-required")
        add("object-lifecycle", pair["producer"], "ready" if ready else "blocked",
            {"consumer": pair["consumer"], "type": pair["type"],
             "expected": "create-use-release-stale-token-rejected"})
    tests.sort(key=lambda x: (x["function"], x["kind"],
                              json.dumps(x["contract"], sort_keys=True)))
    for index, test in enumerate(tests, 1):
        test["id"] = "T%04d" % index
    return {"schema": 1, "library": manifest["library"],
            "summary": {"total": len(tests),
                        "ready": sum(x["status"] == "ready" for x in tests),
                        "blocked": sum(x["status"] == "blocked" for x in tests)},
            "tests": tests}


def approved_bridge_source(report):
    lib, rel = report["library"], report["conf"]
    target = analysis_targets([lib])[0]
    _lib, _rel, base, btype, hdr = target
    if not base or not btype or not hdr:
        short = lib.split(".")[0]
        return (("/* GENERATED fail-closed placeholder for %s.\n"
                 " * Native proto/base metadata is absent, so no crossing can be emitted. */\n"
                 "int emu68k_import_%s_unavailable(void) { return 1; }\n" %
                 (lib, c_ident(short))), 0)
    funcs = parse_conf(os.path.join(AROS, rel)) or []
    return emit_lib(lib, rel, base, btype, hdr, funcs)


def import_artifacts(name):
    reports = collect_source_reports([name])
    if len(reports) != 1:
        raise ValueError("library import must resolve exactly one library")
    analysis = {"schema": 1, "libraries": reports}
    manifest = build_import_manifest(reports[0])
    bridge_source, crossings = approved_bridge_source(reports[0])
    test_plan = generated_test_plan(manifest)
    policy_candidate = policy_subset_for_library(manifest)
    manifest["generated"] = {
        "approved_bridge_crossings": crossings,
        "test_contracts": test_plan["summary"],
        "policy_status": policy_candidate["status"]
    }
    return {
        "analysis.json": json.dumps(analysis, indent=2, sort_keys=False) + "\n",
        "manifest.json": json.dumps(manifest, indent=2, sort_keys=False) + "\n",
        "review.md": import_review_markdown(manifest),
        "policy.generated.json": json.dumps(
            policy_candidate, indent=2, sort_keys=False) + "\n",
        "tests.generated.json": json.dumps(test_plan, indent=2, sort_keys=False) + "\n",
        "bridge.generated.c": bridge_source
    }, manifest


def import_library(name, output_dir=None, check=False):
    short = name[:-8] if name.endswith(".library") else name
    output_dir = output_dir or os.path.join(
        os.path.dirname(os.path.dirname(os.path.abspath(__file__))),
        "build", "emu68k-import", short)
    try:
        artifacts, manifest = import_artifacts(name)
    except ValueError as exc:
        print(str(exc), file=sys.stderr)
        return 1
    stale = []
    if check:
        for filename, content in artifacts.items():
            path = os.path.join(output_dir, filename)
            try:
                current = open(path, encoding="utf-8").read()
            except OSError:
                current = None
            if current != content:
                stale.append(path)
        if stale:
            print("STALE - regenerate library import:")
            for path in stale:
                print("  %s" % path)
            return 1
        print("library import is in sync: %s" % output_dir)
        return 0
    os.makedirs(output_dir, exist_ok=True)
    for filename, content in artifacts.items():
        path = os.path.join(output_dir, filename)
        temporary = path + ".tmp"
        with open(temporary, "w", encoding="utf-8") as fh:
            fh.write(content)
        os.replace(temporary, path)
    print("imported %s: %d vectors, %d review items (%s)" %
          (manifest["library"], manifest["analysis"]["public_vectors"],
           manifest["analysis"]["review_items"], manifest["status"]))
    print("artifacts: %s" % output_dir)
    return 0


# ---------------------------------------------------------------------------
# semantic policy validation
# ---------------------------------------------------------------------------

TAG_KINDS = {"u32": "EMU_TAG_U32", "cstr": "EMU_TAG_CSTR",
             "refuse": "EMU_TAG_REFUSE", "struct": "EMU_TAG_STRUCT",
             "null": "EMU_TAG_NULL", "u16_ffff": "EMU_TAG_U16_FFFF",
             "rgb32": "EMU_TAG_RGB32", "object": "EMU_TAG_OBJECT",
             "out_u32": "EMU_TAG_OUT_U32"}


def policy_key(lib, f):
    return "%s.%s" % (lib, f.name)


def function_policy(lib, f):
    return POLICY.get("functions", {}).get(policy_key(lib, f))


def refusal_policy(lib, f):
    return POLICY.get("refused_functions", {}).get(policy_key(lib, f))


def c_ident(s):
    return re.sub(r"[^A-Za-z0-9_]", "_", s)


def object_canon(t):
    """Compare an object's pointer type without const qualification. Policy
    names identity classes, so `struct Locale *` and `const struct Locale *`
    are the same class while unrelated pointer types must still be rejected."""
    t = re.sub(r"\b(const|CONST)\b", "", norm(t))
    t = re.sub(r"\s*\*\s*", " *", t)
    return norm(t)


def validate_policy(targets):
    """Refuse stale names and unsafe shapes before emitting any C. A policy
    typo must fail the build, not quietly leave the intended vector uncovered."""
    domains = POLICY.get("tag_domains", {})
    object_types = POLICY.get("object_types", {})
    errors = []
    bykey = {}
    for lib, rel, _base, _btype, _hdr in targets:
        for f in parse_conf(os.path.join(AROS, rel)) or []:
            bykey[policy_key(lib, f)] = f

    seen_object_ids = set()
    for name, o in object_types.items():
        oid = o.get("id")
        ctype = o.get("c_type")
        destructor = o.get("destructor")
        if not re.fullmatch(r"[A-Za-z_]\w*", name):
            errors.append("object type %r has an invalid name" % name)
        if not isinstance(oid, int) or oid < 1 or oid > 255:
            errors.append("object type %s id must be 1..255" % name)
        elif oid in seen_object_ids:
            errors.append("object type %s repeats id %d" % (name, oid))
        seen_object_ids.add(oid)
        pointer_typedef = o.get("pointer_typedef", False)
        if pointer_typedef not in (True, False):
            errors.append("object type %s pointer_typedef must be boolean" % name)
        typedef_pointer = (pointer_typedef and isinstance(ctype, str) and
                           re.fullmatch(r"[A-Za-z_]\w*", ctype))
        if (not isinstance(ctype, str) or
                (classify(ctype) not in ("struct", "aptr") and not typedef_pointer)):
            errors.append("object type %s has invalid pointer c_type %r" % (name, ctype))
        if o.get("kind") not in ("opaque", "facade"):
            errors.append("object type %s kind must be opaque or facade" % name)
        if o.get("kind") == "facade" and not re.fullmatch(
                r"[A-Za-z_]\w*", o.get("facade_struct", "")):
            errors.append("object type %s facade_struct is invalid" % name)
        if o.get("facade_size") is not None and (
                o.get("kind") != "facade" or
                not isinstance(o.get("facade_size"), int) or o["facade_size"] < 1):
            errors.append("object type %s facade_size needs a positive facade" % name)
        linked_field = o.get("linked_field")
        if linked_field is not None and not re.fullmatch(
                r"[A-Za-z_]\w*", linked_field):
            errors.append("object type %s linked_field is invalid" % name)
        linked_limit = o.get("linked_limit", 4096)
        if (not isinstance(linked_limit, int) or linked_limit < 1 or
                linked_limit > 65536):
            errors.append("object type %s linked_limit must be 1..65536" % name)
        nested_fields = o.get("nested_fields", [])
        if not isinstance(nested_fields, list):
            errors.append("object type %s nested_fields must be a list" % name)
            nested_fields = []
        if nested_fields and o.get("kind") != "facade":
            errors.append("object type %s nested fields need a facade" % name)
        seen_nested = set()
        for nested in nested_fields:
            field = nested.get("field") if isinstance(nested, dict) else None
            kind = nested.get("kind") if isinstance(nested, dict) else None
            if not isinstance(field, str) or not re.fullmatch(r"[A-Za-z_]\w*", field):
                errors.append("object type %s has invalid nested field" % name)
                continue
            native_field = nested.get("native_field", field)
            if not isinstance(native_field, str) or not re.fullmatch(
                    r"[A-Za-z_]\w*(\.[A-Za-z_]\w*)*", native_field):
                errors.append("object type %s nested field %s has invalid native_field"
                              % (name, field))
            if field in seen_nested:
                errors.append("object type %s repeats nested field %s" % (name, field))
            seen_nested.add(field)
            if kind == "u16_array":
                if not re.fullmatch(r"[A-Za-z_]\w*", nested.get("count_field", "")):
                    errors.append("object type %s nested field %s needs count_field"
                                  % (name, field))
                count = nested.get("max_count")
                if not isinstance(count, int) or count < 1 or count > 1024:
                    errors.append("object type %s nested field %s needs max_count 1..1024"
                                  % (name, field))
            elif kind in ("object", "embedded_object", "embedded_facade"):
                nested_type = nested.get("type")
                if nested_type not in object_types:
                    errors.append("object type %s nested field %s uses missing object %s"
                                  % (name, field, nested_type))
                elif (kind == "embedded_facade" and
                      object_types[nested_type].get("kind") != "facade"):
                    errors.append("object type %s nested field %s needs a facade object"
                                  % (name, field))
            else:
                errors.append("object type %s nested field %s has invalid kind %r"
                              % (name, field, kind))
        if destructor is not None:
            df = bykey.get(destructor)
            if not isinstance(destructor, str) or not df:
                errors.append("object type %s has invalid destructor %r" % (name, destructor))
            elif (classify(df.ret) not in ("void", "scalar") or len(df.args) != 1 or
                  object_canon(df.args[0][0]) != object_canon(ctype)):
                errors.append("object type %s destructor %s has incompatible signature"
                              % (name, destructor))

    for name, d in domains.items():
        if not re.fullmatch(r"[A-Za-z0-9_.-]+", name):
            errors.append("tag domain %r has an invalid name" % name)
        cap = d.get("max_items")
        if not isinstance(cap, int) or cap < 1 or cap > 256:
            errors.append("tag domain %s max_items must be 1..256" % name)
        tags = d.get("tags")
        if not isinstance(tags, list):
            errors.append("tag domain %s tags must be a list" % name)
            continue
        seen = set()
        for t in tags:
            macro, kind = t.get("name"), t.get("kind")
            if not isinstance(macro, str) or not re.fullmatch(r"[A-Za-z_]\w*", macro):
                errors.append("tag domain %s has invalid macro %r" % (name, macro))
            elif macro in seen:
                errors.append("tag domain %s repeats %s" % (name, macro))
            seen.add(macro)
            if kind not in TAG_KINDS:
                errors.append("tag domain %s tag %s has unknown kind %r"
                              % (name, macro, kind))
            elif kind == "struct" and not re.fullmatch(
                    r"[A-Za-z_]\w*", t.get("type", "")):
                errors.append("tag domain %s tag %s needs a structure type"
                              % (name, macro))
            elif kind == "u16_ffff" and (not isinstance(t.get("max_count"), int) or
                                           t["max_count"] < 1 or t["max_count"] > 256):
                errors.append("tag domain %s tag %s needs max_count 1..256"
                              % (name, macro))
            elif kind == "rgb32" and (not isinstance(t.get("max_longs"), int) or
                                       t["max_longs"] < 1 or t["max_longs"] > 4096):
                errors.append("tag domain %s tag %s needs max_longs 1..4096"
                              % (name, macro))
            elif kind == "object":
                if t.get("type") not in object_types:
                    errors.append("tag domain %s tag %s uses missing object type %r"
                                  % (name, macro, t.get("type")))
                if t.get("nullable", True) not in (True, False):
                    errors.append("tag domain %s tag %s nullable must be boolean"
                                  % (name, macro))
            fallback = t.get("fallback_cstr_field")
            if fallback is not None:
                if kind != "struct" or not isinstance(fallback, dict):
                    errors.append("tag domain %s tag %s string fallback needs a structure"
                                  % (name, macro))
                elif (not re.fullmatch(r"[A-Za-z_]\w*", fallback.get("field", "")) or
                      not isinstance(fallback.get("value"), str) or
                      not fallback["value"] or "\0" in fallback["value"]):
                    errors.append("tag domain %s tag %s has invalid string fallback"
                                  % (name, macro))
            tag_fallback = t.get("fallback")
            if tag_fallback is not None and tag_fallback != "omit":
                errors.append("tag domain %s tag %s has invalid fallback"
                              % (name, macro))

    for key, refusal in POLICY.get("refused_functions", {}).items():
        f = bykey.get(key)
        if not f:
            errors.append("function refusal %s does not name a public .conf vector" % key)
            continue
        if f.private:
            errors.append("function refusal %s names a private vector" % key)
        if key in POLICY.get("functions", {}):
            errors.append("function refusal %s also has an active crossing policy" % key)
        if not isinstance(refusal, dict):
            errors.append("function refusal %s must be an object" % key)
            continue
        reason = refusal.get("reason")
        if (not isinstance(reason, str) or not reason.strip() or
                len(reason) > 240 or "\0" in reason):
            errors.append("function refusal %s needs a reason of 1..240 characters" % key)
        evidence = refusal.get("evidence")
        if not isinstance(evidence, list) or not evidence:
            errors.append("function refusal %s needs source evidence" % key)
            continue
        for item in evidence:
            source = item.get("source") if isinstance(item, dict) else None
            first = item.get("line_start") if isinstance(item, dict) else None
            last = item.get("line_end", first) if isinstance(item, dict) else None
            if (not isinstance(source, str) or not re.fullmatch(
                    r"[A-Za-z0-9_./-]+", source) or source.startswith("/") or
                    ".." in source.split("/")):
                errors.append("function refusal %s has invalid evidence source" % key)
            if (not isinstance(first, int) or not isinstance(last, int) or
                    first < 1 or last < first):
                errors.append("function refusal %s has invalid evidence lines" % key)

    for key, p in POLICY.get("functions", {}).items():
        f = bykey.get(key)
        if not f:
            errors.append("function policy %s does not name a public .conf vector" % key)
            continue
        if f.private:
            errors.append("function policy %s names a private vector" % key)
        if p.get("noop") is not None:
            if p.get("noop") is not True:
                errors.append("function policy %s noop must be true" % key)
            if classify(f.ret) != "void":
                errors.append("function policy %s noop requires a void result" % key)
            if set(p) - {"noop", "evidence"}:
                errors.append("function policy %s noop cannot combine with crossings" % key)
            evidence = p.get("evidence")
            if not isinstance(evidence, list) or not evidence:
                errors.append("function policy %s noop needs source evidence" % key)
            else:
                for item in evidence:
                    source = item.get("source") if isinstance(item, dict) else None
                    first = item.get("line_start") if isinstance(item, dict) else None
                    last = item.get("line_end", first) if isinstance(item, dict) else None
                    if (not isinstance(source, str) or not re.fullmatch(
                            r"[A-Za-z0-9_./-]+", source) or source.startswith("/") or
                            ".." in source.split("/")):
                        errors.append("function policy %s noop has invalid evidence source" % key)
                    if (not isinstance(first, int) or not isinstance(last, int) or
                            first < 1 or last < first):
                        errors.append("function policy %s noop has invalid evidence lines" % key)
            continue
        taglists = p.get("taglists", {})
        structs = p.get("structs", {})
        tagged_structs = p.get("tagged_structs", {})
        objects = p.get("objects", {})
        callbacks = p.get("callbacks", {})
        pointers = p.get("pointers", {})
        arrays = p.get("arrays", {})
        record_arrays = p.get("record_arrays", {})
        guest_values = p.get("guest_values", [])
        strings = p.get("strings", [])
        null_args = p.get("null_args", [])
        boopsi = p.get("boopsi")
        args = {n: t for t, n in f.args}
        for arg, domain in taglists.items():
            if arg not in args:
                errors.append("function policy %s names missing argument %s" % (key, arg))
            elif "TagItem" not in args[arg] or "*" not in args[arg]:
                errors.append("function policy %s argument %s is not a TagItem pointer"
                              % (key, arg))
            if domain not in domains:
                errors.append("function policy %s uses missing tag domain %s"
                              % (key, domain))
        for arg, sp in structs.items():
            stype, direction = sp.get("type"), sp.get("direction")
            if arg not in args:
                errors.append("function policy %s names missing argument %s" % (key, arg))
            elif (not isinstance(stype, str) or
                  "struct %s" % stype not in norm(args[arg]) or
                  "*" not in args[arg]):
                errors.append("function policy %s argument %s is not struct %s *"
                              % (key, arg, stype))
            if direction not in ("in", "out", "inout"):
                errors.append("function policy %s struct %s has invalid direction %r"
                              % (key, arg, direction))
            if sp.get("clear", True) not in (True, False):
                errors.append("function policy %s struct %s clear must be boolean"
                              % (key, arg))
            copy_on = sp.get("copy_on", "always")
            if copy_on not in ("always", "nonzero"):
                errors.append("function policy %s struct %s has invalid copy_on %r"
                              % (key, arg, copy_on))
            elif copy_on == "nonzero" and classify(f.ret) not in ("scalar", "widen"):
                errors.append("function policy %s struct %s copy_on nonzero needs scalar result"
                              % (key, arg))
            size_arg = sp.get("size_arg")
            if size_arg is not None:
                if size_arg not in args:
                    errors.append("function policy %s struct %s names missing size argument %s"
                                  % (key, arg, size_arg))
                elif norm(args[size_arg]) not in SIZE_WIDTHS:
                    errors.append("function policy %s size argument %s is %s, not a scalar count"
                                  % (key, size_arg, norm(args[size_arg])))
                if size_arg == arg:
                    errors.append("function policy %s struct %s cannot be its own size"
                                  % (key, arg))
            if arg in taglists:
                errors.append("function policy %s argument %s has two policies" % (key, arg))
            fields = sp.get("fields", {})
            if not isinstance(fields, dict):
                errors.append("function policy %s struct %s fields must be an object"
                              % (key, arg))
                fields = {}
            for field, fp in fields.items():
                kind = fp.get("kind") if isinstance(fp, dict) else None
                if not re.fullmatch(r"[A-Za-z_]\w*", field):
                    errors.append("function policy %s struct %s has invalid field %r"
                                  % (key, arg, field))
                if kind not in ("cstr", "struct", "object", "guest_value"):
                    errors.append("function policy %s struct %s field %s has invalid kind %r"
                                  % (key, arg, field, kind))
                if kind == "struct" and not re.fullmatch(
                        r"[A-Za-z_]\w*", fp.get("type", "")):
                    errors.append("function policy %s struct %s field %s needs a type"
                                  % (key, arg, field))
                nested_fields = fp.get("fields", {}) if kind == "struct" else {}
                if not isinstance(nested_fields, dict):
                    errors.append("function policy %s struct %s field %s nested fields "
                                  "must be an object" % (key, arg, field))
                    nested_fields = {}
                for nested_field, nested_fp in nested_fields.items():
                    nested_kind = (nested_fp.get("kind")
                                   if isinstance(nested_fp, dict) else None)
                    if not re.fullmatch(r"[A-Za-z_]\w*", nested_field):
                        errors.append("function policy %s struct %s field %s has invalid "
                                      "nested field %r" %
                                      (key, arg, field, nested_field))
                    if nested_kind not in ("cstr", "object", "guest_value"):
                        errors.append("function policy %s struct %s field %s nested field %s "
                                      "has invalid kind %r" %
                                      (key, arg, field, nested_field, nested_kind))
                    if (nested_kind == "object" and
                            nested_fp.get("type") not in object_types):
                        errors.append("function policy %s struct %s field %s nested field %s "
                                      "uses missing object %r" %
                                      (key, arg, field, nested_field,
                                       nested_fp.get("type")))
                    if nested_fp.get("nullable", True) not in (True, False):
                        errors.append("function policy %s struct %s field %s nested field %s "
                                      "nullable must be boolean" %
                                      (key, arg, field, nested_field))
                if kind == "object" and fp.get("type") not in object_types:
                    errors.append("function policy %s struct %s field %s uses missing object %r"
                                  % (key, arg, field, fp.get("type")))
                if fp.get("nullable", True) not in (True, False):
                    errors.append("function policy %s struct %s field %s nullable must be boolean"
                                  % (key, arg, field))
        for arg, sp in tagged_structs.items():
            tag_arg, size_arg = sp.get("tag_arg"), sp.get("size_arg")
            variants = sp.get("variants")
            if arg not in args:
                errors.append("function policy %s names missing tagged buffer %s" % (key, arg))
            elif "*" not in args[arg]:
                errors.append("function policy %s tagged buffer %s is not a pointer" % (key, arg))
            if tag_arg not in args or (tag_arg in args and
                                       norm(args[tag_arg]) not in SIZE_WIDTHS):
                errors.append("function policy %s tagged buffer %s has invalid tag argument %r"
                              % (key, arg, tag_arg))
            if size_arg not in args or (size_arg in args and
                                        norm(args[size_arg]) not in SIZE_WIDTHS):
                errors.append("function policy %s tagged buffer %s has invalid size argument %r"
                              % (key, arg, size_arg))
            if sp.get("direction") != "out":
                errors.append("function policy %s tagged buffer %s currently requires direction out"
                              % (key, arg))
            if not isinstance(variants, dict) or not variants:
                errors.append("function policy %s tagged buffer %s needs variants"
                              % (key, arg))
            else:
                for macro, stype in variants.items():
                    if (not re.fullmatch(r"[A-Za-z_]\w*", macro) or
                            not isinstance(stype, str) or
                            not re.fullmatch(r"[A-Za-z_]\w*", stype)):
                        errors.append("function policy %s tagged buffer %s has invalid variant %r"
                                      % (key, arg, macro))
            header = sp.get("header")
            if not isinstance(header, str) or not re.fullmatch(r"[A-Za-z0-9_./-]+\.h", header):
                errors.append("function policy %s tagged buffer %s needs a valid header"
                              % (key, arg))
            if sp.get("clear", True) not in (True, False):
                errors.append("function policy %s tagged buffer %s clear must be boolean"
                              % (key, arg))
            copy_on = sp.get("copy_on", "always")
            if copy_on not in ("always", "nonzero"):
                errors.append("function policy %s tagged buffer %s has invalid copy_on %r"
                              % (key, arg, copy_on))
            elif copy_on == "nonzero" and classify(f.ret) not in ("scalar", "widen"):
                errors.append("function policy %s tagged buffer %s copy_on nonzero needs scalar result"
                              % (key, arg))
            if arg in taglists or arg in structs or arg in objects or arg in pointers:
                errors.append("function policy %s argument %s has two policies" % (key, arg))
        for arg, pp in pointers.items():
            kind, direction = pp.get("kind"), pp.get("direction")
            expected = POINTER_SCALARS.get(kind)
            if arg not in args:
                errors.append("function policy %s names missing scalar pointer %s" % (key, arg))
            elif not expected or "*" not in args[arg]:
                errors.append("function policy %s scalar pointer %s has invalid kind %r"
                              % (key, arg, kind))
            else:
                base_type = norm(re.sub(r"\s*\*\s*$", "", args[arg]))
                if base_type not in expected[0]:
                    errors.append("function policy %s scalar pointer %s kind %s mismatches %s"
                                  % (key, arg, kind, base_type))
            if direction not in ("in", "out", "inout"):
                errors.append("function policy %s scalar pointer %s has invalid direction %r"
                              % (key, arg, direction))
            copy_on = pp.get("copy_on", "always")
            if copy_on not in ("always", "nonzero"):
                errors.append("function policy %s scalar pointer %s has invalid copy_on %r"
                              % (key, arg, copy_on))
            elif copy_on == "nonzero" and classify(f.ret) not in ("scalar", "widen"):
                errors.append("function policy %s scalar pointer %s copy_on nonzero needs scalar result"
                              % (key, arg))
            if arg in taglists or arg in structs:
                errors.append("function policy %s argument %s has two policies" % (key, arg))
        for arg, ap in arrays.items():
            kind, direction = ap.get("kind"), ap.get("direction")
            if arg not in args:
                errors.append("function policy %s names missing array %s" % (key, arg))
            elif "*" not in args[arg]:
                errors.append("function policy %s array %s is not a pointer" % (key, arg))
            elif kind == "rgb32" and object_canon(args[arg]).replace("const ", "") not in (
                    "ULONG *", "const ULONG *"):
                errors.append("function policy %s RGB32 array %s is not ULONG *"
                              % (key, arg))
            if kind != "rgb32":
                errors.append("function policy %s array %s has invalid kind %r"
                              % (key, arg, kind))
            if direction != "in":
                errors.append("function policy %s array %s currently requires direction in"
                              % (key, arg))
            count = ap.get("max_count")
            if not isinstance(count, int) or count < 1 or count > 4096:
                errors.append("function policy %s array %s needs max_count 1..4096"
                              % (key, arg))
            if ap.get("nullable", True) not in (True, False):
                errors.append("function policy %s array %s nullable must be boolean"
                              % (key, arg))
            if (arg in taglists or arg in structs or arg in tagged_structs or
                    arg in objects or arg in callbacks or arg in pointers):
                errors.append("function policy %s argument %s has two policies" % (key, arg))
        for arg, ap in record_arrays.items():
            stype, direction = ap.get("type"), ap.get("direction")
            if arg not in args:
                errors.append("function policy %s names missing record array %s" % (key, arg))
            elif (not isinstance(stype, str) or
                  "struct %s" % stype not in norm(args[arg]) or
                  args[arg].count("*") != 1):
                errors.append("function policy %s record array %s is not struct %s *"
                              % (key, arg, stype))
            if direction != "in":
                errors.append("function policy %s record array %s currently requires direction in"
                              % (key, arg))
            header = ap.get("header")
            if not isinstance(header, str) or not re.fullmatch(
                    r"[A-Za-z0-9_./-]+\.h", header):
                errors.append("function policy %s record array %s needs a valid header"
                              % (key, arg))
            count = ap.get("max_count")
            if not isinstance(count, int) or count < 1 or count > 4096:
                errors.append("function policy %s record array %s needs max_count 1..4096"
                              % (key, arg))
            sentinel = ap.get("sentinel", {})
            if (not re.fullmatch(r"[A-Za-z_]\w*", sentinel.get("field", "")) or
                    not re.fullmatch(r"[A-Za-z_]\w*", sentinel.get("value", ""))):
                errors.append("function policy %s record array %s needs a field/value sentinel"
                              % (key, arg))
            if sentinel.get("width") not in (1, 2, 4):
                errors.append("function policy %s record array %s sentinel width must be 1, 2, or 4"
                              % (key, arg))
            reject = ap.get("reject")
            if reject is not None and (
                    not re.fullmatch(r"[A-Za-z_]\w*", reject.get("field", "")) or
                    not isinstance(reject.get("mask"), int) or reject["mask"] < 1 or
                    reject.get("width") not in (1, 2, 4)):
                errors.append("function policy %s record array %s has invalid reject mask"
                              % (key, arg))
            fields = ap.get("fields", {})
            if not isinstance(fields, dict):
                errors.append("function policy %s record array %s fields must be an object"
                              % (key, arg))
                fields = {}
            for field, fp in fields.items():
                if not re.fullmatch(r"[A-Za-z_]\w*", field):
                    errors.append("function policy %s record array %s has invalid field %r"
                                  % (key, arg, field))
                kind = fp.get("kind") if isinstance(fp, dict) else None
                if kind not in ("cstr", "cstr_sentinel", "guest_value"):
                    errors.append("function policy %s record array %s field %s has invalid kind %r"
                                  % (key, arg, field, kind))
                if kind == "cstr_sentinel" and not re.fullmatch(
                        r"[A-Za-z_]\w*", fp.get("sentinel", "")):
                    errors.append("function policy %s record array %s field %s needs sentinel"
                                  % (key, arg, field))
            if (arg in taglists or arg in structs or arg in tagged_structs or
                    arg in arrays or arg in objects or arg in callbacks or arg in pointers):
                errors.append("function policy %s argument %s has two policies" % (key, arg))
        if record_arrays and callbacks:
            errors.append("function policy %s cannot yet combine record arrays and callbacks"
                          % key)
        for arg, op in objects.items():
            otype = op.get("type")
            ospec = object_types.get(otype)
            if arg not in args:
                errors.append("function policy %s names missing argument %s" % (key, arg))
            elif not ospec:
                errors.append("function policy %s uses missing object type %s"
                              % (key, otype))
            elif object_canon(args[arg]) != object_canon(ospec.get("c_type", "")):
                errors.append("function policy %s argument %s is not object %s"
                              % (key, arg, otype))
            if op.get("nullable", True) not in (True, False):
                errors.append("function policy %s object %s nullable must be boolean"
                              % (key, arg))
            if op.get("release", False) not in (True, False):
                errors.append("function policy %s object %s release must be boolean"
                              % (key, arg))
            if op.get("consume", False) not in (True, False):
                errors.append("function policy %s object %s consume must be boolean"
                              % (key, arg))
            if op.get("sync", False) not in (True, False):
                errors.append("function policy %s object %s sync must be boolean"
                              % (key, arg))
            elif (op.get("sync", False) and ospec and
                  ospec.get("kind") != "facade"):
                errors.append("function policy %s object %s sync needs a facade"
                              % (key, arg))
            if op.get("release", False) and op.get("consume", False):
                errors.append("function policy %s object %s cannot release and consume"
                              % (key, arg))
            if op.get("consume_family", False) not in (True, False):
                errors.append("function policy %s object %s consume_family must be boolean"
                              % (key, arg))
            elif op.get("consume_family", False) and (
                    not op.get("consume", False) or not ospec or
                    not ospec.get("linked_field")):
                errors.append("function policy %s object %s consume_family needs a linked "
                              "object type and consume" % (key, arg))
            if arg in taglists or arg in structs or arg in pointers:
                errors.append("function policy %s argument %s has two policies" % (key, arg))
        for arg, cb in callbacks.items():
            if arg not in args:
                errors.append("function policy %s names missing callback %s" % (key, arg))
            elif "struct Hook" not in args[arg] or "*" not in args[arg]:
                errors.append("function policy %s callback %s is not struct Hook *"
                              % (key, arg))
            if cb.get("kind") != "hook":
                errors.append("function policy %s callback %s kind must be hook"
                              % (key, arg))
            for role in ("object_arg", "message_arg"):
                if cb.get(role) not in args:
                    errors.append("function policy %s callback %s has missing %s"
                                  % (key, arg, role))
            if arg in taglists or arg in structs or arg in objects or arg in pointers:
                errors.append("function policy %s argument %s has two policies" % (key, arg))
        if not isinstance(guest_values, list) or any(a not in args for a in guest_values):
            errors.append("function policy %s has invalid guest_values" % key)
        else:
            for arg in guest_values:
                if classify(args[arg]) != "aptr":
                    errors.append("function policy %s guest value %s is not APTR"
                                  % (key, arg))
        if not isinstance(strings, list) or any(a not in args for a in strings):
            errors.append("function policy %s has invalid strings" % key)
        if not isinstance(null_args, list) or any(a not in args for a in null_args):
            errors.append("function policy %s has invalid null_args" % key)
        else:
            for arg in null_args:
                if "*" not in args[arg]:
                    errors.append("function policy %s NULL-only argument %s is not a pointer"
                                  % (key, arg))
                if (arg in taglists or arg in structs or arg in tagged_structs or
                        arg in objects or arg in callbacks or arg in pointers or
                        arg in arrays or arg in record_arrays or
                        arg in guest_values or arg in strings):
                    errors.append("function policy %s argument %s has two policies"
                                  % (key, arg))
        if boopsi:
            class_arg = boopsi.get("class_arg")
            if class_arg not in objects or objects[class_arg].get("type") != "Class":
                errors.append("function policy %s BOOPSI class_arg is not a Class object"
                              % key)
        result = p.get("result")
        if result:
            if result.get("kind") == "guest_arg":
                if result.get("arg") not in args:
                    errors.append("function policy %s has invalid guest_arg result" % key)
                elif result.get("arg") not in structs:
                    errors.append("function policy %s result argument is not a struct shadow" % key)
            elif result.get("kind") == "object":
                otype = result.get("type")
                ospec = object_types.get(otype)
                owned = result.get("owned", True)
                if owned not in (True, False):
                    errors.append("function policy %s object result owned must be boolean" % key)
                if not ospec:
                    errors.append("function policy %s uses missing result object %s"
                                  % (key, otype))
                elif object_canon(f.ret) != object_canon(ospec.get("c_type", "")):
                    errors.append("function policy %s result is not object %s" % (key, otype))
                elif owned and not ospec.get("destructor"):
                    errors.append("function policy %s owned object needs a destructor" % key)
                elif owned and not ospec["destructor"].startswith(key.rsplit(".", 1)[0] + "."):
                    errors.append("function policy %s object destructor must be in the same library"
                                  % key)
                store_arg = result.get("store_arg")
                if store_arg is not None:
                    if store_arg not in args or args[store_arg].count("*") < 2:
                        errors.append("function policy %s object store_arg must be a "
                                      "pointer-to-pointer argument" % key)
                    elif store_arg in (set(taglists) | set(structs) |
                                       set(tagged_structs) | set(objects) |
                                       set(callbacks) | set(pointers) |
                                       set(arrays) | set(record_arrays) |
                                       set(guest_values) | set(strings) |
                                       set(null_args)):
                        errors.append("function policy %s object store_arg %s has two policies"
                                      % (key, store_arg))
                fallback = result.get("fallback_textattr")
                if fallback is not None:
                    farg = fallback.get("arg") if isinstance(fallback, dict) else None
                    fname = fallback.get("name") if isinstance(fallback, dict) else None
                    if (farg not in structs or
                            structs.get(farg, {}).get("type") != "TextAttr" or
                            structs.get(farg, {}).get("direction") not in ("in", "inout")):
                        errors.append("function policy %s font fallback needs an input TextAttr"
                                      % key)
                    if not isinstance(fname, str) or not fname or "\0" in fname:
                        errors.append("function policy %s font fallback needs a valid name"
                                      % key)
            else:
                errors.append("function policy %s has invalid result policy" % key)
        blockers = []
        for t, n in f.args:
            if result and n == result.get("store_arg"):
                continue
            if (n in taglists or n in structs or n in tagged_structs or
                    n in pointers or n in arrays or n in record_arrays or
                    n in objects or n in callbacks or
                    n in guest_values or n in strings or n in null_args):
                continue
            if classify(t) not in ("scalar", "widen", "string", "bptr"):
                blockers.append("%s %s" % (t, n))
        if not result and classify(f.ret) not in ("scalar", "widen", "void"):
            blockers.append("result %s" % f.ret)
        if blockers:
            errors.append("function policy %s still needs policy for %s"
                          % (key, ", ".join(blockers)))

    return errors


