# emit
# ---------------------------------------------------------------------------

def reg_pair(reg):
    """`D0/D1` -> ('r->d[0]', 'r->d[1]'), the two halves of a 64-bit value.

    The IEEE double libraries are the only place this appears: a double is
    passed high half first, in the two registers the .conf names."""
    m = re.fullmatch(r"([DA][0-7])/([DA][0-7])", reg.strip().upper())
    if not m:
        return None
    return (reg_expr(m.group(1)), reg_expr(m.group(2)))


def reg_expr(reg):
    """`D1` -> `r->d[1]`"""
    reg = reg.strip().upper()
    if not re.fullmatch(r"[DA][0-7]", reg):
        return None
    return "r->%s[%s]" % (reg[0].lower(), reg[1])


def arg_expr(t, reg):
    """The C expression that turns one 68k register into one native argument."""
    if classify(t) == "bptr":
        return "EMU_HANDLE(guest0, %s)" % reg_expr(reg)
    return _arg_expr(t, reg)


def _arg_expr(t, reg):
    """The C expression that turns one 68k register into one native argument."""
    c = classify(t)
    src = reg_expr(reg)
    t = norm(t)
    if c == "string":
        return "(%s)EMU_GPTR(guest0, %s)" % (t, src)
    if c == "widen":
        # sign-extend through LONG: the value is an integer, and a negative one
        # (an error code, a -1 sentinel) must stay negative when it widens
        return "(%s)(LONG)%s" % (t, src)
    return "(%s)%s" % (t, src)


def emit_lib(lib, rel, base, btype, hdr, funcs):
    short = lib.split(".")[0]
    domains = POLICY.get("tag_domains", {})
    object_types = POLICY.get("object_types", {})
    used_domains = []
    used_objects = []
    used_headers = []
    for f in funcs:
        p = function_policy(lib, f)
        if not p:
            continue
        for d in p.get("taglists", {}).values():
            if d not in used_domains:
                used_domains.append(d)
        for sp in p.get("tagged_structs", {}).values():
            if sp.get("header") and sp.get("header") not in used_headers:
                used_headers.append(sp.get("header"))
        for sp in p.get("record_arrays", {}).values():
            if sp.get("header") and sp.get("header") not in used_headers:
                used_headers.append(sp.get("header"))
        for op in p.get("objects", {}).values():
            if op.get("type") not in used_objects:
                used_objects.append(op.get("type"))
        result = p.get("result", {})
        if result.get("kind") == "object" and result.get("type") not in used_objects:
            used_objects.append(result.get("type"))
    uses_structs = (any(function_policy(lib, f) and
                        (function_policy(lib, f).get("structs") or
                         function_policy(lib, f).get("tagged_structs") or
                         function_policy(lib, f).get("record_arrays")) for f in funcs) or
                    any(object_types[o].get("kind") == "facade" for o in used_objects) or
                    any(t.get("kind") == "struct"
                        for d in used_domains for t in domains[d]["tags"]))
    uses_nested_fields = any(object_types[o].get("nested_fields") for o in used_objects)
    out = []
    w = out.append

    def emit_post(items, result_expr=None):
        for lines, when in items:
            if when == "nonzero":
                if result_expr is None:
                    raise RuntimeError("conditional structure copy without a result")
                w("        if (%s)" % result_expr)
                w("        {")
                for line in lines:
                    w("            " + line)
                w("        }")
            else:
                for line in lines:
                    w("        " + line)

    w("/* GENERATED by graft/gen-emu68k-bridge from %s - do not edit." % rel)
    w(" *")
    w(" * Derived crossings for %s. Tier-1 scalar/string calls come straight" % lib)
    w(" * from the .conf prototype and register map; type-sensitive calls additionally")
    w(" * consume the checked semantic policy in graft/emu68k-bridge-policy.json.")
    w(" * Anything still lacking policy remains unavailable rather than guessed.")
    w(" */")
    w("")
    w("#include <exec/types.h>")
    w("#include <%s>" % hdr)
    emitted_headers = {"exec/types.h", hdr}
    if uses_structs:
        w("#include <string.h>")
    if (used_headers or uses_nested_fields or
            any(refusal_policy(lib, f) for f in funcs) or
            any(function_policy(lib, f) and function_policy(lib, f).get("null_args")
                for f in funcs)):
        w("#include <stdio.h>")
    for h in used_headers:
        if h not in emitted_headers:
            w("#include <%s>" % h)
            emitted_headers.add(h)
    for d in used_domains:
        for h in domains[d].get("headers", []):
            if h not in emitted_headers:
                w("#include <%s>" % h)
                emitted_headers.add(h)
    w("")
    w('#include "emu68k_gen.h"')
    if uses_structs:
        w('#include "emu68k_layouts.h"')
    w("")
    for d in used_domains:
        ident = c_ident(d)
        w("static const struct EmuTagDesc emu_tagdesc_%s[] =" % ident)
        w("{")
        tags = domains[d]["tags"]
        for tag in tags:
            if tag["kind"] == "struct":
                st = tag["type"]
                w('    { %s, %s, "%s", emu_fields_%s, EMU_NFIELDS(emu_fields_%s),'
                  % (tag["name"], TAG_KINDS[tag["kind"]], tag["name"], st, st))
                w("      M68K_%s_SIZEOF, sizeof(struct %s), 0, 0 }," % (st, st))
            elif tag["kind"] == "u16_ffff":
                w('    { %s, %s, "%s", NULL, 0, %d, 0, 0, 0 },' %
                  (tag["name"], TAG_KINDS[tag["kind"]], tag["name"],
                   tag["max_count"]))
            elif tag["kind"] == "rgb32":
                w('    { %s, %s, "%s", NULL, 0, %d, 0, 0, 0 },' %
                  (tag["name"], TAG_KINDS[tag["kind"]], tag["name"],
                   tag["max_longs"]))
            elif tag["kind"] == "object":
                w('    { %s, %s, "%s", NULL, 0, 0, 0, EMU_OBJ_%s, %d },' %
                  (tag["name"], TAG_KINDS[tag["kind"]], tag["name"],
                   c_ident(tag["type"]), 1 if tag.get("nullable", True) else 0))
            else:
                w('    { %s, %s, "%s", NULL, 0, 0, 0, 0, 0 },' %
                  (tag["name"], TAG_KINDS[tag["kind"]], tag["name"]))
        if not tags:
            w("    { 0, EMU_TAG_REFUSE, NULL, NULL, 0, 0, 0, 0, 0 },")
        w("};")
        w("static const struct EmuTagDomain emu_tagdomain_%s =" % ident)
        w("{")
        w('    emu_tagdesc_%s, %d, "%s"' % (ident, len(tags), d))
        w("};")
        w("")
    for oname in used_objects:
        ospec = object_types[oname]
        destructor_spec = ospec.get("destructor")
        if not destructor_spec or not destructor_spec.startswith(lib + "."):
            continue
        destructor = destructor_spec.rsplit(".", 1)[1]
        w("static void emu_object_cleanup_%s(APTR emu_base, APTR emu_object)" %
          c_ident(oname))
        w("{")
        w("    %s *%s = emu_base;" % (btype, base))
        w("    %s((%s)emu_object);" % (destructor, ospec["c_type"]))
        w("}")
        w("")
    w("int emu68k_gen_%s(int lvo, struct Emu68kRegs *r, APTR guest0, APTR base," % short)
    w("                  char *err, ULONG errlen)")
    w("{")
    w("    %s *%s = base;" % (btype, base))
    w("    (void)r; (void)guest0; (void)%s; (void)err; (void)errlen;" % base)
    w("")
    w("    switch (lvo)")
    w("    {")
    n = 0
    for f in funcs:
        t = f.tier(lib)[0]
        policy = function_policy(lib, f)
        refusal = refusal_policy(lib, f)
        if not refusal and t not in (1, 2) and not policy:
            continue
        if refusal:
            w("    case %d:  /* %s: explicit reviewed refusal [%d] */" %
              (f.lvo, f.name, f.offset))
            w("        if (err && errlen)")
            message = "capability gap: %s.%s refused: %s" % (
                lib, f.name, refusal["reason"])
            w("            snprintf(err, errlen, %s);" % json.dumps(message))
            w("        r->d[0] = 0;")
            w("        return 1;")
            n += 1
            continue
        regs = [reg_expr(x) or reg_pair(x) for x in f.regs]
        if any(x is None for x in regs):
            continue
        sig = ", ".join("%s %s" % (norm(t), nm) for t, nm in f.args) or "void"
        w("    case %d:  /* %s(%s) -> %s  [%d] */" % (f.lvo, f.name, sig,
                                                      norm(f.ret), f.offset))
        if policy and policy.get("noop"):
            w("        r->d[0] = 0;   /* source-proven no-op; arguments are untouched */")
            w("        return 0;")
            n += 1
            continue
        taglists = policy.get("taglists", {}) if policy else {}
        structs = policy.get("structs", {}) if policy else {}
        tagged_structs = policy.get("tagged_structs", {}) if policy else {}
        pointers = policy.get("pointers", {}) if policy else {}
        arrays = policy.get("arrays", {}) if policy else {}
        record_arrays = policy.get("record_arrays", {}) if policy else {}
        objects = policy.get("objects", {}) if policy else {}
        callbacks = policy.get("callbacks", {}) if policy else {}
        guest_values = policy.get("guest_values", []) if policy else []
        strings = policy.get("strings", []) if policy else []
        null_args = policy.get("null_args", []) if policy else []
        boopsi = policy.get("boopsi") if policy else None
        result_policy = policy.get("result") if policy else None
        result_store_arg = (result_policy or {}).get("store_arg")
        if policy:
            w("    {")
        call_args = []
        post = []
        array_pre = []
        record_pre = []
        precall = []
        destructive_pre = []
        heap_tag_scratch = []
        heap_array_scratch = []
        heap_record_scratch = []
        tag_copybacks = []
        # A "how much of this structure do you want" argument is clamped before
        # anything else: it bounds the guest range check as well as the copy, so
        # it cannot be computed inside the block that already needs it. The
        # clamped value is what the native call is told too, so a short buffer
        # stays short on both sides of the crossing.
        size_limits, size_args = {}, {}
        for sname, sp in structs.items():
            if "size_arg" not in sp:
                continue
            si = [n for _t, n in f.args].index(sp["size_arg"])
            width = SIZE_WIDTHS[norm(f.args[si][0])]
            var = "emu_limit_%d" % si
            w("        ULONG %s = %s%s;"
              % (var, SIZE_CASTS[width], reg_expr(f.regs[si])))
            w("        if (%s > M68K_%s_SIZEOF) %s = M68K_%s_SIZEOF;"
              % (var, sp["type"], var, sp["type"]))
            size_limits[sname] = var
            size_args[sp["size_arg"]] = var
        tagged_size_args = {}
        for bname, sp in tagged_structs.items():
            bi = [n for _t, n in f.args].index(bname)
            ti = [n for _t, n in f.args].index(sp["tag_arg"])
            si = [n for _t, n in f.args].index(sp["size_arg"])
            bsrc = reg_expr(f.regs[bi])
            tsrc = reg_expr(f.regs[ti])
            ssrc = reg_expr(f.regs[si])
            for stype in sp["variants"].values():
                w("        struct %s emu_tagged_%d_%s;" % (stype, bi, stype))
            w("        APTR emu_tagged_native_%d = NULL;" % bi)
            w("        const struct EmuField *emu_tagged_fields_%d = NULL;" % bi)
            w("        ULONG emu_tagged_nfields_%d = 0;" % bi)
            w("        ULONG emu_tagged_native_size_%d = 0;" % bi)
            w("        ULONG emu_tagged_guest_size_%d = 0;" % bi)
            w("        switch ((ULONG)%s)" % tsrc)
            w("        {")
            for macro, stype in sp["variants"].items():
                w("        case %s:" % macro)
                w("            memset(&emu_tagged_%d_%s, 0, sizeof(emu_tagged_%d_%s));"
                  % (bi, stype, bi, stype))
                w("            emu_tagged_native_%d = &emu_tagged_%d_%s;"
                  % (bi, bi, stype))
                w("            emu_tagged_fields_%d = emu_fields_%s;" % (bi, stype))
                w("            emu_tagged_nfields_%d = EMU_NFIELDS(emu_fields_%s);"
                  % (bi, stype))
                w("            emu_tagged_native_size_%d = sizeof(struct %s);" % (bi, stype))
                w("            emu_tagged_guest_size_%d = M68K_%s_SIZEOF;" % (bi, stype))
                w("            break;")
            w("        default:")
            w("            if (err && errlen)")
            w('                snprintf(err, errlen, "%s.%s: unsupported tag %%08lx",'
              % (f.name, bname))
            w("                         (unsigned long)%s);" % tsrc)
            w("            return 1;")
            w("        }")
            w("        ULONG emu_tagged_limit_%d = (ULONG)%s;" % (bi, ssrc))
            w("        if (emu_tagged_limit_%d > emu_tagged_guest_size_%d)"
              % (bi, bi))
            w("            emu_tagged_limit_%d = emu_tagged_guest_size_%d;" % (bi, bi))
            w("        if (emu68k_require_guest_range(%s, emu_tagged_limit_%d," % (bsrc, bi))
            w('                                         "%s.%s", err, errlen) < 0)'
              % (f.name, bname))
            w("            return 1;")
            lines = []
            if sp.get("clear", True):
                lines.append("memset(EMU_GPTR(guest0, %s), 0, emu_tagged_limit_%d);"
                             % (bsrc, bi))
            lines += ["emu68k_to_guest_sized(guest0, %s, emu_tagged_native_%d," % (bsrc, bi),
                      "                   emu_tagged_fields_%d, emu_tagged_nfields_%d, emu_tagged_limit_%d);"
                      % (bi, bi, bi),
                      "r->d[0] = emu_tagged_limit_%d;" % bi]
            post.append((lines, sp.get("copy_on", "always")))
            tagged_size_args[sp["size_arg"]] = "emu_tagged_native_size_%d" % bi
        for ai, ((atype, aname), reg) in enumerate(zip(f.args, f.regs)):
            src = reg_expr(reg)
            if aname == result_store_arg:
                native_type = norm(re.sub(r"\s*\*\s*$", "", atype))
                w("        if (emu68k_require_guest_range(%s, 4," % src)
                w('                                         "%s.%s", err, errlen) < 0)'
                  % (f.name, aname))
                w("            return 1;")
                w("        if (emu68k_scalar_from_guest(guest0, %s, 4) != 0)" % src)
                w("        {")
                w("            if (err && errlen)")
                w('                snprintf(err, errlen, "%s.%s must initially contain NULL");'
                  % (f.name, aname))
                w("            return 1;")
                w("        }")
                w("        %s emu_result_store_native = NULL;" % native_type)
                call_args.append("(%s)&emu_result_store_native" % norm(atype))
                continue
            if classify(atype) == "double":
                hi, lo = reg_pair(reg)
                call_args.append("emu68k_double_in(%s, %s)" % (hi, lo))
                continue
            if aname in objects:
                op = objects[aname]
                oname = op["type"]
                w("        APTR emu_object_%d;" % ai)
                w("        if (emu68k_object_from_guest(guest0, %s, EMU_OBJ_%s, %d,"
                  % (src, c_ident(oname), 1 if op.get("nullable", True) else 0))
                w('                                        "%s", &emu_object_%d, err, errlen) < 0)'
                  % (oname, ai))
                w("            return 1;")
                call_args.append("(%s)emu_object_%d" % (norm(atype), ai))
                if boopsi and boopsi.get("class_arg") == aname:
                    w("        struct Emu68kBoopsiBridge emu_boopsi_%d;" % ai)
                    precall.extend([
                        "        if (emu68k_boopsi_prepare(guest0, %s, emu_object_%d," % (src, ai),
                        "                                   &emu_boopsi_%d, err, errlen) < 0)" % ai,
                        "            return 1;",
                    ])
                    post.append((["if (emu68k_boopsi_finish(&emu_boopsi_%d, err, errlen) < 0)" % ai,
                                  "    return 1;"], "always"))
                if op.get("release", False) or op.get("consume", False):
                    ospec = object_types[oname]
                    stype = ospec.get("facade_struct")
                    for nested in ospec.get("nested_fields", []):
                        if nested["kind"] == "object":
                            post.append(([
                                "emu68k_object_release(guest0,",
                                "    (ULONG)emu68k_scalar_from_guest(guest0, %s + M68K_%s_%s, 4),"
                                % (src, stype, nested["field"]),
                                "    EMU_OBJ_%s);" % c_ident(nested["type"]),
                            ], "always"))
                        elif nested["kind"] in ("embedded_object", "embedded_facade"):
                            post.append(([
                                "emu68k_object_release(guest0,",
                                "    %s + M68K_%s_%s," % (src, stype, nested["field"]),
                                "    EMU_OBJ_%s);" % c_ident(nested["type"]),
                            ], "always"))
                if op.get("release", False):
                    post.append((["emu68k_object_release(guest0, %s, EMU_OBJ_%s);"
                                  % (src, c_ident(oname))], "always"))
                if op.get("consume", False):
                    post.append((["emu68k_object_consume(guest0, %s, EMU_OBJ_%s);"
                                  % (src, c_ident(oname))], "always"))
                if op.get("consume_family", False):
                    ospec = object_types[oname]
                    linked_field = ospec["linked_field"]
                    linked_limit = ospec.get("linked_limit", 4096)
                    native_type = ospec["c_type"]
                    destructive_pre.extend([
                        "        ULONG emu_family_count_%d = 0;" % ai,
                        "        %s emu_family_scan_%d = (%s)emu_object_%d;" %
                        (native_type, ai, native_type, ai),
                        "        while (emu_family_scan_%d && emu_family_count_%d < %d)" %
                        (ai, ai, linked_limit),
                        "        {",
                        "            emu_family_scan_%d = (%s)emu_family_scan_%d->%s;" %
                        (ai, native_type, ai, linked_field),
                        "            emu_family_count_%d++;" % ai,
                        "        }",
                        "        if (emu_family_scan_%d)" % ai,
                        "        {",
                        "            if (err && errlen)",
                        ('                snprintf(err, errlen, "%s.%s linked %s family exceeds '
                         '%d members or contains a cycle");' %
                         (f.name, aname, oname, linked_limit)),
                        "            return 1;",
                        "        }",
                        "        %s emu_family_member_%d = (%s)emu_object_%d;" %
                        (native_type, ai, native_type, ai),
                        "        for (ULONG emu_family_i_%d = 0;" % ai,
                        "             emu_family_i_%d < emu_family_count_%d; emu_family_i_%d++)" %
                        (ai, ai, ai),
                        "        {",
                        "            %s emu_family_next_%d = (%s)emu_family_member_%d->%s;" %
                        (native_type, ai, native_type, ai, linked_field),
                        "            emu68k_object_consume_native(guest0, emu_family_member_%d," % ai,
                        "                EMU_OBJ_%s);" % c_ident(oname),
                        "            emu_family_member_%d = emu_family_next_%d;" % (ai, ai),
                        "        }",
                    ])
                if op.get("sync", False):
                    ospec = object_types[oname]
                    stype = ospec["facade_struct"]
                    post.append(([
                        "emu68k_to_guest_sized(guest0, %s, emu_object_%d," % (src, ai),
                        "    emu_fields_%s, EMU_NFIELDS(emu_fields_%s), M68K_%s_SIZEOF);"
                        % (stype, stype, stype),
                    ], "always"))
                continue
            if aname in callbacks:
                w("        struct Emu68kHookBridge emu_hook_%d;" % ai)
                w("        if (emu68k_hook_prepare(guest0, %s, &emu_hook_%d, err, errlen) < 0)"
                  % (src, ai))
                w("            return 1;")
                call_args.append("(%s)&emu_hook_%d.native" % (norm(atype), ai))
                post.append((["if (emu68k_hook_finish(&emu_hook_%d, err, errlen) < 0)" % ai,
                              "    return 1;"], "always"))
                continue
            if aname in structs:
                sp = structs[aname]
                stype, direction = sp["type"], sp["direction"]
                span = size_limits.get(aname, "M68K_%s_SIZEOF" % stype)
                w("        struct %s emu_struct_%d;" % (stype, ai))
                w("        if (emu68k_require_guest_range(%s, %s," % (src, span))
                w('                                         "%s.%s", err, errlen) < 0)'
                  % (f.name, aname))
                w("            return 1;")
                w("        memset(&emu_struct_%d, 0, sizeof(emu_struct_%d));" % (ai, ai))
                if direction in ("in", "inout"):
                    w("        emu68k_from_guest_sized(guest0, %s, &emu_struct_%d,"
