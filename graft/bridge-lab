#!/usr/bin/env python3
"""bridge-lab - turn a 68k run's trace into runtime-contract findings.

The consumer is an AGENT, so structured output is the product and the text
rendering is a convenience. Every finding is self-describing: it carries the
contract, the invariant in full, the evidence that produced it, and the next
action as data - because an agent cannot skim a terminal and should not have to
read this file to act on a result.

Aggregate first. A run produces tens of thousands of events; a report that
repeated them would cost more to read than the trace. Detail stays addressable
by seq range.

    bridge-lab report <trace> [--text]
    bridge-lab events <trace> --seq A..B
    bridge-lab compare <trace> <baseline.json>
"""

import json
import os
import sys
import collections

HERE = os.path.dirname(os.path.abspath(__file__))
REGISTRY = os.path.join(HERE, "emu68k-runtime-contracts.json")


def load_trace(path):
    """Events, plus the tool's own failures as findings rather than a crash."""
    events, bad = [], 0
    try:
        with open(path, encoding="utf-8") as fh:
            for line in fh:
                line = line.strip()
                if not line:
                    continue
                try:
                    e = json.loads(line)
                except ValueError:
                    bad += 1
                    continue
                if e.get("schema") != 1:
                    bad += 1
                    continue
                events.append(e)
    except OSError as exc:
        return None, str(exc), bad
    return events, None, bad


def load_registry():
    with open(REGISTRY, encoding="utf-8") as fh:
        return json.load(fh)["contracts"]


def by_event(events):
    out = collections.defaultdict(list)
    for e in events:
        out[e.get("event")].append(e)
    return out


def seq_range(rows):
    if not rows:
        return None
    s = [r["seq"] for r in rows]
    return [min(s), max(s)]


# The two axes. MATURITY is what the reviewed registry says we support, and only
# a person changes it. OBSERVATION is what THIS trace showed. Collapsing them
# into one "status" let a trace report "supported" for a contract the registry
# still calls needs-review - the tool announcing a decision it has no authority
# to make.
OBSERVATIONS = ("not-exercised", "exercised-conformant", "exercised-violated",
                "exercised-incomplete", "invalid-trace")

_REG = None


def registry_status(contract):
    global _REG
    if _REG is None:
        _REG = {c["id"]: c for c in load_registry()}
    return _REG.get(contract, {}).get("status", "unregistered")


# A fixture proves the MECHANISM works. It is not a second legacy program
# proving the shape GENERALIZES, so the two are counted apart and never summed:
# promoting a contract on fixture evidence alone would be certifying our own
# test rather than the behaviour it stands for.
def split_evidence(programs):
    fixtures = [p for p in programs if p and p.startswith("gen")]
    return len(programs) - len(fixtures), len(fixtures)


def finding(contract, observation, invariant, summary, evidence,
            next_action=None, counts=(0, 0)):
    assert observation in OBSERVATIONS, observation
    f = {"contract": contract,
         "maturity": registry_status(contract),
         "observation": observation,
         "program_evidence": counts[0],
         "fixture_evidence": counts[1],
         "invariant": invariant,
         "summary": summary,
         "evidence": evidence}
    if next_action:
        f["next_action"] = next_action
    return f


def no_evidence(rows):
    return {"seq_range": None, "aggregate": [], "sample_seq": []}


def not_exercised(contract, invariant, triggers, counts):
    """A run that never triggered a contract has said NOTHING about it.

    Reporting it as conformant is the worst answer this tool can give: it is
    indistinguishable from a run that exercised the contract and satisfied it,
    so an agent would conclude a capability is proven when nothing tested it."""
    return finding(
        contract, "not-exercised", invariant,
        "no %s in this trace: the run says nothing about this contract"
        % " or ".join(triggers),
        no_evidence(None),
        {"kind": "need-evidence",
         "hypothesis": "the program stopped before reaching this behaviour",
         "confirms_if": "the trace holds a bridge.gap or an early run.end",
         "command": "graft/bridge-lab report <trace> --text"}, counts)


def incomplete(contract, invariant, what, evidence, counts):
    """A trigger fired but the expected sequence never finished, because the
    program died at an UNRELATED gap. That is neither conformance nor a
    violation: the contract was reached and then abandoned."""
    return finding(
        contract, "exercised-incomplete", invariant, what, evidence,
        {"kind": "need-evidence",
         "hypothesis": "the run ended at an unrelated capability gap before the "
                       "contract's sequence completed",
         "confirms_if": "capability_gaps is non-empty and names an unrelated vector",
         "command": "graft/bridge-lab report <trace> --text"}, counts)


def check_port_lifecycle(ev, counts, gaps):
    created = ev.get("port.create", [])
    deleted = ev.get("port.delete", [])
    inv = ("a created port names its creating task and owns an allocated signal "
           "bit; deleting it releases that bit")
    if not created and not deleted:
        return not_exercised("port.lifecycle", inv,
                             ["port.create", "port.delete"], counts)
    bad_owner = [e for e in created if not e.get("owner")]
    bad_bit = [e for e in created if not e.get("signal_bit")]
    bits = {e["port"]: e.get("signal_bit") for e in created}
    unreleased = [e for e in deleted
                  if e.get("port") in bits and e.get("signal_bit") != bits[e["port"]]]
    bad = bad_owner + bad_bit + unreleased
    ev_block = {"seq_range": seq_range(created + deleted),
                "aggregate": [{"event": "port.create", "count": len(created)},
                              {"event": "port.delete", "count": len(deleted)}],
                "sample_seq": [e["seq"] for e in (bad or created)[:3]]}
    summary = ("%d ports created, %d deleted, %d without an owner, %d without a bit"
               % (len(created), len(deleted), len(bad_owner), len(bad_bit)))
    if bad:
        return finding("port.lifecycle", "exercised-violated", inv, summary,
                       ev_block,
                       {"kind": "fix-invariant",
                        "hypothesis": "a port was created without an owner or a bit",
                        "confirms_if": "the named seq events lack owner or signal_bit",
                        "command": "graft/bridge-lab events <trace> --seq %s"
                                   % "..".join(str(x) for x in seq_range(bad))},
                       counts)
    return finding("port.lifecycle", "exercised-conformant", inv, summary,
                   ev_block, None, counts)


def check_binding(ev, counts, gaps):
    binds = ev.get("port.bind", [])
    pumps = ev.get("port.pump", [])
    gets = ev.get("port.get", [])
    replies = ev.get("port.reply", [])
    inv = ("only an explicitly bound destination may receive a pumped native "
           "message; a pumped message reaches exactly one guest destination; "
           "reply pairing is released exactly once")
    if not binds and not pumps:
        return not_exercised("event.native_port_binding", inv,
                             ["port.bind", "port.pump"], counts)
    bound = {b.get("destination") for b in binds}
    unsolicited = [p for p in pumps if p.get("destination") not in bound]
    doubled = [m for m, n in
               collections.Counter(r.get("message") for r in replies).items() if n > 1]
    dests = collections.Counter(b.get("destination") for b in binds)
    ev_block = {"seq_range": seq_range(binds + pumps),
                "aggregate": [{"destination": d, "windows_bound": n}
                              for d, n in sorted(dests.items())]
                             + [{"pumped": len(pumps), "got": len(gets),
                                 "replied": len(replies)}],
                "sample_seq": [e["seq"] for e in (unsolicited or binds)[:3]]}
    summary = ("%d bindings to %d destination port(s), %d pumped, %d unsolicited, "
               "%d double replies"
               % (len(binds), len(dests), len(pumps), len(unsolicited), len(doubled)))
    if unsolicited or doubled:
        return finding("event.native_port_binding", "exercised-violated", inv,
                       summary, ev_block,
                       {"kind": "fix-invariant",
                        "hypothesis": "a native message reached a port nothing bound",
                        "confirms_if": "a port.pump names an unbound destination",
                        "command": "graft/bridge-lab events <trace> --seq %s"
                                   % ("..".join(str(x) for x in seq_range(unsolicited))
                                      if unsolicited else "")},
                       counts)
    # Bound, but nothing was ever delivered or replied: reached and abandoned.
    if binds and not pumps and gaps:   # `gaps` = the run did not finish
        return incomplete("event.native_port_binding", inv,
                          summary + " - bound but nothing delivered before the run ended",
                          ev_block, counts)
    return finding("event.native_port_binding", "exercised-conformant", inv,
                   summary, ev_block, None, counts)


def check_mailbox(ev, counts, gaps):
    procs = ev.get("process.create", [])
    inv = "a process's own pr_MsgPort never receives native input"
    if not procs:
        return not_exercised("process.mailbox", inv, ["process.create"], counts)
    mailboxes = {p.get("port") for p in procs}
    leaked = [p for p in ev.get("port.pump", [])
              if p.get("destination") in mailboxes]
    ev_block = {"seq_range": seq_range(procs + leaked),
                "aggregate": [{"mailbox": m} for m in sorted(x for x in mailboxes if x)],
                "sample_seq": [e["seq"] for e in (leaked or procs)[:3]]}
    summary = ("%d process mailbox(es) identified, %d native deliveries into one"
               % (len(mailboxes), len(leaked)))
    if leaked:
        return finding("process.mailbox", "exercised-violated", inv, summary,
                       ev_block,
                       {"kind": "fix-invariant",
                        "hypothesis": "native input is broadcast to a worker mailbox",
                        "confirms_if": "a port.pump destination is a process port",
                        "command": "graft/bridge-lab events <trace> --seq %s"
                                   % "..".join(str(x) for x in seq_range(leaked))},
                       counts)
    return finding("process.mailbox", "exercised-conformant", inv, summary,
                   ev_block, None, counts)


def check_scheduler(ev, counts, gaps):
    """Did a context that owns work never get to run, while a sibling spun?"""
    inv = ("a context that never calls a blocking primitive must not starve "
           "its siblings")
    polls = collections.Counter()
    for e in ev.get("port.get", []) + ev.get("port.wait", []):
        if "context" in e:
            polls[e["context"]] += 1
    yields = ev.get("scheduler.yield", [])
    resumes = ev.get("scheduler.resume", [])
    known = set(polls) | {e.get("context") for e in yields + resumes}
    known.discard(None)
    if len(known) < 2:
        return not_exercised("scheduler.yield.frame_wait", inv,
                             ["a second context"], counts)

    # Threshold-free, and by ORDERING rather than by a poll count tuned to one
    # program. Take the last moment the scheduler did anything; everything after
    # it is a window in which nothing switched. If ONE context ran through that
    # window while another existed and never got a turn, the machine was
    # monopolized - which is the same fact whether the idle context is parked in
    # a wait or suspended inside a nested call, and those look different.
    last_sched = max([e["seq"] for e in yields + resumes], default=0)
    tail = [e for e in ev.get("port.get", []) + ev.get("port.wait", [])
            if e.get("seq", 0) > last_sched and "context" in e]
    tail_ctx = {e["context"] for e in tail}
    tail_yields = [e for e in yields if e.get("seq", 0) > last_sched]
    monopolist = sorted(tail_ctx)
    idle = sorted(known - tail_ctx)
    ev_block = {"seq_range": [last_sched, max([e["seq"] for e in tail],
                                              default=last_sched)],
                "aggregate": [{"context": c, "port_polls": polls.get(c, 0),
                               "yields": sum(1 for y in yields
                                             if y.get("context") == c),
                               "resumes": sum(1 for y in resumes
                                              if y.get("context") == c)}
                              for c in sorted(known)],
                "sample_seq": [e["seq"] for e in tail[:3]]}
    spinning = monopolist if (len(monopolist) == 1 and len(tail) >= 20
                              and not tail_yields and idle) else []
    starved = idle if spinning else []

    if spinning and starved:
        return finding("scheduler.yield.frame_wait", "exercised-violated", inv,
                       "after the last scheduler event, context(s) %s ran %d "
                       "calls with no yield while context(s) %s never got a turn"
                       % (spinning, len(tail), starved), ev_block,
                       {"kind": "propose-contract",
                        "hypothesis": "a frame wait blocks until vertical blank on "
                                      "real hardware and is therefore a yield point",
                        "confirms_if": "the starved context's port_polls rises above 2 "
                                       "once that call declares a yield",
                        "refutes_if": "the spinning context stops making progress",
                        "command": "graft/bridge-lab compare <trace> <baseline.json>"},
                       counts)
    return finding("scheduler.yield.frame_wait", "exercised-conformant", inv,
                   "%d contexts ran; none monopolized the machine" % len(known),
                   ev_block, None, counts)


CHECKS = [check_port_lifecycle, check_binding, check_mailbox, check_scheduler]


# An observation is only meaningful for ONE run. Aggregating several programs
# into one surface hides the very thing a focused fixture exists to isolate: a
# violation in one run is diluted by conformance in the next, and an ordering
# check reads one program's tail as the next program's head. So every check runs
# PER RUN and the report keeps the worst answer, with each run's own result
# beside it.
SEVERITY = {"not-exercised": 0, "exercised-conformant": 1,
            "exercised-incomplete": 2, "exercised-violated": 3,
            "invalid-trace": 4}


def split_runs(events):
    runs, cur = [], []
    for e in events:
        if e.get("event") == "run.start" and cur:
            runs.append(cur)
            cur = []
        cur.append(e)
    if cur:
        runs.append(cur)
    return runs


def worst_across_runs(check, events, counts):
    per_run, worst = [], None
    for rows in split_runs(events):
        ev = by_event(rows)
        starts = ev.get("run.start", [])
        name = starts[0].get("program") if starts else None
        unfinished = (bool(ev.get("bridge.gap")) or
                      not any(x.get("result") == "ok" for x in ev.get("run.end", [])))
        f = check(ev, counts, unfinished)
        per_run.append({"program": name, "observation": f["observation"],
                        "summary": f["summary"]})
        if worst is None or SEVERITY[f["observation"]] > SEVERITY[worst["observation"]]:
            worst = f
    if worst is None:
        return None
    worst["per_run"] = per_run
    return worst


def report(path, as_text=False):
    events, err, bad = load_trace(path)
    if err is not None:
        # The tool's own failure is a finding with the same shape as any other.
        out = {"schema": 1, "trace": path, "findings": [
            finding("tool.trace_readable", "invalid-trace",
                    "a trace named on the command line can be read and parsed",
                    err, {"seq_range": None, "aggregate": [], "sample_seq": []},
                    {"kind": "fix-input",
                     "hypothesis": "the trace was never written, so the recorder was off",
                     "confirms_if": "the file is absent or empty",
                     "command": "EMU68K_BRIDGE_TRACE=<file> <run the program>"})]}
        emit(out, as_text)
        return 1

    ev = by_event(events)
    starts = ev.get("run.start", [])
    findings = []
    if not starts:
        # Distinguishable by construction: run.start is unconditional.
        findings.append(finding(
            "tool.trace_readable", "invalid-trace",
            "an enabled recorder always emits run.start",
            "no run.start: the recorder never ran, so this trace describes nothing",
            {"seq_range": None, "aggregate": [], "sample_seq": []},
            {"kind": "fix-input",
             "hypothesis": "EMU68K_BRIDGE_TRACE did not reach the process",
             "confirms_if": "the file is empty",
             "command": "EMU68K_BRIDGE_TRACE=<file> <run the program>"}))
    counts = split_evidence([x.get("program") for x in starts])

    for check in CHECKS:
        findings.append(worst_across_runs(check, events, counts))

    gaps = ev.get("bridge.gap", [])
    out = {
        "schema": 1,
        "trace": os.path.basename(path),
        # Every run in the file. Contracts are about the SUBSTRATE, not about
        # one program, so the checks read all of them - and a sweep is exactly
        # where a contract one program never reaches gets exercised by another.
        "programs": [x.get("program") for x in starts],
        "program_evidence": counts[0],
        "fixture_evidence": counts[1],
        "results": [e.get("result") for e in ev.get("run.end", [])],
        "events": len(events),
        "malformed_lines": bad,
        "capability_gaps": [{"lvo": g.get("lvo"), "offset": g.get("offset"),
                             "seq": g.get("seq")} for g in gaps],
        "findings": findings,
    }
    emit(out, as_text)
    return 0


def emit(out, as_text):
    if not as_text:
        json.dump(out, sys.stdout, indent=2, sort_keys=False)
        sys.stdout.write("\n")
        return
    print("trace   : %s (%s events)" % (out.get("trace"), out.get("events")))
    print("programs: %s   results: %s   (%d program / %d fixture evidence)"
          % (", ".join(x or "?" for x in out.get("programs") or []) or "none",
             ", ".join(x or "?" for x in out.get("results") or []) or "none",
             out.get("program_evidence", 0), out.get("fixture_evidence", 0)))
    for g in out.get("capability_gaps", []):
        print("GAP     : LVO %s (offset %s) at seq %s"
              % (g["lvo"], g["offset"], g["seq"]))
    for f in out["findings"]:
        print("\n%-22s %s  [registry: %s]"
              % (f["observation"].upper(), f["contract"], f["maturity"]))
        print("  %s" % f["summary"])
        for a in f["evidence"]["aggregate"][:8]:
            print("    %s" % json.dumps(a, sort_keys=True))
        for r in f.get("per_run", []):
            if len(f.get("per_run", [])) > 1:
                print("    per-run: %-14s %s" % (r["program"], r["observation"]))
        if f.get("next_action"):
            print("  next: %s - %s" % (f["next_action"]["kind"],
                                       f["next_action"].get("hypothesis", "")))


def events_cmd(path, lo, hi):
    events, err, _ = load_trace(path)
    if err:
        print(err, file=sys.stderr)
        return 1
    for e in events:
        if lo <= e.get("seq", -1) <= hi:
            print(json.dumps(e, sort_keys=False))
    return 0


def compare(path, baseline):
    """What changed between a run and a recorded baseline, by contract."""
    events, err, _ = load_trace(path)
    if err:
        print(err, file=sys.stderr)
        return 1
    with open(baseline, encoding="utf-8") as fh:
        base = json.load(fh)
    ev = by_event(events)
    counts = split_evidence([x.get("program") for x in ev.get("run.start", [])])
    unfinished = (bool(ev.get("bridge.gap")) or
                  not any(x.get("result") == "ok" for x in ev.get("run.end", [])))
    now = {f["contract"]: f for f in
           (check(ev, counts, unfinished) for check in CHECKS)}
    was = {f["contract"]: f for f in base.get("findings", [])}
    diff = []
    for cid in sorted(set(now) | set(was)):
        a, b = was.get(cid), now.get(cid)
        if not a or not b:
            diff.append({"contract": cid, "change": "added" if b else "removed"})
        elif a.get("observation") != b.get("observation"):
            diff.append({"contract": cid, "change": "observation",
                         "from": a.get("observation"), "to": b.get("observation")})
        elif a["evidence"]["aggregate"] != b["evidence"]["aggregate"]:
            diff.append({"contract": cid, "change": "evidence",
                         "from": a["evidence"]["aggregate"],
                         "to": b["evidence"]["aggregate"]})
    json.dump({"schema": 1, "baseline": os.path.basename(baseline),
               "changes": diff}, sys.stdout, indent=2)
    sys.stdout.write("\n")
    return 1 if diff else 0


def main(argv):
    if len(argv) < 3:
        print(__doc__)
        return 2
    cmd, path = argv[1], argv[2]
    if cmd == "report":
        return report(path, "--text" in argv)
    if cmd == "events":
        rng = None
        for i, a in enumerate(argv):
            if a == "--seq" and i + 1 < len(argv):
                rng = argv[i + 1]
        if not rng or ".." not in rng:
            print("events needs --seq A..B", file=sys.stderr)
            return 2
        lo, hi = rng.split("..", 1)
        return events_cmd(path, int(lo), int(hi))
    if cmd == "compare":
        if len(argv) < 4:
            print("compare needs a baseline", file=sys.stderr)
            return 2
        return compare(path, argv[3])
    print(__doc__)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
