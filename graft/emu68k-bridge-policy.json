    },
    "locale.library.ConvToLower": {
      "objects": {
        "locale": {"type": "Locale", "nullable": false}
      }
    },
    "locale.library.ConvToUpper": {
      "objects": {
        "locale": {"type": "Locale", "nullable": false}
      }
    },
    "locale.library.OpenCatalogA": {
