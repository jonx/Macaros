        {"name": "BIDTAG_DesiredHeight", "kind": "u32"},
        {"name": "BIDTAG_Depth", "kind": "u32"},
        {"name": "BIDTAG_MonitorID", "kind": "u32"},
        {"name": "BIDTAG_SourceID", "kind": "u32"},
        {"name": "BIDTAG_RedBits", "kind": "u32"},
        {"name": "BIDTAG_BlueBits", "kind": "u32"},
        {"name": "BIDTAG_GreenBits", "kind": "u32"}
