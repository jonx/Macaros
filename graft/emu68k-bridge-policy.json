      "result": {"kind": "guest_arg", "arg": "date"}
    },
    "dos.library.CompareDates": {
      "structs": {
        "date1": {"type": "DateStamp", "direction": "in"},
        "date2": {"type": "DateStamp", "direction": "in"}
      }
    },
    "dos.library.Examine": {
      "structs": {
        "fib": {"type": "FileInfoBlock", "direction": "out", "copy_on": "nonzero"}
      }
    },
    "dos.library.ExNext": {
      "structs": {
        "fileInfoBlock": {"type": "FileInfoBlock", "direction": "inout", "copy_on": "nonzero"}
      }
    },
    "dos.library.Info": {
