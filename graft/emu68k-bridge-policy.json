    },
    "icon.library.FreeDiskObject": {
      "objects": {
        "diskobj": {"type": "DiskObject", "nullable": true, "release": true}
      }
    },
    "icon.library.DupDiskObjectA": {
      "objects": {
        "icon": {"type": "DiskObject", "nullable": false}
      },
      "taglists": {"tags": "icon.duplicate"},
      "result": {"kind": "object", "type": "DiskObject"}
    }
