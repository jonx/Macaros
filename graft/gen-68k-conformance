#!/usr/bin/env python3
"""Generate a conformance corpus for the 68k translator: one tiny program per
(instruction, addressing-mode) pair.

The point is coverage of the ADDRESSING MODES, not of the arithmetic. Every
translator bug found so far has been a mode the emitted code got wrong while
the surrounding instruction was fine:

  - PC-relative data access read from an unseeded register, so `move.w
    tbl(pc),d1` silently returned zero and a program jumped through a garbage
    jump table.
  - the indexed jump forms were not recognised as branches at all, so the
    decoder walked off the end of a function into the table's data.

Both were found by a real program dying, days after they were introduced. A
program is a terrible detector: it exercises whatever modes its compiler
happened to emit, reports the failure somewhere unrelated, and says nothing
about the modes it never used.

Each case here is self-checking against the INTERPRETER, which decodes every
mode in plain C and has no register-allocation or emission layer to get wrong.
Same program, both engines, compare the final register file and memory. A
divergence names one instruction and one mode.
"""

import os
import sys

# (name, template). {ea} is the source operand. Each case leaves its result in
# D0..D3 and at the scratch area, then returns.
INSNS = [
    ("move_b", "        move.b  {ea},d0"),
    ("move_w", "        move.w  {ea},d0"),
    ("move_l", "        move.l  {ea},d0"),
    ("add_l",  "        moveq   #7,d0\n        add.l   {ea},d0"),
    ("sub_l",  "        moveq   #99,d0\n        sub.l   {ea},d0"),
    ("cmp_l",  "        moveq   #5,d0\n        cmp.l   {ea},d0"),
    ("and_l",  "        move.l  #$0f0f0f0f,d0\n        and.l   {ea},d0"),
    ("or_l",   "        moveq   #1,d0\n        or.l    {ea},d0"),
    ("tst_l",  "        tst.l   {ea}"),
    # beyond MOVE and arithmetic: the families most likely to hide the next
    # silent bug, because each has its own decoder and its own CCR rules
    ("muls_w", "        move.w  {ea},d0\n        muls.w  #7,d0"),
    ("mulu_w", "        move.w  {ea},d0\n        mulu.w  #3,d0"),
    ("divu_w", "        move.l  {ea},d0\n        andi.l  #$0000ffff,d0\n        divu.w  #7,d0"),
    # the DIVISOR from every mode, not just the dividend. A divide is computed
    # in C so a zero divisor can take the 68k exception path, which makes the
    # source operand this side's problem rather than the emitter's, and it is
    # the operand a compiler is most likely to fetch from memory.
    ("divu_ea", "        move.l  #$00012345,d0\n        divu.w  {ea},d0"),
    ("divs_ea", "        move.l  #$00012345,d0\n        divs.w  {ea},d0"),
    ("asl_l",  "        move.l  {ea},d0\n        asl.l   #3,d0"),
    ("asr_l",  "        move.l  {ea},d0\n        asr.l   #5,d0"),
    ("lsr_l",  "        move.l  {ea},d0\n        lsr.l   #2,d0"),
    ("rol_l",  "        move.l  {ea},d0\n        rol.l   #7,d0"),
    ("ror_l",  "        move.l  {ea},d0\n        ror.l   #4,d0"),
    ("btst_l", "        move.l  {ea},d0\n        moveq   #0,d1\n        btst    #5,d0\n        sne     d1"),
    # bset/bclr are DELIBERATELY absent, and the reason is worth keeping: the
    # oracle does not implement them on a data register and does not say so -
    # it leaves the value unchanged and reports success. The JIT is right
    # (bset #11 on $11223344 gives $11223b44, bclr #6 gives $11223304, both
    # checkable by hand), so every one of those cases looked like a translator
    # bug and was an oracle bug.
    #
    # The real fix is in the oracle: an instruction it does not implement must
    # fail out-of-subset, never quietly do nothing. Until then these cannot be
    # used as a check, because a silent no-op is indistinguishable from a
    # correct answer for any value that happens to already have the bit set.
    ("neg_l",  "        move.l  {ea},d0\n        neg.l   d0"),
    ("not_l",  "        move.l  {ea},d0\n        not.l   d0"),
    ("swap_l", "        move.l  {ea},d0\n        swap    d0"),
    ("extb_w", "        move.l  {ea},d0\n        ext.w   d0\n        ext.l   d0"),
]

# (name, source operand, setup). Every mode a 68000 can name a source with.
MODES = [
    ("dn",       "d4",            "        move.l  #$12345678,d4"),
    ("indirect", "(a1)",          "        lea     data(pc),a1"),
    ("postinc",  "(a1)+",         "        lea     data(pc),a1"),
    ("predec",   "-(a1)",         "        lea     data+8(pc),a1"),
    ("d16an",    "4(a1)",         "        lea     data(pc),a1"),
    ("d8anxn",   "2(a1,d5.w)",    "        lea     data(pc),a1\n        moveq   #2,d5"),
    ("d8anxn_l", "2(a1,d5.l)",    "        lea     data(pc),a1\n        move.l  #2,d5"),
    ("absl",     "absdata",       ""),
    ("d16pc",    "data(pc)",      ""),
    ("d8pcxn",   "data(pc,d5.w)", "        moveq   #4,d5"),
    ("d8pcxn_l", "data(pc,d5.l)", "        move.l  #4,d5"),
    ("imm",      "#$5a5a5a5a",    ""),
]

# Modes an instruction cannot legally take as a source.
ILLEGAL = {
    # tst needs a DATA ALTERABLE destination, so neither an immediate nor a
    # PC-relative source is a legal form. vasm rejects them, correctly.
    ("tst_l", "imm"),
    ("tst_l", "d16pc"), ("tst_l", "d8pcxn"), ("tst_l", "d8pcxn_l"),
    # these load through move.w / move.l first, so an immediate source is a
    # different width than the template assumes
    ("muls_w", "imm"), ("mulu_w", "imm"), ("divu_w", "imm"),
    # the immediate divisor is a WORD, which the shared longword literal is not;
    # divu_w above already covers that form
    ("divu_ea", "imm"), ("divs_ea", "imm"),
}

TEMPLATE = """; GENERATED by graft/gen-68k-conformance - {name}
; Runs under the JIT and under the interpreter oracle; the two final states
; must be identical. A difference is a translator bug in exactly this pair.

        move.l  #$deadbeef,d0
        move.l  #$deadbeef,d1
        moveq   #0,d2
        moveq   #0,d3
{setup}
{body}
        ; leave a memory trace as well, so a wrong value that happens to match
        ; in a register still shows up
        lea     scratch(pc),a2
        move.l  d0,(a2)
        move.l  d1,4(a2)
        rts

        cnop    0,4
data:
        dc.l    $11223344
        dc.l    $55667788
        dc.l    $99aabbcc
        dc.l    $ddeeff00
absdata:
        dc.l    $0f1e2d3c
scratch:
        ds.l    4
"""


def main():
    if len(sys.argv) < 2:
        sys.stderr.write(__doc__)
        return 2
    out = sys.argv[1]
    os.makedirs(out, exist_ok=True)
    n = 0
    for iname, body in INSNS:
        for mname, ea, setup in MODES:
            if (iname, mname) in ILLEGAL:
                continue
            # a byte/word move from an immediate needs a matching-width literal
            src = ea
            if mname == "imm":
                if iname == "move_b":
                    src = "#$5a"
                elif iname == "move_w":
                    src = "#$5a5a"
            name = "%s__%s" % (iname, mname)
            text = TEMPLATE.format(name=name, setup=setup,
                                   body=body.format(ea=src))
            with open(os.path.join(out, name + ".s"), "w") as fh:
                fh.write(text)
            n += 1
    print("%d conformance cases -> %s" % (n, out))
    return 0


if __name__ == "__main__":
    sys.exit(main())
